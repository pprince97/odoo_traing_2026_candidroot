<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="driver_management_list_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.list</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="status"/>
                <field name="per_day_rate"/>
            </xpath>
        </field>
    </record>

    <record id="driver_management_form_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="show_booking_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list"
                        string="Booking History"
                >
                    <field name="booking_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group name="driver_information" string="Driver Information">
                    <field name="status"/>
                    <field name="per_day_rate"/>
                </group>
                <group name="license_details" string="Licence Details">
                    <field name="license_issue_date"/>
                    <field name="birth_date"/>
                    <field name="is_handicap"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="driver_management_menu_action" model="ir.actions.act_window">
        <field name="name">Car Management</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Driver Management" id="driver_management_menu" parent="car_rental_root_menu" action="driver_management_menu_action"
              groups="car_rental_management_tanisha.group_car_rental_manager"/>

</odoo>