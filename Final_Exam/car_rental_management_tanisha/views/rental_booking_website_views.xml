<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <template id="car_rental_booking_form_template" name="Service Request Form">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="pt40 pb40">
                    <div class="container">
                        <h3>Booking Form</h3>
                        <section>
                            <div class="container">
                                <div id="booking_form">
                                    <div class="mt-3">
                                        <label for="customer">Customer *</label>
                                        <div>
                                            <select id="customer" name="customer"
                                                    class="from-select form-control"
                                                    style="width: 400px">
                                                <option hidden="1" selected="1" disabled="1">Select Customer</option>
                                                <t t-foreach="request.env['res.users'].search([])"
                                                   t-as="cus">
                                                    <option t-att-value="cus.id">
                                                        <t t-out="cus.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <label for="start_date">Start date *</label>
                                        <input id="start_date" type="date" class="form-control" name="start_date" style="width: 400px"/>
                                    </div>
                                    <div class="mt-3">
                                        <label for="end_date">End date *</label>
                                        <input id="end_date" type="date" class="form-control" name="end_date" style="width: 400px"/>
                                    </div>
                                    <div class="mt-3">
                                        <label for="trip_details">Trip Details *</label>
                                        <textarea id="trip_details" class="form-control" name="trip_details"
                                                  style="width: 400px" rows="4" required="1"/>
                                    </div>
                                    <div class="mt-3">
                                        <label for="state">State *</label>
                                        <div>
                                            <select id="state" name="state"
                                                    class="from-select form-control"
                                                    style="width: 400px">
                                                <option selected="1" value="draft">Draft</option>
                                                <option value="inquiry">Inquiry</option>
                                                <option value="approved">Approved</option>
                                                <option value="on_going">On-going</option>
                                                <option value="completed">Completed</option>
                                                <option value="paid">Paid</option>
                                                <option value="cancelled">Cancelled</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <button id="booking_create_record" class="btn btn-primary" type="submit">
                                            Submit
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="car_rental_booking_tile_website" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_vendor_category']" position="after">
            <div id="portal_borrow_request">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/web/static/img/rfq.svg'"/>
                    <t t-set="title">My Bookings</t>
                    <t t-set="url" t-value="'/my/rental-bookings'"/>
                    <t t-set="text">View Your Bookings</t>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="car_rental_booking_report_view" name="My Bookings">
        <t t-call="website.layout">
            <div class="container">
                <div class="row">
                    <div class="col-md-3">
                        <div class="o_download_pdf d-flex flex-lg-column flex-xl-row flex-wrap gap-2">
                            <a class="btn btn-light o_download_btn flex-grow-1" href="#" title="Download" role="button">
                                <i class="fa fa-download"/> Download
                            </a>
                        </div>
                    </div>
                    <div class="col-md-9">

                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="car_rental_booking_list" name="My Bookings">
        <t t-call="website.layout">
            <div class="container">
                <div class="row mt-3">
                    <div class="row">
                        <div class="col-md-6">
                            <h3>Bookings</h3>
                        </div>
                        <div class="col-md-6 d-flex justify-content-end">
                            <a href="/booking/form" class="btn btn-primary">Create Booking</a>
                        </div>
                    </div>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Damage Description</th>
                            <th>Damage Charges</th>
                            <th>Total Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="bookings" t-as="rec">
                            <tr>
                                <td>
                                    <t t-if="rec.customer_id">
                                        <a href="/my/rental-booking/view">
                                            <span t-field="rec.customer_id"/>
                                        </a>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.phone">
                                        <span t-field="rec.phone"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.start_date">
                                        <span t-field="rec.start_date"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.end_date">
                                        <span t-field="rec.end_date"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.state">
                                        <span t-field="rec.state"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.damage_description">
                                        <span t-field="rec.damage_description"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.damage_charges">
                                        <span t-field="rec.damage_charges"
                                              t-options="{'widget': 'monetary', 'display_currency': rec.currency_id or res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="rec.total_cost">
                                        <span t-field="rec.total_cost"
                                              t-options="{'widget': 'monetary', 'display_currency': rec.currency_id or res_company.currency_id}"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>