<odoo>
    <data>
        <!-- category-->

        <record model="ir.module.category" id="module_category_rental">
            <field name="name">Car Rental Management</field>
            <field name="sequence">5</field>
        </record>

        <!--  privilege-->

        <record model="res.groups.privilege" id="res_groups_privilege_car_rental">
            <field name="name">User Role</field>
            <field name="category_id" ref="car_management_amitkumar.module_category_rental"/>
            <field name="sequence">7</field>
        </record>

        <!-- Group-->

        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_car_rental"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">21</field>
            <field name="privilege_id" ref="res_groups_privilege_car_rental"/>
            <field name="implied_ids" eval="[(4, ref('car_management_amitkumar.group_user'))]"/>
        </record>

        <record id="manager_access_all_record" model="ir.rule">
            <field name="name">Manger: Access booking</field>
            <field name="model_id" ref="car_management_amitkumar.model_booking_management"/>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="manager_access_cars" model="ir.rule">
            <field name="name">Manger: Access cars</field>
            <field name="model_id" ref="car_management_amitkumar.model_product_product"/>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="manager_access_user" model="ir.rule">
            <field name="name">Manger: Access user</field>
            <field name="model_id" ref="car_management_amitkumar.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>


<!--        User-->
        <record id="user_access_own_record" model="ir.rule">
            <field name="name">user: Access user</field>
            <field name="model_id" ref="car_management_amitkumar.model_res_partner"/>
            <field name="groups" eval="[(4, ref('group_user'))]"/>
            <field name="domain_force">[('id', '=', user.partner_id.id),('member', '=', 'driver')]</field>
        </record>

        <record id="user_access_own_booking" model="ir.rule">
            <field name="name">user: Access booking</field>
            <field name="model_id" ref="car_management_amitkumar.model_booking_management"/>
            <field name="groups" eval="[(4, ref('group_user'))]"/>
            <field name="domain_force">[('customer_detail_ids', '=', user.partner_id.id)]</field>
        </record>


