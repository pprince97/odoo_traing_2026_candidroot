<odoo>
    <record id="book_list_view" model="ir.ui.view">
        <field name="name">booking.management.list.view</field>
        <field name="model">booking.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_detail_ids" widget="many2many_avatar_user"/>
                <field name="vehicle_detail_ids" widget="many2many_tags"/>
                <field name="trip_detail"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <!--    Books form views-->
    <record id="booking_form_view" model="ir.ui.view">
        <field name="name">booking.form.view</field>
        <field name="model">booking.management</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_draft" class="oe_highlight" type="object" string="Draft"
                            invisible="states in ['draft','inquiry','approved','ongoing','completed','paid']"/>

                    <button name="action_inquiry" class="oe_highlight" type="object" string="Inquiry"
                            invisible="states in ['inquiry','approved','ongoing','completed','paid','cancelled']"/>

                    <button name="action_approved" class="oe_highlight" type="object" string="Approved"
                            invisible="states in ['approved','ongoing','completed','paid','cancelled','draft']"/>

                    <button name="action_ongoing" class="oe_highlight" type="object" string="Ongoing"
                            invisible="states in ['ongoing','completed','paid','cancelled','draft','inquiry']"/>

                    <button name="action_completed" class="oe_highlight" type="object" string="Completed"
                            invisible="states in ['completed','paid','cancelled','draft','inquiry','approved']"/>

                    <button name="action_paid" class="oe_highlight" type="object" string="Paid"
                            invisible="states in ['paid','cancelled','draft','inquiry','approved','ongoing',]"/>

                    <button name="action_cancelled" class="oe_highlight" type="object" string="Cancelled"
                            invisible="states in ['cancelled','draft','inquiry','approved','ongoing','completed']"/>

                    <field name="states" widget="statusbar"
                           statusbar_visible="draft,inquiry,approved,ongoing,completed,paid,cancelled"
                           options="{'clickable': '1'}"/>
                </header>

                <sheet>
                    <group>
                        <group string="Customer Details">
                            <field name="customer_detail_ids"
                                   domain="[('member', '=', 'driver'),('status', '=', 'available')]"
                                   widget="many2many_avatar_user"/>

                            <field name="vehicle_detail_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>

                            <field name="start_date" widget="daterange" options="{'end_date_field': 'end_date'}"/>

                            <field name="start_km"/>
                            <field name="end_km"/>
                            <field name="trip_detail"/>
                        </group>

                        <group string="Trip Cost" groups="car_management_amitkumar.group_manager">
                            <field name="km_cost"/>
                            <field name="trip_km"/>

                            <field name="issue_days"/>

                            <field name="total_trip_cost"/>
                        </group>

                        <group string="Vehicle Damage">
                            <field name="damage_charge"/>
                            <field name="damage_description"/>
                        </group>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>


    <record id="booking_action_window" model="ir.actions.act_window">
        <field name="name">Booking Records</field>
        <field name="res_model">booking.management</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="car_booking_record"
              name="Booking Management"
              parent="parent_car_management"
              action="booking_action_window"/>

</odoo>