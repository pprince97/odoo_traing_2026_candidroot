    <record id="driver_action_window" model="ir.actions.act_window">
        <field name="name">Driver Records</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_member':'driver'}</field>
    </record>

    <record id="action_driver_list" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="driver_list_view"/>
        <field name="act_window_id" ref="driver_action_window"/>
    </record>

    <record id="action_driver_form" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="driver_form_view"/>
        <field name="act_window_id" ref="driver_action_window"/>
    </record>

<!--    <record id="action_driver_search" model="ir.actions.act_window.view">-->
