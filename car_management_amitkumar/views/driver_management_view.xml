<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="driver_list_view" model="ir.ui.view">
        <field name="name">driver.list.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="license_details"/>
                <field name="driver_per_day_rate"/>
            </list>
        </field>
    </record>


    <record id="driver_form_view" model="ir.ui.view">
        <field name="name">driver.form.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="get_booking_record" class="oe_stat_button" type="object" icon="fa-book">
                            <field name="driver_booking_count" string="Total Booking Record" widget="statinfo"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="license_details"/>
                            <field name="driver_per_day_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


