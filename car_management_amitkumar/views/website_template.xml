<odoo>
    <template id="portal_my_home_books" name="Bookings" inherit_id="portal.portal_my_home" priority="10">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div id="portal_alert_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                    <t t-set="title">Booking</t>
                    <t t-set="url" t-value="'/booking/data'"/>
                    <t t-set="text">View and Create a Booking</t>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>


    <template id="portal_my_orders" name="My Sales Orders">
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_table">
                <form action="/booking/form" method="get">
                    <button type="submit" class="btn btn-primary">Create Record</button>
                </form>

                <thead>
                    <tr class="active">
                        <th>
                            <span class='d-none d-md-inline'>Report</span>
                        </th>
                        <th class="text-end">Customer</th>
                        <th class="text-end">Vehicle</th>
                        <th class="text-end">Start Date</th>
                        <th class="text-end">End Date</th>
                        <th class="text-end">Trip Details</th>
                    </tr>
                </thead>
                <t t-foreach="docs" t-as="val">
                    <tr>
                        <td class="text-end">
                            <a href="/book/print">
                                <i class="fa fa-download"/>
                                Download Report
                            </a>
                        </td>
                        <td class="text-end">
                            <span t-field="val.customer_detail_ids"/>
                        </td>
                        <td class="text-end">
                            <span t-field="val.vehicle_detail_ids"/>
                        </td>
                        <td class="text-end">
                            <span t-field="val.start_date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td class="text-end">
                            <span t-field="val.end_date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td class="text-end">
                            <span t-field="val.trip_detail"/>
                        </td>
                    </tr>
                </t>
            </t>
<!--            <div id="sale_order_communication">-->
<!--                <h3>Communication history</h3>-->
<!--                <t t-call="portal.message_thread"/>-->
<!--            </div>-->
        </t>
    </template>
</odoo>