<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="vehicle_customer_kanban" model="ir.ui.view">
            <field name="name">Customer</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="name"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="phone"/>
                                </div>
                            </div>
                            <div>
                               <field name="email"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="vehicle_customer_form" model="ir.ui.view">
            <field name="name">Customer</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Form View">

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="phone"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="vehicle_customer_action" model="ir.actions.act_window">
            <field name="name">Customer</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'default_is_customer':1}</field>
            <field name="domain">[('is_customer','=','1')]</field>
        </record>

        <record model="ir.actions.act_window.view" id="vehicle_customer_kanban_action">
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="vehicle_customer_kanban"/>
            <field name="act_window_id" ref="vehicle_customer_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="vehicle_customer_form_action">
            <field name="view_mode">form</field>
            <field name="view_id" ref="vehicle_customer_form"/>
            <field name="act_window_id" ref="vehicle_customer_action"/>
        </record>

        <menuitem id="vehicle_customer_menu" name="Customer" parent="car_rental_management_jui.car_rental_management_menu" action="vehicle_customer_action" groups="car_rental_management_jui.car_rental_group_manager"/>
    </data>
</odoo>