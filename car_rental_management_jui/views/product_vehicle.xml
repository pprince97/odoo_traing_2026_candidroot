<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_vehicle_list" model="ir.ui.view">
            <field name="name">Vehicles</field>
            <field name="model">product.product</field>
            <field name="arch" type="xml">
            <list>
                <field name="vehicle_code" width="25px"/>
                <field name="name" width="30px"/>
                <field name="vehicle_type" width="30px"/>
                <field name="status" width="30px"/>
                <field name="cost_per_km" width="30px"/>
                <field name="service_per_km" width="25px"/>
                <field name="per_day_km" width="25px"/>
            </list>
            </field>
        </record>

        <record id="product_vehicle_form" model="ir.ui.view">
            <field name="name">Vehicle</field>
            <field name="model">product.product</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="available,booked,maintenance"/>
                    </header>
                    <sheet>
                        <div name="button_box" position="inside">
                            <button name="maintenance_records"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-list">
                                <field name="maintenance_records_count" string="Maintenance Records" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="vehicle_code"/>
                                <field name="name"/>
                                <field name="vehicle_type"/>
                            </group>
                            <group>
                                <field name="cost_per_km"/>
                                <field name="service_per_km"/>
                                <field name="per_day_km"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_vehicle_action" model="ir.actions.act_window">
            <field name="name">Vehicle</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'default_is_vehicle':1}</field>
            <field name="domain">[('is_vehicle','=','1')]</field>
        </record>

        <record model="ir.actions.act_window.view" id="product_vehicle_list_action">
            <field name="view_mode">list</field>
            <field name="view_id" ref="product_vehicle_list"/>
            <field name="act_window_id" ref="product_vehicle_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="product_vehicle_form_action">
            <field name="view_mode">form</field>
            <field name="view_id" ref="product_vehicle_form"/>
            <field name="act_window_id" ref="product_vehicle_action"/>
        </record>

        <menuitem id="product_vehicle_menu" name="Vehicle" parent="car_rental_management_jui.car_rental_management_menu" action="product_vehicle_action"  groups="car_rental_management_jui.car_rental_group_manager"/>
    </data>
</odoo>