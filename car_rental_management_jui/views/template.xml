<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="car_rental_management_jui.inheritedaccountcarrental" name="Car Rental Bookings"
              inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Car Rental Bookings</t>
                <t t-set="text">My Car Rental Bookings</t>
                <t t-set="url" t-value="'/my/car/rental/bookings'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <record id="car_rental_management_jui.model_vehicle_booking" model="ir.model">
        <field name="website_form_access">True</field>
    </record>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>vehicle.booking</value>
        <value eval="[
        'customer_id',
        'booking_line_ids',
        'rent_date',
        'return_date',
        'trip_place',
        'no_of_days',
        'state',
        'damage_description',
        'damage_charges',
        'total_kms',
        'total_cost',
        'invoice_id',
            ]"/>
    </function>

    <template id="car_rental_management_jui.car_rental_bookings_template_list" name="Customer Rental Bookings">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">

                    <!-- HEADER -->
                    <section class="title mb-5">
                        <span class="bg-primary d-flex pt-4 pb-4"
                              style="background-position: 50% 0;">
                            <div class="container">
                                <h1 class="text-white">Customer Rental Bookings</h1>
                            </div>
                        </span>
                    </section>
                    <div class="container mt-2 mb-4">
                        <div class="row">
                            <div class="col-md-6 ">
                                <h3 class="mb-4">Customer Rental Bookings</h3>
                            </div>
                            <div class="col-md-6 mt-2 text-end">
                                <a href="/my/car/rental/bookings/form/" role="button" class="btn btn-primary s_website_form_send">Book Car Rental</a>
                            </div>
                        </div>
                    </div>

                    <div class="container">
                        <div class="container">
                            <table class="table table-hover mb-5 bg-white">
                                <thead>
                                    <tr class="active">
                                        <th name="customer_id">Customer</th>
                                        <th name="rent_date">Rent Date</th>
                                        <th name="return_date">Return Date</th>
                                        <th name="trip_place">Trip Place</th>
                                        <th name="no_of_days">No of days</th>
                                        <th name="state">State</th>
                                        <th name="total_kms">Total Kms</th>
                                        <th name="total_cost">Total Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="requests" t-as="req">
                                        <tr>
                                            <td>
                                                <a t-attf-href="/my/car/rental/bookings/view/#{req.id}">
                                                    <span t-field="req.customer_id"/>
                                                </a>
                                            </td>
                                            <td>
                                                <span t-field="req.rent_date"/>
                                            </td>
                                            <td>
                                                <span t-field="req.return_date"/>
                                            </td>
                                            <td>
                                                <span t-field="req.trip_place"/>
                                            </td>
                                            <td>
                                                <span t-field="req.no_of_days"/>
                                            </td>
                                            <td>
                                                <span t-field="req.state"/>
                                            </td>
                                            <td>
                                                <span t-field="req.total_kms"/>
                                            </td>
                                            <td>
                                                <span t-field="req.total_cost"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-center mt-3 mb-5">
                                <t t-call="website.pager">
                                    <t t-set="_classes">mt-2 ml-md-2</t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="car_rental_bookings_template_view" name="Car Rental Bookings">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container">
                    <h1 class="mt-4">Booking Record Details</h1>

                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-3">Customer</div>
                                <div class="col-sm-9">
                                    <span t-field="record.customer_id.name"/>
                                </div>

                                <div class="col-sm-3">Trip Place</div>
                                <div class="col-sm-9">
                                    <span t-field="record.trip_place"/>
                                </div>

                                <div class="col-sm-3">No of days</div>
                                <div class="col-sm-9">
                                    <span t-field="record.no_of_days"/>
                                </div>

                                <div t-if="record.rent_date" class="col-sm-3">Rent Date</div>
                                <div t-if="record.rent_date" class="col-sm-9">
                                    <span t-field="record.rent_date"/>
                                </div>

                                <div t-if="record.return_date" class="col-sm-3">Return Date</div>
                                <div t-if="record.return_date" class="col-sm-9">
                                    <span t-field="record.return_date"/>
                                </div>

                                <div class="col-sm-3">State</div>
                                <div class="col-sm-9">
                                    <span t-field="record.state"/>
                                </div>

                                <div class="col-sm-3">Total Kms</div>
                                <div class="col-sm-9">
                                    <span t-field="record.total_kms"/>
                                </div>

                                <div class="col-sm-3">Total Cost</div>
                                <div class="col-sm-9">
                                    <span t-field="record.total_cost"/>
                                </div>

                                <div t-if="record.damage_charges" class="col-sm-3">Damage Charges</div>
                                <div t-if="record.damage_charges" class="col-sm-9">
                                    <span t-field="record.damage_charges"/>
                                </div>

                                <div t-if="record.damage_description" class="col-sm-3">Damage Description</div>
                                <div t-if="record.damage_description" class="col-sm-9">
                                    <span t-field="record.damage_description"/>
                                </div>

                            </div>

                            <h6>Vehicles:</h6>
                            <t t-if="record.booking_line_ids">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Vehicle</th>
                                            <th>Start Km</th>
                                            <th>End Km</th>
                                            <th>Driver</th>
                                            <th>Total Km</th>
                                            <th>Total Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="record.booking_line_ids" t-as="line">
                                            <tr>
                                                <td>
                                                    <t t-out="line.vehicle_id.name"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.start_km"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.end_km"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.driver_id.name"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.total_km"/>
                                                </td>
                                                <td>
                                                    <t t-out="line.total_cost"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p>No vehicles rented.</p>
                            </t>
                        </div>
                    </div>
                    <div class="my-3">
                        <t t-if="record.state == 'paid'">
                            <a t-attf-href="/my/rental/print/#{record.id}" class="btn btn-primary">
                                Print Report
                            </a>
                        </t>

                        <div id="chatter" class="oe_chatter mt-4">
                            <h3>Communication history</h3>
                            <t t-call="portal.message_thread">
                                <t t-set="object" t-value="record"/>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="car_rental_management_jui.car_rental_bookings_template_form" name="Car Rental Booking Form">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">

                    <!-- HEADER -->
                    <section class="title mb-5">
                        <span class="bg-primary d-flex pt-4 pb-4"
                              style="background-position: 50% 0;">
                            <div class="container">
                                <h1 class="text-white">Car Rental Booking Form</h1>
                            </div>
                        </span>
                    </section>

                    <section class="body mt-5 mb-5">
                        <div class="container">
                            <form action="/my/car/rental/bookings/form/submit" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="request_id" t-att-value="id"/>

                                <div class="row">
                                    <div class="mb-2 col-lg-6">
                                        <t t-set="current_customer" t-value="request.env.user.partner_id"/>

                                        <label class="col-form-label">Customer*s</label>
                                        <select name="customer_id" class="form-control"
                                                readonly="1"
                                                style="pointer-events:none; background:#e9ecef;">
                                            <option t-att-value="current_customer.id" selected="selected">
                                                <t t-esc="current_customer.name"/>
                                            </option>
                                        </select>
                                    </div>
                                    <div id="div_rent_date" class="col-lg-6 mb-2">
                                        <label class="col-form-label" for="rent_date">
                                            Rent Date*
                                        </label>
                                        <input id="rent_date" type="date" name="rent_date" class="form-control" t-att-value="requests.rent_date if requests else ''"/>
                                    </div>
                                    <div id="div_return_date" class="col-lg-6 mb-2">
                                        <label class="col-form-label" for="return_date">
                                            Return Date*
                                        </label>
                                        <input id="return_date" type="date" name="return_date" class="form-control" t-att-value="requests.return_date if requests else ''"/>
                                    </div>
                                    <div id="div_trip_place" class="col-lg-6 mb-2">
                                        <label class="col-form-label" for="s_trip_place">
                                            Trip Place*
                                        </label>
                                        <input id="s_trip_place" type="text" name="trip_place" class="form-control" t-att-value="requests.trip_place if requests else ''"/>
                                    </div>
                                </div>

                                <div class="table-responsive mt-4">
                                    <t t-set="request_lines" t-value="requests.booking_line_ids if requests else []"/>
                                    <t t-set="available_vehicles" t-value="request.env['product.product'].search([('is_vehicle','=',True),('status','in',['available'])])"/>
                                    <t t-set="available_drivers" t-value="request.env['res.partner'].search([('is_driver','=',True),('status','=',True)])"/>

                                    <table class="table table-bordered">
                                        <thead class="bg-light">
                                            <tr>
                                                <th>Vehicle</th>
                                                <th>Driver</th>
                                                <th class="text-end">Start Km</th>
                                                <th class="text-end">End Km</th>
                                                <th class="text-center">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            <!-- EXISTING LINES -->
                                            <t t-foreach="request_lines" t-as="line">
                                                <tr>
                                                    <td><t t-esc="line.vehicle_id.name"/></td>
                                                    <td><t t-esc="line.driver_id.name"/></td>
                                                    <td class="text-end"><t t-esc="line.start_km"/></td>
                                                    <td class="text-end"><t t-esc="line.end_km"/></td>
                                                    <td class="text-center">
                                                        <a t-attf-href="/car/rental/booking/line/delete/#{line.id}"
                                                           class="btn btn-sm btn-danger">
                                                            Delete
                                                        </a>
                                                    </td>
                                                </tr>
                                            </t>

                                            <!-- ADD LINE ROW -->
                                            <tr class="bg-light">
                                                <td>
                                                    <select name="new_vehicle_id" class="form-control">
                                                        <option value="">Select Vehicle...</option>
                                                        <t t-foreach="available_vehicles" t-as="veh">
                                                            <option t-att-value="veh.id">
                                                                <t t-esc="veh.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </td>

                                                <td>
                                                    <select name="new_driver_id" class="form-control">
                                                        <option value="">Select Driver...</option>
                                                        <t t-foreach="available_drivers" t-as="driver">
                                                            <option t-att-value="driver.id">
                                                                <t t-esc="driver.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </td>

                                                <td>
                                                    <input type="number" name="new_start_km" value="0"
                                                           class="form-control text-end"/>
                                                </td>

                                                <td>
                                                    <input type="number" name="new_end_km" value="0"
                                                           class="form-control text-end"/>
                                                </td>

                                                <td class="text-center">
                                                    <button type="submit"
                                                            name="action"
                                                            value="add_line"
                                                            class="btn btn-primary btn-sm">
                                                        Add Line
                                                    </button>
                                                </td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </div>

                                <!-- FINAL SUBMIT -->
                                <div class="mt-4">
                                    <button id="save_details" type="submit" class="btn btn-primary">
                                        Submit
                                    </button>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>

    <template id="car_rental_management_jui.thank_you" name="Thank You">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <section class="body mt-5 mb-5">
                        <div class="container text-center center">
                            <h2> Thank you 🙂 </h2>
                            <p class="fs-5">Your Booking Request has been submitted</p>
                        </div>
                        <div class="justify-content-center mt-2 d-flex"><a href="/my/home" class="fs-5">Home</a></div>
                    </section>
                </div>
            </div>
        </t>
    </template>
</odoo>