<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vehicle_maintenance_list" model="ir.ui.view">
            <field name="name">Maintenance</field>
            <field name="model">vehicle.maintenance</field>
            <field name="arch" type="xml">
            <list>
                <field name="vehicle_id" width="30px"/>
                <field name="current_km" width="30px"/>
                <field name="arrival_date" width="15px"/>
                <field name="dispatch_date" width="40px"/>
                <field name="parts_ids" width="40px"/>
                <field name="status" width="40px"/>
            </list>
            </field>
        </record>

        <record id="vehicle_maintenance_form" model="ir.ui.view">
            <field name="name">Maintenance</field>
            <field name="model">vehicle.maintenance</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <header>
                        <button name="status_completed"
                                string="Complete"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['completed','paid']"
                        />
                        <button name="status_paid"
                                string="Pay"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['on_going','paid']"
                        />
                        <field name="status" widget="statusbar" statusbar_visible="on_going,completed,paid"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="vehicle_id" domain="[('is_vehicle','=',True),('status','in',['available'])]" options="{'no_open': True, 'no_create': True}"/>
                                <field name="current_km"/>
                            </group>
                            <group>
                                <field name="arrival_date"/>
                                <field name="dispatch_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="product_parts" string="Parts">
                                <field name="parts_ids">
                                    <list editable="bottom">
                                        <field name="part_id" width="30px" domain="[('is_part','=',True)]" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="price" width="15px"/>
                                    </list>
                                </field>
                                <group name="note_group" col="6" class="mt-2 mt-md-0">
                                    <group class="oe_subtotal_footer order-0 order-lg-1 flex-column" colspan="2" name="total_cost">
                                        <field name="total_cost"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="vehicle_maintenance_action" model="ir.actions.act_window">
            <field name="name">Maintenance</field>
            <field name="res_model">vehicle.maintenance</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="vehicle_maintenance_menu" name="Maintenance" parent="car_rental_management_jui.car_rental_management_menu" action="vehicle_maintenance_action"  groups="car_rental_management_jui.car_rental_group_manager"/>

    </data>
</odoo>