<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--   Group Category   -->
        <record model="ir.module.category" id="module_category_car_rental_management">
            <field name="name">Car Rental Management</field>
            <field name="sequence">1</field>
        </record>

        <!-- Group Privilage    -->
        <record model="res.groups.privilege" id="res_groups_privilege_service">
            <field name="name">Car Rental</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="car_rental_management_rushvi.module_category_car_rental_management"/>
        </record>
        .
        <!--  Groups  -->
        <record id="group_car_rental_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>

        <record id="group_car_rental_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('car_rental_management_rushvi.group_car_rental_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>

        </record>

        <record id="group_car_rental_admin" model="res.groups">
            <field name="name">POS Cash Manager</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!--        RECORD RULES       -->
        <!--     Car Rental Request        -->
        <record id="request_restriction_customer" model="ir.rule">
            <field name="name">Request Restriction for customer</field>
            <field name="model_id" ref="model_car_rent_booking"/>
            <field name="domain_force">[('customer_id','=',user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="request_restriction_customer" model="ir.rule">
            <field name="name">Request Restriction for user/manager</field>
            <field name="model_id" ref="model_car_rent_booking"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('car_rental_management_rushvi.group_car_rental_user'))]"/>
        </record>

    </data>
</odoo>