<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="car_rental_request">
        <t t-call="website.layout">
            <t>
                <div class="container my-5">
                    <div class="card shadow-sm border-0 custom-book-form">
                        <div class="card-header bg-primary text-white py-3">
                            <h4 class="mb-0 text-light">Add New Car Rental Request</h4>
                        </div>
                        <div class="card-body p-4">
                            <form action="/my/car-rentals/create" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-md-12">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="form-label fw-bold">Trip Start Date
                                                <span class="text-danger">*</span>
                                            </label>
                                            <input type="date" name="trip_start_date" required="1" class="form-control" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">Trip End Date
                                                <span class="text-danger">*</span>
                                            </label>
                                            <input type="date" name="trip_end_date" class="form-control" required="1"/>
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label fw-bold">Trip Details<span class="text-danger">*</span></label>
                                            <input type="textarea" name="trip_description" required="1" class="form-control"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5 text-end">
                                    <a href="/my/car-rentals" class="btn btn-link text-muted me-3">Cancel</a>
                                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm"> Request
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>