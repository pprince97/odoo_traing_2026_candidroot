<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_car_rent_management_bookings_list" model="ir.ui.view">
        <field name="name">car.rent.bookings.list</field>
        <field name="model">car.rent.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_number"/>
                <field name="customer_id"/>
                <field name="trip_start_date"/>
                <field name="trip_end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_car_rent_management_bookings_form" model="ir.ui.view">
        <field name="name">car.rent.management.bookings.form</field>
        <field name="model">car.rent.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object"
                            name="state_inquiry"
                            string="Inquiry"
                            invisible="state in ['completed','inquiry','approved','paid','on_going','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="generate_invoice"
                            string="Generate Invoice"
                            invisible="state in ['inquiry','draft','approved','paid','on_going','canceled'] or invoice_id"
                            class="oe_highlight"/>
                    <button type="object"
                            name="state_approved"
                            string="Approved"
                            invisible="state in ['draft','approved','completed','paid','on_going','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="state_on_going"
                            string="On Going"
                            invisible="state in ['draft','inquiry','completed','paid','on_going','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="state_completed"
                            string="Completed"
                            invisible="state in ['draft','inquiry','approved','completed','paid','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="state_paid"
                            string="Paid"
                            invisible="state in ['draft','inquiry','approved','paid','on_going','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="state_paid"
                            string="Cancel"
                            invisible="state in ['completed','paid','on_going','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,inquiry,approved,on_going,completed,paid,canceled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id" readonly="state not in ['draft','inquiry']"/>
                            <field name="serial_number" readonly="1"/>
                            <field name="trip_details" readonly="state not in ['draft','inquiry']"/>
                            <field name="damage_description"
                                   invisible="state in ['draft','inquiry','approved','on_going','canceled']"
                                   readonly="state in ['paid']"/>
                            <field name="damage_cost"
                                   invisible="state in ['draft','inquiry','approved','on_going','canceled']"
                                   readonly="state in ['paid']"/>
                        </group>
                        <group>
                            <field name="trip_start_date" readonly="state not in ['draft','inquiry']"/>
                            <field name="trip_end_date" readonly="state not in ['draft','inquiry']"/>
                            <field name="total_cost" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="unavailable_vehicle_ids" invisible="1"/>
                            <field name="selected_vehicle_ids" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vehicles" name="vehicles">
                            <field name="booking_vehicle_ids" readonly="state not in ['draft','inquiry']">
                                <list editable="bottom">
                                    <field name="vehicle_id"
                                           domain="[('vehicle_code','ilike','V%'),('id', 'not in', parent.unavailable_vehicle_ids),('id', 'not in', parent.selected_vehicle_ids)]"
                                           options="{'no_create_edit': True}"/>
                                    <field name="driver_id" domain="[('driver_code','ilike','DR%'),('status','=','available')]"/>
                                    <field name="trip_start_kms"/>
                                    <field name="trip_end_kms"/>
                                    <field name="total_kms"/>
                                    <field name="total_min_kms"/>
                                    <field name="per_km_cost"/>
                                    <field name="total_cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

     <record id="action_car_rent_management_bookings" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">car.rent.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Bookings" id="car_rent_management_bookings_menuitem"
              parent="car_rental_menu_root"
              action="action_car_rent_management_bookings"/>
</odoo>