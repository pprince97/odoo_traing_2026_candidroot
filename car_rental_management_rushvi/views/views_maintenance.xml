<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_car_rent_management_maintenance_list" model="ir.ui.view">
        <field name="name">car.rent.maintenance.list</field>
        <field name="model">car.rent.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="current_kms"/>
                <field name="arrival_date"/>
                <field name="dispatch_date"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>

    <record id="view_car_rent_management_maintenance_form" model="ir.ui.view">
        <field name="name">car.rent.management.maintenance.form</field>
        <field name="model">car.rent.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object"
                            name="status_arrived"
                            string="Arrived"
                            invisible="status in ['arrived','paid','dispatched','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="status_dispatched"
                            string="Dispatched"
                            invisible="status in ['draft','arrived','canceled','dispatched']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="status_paid"
                            string="Paid"
                            invisible="status in ['draft','dispatched','paid','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <button type="object"
                            name="status_canceled"
                            string="Cancel"
                            invisible="status in ['arrived','paid','dispatched','canceled']"
                            class="oe_highlight"
                            groups="car_rental_management_rushvi.group_car_rental_manager"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,arrived,paid,dispatched,canceled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="current_kms"/>
                            <field name="arrival_date"/>
                            <field name="dispatch_date"/>
                            <field name="bill_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="parts_added_ids" widget="many2many_tags" domain="[('vehicle_code','=',False)]"/>
                            <field name="service_cost"/>
                            <field name="parts_cost"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="action_car_rent_management_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">car.rent.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Maintenance" id="car_rent_maintenance_menuitem"
              parent="car_rental_menu_root"
              action="action_car_rent_management_maintenance"
              groups="car_rental_management_rushvi.group_car_rental_manager"/>
</odoo>