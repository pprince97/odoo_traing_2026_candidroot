<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="booking_report_template">
        <t t-call="web.external_layout">
            <t t-esc="docs"/>
            <br/>
            <t t-esc="doc_model"/>
            <t t-foreach="docs" t-as="rec">
                Customer name:
                <span t-field="rec.partner_id"/>
                <br/>
                Report date:
                <span t-field="rec.invoice_date"/>
                <br/>
                <table class="table" style="border: 1px solid black">
                    <thead>
                        <tr>
                            <th>
                                <span>Vehicle</span>
                            </th>
                            <th>
                                <span>Driver</span>
                            </th>
                            <th>
                                <span>Cost per KM</span>
                            </th>
                            <th>
                                <span>Trip KM/Adjustment KM</span>
                            </th>
                            <th>
                                <span>Cost</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>

                    </tbody>
                </table>
                <hr style="width: 20%; margin-left: auto; margin-right: 0"/>
                <div class="o_total text-end">
                    <strong>Total Amount:</strong>
                    <strong t-field="rec.amount_total"/>
                </div>
            </t>
        </t>
    </template>

    <template id="rental_report_booking">
        <t t-call="web.html_container">
            <t t-call="car_rental_management_tanisha.booking_report_template"/>
        </t>
    </template>

    <record id="generate_report_booking" model="ir.actions.report">
        <field name="name">Booking Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">car_rental_management_tanisha.report_booking</field>
        <field name="report_file">car_rental_management_tanisha.report_booking</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>

