<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <!-- Groups Category -->
    <record model="ir.module.category" id="car_rental_management_groups_category">
        <field name="name">Car Rental Management</field>
        <field name="sequence">1</field>
    </record>

    <!-- Groups Privilege -->
    <record model="res.groups.privilege" id="car_rental_management_groups_privilege">
        <field name="name">Car Rental</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="car_rental_management_tanisha.car_rental_management_groups_category"/>
    </record>

    <!-- Groups -->
    <record id="group_car_rental_customer" model="res.groups">
        <field name="name">Customer</field>
        <field name="sequence">3</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="privilege_id" ref="car_rental_management_groups_privilege"/>
    </record>

    <record id="group_car_rental_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">4</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
<!--        <field name="user_ids" eval="[(4, ref('base.group_admin'))]"/>-->
        <field name="privilege_id" ref="car_rental_management_groups_privilege"/>
    </record>

    <!-- Bookings -->
    <record id="customer_bookings" model="ir.rule">
        <field name="name">User: Own Bookings</field>
        <field name="model_id" ref="car_rental_management_tanisha.model_rental_booking"/>
        <field name="domain_force">[('customer_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('car_rental_management_tanisha.group_car_rental_customer'))]"/>
    </record>

    <record id="manager_bookings" model="ir.rule">
        <field name="name">Manager: All Bookings</field>
        <field name="model_id" ref="car_rental_management_tanisha.model_rental_booking"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('car_rental_management_tanisha.group_car_rental_manager'))]"/>
    </record>

</odoo>