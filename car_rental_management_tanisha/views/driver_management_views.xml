<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="driver_management_list_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="status"/>
                <field name="per_day_rate"/>
            </list>
        </field>
    </record>

    <record id="driver_management_form_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="show_booking_history"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                string="Booking History"
                        >
                            <field name="booking_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group string="Driver Details">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="status" widget="radio" options="{'horizontal': True}" readonly="1"/>
                            <field name="currency_id" readonly="0"/>
                            <field name="per_day_rate"/>
                        </group>
                        <group string="Licence Details">
                            <field name="license_no"/>
                            <field name="license_issue_date"/>
                            <field name="birth_date"/>
                            <field name="is_handicap"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="driver_management_menu_action" model="ir.actions.act_window">
        <field name="name">Driver Management</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_driver': True}</field>
        <field name="domain">[('is_driver','=',True)]</field>
    </record>

    <record id="driver_management_list_action" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="driver_management_list_view"/>
        <field name="act_window_id" ref="driver_management_menu_action"/>
    </record>

    <record id="driver_management_form_action" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="driver_management_form_view"/>
        <field name="act_window_id" ref="driver_management_menu_action"/>
    </record>

    <menuitem name="Driver Management" id="driver_management_menu" parent="car_rental_root_menu" action="driver_management_menu_action"
              groups="car_rental_management_tanisha.group_car_rental_manager"/>

</odoo>