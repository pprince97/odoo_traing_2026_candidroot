<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="rental_maintenance_list_view" model="ir.ui.view">
        <field name="name">rental.maintenance.list</field>
        <field name="model">rental.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="current_km"/>
                <field name="arrival_date"/>
                <field name="dispatch_date"/>
                <field name="total_cost"/>
            </list>
        </field>
    </record>

    <record id="rental_maintenance_form_view" model="ir.ui.view">
        <field name="name">rental.maintenance.form</field>
        <field name="model">rental.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="generate_maintenance_bill"
                            string="Generate Bill"
                            type="object"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id" domain="[('type','=','vehicle')]"/>
                            <field name="current_km"/>
                            <field name="arrival_date"/>
                            <field name="dispatch_date"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="vehicle_parts" string="Parts">
                            <field name="part_line_ids">
                                <list editable="top">
                                    <field name="part_id" domain="[('type','=','parts')]"/>
                                    <field name="price" readonly="1"/>
                                    <field name="quantity"/>
                                    <field name="sub_cost"/>
                                </list>
                            </field>
                            <group>
                                <group class="oe_subtotal_footer" name="total_cost">
                                    <span class="o_td_label float-start">
                                        <label class="fw-bold" for="total_cost" string="Total Cost"/>
                                    </span>
                                    <strong>
                                        <field name="total_cost" nolabel="1"/>
                                    </strong>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rental_maintenance_menu_action" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">rental.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="rental_maintenance_menu" name="Maintenances" parent="car_rental_root_menu" action="rental_maintenance_menu_action"
              groups="car_rental_management_tanisha.group_car_rental_manager"/>

</odoo>