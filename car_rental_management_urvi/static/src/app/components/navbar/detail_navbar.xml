<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="owl_template.DetailNavbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-burger-menu-items')]" position="inside">
            <DropdownItem t-if="stateu.hasDetailGroup"
                          onSelected="() => this.openDetails_bar()" >
                Details
            </DropdownItem>
        </xpath>
    </t>
</templates>
