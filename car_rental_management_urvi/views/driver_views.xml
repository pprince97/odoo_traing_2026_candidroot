<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="driver_list_view" model="ir.ui.view">
        <field name="name">driver.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="status"/>
                <field name="per_day_rate"/>
                <field name="licence_no"/>
            </list>
        </field>
    </record>

    <record id="driver_form_view" model="ir.ui.view">
        <field name="name">driver.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" position="inside">
                        <button
                                type="object"
                                icon="fa-list"
                                name="booking_records"
                                class="btn-primary">
                            <field name="booking_count" string="Booking Records" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="licence_no"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="per_day_rate"/>
                            <field name="licence_prof" filename="file_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="driver_action" model="ir.actions.act_window">
        <field name="name">Driver</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('driver_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('driver_form_view')})]"/>
        <field name="context">{'default_is_driver':True}</field>
        <field name="domain">[('is_driver','=',True)]</field>
    </record>

    <menuitem id="car_rental_driver" name="Driver" parent="car_rental_root" action="driver_action" sequence="2"
              groups="car_rental_management_urvi.group_service_admin"/>
</odoo>











