<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="maintenance_list_view" model="ir.ui.view">
        <field name="name">maintenance.list</field>
        <field name="model">car.rental.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="current_km"/>
                <field name="arrival_date"/>
                <field name="dispatch_date"/>
                <field name="total_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="maintenance_form_view" model="ir.ui.view">
        <field name="name">maintenance.form</field>
        <field name="model">car.rental.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            string="In Process"
                            name="in_process_state"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ['pending']"
                    />
                    <button
                            string="Completed"
                            name="completed_state"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ['in_process']"
                    />
                    <button
                            string="Generate Bill"
                            name="generate_bill"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ['completed']"
                    />
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_process,completed,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="arrival_date"/>
                            <field name="dispatch_date"/>
                        </group>
                        <group>
                            <field name="total_cost"/>
                            <field name="current_km"/>

                        </group>
                    </group>
                    <notebook>
                        <page name="maintenance_lines" string="Vehicle Details">
                            <field name="maintenance_lines">
                                <list editable="bottom">
                                    <field name="part_id"
                                           domain="[('categ_id','=',%(car_rental_management_urvi.product_category_vehicle_parts)d)]"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">car.rental.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="car_rental_maintenance" name="Maintenance" parent="car_rental_root" action="maintenance_action"
              sequence="4" groups="car_rental_management_urvi.group_service_admin"/>
</odoo>











