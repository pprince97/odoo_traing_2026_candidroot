<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="vehicles_list_view" model="ir.ui.view">
        <field name="name">vehicles.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_code"/>
                <field name="name"/>
                <field name="vehicle_type"/>
                <field name="lst_price"/>
                <field name="status"/>
                <field name="service_per_km"/>
                <field name="per_day_km"/>
            </list>
        </field>
    </record>

    <record id="vehicles_form_view" model="ir.ui.view">
        <field name="name">vehicles.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" position="inside">
                        <button
                                type="object"
                                icon="fa-list"
                                name="maintenance_records"
                                class="btn-primary">
                            <field name="main_count" string="Maintenance Count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_code"/>
                            <field name="name"/>
                            <field name="vehicle_type"/>
                            <field name="lst_price"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="service_per_km"/>
                            <field name="per_day_km"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vehicles_action" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('vehicles_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('vehicles_form_view')})]"/>
        <field name="context">{'vehicles':True}</field>
        <field name="domain">[('type','=','vehicle')]</field>
    </record>


    <menuitem id="car_rental_root" name="Car Rental Management"/>
    <menuitem id="car_rental_vehicles" name="Vehicles" parent="car_rental_root" action="vehicles_action" sequence="1" groups="car_rental_management_urvi.group_service_admin"/>
</odoo>


