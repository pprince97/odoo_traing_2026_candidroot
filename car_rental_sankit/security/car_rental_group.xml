<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groups Category        -->
        <record model="ir.module.category" id="car_rental_groups_catgory">
            <field name="name">Car Rental Management</field>
            <field name="sequence">35</field>
        </record>

        <!-- Group Privilage        -->
        <record model="res.groups.privilege" id="res_groups_privilege_car_rental">
            <field name="name">Car Rental</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="car_rental_sankit.car_rental_groups_catgory"/>
        </record>

        <!-- Groups -->
        <record id="group_rental_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_car_rental"/>
        </record>
        <record id="group_rental_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_car_rental"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>



        <record id="group_rental_user_booking" model="ir.rule">
            <field name="name">Car Rental User Booking</field>
            <field name="model_id" ref="car_rental_sankit.model_car_booking"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_rental_user'))]"/>
        </record>
        <record id="group_rental_manager_booking" model="ir.rule">
            <field name="name">Car Rental Manager Booking</field>
            <field name="model_id" ref="car_rental_sankit.model_car_booking"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_rental_manager'))]"/>
        </record>

    </data>
</odoo>