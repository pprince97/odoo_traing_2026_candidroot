<odoo>
    <record id="car_rental_sequence" model="ir.sequence">
        <field name="name">Car Rental Number</field>
        <field name="code">rental.sequence</field>
        <field name="prefix">CR/%(year)s/</field>
        <field name="padding">3</field>
    </record>

    <record id="car_list_view" model="ir.ui.view">
        <field name="name">Car List</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_code" readonly="1"/>
                <field name="name"/>
                <field name="vehicle_type"/>
                <field name="cost_per_km"/>
                <field name="status"/>
                <field name="service_per_km"/>
                <field name="min_km_per_day"/>
            </list>
        </field>
    </record>
    <record id="car_form_view" model="ir.ui.view">
        <field name="name">Car Form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                     <field name="status" widget="statusbar" statusbar_visible="available,booked,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                icon="fa-taxi"
                                type="object"
                                name="maintenance_history">
                            <field name="maintenance_ids" string="Maintenance" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <field name="vehicle_code" readonly="1"/>
                        <field name="name"/>
                        <field name="vehicle_type"/>
                        <field name="cost_per_km"/>
                        <field name="status"/>
                        <field name="service_per_km"/>
                        <field name="min_km_per_day"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_window_action_menu" model="ir.actions.act_window">
        <field name="name">Cars</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_what': 'car'}</field>
        <field name="domain">[('is_what', '=', 'car')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('car_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('car_form_view')})]"/>
    </record>

    <menuitem id="car_menu_root" name="Car Rental Management"/>

    <menuitem id="car_menu"
              name="Car"
              action="car_window_action_menu"
              parent="car_menu_root"
              groups="car_rental_sankit.group_rental_user"
    />
</odoo>