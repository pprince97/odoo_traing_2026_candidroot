<odoo>

    <record id="driver_list_view" model="ir.ui.view">
        <field name="name">Driver List</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="pan_number"/>
                <field name="license_number"/>
                <field name="address"/>
                <field name="status"/>
                <field name="per_day_rate"/>
            </list>
        </field>
    </record>
    <record id="driver_form_view" model="ir.ui.view">
        <field name="name">Driver Form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                     <field name="status" widget="statusbar" statusbar_visible="available,booked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                icon="fa-taxi"
                                type="object"
                                name="booking_record_history">
                            <field name="booking_record_ids" string="Booking Record" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="pan_number"/>
                        <field name="license_number"/>
                        <field name="address"/>
                        <field name="status"/>
                        <field name="per_day_rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="driver_window_action_menu" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_what': 'driver'}</field>
        <field name="domain">[('is_what', '=', 'driver')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('driver_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('driver_form_view')})]"/>
    </record>

    <menuitem id="driver_menu"
              name="Driver"
              action="driver_window_action_menu"
              parent="car_menu_root"
              groups="car_rental_sankit.group_rental_user"
    />
</odoo>