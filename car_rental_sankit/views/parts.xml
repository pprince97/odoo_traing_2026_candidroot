<odoo>
    <record id="parts_list_view" model="ir.ui.view">
        <field name="name">Part List</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="standard_price"/>
            </list>
        </field>
    </record>
    <record id="parts_form_view" model="ir.ui.view">
        <field name="name">Part Form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="standard_price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="parts_window_action_menu" model="ir.actions.act_window">
        <field name="name">Cars</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_what': 'part'}</field>
        <field name="domain">[('is_what', '=', 'part')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('parts_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('parts_form_view')})]"/>
    </record>

    <menuitem id="parts_menu"
              name="Parts"
              action="parts_window_action_menu"
              parent="car_menu_root"
    />
</odoo>