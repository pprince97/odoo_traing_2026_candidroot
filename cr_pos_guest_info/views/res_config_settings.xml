<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_pos_guest" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_restaurant_guest</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iface_splitbill']" position="after">
                <setting help="Guest Details" id="pos_guest_details">
                    <field name="guest_details"/>
                    <div class="content-group" invisible="not guest_details">
                        <div class="row mt16">
                            <label for="guest_details_timing" class="col-lg-6"/>
                            <field name="guest_details_timing" class="col-lg-6"/>
                        </div>
                        <div class="row mt16">
                            <label for="guest_details_required" class="col-lg-6"/>
                            <field name="guest_details_required" class="col-lg-6"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>