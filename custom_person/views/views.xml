<odoo>
    <data>
        <record model="ir.ui.view" id="custom_tree">
            <field name="name">custom_person.list</field>
            <field name="model">custom.person</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="birthdate"/>
                    <field name="gender"/>
                    <field name="handicap"/>
                    <field name="percentage"/>
                    <field name="address"/>
                    <field name="photo"/>
                    <field name="signature" />
                    <field name="current_date"/>
                </list>
            </field>
        </record>

        <record id="custom_form" model="ir.ui.view">
            <field name="name">custom_person.form</field>
            <field name="model">custom.person</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="age"/>
                                <field name="birthdate" />
                                <field name="percentage"/>
                                <field name="photo" widget="image"/>
                            </group>
                            <group>
                                 <field name="gender"/>
                                 <field name="handicap"/>
                                 <field name="address"/>
                                 <field name="current_date" />
                                <field name="signature" widget="image"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="customperson_action">
            <field name="name">Person</field>
            <field name="res_model">custom.person</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem name="Person" id="custom_menu" action="custom_person.customperson_action"/>
    </data>
</odoo>