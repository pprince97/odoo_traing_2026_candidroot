<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="subscribe_page_template" name="Subscribe Us">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Subscribe</h1>
                    </div>
                </section>
<!--                <img src="/home/erp/workspace/projects/project_19/custom_website/static/image/download.jpeg" width="100px" height="100px" alt="Image"/>-->
            </div>
        </t>
    </template>

    <data noupdate="1">

        <record id="subscribe_page" model="website.page">
            <field name="is_published">True</field>
            <field name="url">/subscribe</field>
            <field name="view_id" ref="subscribe_page_template"/>
            <field name="website_meta_description">This is the Subscribe page of the website</field>
        </record>

        <record id="test_menu1" model="website.menu">
            <field name="name">Subscribe</field>
            <field name="url">/subscribe</field>
            <field name="page_id" ref="subscribe_page"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">70</field>
        </record>

    </data>
</odoo>
