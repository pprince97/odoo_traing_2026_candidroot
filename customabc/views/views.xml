<odoo>
    <data>
        <record model="ir.ui.view" id="custom_tree1">
            <field name="name">customabc.list</field>
            <field name="model">custom.abc</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="percentage"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="custom_tree2">
            <field name="name">customabc.list</field>
            <field name="model">custom.form</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <field name="password" password="True"/>
                    <field name="review"/>
                </list>
            </field>
        </record>

        <record id="custom_form1" model="ir.ui.view">
            <field name="name">customabc.form</field>
            <field name="model">custom.abc</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="age"/>
                            </group>
                            <group>
                                <field name="percentage"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="custom_form2" model="ir.ui.view">
            <field name="name">customabc.form</field>
            <field name="model">custom.form</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="age"/>
                                <field name="gender" />
                            </group>
                            <group>
                                 <field name="password" password="True"/>
                                 <field name="review"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


         <record model="ir.actions.act_window" id="customabc_action1">
            <field name="name">ABC</field>
            <field name="res_model">custom.abc</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.actions.act_window" id="customabc_action2">
            <field name="name">FORM</field>
            <field name="res_model">custom.form</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="abc" id="custom_menu_root"/>
        <menuitem name="Child1" id="menu_child1" parent="customabc.custom_menu_root"
                  action="customabc.customabc_action1"/>
        <menuitem name="Child2" id="menu_child2" parent="customabc.custom_menu_root" action="customabc.customabc_action2"/>
    </data>
</odoo>