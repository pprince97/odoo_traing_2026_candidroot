<odoo>
    <data>
        <record model="ir.ui.view" id="custom_tree">
            <field name="name">customcar.list</field>
            <field name="model">custom.car</field>
            <field name="arch" type="xml">
                <list>
                    <field name="model"/>
                    <field name="make"/>
                    <field name="color"/>
                    <field name="accident"/>
                    <field name="price"/>
                </list>
            </field>
        </record>

        <record id="custom_form" model="ir.ui.view">
            <field name="name">customcar.form</field>
            <field name="model">custom.car</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="model"/>
                                <field name="make"/>
                                <field name="color" />
                            </group>
                            <group>
                                 <field name="accident"/>
                                 <field name="price"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


         <record model="ir.actions.act_window" id="customcar_action">
            <field name="name">Car</field>
            <field name="res_model">custom.car</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem name="Car" id="custom_menu" action="customcar.customcar_action"/>
    </data>
</odoo>