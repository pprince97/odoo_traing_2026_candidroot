<odoo>
    <data>
        <record id="demo_tree" model="ir.ui.view">
            <field name="name">demo_addons.list</field>
            <field name="model">demo.object</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="phone"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <record id="demo_form" model="ir.ui.view">
            <field name="name">demo_addons.form</field>
            <field name="model">demo.object</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="age"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="email"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="demo_addons_action">
            <field name="name">demo.addons.window</field>
            <field name="res_model">demo.object</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Demo" id="demo_menu_root"/>

        <menuitem name="ChildDemo" id="menu_child" parent="demo_addons.demo_menu_root"
                    action="demo_addons.demo_addons_action"/>

    </data>
</odoo>