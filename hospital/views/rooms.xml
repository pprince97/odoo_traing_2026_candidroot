<odoo>
    <data>
        <record id="room_list" model="ir.ui.view">
            <field name="name">Rooms</field>
            <field name="model">rooms.obj</field>
            <field name="arch" type="xml">
            <list>
                <field name="number" width="25px"/>
                <field name="type" width="30px"/>
                <field name="no_beds" width="30px"/>
                <field name="is_available" width="30px"/>
                <field name="cost_room" width="30px"/>
                <field name="p_id" width="30px"/>
            </list>
            </field>
        </record>


        <record id="room_tree" model="ir.ui.view">
            <field name="name">Rooms</field>
            <field name="model">rooms.obj</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="number" width="25px"/>
                                <field name="type" width="30px"/>
                                <field name="no_beds" width="30px"/>
                            </group>
                            <group>
                                <field name="is_available" width="30px"/>
                                <field name="cost_room" width="30px"/>
                            </group>
                        </group>
                    </sheet>
                    <notebook>
                        <page name="patient" string="Patients">
                            <field name="p_id">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="room_search" model="ir.ui.view">
            <field name="name">Rooms</field>
            <field name="model">rooms.obj</field>
            <field name="arch" type="xml">
                <search string="Search rooms">
                    <field name="number"/>
                    <field name="type"/>
                    <field name="no_beds" width="30px"/>
                    <field name="is_available" width="30px"/>
                    <field name="cost_room" width="30px"/>
                </search>
            </field>
        </record>

        <record id="room_kanban" model="ir.ui.view">
            <field name="name">Rooms</field>
            <field name="model">rooms.obj</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="number"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="cost_room"/>
                                </div>
                            </div>
                            <div>
                               <field name="type"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="room_pivot" model="ir.ui.view">
            <field name="name">Rooms</field>
            <field name="model">rooms.obj</field>
            <field name="arch" type="xml">
                <pivot string="Rooms">
                    <field name="type" type="col"/>
                    <field name="cost_room" type="row"/>
                </pivot>
            </field>
        </record>

         <record id="room_calendar" model="ir.ui.view">
             <field name="name">Rooms</field>
             <field name="model">rooms.obj</field>
             <field name="arch" type="xml">
                 <calendar string="Rooms" date_start="room_d">
                     <field name="number"/>
                 </calendar>
             </field>
        </record>

        <record id="room_graph" model="ir.ui.view">
             <field name="name">Rooms</field>
             <field name="model">rooms.obj</field>
             <field name="arch" type="xml">
                 <graph string="Rooms" type="line" sample="1">
                     <field name="type"/>
                     <field name="no_beds"/>
                 </graph>
             </field>
        </record>

        <record id="room_action"  model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">rooms.obj</field>
            <field name="view_mode">list,form,search,kanban,pivot,calendar,graph</field>
        </record>

        <menuitem id="room_id" name="Rooms" parent="hospital_parent_id" action="room_action"/>
    </data>
</odoo>