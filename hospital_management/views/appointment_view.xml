<odoo>
    <data>

        <record id="appointment_list" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
            <list>
                <field name="hospital_id" width="25px"/>
                <field name="patient_id" width="25px"/>
                <field name="department_id" width="30px"/>
                <field name="doctor_id" width="30px"/>
                <field name="appointment_date" width="25px"/>
                <field name="patient_address" width="25px"/>
                <field name="patient_dob" width="25px"/>
                <field name="patient_age" width="25px"/>
                <field name="patient_mobile" width="25px"/>
                <field name="patient_email" width="25px"/>
                <field name="status" width="25px"/>
            </list>
            </field>
        </record>


        <record id="appointment_form" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
                <form string="Form View">

                    <header>
                        <button name="in_progress_status"
                                string="Appointment In Progress"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['in_progress','cancelled','done']"/>
                        <button name="done_status"
                                string="Done"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['done','cancel']"/>
                        <button name="cancel_status"
                                string="Cancel"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['cancelled','done']"
                                groups="hospital_management.hospital_group_receptionist"/>
                        <field name="status" widget="statusbar" statusbar_visible="new,in_progress,done,cancelled"/>
                    </header>

                    <sheet>

                        <div name="button_box" position="inside">
                            <button name="appointment_a_btn" type="object" class="oe_stat_button" icon="fa-id-card-o">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Appointments</span>
                                </div>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="hospital_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="patient_id" context="{'form_view_ref':'hospital_management.patient_form'}"/>
                                <field name="department_id"/>
                                <field name="doctor_id" context="{'form_view_ref':'hospital_management.doctor_form'}" invisible="hospital_id or department_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="doctor_id" context="{'form_view_ref':'hospital_management.doctor_form'}" domain="[('hospital_id','=',hospital_id)]" invisible="department_id or not hospital_id and not department_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="doctor_id" context="{'form_view_ref':'hospital_management.doctor_form'}" domain="[('department_id','=',department_id)]" invisible="hospital_id or not hospital_id and not department_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="doctor_id" context="{'form_view_ref':'hospital_management.doctor_form'}" domain="[('department_id','=',department_id),('hospital_id','=',hospital_id)]" invisible="(not hospital_id and not department_id) or (hospital_id and not department_id) or (department_id and not hospital_id)" options="{'no_open': True, 'no_create': True}"/>
                                <field name="appointment_date" />
                            </group>
                            <group>
                                <field name="patient_address" />
                                <field name="patient_dob"/>
                                <field name="patient_age"/>
                                <field name="patient_mobile" widget="phone"/>
                                <field name="patient_email" widget="email"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="appointment_search" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
                <search string="Search appointment">
                    <filter name="filter_appointment" string="Today's Appointment" domain="[('appointment_date', '=', 'today')]"/>
                </search>
            </field>
        </record>

        <record id="appointment_action" model="ir.actions.act_window">
            <field name="name">Appointment</field>
            <field name="res_model">appointment.model</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="appointment_search"/>
            <field name="context">{'search_default_filter_appointment':1}</field>
        </record>

        <menuitem name="Appointment" id="appointment_id" parent="hospital_management.hospital_management_id" action="appointment_action"/>
    </data>
</odoo>