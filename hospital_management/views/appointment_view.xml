<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="appointment_list_view" model="ir.ui.view">
        <field name="name">appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="status"/>
                <field name="token_no"/>
                <field name="fees"/>
                <field name="paid"/>
                <field name="description"/>
                <field name="prescription"/>
                <field name="attachment"/>
                <field name="followup_date"/>
                <field name="duration_minutes"/>
                <field name="is_emergency"/>
                <field name="currency_id_m"/>
                <field name="ap_fees" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="appointment_form_view" model="ir.ui.view">
        <field name="name">appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            string="Confirm"
                            name="confirm_status"
                            type="object"
                            class="oe_highlight"
                            invisible="status in ['confirm','done','cancel']"
                    />
                    <button
                            string="Done"
                            name="done_status"
                            type="object"
                            class="oe_highlight"
                            invisible="status in ['done', 'draft', 'cancel']"
                    />
                    <button
                            string="Cancel"
                            name="cancel_status"
                            type="object"
                            class="oe_highlight"
                            invisible="status in ['done', 'cancel']"
                    />
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirm,done,cancel"/>
                    <button
                            name="%(action_open_website_url)d"
                            string="Action URL"
                            type="action"
                            confirm="Are you sure to execute the automatic merge of your contacts ?"
                            class="oe_highlight"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="appointment_date"/>
                            <field name="status"/>
                            <field name="token_no"/>
                            <field name="fees"/>
                            <field name="paid"/>
                        </group>
                        <group>
                            <field name="followup_date"/>
                            <field name="duration_minutes"/>
                            <field name="is_emergency"/>
                            <field name="patient_id" context="{'test': True}"/>
                            <field name="doctor_id"/>
                            <field name="currency_id_m"/>
                            <field name="ap_fees" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="attachment" string="Attachment">
                            <group>
                                <field name="attachment"/>
                            </group>
                        </page>
                        <page name="descriptive" string="Descriptive">
                            <group>
                                <field name="description"/>
                                <field name="prescription"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="appointment_search_view" model="ir.ui.view">
        <field name="name">appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Appointment Search">
                <field name="name"/>
                <field name="followup_date"/>
                <field name="duration_minutes"/>
                <filter string="Emergency" name="is_emergency" domain="[('is_emergency', '==', 'True')]"/>
                <filter string="Status Draft" name="status" domain="[('status', '==', 'draft')]"/>
                <filter string="Status confirm" name="status" domain="[('status','==','confirm')]"/>
                <filter string="Status done" name="status" domain="[('status','==','done')]"/>
                <filter string="status Cancel" name="status" domain="[('status','==','cancel')]"/>
            </search>
        </field>
    </record>

    <record id="appointment_kanban_view" model="ir.ui.view">
        <field name="name">appointment.kanban</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <div>
                            <div>
                                <field class="fw-bold fs-5" name="name"/>
                                <br/>
                                <field name="status" class="ms-2 text-muted"/>
                            </div>
                            <small>Appointment Date:
                                <field name="appointment_date"/>
                            </small>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="appointment_pivot_view" model="ir.ui.view">
        <field name="name">appointment.pivot</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <pivot string="appointment Records">
                <field name="name" type="row"/>
                <field name="fees"/>
            </pivot>
        </field>
    </record>

    <record id="appointment_graph_view" model="ir.ui.view">
        <field name="name">appointment.graph</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <graph string="Fees Records" type="bar" sample="1">
                <field name="name" type="row"/>
                <field name="fees"/>
            </graph>
        </field>
    </record>

    <record id="appointment_calendar_views" model="ir.ui.view">
        <field name="name">appointment.calendar</field>
        <field name="model">hospital.appointment</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <calendar string="Appointment Calendar" date_start="appointment_date">
                <field name="name"/>
                <field name="followup_date"/>
            </calendar>
        </field>
    </record>

    <record id="appointment_action_from_patient" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">form</field>
    </record>

    <record model="ir.actions.server" id="action_server_check">
        <field name="name">Server Action Check</field>
        <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
        <!--        <field name="binding_model_id" ref="hospital_management.model_hospital_appointment"/>-->
        <!--        <field name="binding_view_types">form,list</field>-->
        <field name="state">code</field>
        <field name="code">
            action = records.server_action_method()
        </field>
    </record>


    <record model="ir.actions.server" id="action_server_check1">
        <field name="name">Server Action Check1</field>
        <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
        <field name="state">code</field>
        <field name="code">
            action = records.server_action_method1()
        </field>
    </record>

    <record id="action_open_website_url" model="ir.actions.act_url">
        <field name="name">Website Url</field>
        <field name="target">new</field>
        <field name="url" eval="'https://www.google.com/'"/>
    </record>


    <record id="appointment_action" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form,search,kanban,pivot,graph,calendar</field>
    </record>

    <menuitem name="Appointment" id="hospital_appointment" parent="hospital_root" action="appointment_action"/>
</odoo>















