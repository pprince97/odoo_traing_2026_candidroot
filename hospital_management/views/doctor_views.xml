<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="doctor_list_view" model="ir.ui.view">
        <field name="name">hospital_management.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="50px"/>
                <field name="department" width="50px"/>
                <field name="available" width="50px"/>
                <field name="room_no" width="50px"/>
                <field name="max_patients" width="50px"/>
                <field name="doctor_img" width="50px"/>
                <field name="bio" width="50px"/>
                <field name="appointment_ids" width="50px"/>
            </list>
        </field>
    </record>

    <record id="doctor_form_view" model="ir.ui.view">
        <field name="name">hospital_management.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor Form View">
                <header>
                    <button name="toggle_availability"
                            string="Toggle Availability"
                            type="object"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department"/>
                            <field name="available"/>
                        </group>
                        <group>
                            <field name="room_no"/>
                            <field name="max_patients"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="image" string="Image">
                            <field name="doctor_img" widget="image"/>
                        </page>
                        <page name="bio" string="Bio">
                            <field name="bio"/>
                        </page>
                        <page name="appointments" string="Appointments">
                            <field name="appointment_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="doctor_search_view" model="ir.ui.view">
        <field name="name">hospital_management.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="department" domain="[('department', 'in', ['surgery','icu'])]"/>
                <filter name="available" domain="[('available', '=', True)]"/>
                <filter name="max_patients" domain="[('max_patients', '&lt;', 20)]"/>
            </search>
        </field>
    </record>

    <record id="doctor_kanban_view" model="ir.ui.view">
        <field name="name">hospital_management.kanban</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <div>
                            <div>
                                <field class="fw-bold fs-5" name="name"/>
                                <br/>
                                <field name="department" class="ms-2 text-muted"/>
                                <br/>
                                <field name="available" class="ms-2 text-muted"/>
                            </div>
                            <small>Max Patients:
                                <field name="max_patients"/>
                            </small>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="doctor_pivot_view" model="ir.ui.view">
        <field name="name">hospital_management.pivot</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <pivot string="Doctor Analysis " sample="1">
                <field name="department" type="col"/>
                <field name="available" type="row"/>
                <field name="max_patients" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="doctor_graph_view" model="ir.ui.view">
        <field name="name">hospital_management.graph</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <graph string="Doctor Analysis" type="line" sample="1">
                <field name="department"/>
                <field name="max_patients" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="doctor_calendar_view" model="ir.ui.view">
        <field name="name">hospital_management.calendar</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <calendar string="Doctor Actions" date_start="current_date" color="available">
                <field name="name"/>
            </calendar>
        </field>
    </record>

    <record id="doctor_menu_action" model="ir.actions.act_window">
        <field name="name">Doctor Menu</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form,search,kanban,pivot,graph,calendar</field>
    </record>
    <menuitem id="doctor_menu" name="Doctor" parent="hospital_base_menu" action="doctor_menu_action"/>
</odoo>