<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="patient_list_view" model="ir.ui.view">
        <field name="name">patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_active"/>
                <field name="partner_id"/>
                <field name="age"/>
                <field name="dob"/>
                <field name="gender"/>
                <field name="address" force_save="1"/>
                <field name="symptoms"/>
                <field name="priority"/>
                <field name="doctor_employee_id"/>
                <field name="report_file" filename="report_name" widget="binary"/>
                <field name="report_name"/>
                <field name="reference_field"/>
            </list>
        </field>
    </record>

    <record id="patient_form_view" model="ir.ui.view">
        <field name="name">patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            string="Admit Patient"
                            name="admit_patient"
                            type="object"
                            class="oe_highlight ms-2 me-2"
                    />
                    <button
                            string="Book Appointment"
                            name="%(hospital_management.appointment_action_from_patient)d"
                            type="action"
                            class="oe_highlight"
                    />
                    <button
                            string="Discharge Patient"
                            name="discharge_patient"
                            type="object"
                            class="oe_highlight"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="is_active"/>
                            <field name="age"/>
                            <field name="dob"/>
                            <field name="gender"/>
                            <field name="address" force_save="1"/>
                        </group>
                        <group>
                            <field name="symptoms"/>
                            <field name="priority"/>
                            <field name="reference_field"/>
                            <field name="doctor_employee_id"/>
                            <field name="consultation_fee"/>
                            <field name="partner_id" required="0" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="uploads" string="Reports">
                            <field name="report_file" filename="report_name" widget="binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="patient_search_view" model="ir.ui.view">
        <field name="name">patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patient Search">
                <field name="name"/>
                <field name="symptoms"/>
                <filter string="Male Patient" name="gender" domain="[('gender', '==', 'male')]"/>
                <filter string="Female Patient" name="gender" domain="[('gender', '==', 'female')]"/>
                <filter string="Active Patient" name="is_active" domain="[('is_active','==','True')]"/>
                <filter string="In Active Patient" name="is_active" domain="[('is_active','==','False')]"/>
            </search>
        </field>
    </record>

    <record id="patient_kanban_view" model="ir.ui.view">
        <field name="name">patient.kanban</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <div>
                            <div>
                                <field class="fw-bold fs-5" name="name"/>
                                <br/>
                                <field name="dob" class="ms-2 text-muted"/>
                                <br/>
                                <field name="age" class="ms-2 text-muted"/>
                            </div>
                            <small>Gender:
                                <field name="gender"/>
                            </small>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="patient_pivot_view" model="ir.ui.view">
        <field name="name">patient.pivot</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <pivot string="patient Records">
                <field name="name" type="row"/>
                <field name="age"/>
            </pivot>
        </field>
    </record>

    <record id="patient_graph_view" model="ir.ui.view">
        <field name="name">patient.graph</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <graph string="Employee Records" type="bar" sample="1">
                <field name="age" type="row"/>
                <field name="is_active"/>
            </graph>
        </field>
    </record>

    <record id="patient_calendar_views" model="ir.ui.view">
        <field name="name">patient.calendar</field>
        <field name="model">hospital.patient</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <calendar string="Patient Calendar" date_start="dob">
                <field name="name"/>
            </calendar>
        </field>
    </record>

    <record id="patient_action" model="ir.actions.act_window">
        <field name="name">Patient</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form,search,kanban,pivot,graph,calendar</field>
    </record>

    <menuitem name="Hospital Management" id="hospital_root"/>
    <menuitem name="Patient" id="hospital_patient" parent="hospital_root" action="patient_action"/>
</odoo>















