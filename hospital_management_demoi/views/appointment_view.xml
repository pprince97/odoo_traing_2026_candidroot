<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="appointment_list">
        <field name="name">appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id" width="100px"/>
                <field name="appointment_datetime" width="100px"/>
                <field name="appointment_status" width="100px"/>
                <field name="doctor_id" width="100px"/>
                <field name="department_id" width="100px"/>
            </list>
        </field>
    </record>

    <record id="appointment_form" model="ir.ui.view">
        <field name="name">appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" width="100px"/>
                            <field name="appointment_datetime" width="100px"/>
                            <field name="appointment_status" width="100px"/>
                        </group>
                        <group>
                            <field name="doctor_id" width="100px"/>
                            <field name="department_id" width="100px"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="hospital" string="Hospital">
                            <field name="hospital_ids">
                                <list>
                                    <field name="hospital_name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="appointment_search" model="ir.ui.view">
        <field name="name">appointment.select</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="appointment Search">
                <field name="appointment_datetime"/>
                <field name="doctor_id"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="appointment_action">
        <field name="name">appointment</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <menuitem name="Appointment" id="appointment" parent="hospital_root" action="appointment_action"/>
</odoo>