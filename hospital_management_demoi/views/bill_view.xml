<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bill_inherit_view_list" model="ir.ui.view">
        <field name="name">bill.inherit.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="replace">-->
<!--                <field name="doctor_id"/>-->
<!--            </xpath>-->
        </field>
    </record>

</odoo>