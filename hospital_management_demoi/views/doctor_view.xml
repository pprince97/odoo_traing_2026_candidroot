<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="doctor_list">
        <field name="name">doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="doctor_name" width="100px"/>
                <field name="doctor_phone" width="100px"/>
                <field name="doctor_dob" width="100px"/>
                <field name="doctor_gender" width="100px"/>
                <field name="joining_date" width="100px"/>
                <field name="doctor_timing" width="100px"/>
                <field name="salary" width="100px"/>
                <field name="doctor_id_proof" width="100px"/>
                <field name="doctor_image" width="100px" widget="image"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <record id="doctor_form" model="ir.ui.view">
        <field name="name">doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="doctor_name" width="100px"/>
                            <field name="doctor_phone" width="100px"/>
                            <field name="doctor_dob" width="100px"/>
                            <field name="doctor_gender" width="100px"/>
                        </group>
                        <group>
                            <field name="joining_date" width="100px"/>
                            <field name="doctor_timing" width="100px"/>
                            <field name="salary" width="100px"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Uploads">
                            <group>
                                <field name="doctor_id_proof"/>
                                <field name="doctor_image" widget="image"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="doctor_search" model="ir.ui.view">
        <field name="name">doctor.select</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Doctor Search">
                <field name="doctor_name"/>
                <field name="doctor_timing"/>
                <filter string="Male Doctor" name="doctor_gender" domain="[('doctor_gender', '==', 'male')]"/>
                <filter string="Female Doctor" name="doctor_gender" domain="[('doctor_gender', '==', 'female')]"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="doctor_action">
        <field name="name">Doctor</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <menuitem name="Doctors" id="doctors" parent="hospital_root" action="doctor_action"/>
</odoo>