<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="patient_list">
        <field name="name">patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_name" width="100px"/>
                <field name="patient_address" width="100px"/>
                <field name="patient_phone" width="100px"/>
                <field name="patient_age" width="100px"/>
                <field name="patient_dob" width="100px"/>
                <field name="patient_height" width="100px"/>
                <field name="patient_weight" width="100px"/>
                <field name="disease_description" width="100px"/>
                <field name="health_insurance" width="100px"/>
                <field name="patient_gender" width="100px"/>
                <field name="patient_blood" width="100px"/>
                <field name="patient_reports" width="100px"/>
            </list>
        </field>
    </record>

    <record id="patient_form" model="ir.ui.view">
        <field name="name">patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_name" width="100px"/>
                            <field name="patient_address" width="100px"/>
                            <field name="patient_phone" width="100px"/>
                            <field name="patient_age" width="100px"/>
                            <field name="patient_dob" width="100px"/>
                            <field name="patient_height" width="100px"/>
                            <field name="patient_blood" width="100px"/>
                        </group>
                        <group>
                            <field name="patient_height" width="100px"/>
                            <field name="patient_weight" width="100px"/>
                            <field name="disease_description" width="100px"/>
                            <field name="health_insurance" width="100px"/>
                            <field name="patient_gender" width="100px"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="Uploads">
                            <group>
                                <field name="patient_reports" width="100px"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="patient_search" model="ir.ui.view">
        <field name="name">patient.select</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patient Search">
                <field name="patient_name"/>
                <field name="disease_description"/>
                <field name="patient_blood" width="100px"/>
                <filter string="Male patient" name="patient_gender" domain="[('patient_gender', '==', 'male')]"/>
                <filter string="Female patient" name="patient_gender" domain="[('patient_gender', '==', 'female')]"/>
                <filter string="child patient" name="patient_age" domain="[('patient_age','&lt;', '18')]"/>
                <filter string="adult patient" name="patient_age"
                        domain="[('patient_age','&gt;', '20'),('patient_age','&lt;','60')]"/>
                <filter string="senior citizen Doctor" name="patient_age"
                        domain="[('patient_age','&gt;', '60')]"/>
            </search>
        </field>
    </record>


    <record model="ir.actions.act_window" id="patient_action">
        <field name="name">Patient</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <menuitem name="Patient" id="patients" parent="hospital_root" action="patient_action"/>
</odoo>