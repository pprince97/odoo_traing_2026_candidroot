<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_patient_document">
        <t t-call="web.external_layout">
<!--            <t t-esc="docs"/>-->
<!--            <t t-esc="docs_ids"/>-->
<!--            <t t-esc="doc_model"/>-->
<!--            <t t-foreach="docs" t-as="rec">-->
<!--                <h6>-->
<!--                    <span t-field="rec.name"/>-->
<!--                </h6>-->
<!--                </t>-->

            <div class="row">
                <div class="col-6">
                    <strong>Patient Name:</strong>
                    <span t-field="doc.name"/>
                    <br/>
                    <strong>Patient Code:</strong>
                    <span t-field="doc.patient_code"/>
                </div>
                <div class="col-6">
                    <strong>Patient Mobile:</strong><span t-field="doc.phone"/>
                    <br/>
                    <strong>Patient Email:</strong><span t-field="doc.email"/>
                </div>
            </div>
            <br/>s
            <h3> Prescription</h3>
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th>Quantity</th>
                        <th>Frequency</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.prescription_ids" t-as="line">
                        <tr>
                            <td>
                                <span t-field="line.medicine"/>
                            </td>
                            <td>
                                <span t-field="line.quantity"/>
                            </td>
                            <td>
                                <span t-field="line.frequency"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>

    <template id="report_patient">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hospital_management_rushvi.report_patient_document" t-lang="doc.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_patient" model="ir.actions.report">
        <field name="name">Patient Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management_rushvi.report_patient</field>
        <field name="report_file">hospital_management_rushvi.report_patient</field>
        <field name="print_report_name">'patient'</field>
        <field name="binding_model_id" ref="hospital_management_rushvi.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>
</odoo>