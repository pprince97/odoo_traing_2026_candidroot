         <record model="res.groups.privilege" id="res_groups_privilege_hospital">
            <field name="name">Hospital</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="hospital_management_rushvi.module_category_hospital_management"/>
        </record>

        <!--  Groups  -->
        <record id="group_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        </record>

        <record id="group_hospital_doctor" model="res.groups" context="{'doctor':True}">
            <field name="name">Doctor</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('hospital_management_rushvi.group_hospital_patient'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        </record>

        <record id="group_hospital_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('hospital_management_rushvi.group_hospital_doctor'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        </record>

        <record id="group_hospital_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('hospital_management_rushvi.group_hospital_manager'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_hospital"/>
        </record>

