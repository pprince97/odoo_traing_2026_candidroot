<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_hospital_management_departments_list" model="ir.ui.view">
        <field name="name">hospital.management.departments.list</field>
        <field name="model">hospital.management.departments</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dept_code"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_management_departments_form" model="ir.ui.view">
        <field name="name">hospital.management.departments.form</field>
        <field name="model">hospital.management.departments</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="dept_code"/>
                    </group>
                    <notebook>
                        <page name="hospital_ids" string="Hospitals">
                            <field name="hospital_ids"/>
                        </page>
                        <page name="doctor_ids" string="DOCTORS">
                            <field name="doctor_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

     <record id="action_hospital_management_departments" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hospital.management.departments</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem name="Departments" id="hospital_management_departments_menuitem"
              parent="hospital_menu_root"
              action="action_hospital_management_departments"/>
</odoo>