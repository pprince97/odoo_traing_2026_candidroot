<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_hospital_management_doctors_list" model="ir.ui.view">
        <field name="name">hospital.management.doctors.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="doctor_code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="experience"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_management_doctors_form" model="ir.ui.view">
        <field name="name">hospital.management.doctors.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                            name="doc_view_appointments"
                                string="Appointments"
                                icon="fa-star"
                                context="{'doc_app':True}">
                            <field name="doc_appointment_count" string="Appointments" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="doctor_code"/>
                            <field name="name"/>
                            <field name="experience"/>
                            <span class="o_form_label o_td_label o_address_type" name="address_name">
                                <span>Address</span>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="speciality" string="Speciality">
                            <field name="speciality"/>
                        </page>
                        <page name="hospital_ids" string="Hospitals">
                            <field name="hospital_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_hospital_management_doctors" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.partner</field>
        <field name="context">{'doctor':True}</field>
<!--        <field name="view_mode">list,form</field>-->
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_hospital_management_doctors_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_management_doctors_form')})]"/>
        <field name="domain">[('doctor_code','ilike','D%')]</field>
    </record>

    <menuitem name="Hospital Management" id="hospital_menu_root"/>
    <menuitem name="Doctors" id="hospital_management_doctors_menuitem"
              parent="hospital_menu_root"
              action="action_hospital_management_doctors"/>
</odoo>