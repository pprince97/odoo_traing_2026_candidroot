<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_hospital_management_patients_list" model="ir.ui.view">
        <field name="name">hospital.management.patients.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_code"/>
                <field name="name"/>
                <field name="date_of_birth"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_management_patients_form" model="ir.ui.view">
        <field name="name">hospital.management.patients.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button class="oe_highlight"
                            type="object"
                            name="appointment_create"
                            string="Create Appointment"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                            name="pat_view_appointments"
                                string="Appointments"
                                icon="fa-star">
                            <field name="appointment_count" string="Appointments" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="patient_code"/>
                            <field name="name"/>
                            <span class="o_form_label o_td_label o_address_type" name="address_name">
                                <span>Address</span>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="hospital_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="prescriptions" string="Prescriptions">
                            <field name="prescription_ids">
                                <list editable="bottom">
                                    <field name="medicine"/>
                                    <field name="quantity"/>
                                    <field name="frequency"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

     <record id="action_hospital_management_patients" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
         <field name="context">{'patient':True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_hospital_management_patients_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_management_patients_form')})]"/>
         <field name="domain">[('patient_code','ilike','P%')]</field>
    </record>

<!--        <field name="domain">[('category_id','=','Patient')]</field>-->

    <menuitem name="Patients" id="hospital_management_patients_menuitem"
              parent="hospital_menu_root"
              action="action_hospital_management_patients"/>
</odoo>