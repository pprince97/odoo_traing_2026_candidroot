<odoo>
    <record id="hospital_doctor_list_view" model="ir.ui.view">
        <field name="name">hospital.doctor.list.view</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="doctor_code"/>
                <field name="name"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="specialty_description"/>
                <field name="experience"/>
                <field name="department_id"/>
                <field name="hospital_id"/>
            </list>
        </field>
    </record>
    <record id="hospital_doctor_form_view" model="ir.ui.view">
        <field name="name">hospital.doctor.form.view</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="generate_doctor_code"
                            string="Generate Doctor Code"
                            type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_hospital_appointment" type="object" icon="fa-users">
                            <field string="Appointment" name="appointment_ids" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="doctor_code"/>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="specialty_description"/>
                            <field name="experience"/>
                            <field name="department_id"/>
                            <field name="hospital_id"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_doctor_window_action_menu" model="ir.actions.act_window">
        <field name="name">hospital.doctor.window.action.menu</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="hospital_menu_root" name="Hospital Management System"/>

    <menuitem id="hospital_doctor_menu"
              name="Doctor"
              action="hospital_doctor_window_action_menu"
              parent="hospital_menu_root"/>
</odoo>