<odoo>

    <record id="doctor_seq" model="ir.sequence">
        <field name="name">doctor Seq</field>
        <field name="code">doctor.seq</field>
        <field name="prefix">D/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>


    <record id="hospital_doctor_list_view" model="ir.ui.view">
        <field name="name">Doctor List</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="doctor_code"/>
                <field name="name"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="specialty_description"/>
                <field name="experience"/>
                <field name="department_id"/>
                <field name="hospital_id"/>
            </list>
        </field>
    </record>
    <record id="hospital_doctor_form_view" model="ir.ui.view">
        <field name="name">Doctor Form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_hospital_appointment_doctor" type="object"
                                icon="fa-users">
                            <field string="Appointment" name="appointment_ids" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="doctor_code"/>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="specialty_description"/>
                            <field name="experience"/>
                            <!--                            <field name="department_id"/>-->
                            <!--                            <field name="hospital_id"/>-->
                            <field name="hospital_id" invisible="department_id"/>
                            <field name="hospital_id" domain="[('department_ids', 'in', department_id)]"
                                   invisible="not department_id"/>
                            <field name="department_id" invisible="hospital_id"/>
                            <field name="department_id" domain="[('hospital_ids', 'in', hospital_id)]"
                                   invisible="not hospital_id"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_doctor_window_action_menu" model="ir.actions.act_window">
        <field name="name">Doctor menu</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'doctor':True}</field>
        <field name="domain">[('doctor_code', 'ilike', 'D/%')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_doctor_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_doctor_form_view')})]"/>
    </record>
    <menuitem id="hospital_menu_root" name="Hospital Management System"/>

    <menuitem id="hospital_doctor_menu"
              name="Doctor"
              action="hospital_doctor_window_action_menu"
              parent="hospital_menu_root"
              groups="hospital_management_sankit.group_hospital_doctor"/>
</odoo>