<odoo>

    <record id="patient_seq" model="ir.sequence">
            <field name="name">patient Seq</field>
            <field name="code">patient.seq</field>
            <field name="prefix">p</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    <record id="patient_view" model="ir.ui.view">
        <field name="name">patient view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <div class="oe_button_box" name="button_box" >
                    <button class="oe_stat_button" name="action_hospital_appointment" type="object" icon="fa-users">
                        <field string="Appointment" name="appointment_ids" widget="statinfo"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//form//div[@class='alert alert-warning oe_edit_only']" position="after">
                <header>
                    <button name="generate_patient_code"
                            string="Generate Patient Code"
                            type="object" class="oe_highlight"/>
                </header>
            </xpath>
            <xpath expr="//div[@class='o_address_format']" position="after">
                <field name="patient_code"/>
                <field name="name"/>
                <field name="dob"/>
                <field name="phone"/>
                <field name="email"/>

            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="age_year"/>
                <field name="age_month"/>
                <field name="age_day"/>
                <field name="address"/>

            </xpath>
        </field>
    </record>
    <record id="patient_action_views" model="ir.actions.act_window">
        <field name="name">Patient View</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hospital_patient_menu"
              name="Patient"
              action="patient_action_views"
              parent="hospital_menu_root"
                groups="hospital_management_sankit.group_hospital_user" />
</odoo>