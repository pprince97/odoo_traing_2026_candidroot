<odoo>

    <record id="patient_seq" model="ir.sequence">
        <field name="name">patient Seq</field>
        <field name="code">patient.seq</field>
        <field name="prefix">P/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>


    <record id="hospital_patient_list_view" model="ir.ui.view">
        <field name="name">patient list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="patient_code"/>
                <field name="dob"/>
                <field name="age_year"/>
                <field name="age_month"/>
                <field name="age_day"/>

                <field name="p_hospital_id"/>
            </list>
        </field>
    </record>

    <record id="hospital_patient_form_view" model="ir.ui.view">
        <field name="name">patient list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button class="oe_stat_button" name="create_appointment" type="object" string="Create Appointment" >
                    </button>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_hospital_appointment_patient" type="object"
                                icon="fa-users">
                            <field string="Appointment" name="patient_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="patient_code"/>
                        <field name="dob"/>
                        <field name="age_year"/>
                        <field name="age_month"/>
                        <field name="age_day"/>

                        <field name="p_hospital_id"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="patient_action_views" model="ir.actions.act_window">
        <field name="name">Patient View</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'patient':True}</field>
        <field name="domain">[('patient_code', 'ilike', 'P/%')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('hospital_patient_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('hospital_patient_form_view')})]"/>
    </record>

    <menuitem id="hospital_patient_menu"
              name="Patient"
              action="patient_action_views"
              parent="hospital_menu_root"
              groups="hospital_management_sankit.group_hospital_patient"/>
</odoo>