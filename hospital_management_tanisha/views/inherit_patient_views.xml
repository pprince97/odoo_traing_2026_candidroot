<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="patient_list_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id" width="50px"/>
                <field name="name" width="50px"/>
                <field name="dob" width="50px"/>
                <field name="age" width="50px"/>
                <field name="street" width="50px" string="Address"/>
                <field name="phone" width="50px" string="Mobile"/>
                <field name="email" width="50px"/>
            </list>
        </field>
    </record>

    <record id="patient_form_view" model="ir.ui.view">
        <field name="name">res.partner.inherit.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_appointment"
                            string="Create Appointment"
                            class="oe_highlight"
                            type="object"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="patient_appointments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                        >
                            <field name="appointment_count" string="Appointments" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="0"/>
                            <field name="dob"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="street" string="Address"/>
                            <field name="phone" string="Mobile"/>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="patient_menu_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'patient': True}</field>
        <field name="domain">[('patient_id','ilike','P%')]</field>
    </record>

    <record id="patient_list_action" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="patient_list_view"/>
        <field name="act_window_id" ref="patient_menu_action"/>
    </record>

    <record id="patient_form_action" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="patient_form_view"/>
        <field name="act_window_id" ref="patient_menu_action"/>
    </record>

    <menuitem id="patient_menu" name="Patient" parent="hospital_root" action="patient_menu_action"/>
</odoo>