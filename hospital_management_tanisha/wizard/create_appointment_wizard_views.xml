<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="create_appointment_wizard_form" model="ir.ui.view">
        <field name="name">appointment.wizard.form</field>
        <field name="model">create.appointment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="hospital_id"/>
                            <field name="patient_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="doctor_id"/>
                            <field name="appointment_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="create_appointment_wizard"
                            string="Create Appointment"
                            class="oe_highlight"
                            type="object"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>