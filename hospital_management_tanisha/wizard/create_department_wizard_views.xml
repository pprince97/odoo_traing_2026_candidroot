<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="create_department_wizard_form" model="ir.ui.view">
        <field name="name">department.wizard.form</field>
        <field name="model">create.department.wizard</field>
        <field name="arch" type="xml">
            <form string="Hospital Form">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                <footer>
                    <button name="create_department_wizard"
                            string="Create Department"
                            class="btn-primary"
                            type="object"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>