<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="department_list_view" model="ir.ui.view">
        <field name="name">hospital.department.list</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="department_form_view" model="ir.ui.view">
        <field name="name">hospital.department.form</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="department_action" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">hospital.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hospital_department" name="Departments" parent="hospital_root" action="department_action" groups="hospital_management_urvi.group_hospital_Manager"/>
</odoo>















