<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hospital_list_view" model="ir.ui.view">
        <field name="name">hospital.hospital.list</field>
        <field name="model">hospital.hospital</field>
        <field name="arch" type="xml">
            <list>
                <field name="hospital_name"/>
                <field name="address"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="registration_number"/>
                <field name="description"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="doctor_ids" widget="many2many_tags"/>
                <field name="patient_ids" widget="many2many_tags"/>
                <field name="appointment_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="hospital_form_view" model="ir.ui.view">
        <field name="name">hospital.hospital.form</field>
        <field name="model">hospital.hospital</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            type="object"
                            name="create_appointment"
                            string="Create Department"
                            icon="fa-list"
                            class="btn-primary">
                    </button>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button
                                type="object"
                                name="view_doctor"
                                icon="fa-list"
                                class="btn-primary">
                            <field name="d_counts" string="Doctors" widget="statinfo"/>
                        </button>
                        <button
                                type="object"
                                name="view_patient"
                                icon="fa-list"
                                class="btn-primary">
                            <field name="p_counts" string="Patients" widget="statinfo"/>
                        </button>
                        <button
                                type="object"
                                name="view_appointment"
                                icon="fa-list"
                                class="btn-primary">
                            <field name="a_counts" string="Appointments" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="hospital_name"/>
                            <field name="address"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="registration_number"/>
                            <field name="description"/>
                            <field name="department_ids" widget="many2many_tags"
                                   options="{'no_create':True,'no_open':True,'color_field':'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="doctor" string="Doctors">
                            <field name="doctor_ids" context="{'form_view_ref':'hospital_management_urvi.doctor_form_view'}">
                                <list>
                                    <field name="doctor_id" />
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="patient" string="Patients">
                            <field name="patient_ids" context="{'form_view_ref':'hospital_management_urvi.patient_form_view'}">
                                <list>
                                    <field name="patient_id" />
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="appointment" string="Appointments">
                            <field name="appointment_ids">
                                <list>
                                    <field name="patient_id"/>
                                    <field name="doctor_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_action" model="ir.actions.act_window">
        <field name="name">Hospital</field>
        <field name="res_model">hospital.hospital</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hospital_root" name="Hospital Management"/>
    <menuitem id="hospital_hospital" name="Hospital" parent="hospital_root" action="hospital_action"/>
</odoo>















