<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="patient_list_view" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="name"/>
                <field name="date_of_birth"/>
                <field name="age_"/>
                <!--                <field name="address"/>-->
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="hospital_ids_" widget="many2many_tags"/>
            </list>
        </field>
    </record>


    <record id="patient_form_view" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" position="inside">
                        <button
                                type="object"
                                name="view_appointment_patient"
                                icon="fa-list"
                                class="btn-primary">
                            <field name="pa_counts" string="Appointments" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="name" string="Patient Name"/>
                            <field name="date_of_birth"/>
                            <field name="age_"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <span class="o_form_label o_td_label o_address_type" name="address_name">
                                <field name="type_address_label" invisible="is_company" readonly="1" class="fw-bold"/>
                                <span invisible="not is_company">Address</span>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" placeholder="State" class="o_address_state"
                                       options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="country_id" placeholder="Country" class="o_address_country"
                                           options='{"no_open": True, "no_create": True}'/>
                                </div>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page name="hospital" string="Hospital">
                            <field name="hospital_ids_">
                                <list>
                                    <field name="hospital_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="patient_action" model="ir.actions.act_window">
        <field name="name">Patient</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'patient':1}</field>
        <field name="domain">[('patient_id','like','P%')]</field>
    </record>

    <record id="action_patient_list" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="patient_list_view"/>
        <field name="act_window_id" ref="patient_action"/>
    </record>

    <record id="action_patient_form" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="patient_form_view"/>
        <field name="act_window_id" ref="patient_action"/>
    </record>

    <menuitem id="hospital_patient" name="Patients" parent="hospital_root" action="patient_action"/>
</odoo>















