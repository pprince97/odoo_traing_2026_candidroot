<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="department_wizard_view" model="ir.ui.view">
        <field name="name">Department.Wizard.View</field>
        <field name="model">department.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="hospital_ids" widget="many2many_tags" />
                    </group>
                    <footer>
                        <button
                                type="object"
                                name="wizard_create"
                                string="Save"
                                class="btn-primary"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>