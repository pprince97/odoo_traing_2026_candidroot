<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="hotel_booking_list">
            <field name="name">hotel_management.list</field>
            <field name="model">hotel.booking</field>
            <field name="arch" type="xml">
                <list>
                    <field name="booking_reference"/>
                    <field name="number_of_nights"/>
                    <field name="total_amount"/>
                    <field name="booking_status"/>
                    <field name="is_paid"/>
                    <field name="booking_date"/>
                    <field name="check_in_date_and_time"/>
                    <field name="special_request"/>
                    <field name="invoice"/>
                    <field name="booking_image_proof"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="hotel_booking_search">
            <field name="name">hotel_management.search</field>
            <field name="model">hotel.booking</field>
            <field name="arch" type="xml">
                <search>
                    <field name="booking_reference"/>
                    <field name="number_of_nights"/>
                    <field name="total_amount"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="hotel_booking_form">
            <field name="name">hotel_management.form</field>
            <field name="model">hotel.booking</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <header>
                        <button name="set_booking_with_service"
                                string="command_Create"
                                type="object"
                                context="{'service_date':True}"
                        />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="booking_reference"/>
                                <field name="number_of_nights"/>
                                <field name="total_amount"/>
                                <field name="booking_status"/>
                            </group>
                            <group>
                                <field name="is_paid"/>
                                <field name="booking_date"/>
                                <field name="check_in_date_and_time"/>
                                <!--                                Many2One many booking for 1 guest-->
                                <!--                                <field name="guest_id"/>-->
                                <field name="guest_id"
                                       domain="[('is_vip','!=',True)]"/>

                            </group>
                        </group>
                        <notebook>
                            <page name="descriptive_section" string="Requesting Section">
                                <group>
                                    <field name="special_request"/>
                                </group>
                            </page>
                            <page name="booking_documents" string="Booking related Documents">
                                <group>
                                    <field name="invoice"/>
                                    <field name="booking_image_proof" widget="image" class="oe_avatar"/>
                                </group>
                            </page>

                            <!--                            Many2Many Many Bookings to Many Hotels-->
                            <page name="hotels" string="Hotels">
                                <group>
                                    <field name="hotels_ids">
                                        <list>
                                            <field name="name"/>
                                            <field name="total_rooms"/>
                                            <field name="rating"/>
                                            <field name="category"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <!--                            Many2Many Many Booking Have a Many service-->
                            <page name="service" string="Services">
                                <group>
                                    <field name="service_ids">
                                        <list>
                                            <field name="service_name"/>
                                            <field name="service_type"/>
                                            <field name="price"/>
                                            <field name="Quantity"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.server" id="action_server_hotel_booking">
            <field name="name">Is Paid</field>
            <field name="model_id" ref="hotel_management.model_hotel_booking"/>
<!--            <field name="binding_model_id" ref="account.model_account_move"/>-->
            <field name="state">code</field>
            <field name="binding_view_types">list,form</field>
            <field name="code">action = records.action_server_is_paid()</field>
        </record>

        <record model="ir.actions.act_window" id="hotel_booking_action">
            <field name="name">Booking Form</field>
            <field name="res_model">hotel.booking</field>
            <field name="view_mode">list,form,search</field>
        </record>

        <menuitem name="Hotel Management System" id="hotel_menu_root"/>

        <menuitem name="Booking" id="hotel_booking_menu" parent="hotel_menu_root"
                  action="hotel_booking_action"/>

    </data>
</odoo>