<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="hotel_hotel_list">
            <field name="name">hotel_management.list</field>
            <field name="model">hotel.hotel</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="total_rooms"/>
                    <field name="rating"/>
                    <field name="category"/>
                    <field name="is_active"/>
                    <field name="opening_date"/>
                    <field name="description"/>
                    <field name="license_document"/>
                    <field name="image" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="hotel_hotel_search">
            <field name="name">hotel_management.search</field>
            <field name="model">hotel.hotel</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Name"/>
                    <field name="rating" string="Rating"/>
                    <field name="category" string="Category"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="hotel_hotel_form">
            <field name="name">hotel_management.list</field>
            <field name="model">hotel.hotel</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="total_rooms"/>
                                <field name="rating"/>
                            </group>
                            <group>
                                <field name="category"/>
                                <field name="is_active"/>
                                <field name="opening_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="hotel_description" string="About Hotel">
                                <group>
                                    <field name="description"/>
                                </group>
                            </page>
                            <page name="hotel_documents" string="Legal Documents">
                                <group>
                                    <field name="license_document"/>
                                    <field name="image"/>
                                </group>
                            </page>

<!--                            one to many list of rooms-->
                            <page name="rooms" string="Rooms">
                                <field name="room_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="room_number"/>
                                        <field name="price_per_night"/>
                                        <field name="room_type"/>
                                    </list>
                                </field>
                            </page>

                             <page name="bookings" string="Bookings">
                                 <group>
                                <field name="booking_ids">
                                    <list>
                                        <field name="booking_reference"/>
                                        <field name="number_of_nights"/>
                                        <field name="total_amount"/>
                                        <field name="booking_status"/>
                                    </list>
                                </field>
                                 </group>
                            </page>

<!--                            one2Many One hotel have Many services-->
                            <page name="service" string="Services Ids">
                                <group>
                                    <field name="service_ids">
                                        <list>
                                            <field name="service_name"/>
                                            <field name="service_type"/>
                                            <field name="price"/>
                                            <field name="Quantity"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="hotel_hotel_action">
            <field name="name">Hotel Details Form</field>
            <field name="res_model">hotel.hotel</field>
            <field name="view_mode">list,form,search</field>
        </record>

        <menuitem name="Hotel Management System" id="hotel_menu_root"/>

        <menuitem name="Hotel" id="hotel_hotel_menu" parent="hotel_menu_root"
                  action="hotel_hotel_action"/>

    </data>
</odoo>