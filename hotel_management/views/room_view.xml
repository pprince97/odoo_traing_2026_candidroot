<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="room_list">
        <field name="name">hotel_management.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="100px"/>
                <field name="room_number" width="100px"/>
                <field name="price_per_night" width="100px"/>
                <field name="room_type" width="100px"/>
                <field name="is_available" width="100px"/>
                <field name="maintenance_date" width="100px"/>
                <field name="last_cleaned" width="100px"/>
                <field name="notes" width="100px"/>
                <field name="room_document" width="100px"/>
                <field name="room_images" widget="image" width="100px"/>
                <field name="hotel_ids"/>
                <field name="guest_ids"/>
            </list>
        </field>
    </record>

    <record id="room_form" model="ir.ui.view">
        <field name="name">hotel_managment.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_number"/>
                            <field name="price_per_night"/>
                            <field name="room_type"/>
                        </group>
                        <group>
                            <field name="is_available"/>
                            <field name="maintenance_date"/>
                            <field name="last_cleaned"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Room Description" name="room_description">
                            <group>
                                <label for="notes"/>
                                <div>
                                    <field name="notes"/>
                                </div>
                            </group>
                        </page>
                        <page string="Hotel Uploads" name="hotel_upload">
                            <group>
                                <label for="room_document"/>
                                <div>
                                    <field name="room_document"/>
                                </div>
                                <label for="room_images"/>
                                <div>
                                    <field name="room_images" widget="image"/>
                                </div>
                            </group>
                        </page>
                        <page string="Hotels" name="hotels">
                            <field name="hotel_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="guests" name="Guest">
                            <field name="guest_ids">
                                <list>
                                    <field name="guest_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="room_search" model="ir.ui.view">
        <field name="name">hotel_managment.select</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search string="Room Search">
                <field name="name"/>
                <field name="room_number"/>
                <field name="price_per_night"/>
                <field name="room_type"/>
                <field name="is_available"/>
                <field name="maintenance_date"/>
                <field name="last_cleaned"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_room">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <menuitem name="Rooms" id="hotel_management_room" parent="hotel_management_root" action="action_room"/>
</odoo>