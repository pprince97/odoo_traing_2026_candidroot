<odoo>
    <data>

        <record id="service_list" model="ir.ui.view">
            <field name="name">Service</field>
            <field name="model">obj.service</field>
            <field name="arch" type="xml">

                <list>
                    <field name="name" width="30px"/>
                    <field name="s_type" width="30px"/>
                    <field name="price" width="30px"/>
                    <field name="quantity" width="30px"/>
                    <field name="is_chargeable" width="30px"/>
                    <field name="s_date" width="30px"/>
                    <field name="s_time" width="30px"/>
                    <field name="description" width="30px"/>
                    <field name="attachment" filename="file_name" width="30px"/>
                    <field name="s_image" filename="file_name_i" width="30px"/>

                    <field name="booking_ids" width="30px"/>
                    <field name="hotel_ids" width="30px"/>
                </list>

            </field>
        </record>

        <record id="service_form" model="ir.ui.view">
            <field name="name">Service</field>
            <field name="model">obj.service</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="s_type"/>
                                <field name="price"/>
                                <field name="quantity"/>
                            </group>
                            <group>
                                <field name="is_chargeable"/>
                                <field name="s_date"/>
                                <field name="s_time"/>
                            </group>
                        </group>

                        <notebook>

                            <page string="Description" name="des">
                                <group>
                                    <field name="description"/>
                                </group>
                            </page>

                            <page string="Upload documents" name="upload_docs">
                                <group>
                                    <group>
                                        <field name="attachment" filename="file_name"/>
                                    </group>
                                    <group>
                                        <field name="s_image" filename="file_name_i"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Booking" name="booking">
                                <group>
                                    <field name="booking_ids">
                                        <list>
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <page string="Hotel" name="hotel">
                                <group>
                                    <field name="hotel_ids">
                                        <list>
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="service_search" model="ir.ui.view">
            <field name="name">Service</field>
            <field name="model">obj.service</field>
            <field name="arch" type="xml">
                <search string="Search service">
                    <field name="name"/>
                    <field name="s_type"/>
                    <field name="price"/>
                    <field name="quantity"/>
                </search>
            </field>
        </record>

        <record id="service_action" model="ir.actions.act_window">
            <field name="name">Service</field>
            <field name="res_model">obj.service</field>
            <field name="view_mode">list,form,search</field>
        </record>

        <menuitem name="Service" id="service_menu_id" parent="parent_id" action="service_action"/>

    </data>
</odoo>
