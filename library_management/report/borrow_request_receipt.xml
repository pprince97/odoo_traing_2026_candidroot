<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_book_history_report_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row mt8">
                        <div class="col-lg-12">
                            <h2>
                                <span>Book History Report
                                </span>
                            </h2>
                        </div>
                    </div>
                    <div class="oe_structure"/>
                    <div class="row mt8">
                        <div class="col-12">
                            <table class="table table-borderless">
                                <thead>
                                    <tr>
                                        <th class="text-start align-middle">
                                            <span>Student Name</span>
                                        </th>
                                        <th class="text-start align-middle">
                                            <span>Book Name</span>
                                        </th>
                                        <th class="text-start align-middle">
                                            <span>Is Returned</span>
                                        </th>
                                        <th class="text-start align-middle">
                                            <span>Start Date</span>
                                        </th>
                                        <th class="text-start align-middle">
                                            <span>End Date</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="docs" t-as="line"
                                        t-att-style="'background-color: #F1F1F1;' if line_index % 2 == 0 else ''">
                                        <td class="align-middle">
                                            <span t-field="line.student_ids">REF123</span>
                                        </td>
                                        <td class="align-middle">
                                            <span t-field="line.book_ids">Laptop</span>
                                        </td>
                                        <td class="align-middle">
                                            <span t-field="line.is_return_date">Laptop</span>
                                        </td>
                                        <td class="align-middle">
                                            <span t-field="line.start_date">2023-08-15</span>
                                        </td>
                                        <td class="align-middle">
                                            <span t-field="line.end_date">2023-08-15</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="oe_structure"/>
                </div>
            </t>
        </t>
    </template>

    <template id="book_history_report">
        <t t-call="web.html_container">
            <t t-call="library_management.report_book_history_report_document" t-lang="doc.lang"/>
        </t>
    </template>

    <record id="action_book_history_report" model="ir.actions.report">
        <field name="name">Book History</field>
        <field name="model">report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management.book_history_report</field>
        <field name="report_file">library_management.book_history_report</field>
        <field name="print_report_name">'Book History'</field>
        <field name="binding_model_id" ref="library_management.model_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

</odoo>


