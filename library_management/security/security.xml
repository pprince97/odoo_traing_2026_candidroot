<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <!-- Groups Category        -->
        <record model="ir.module.category" id="library_management_groups_category">
            <field name="name">Library Management</field>
            <field name="sequence">1</field>
        </record>
        <!--        Privilege-->
        <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="library_management_groups_category"/>
        </record>
        <!-- Groups        -->
        <record id="group_library_student" model="res.groups">
            <field name="name">Student</field>
            <field name="sequence">1</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>
        <record id="group_school_librarian" model="res.groups">
            <field name="name">Librarian</field>
            <field name="sequence">2</field>
            <field name="implied_ids" eval="[(4, ref('library_management.group_library_student'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>
        <record id="group_school_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">3</field>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="implied_ids" eval="[(4, ref('library_management.group_school_librarian'))]"/>
        </record>


<!--        <record id="group_library_extra_rights" model="res.groups">-->
<!--            <field name="name">New School Extra Rights</field>-->
<!--        </record>-->

<!--        Rule-->
        <record id="librarian_no_create_rule" model="ir.rule">
        <field name="name">Librarian Cannot Create Librarian</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('library_management.group_school_librarian'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    </data>
</odoo>