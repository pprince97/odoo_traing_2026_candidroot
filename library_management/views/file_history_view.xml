<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="file_upload_history_list_view" model="ir.ui.view">
        <field name="name">file.upload.history.list.view</field>
        <field name="model">file.upload.history</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="file"/>
                <field name="upload_date"/>
                <field name="book_id"/>
            </list>
        </field>
    </record>

    <record id="file_upload_history_form_view" model="ir.ui.view">
        <field name="name">file.upload.history.form.view</field>
        <field name="model">file.upload.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="file"/>
                            <field name="upload_date"/>
                            <field name="book_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="file_history_window" model="ir.actions.act_window">
        <field name="name">File History Records</field>
        <field name="res_model">file.upload.history</field>
        <field name="view_mode">list,form</field>
    </record>

<!--    <menuitem id="file_upload_history_view"-->
<!--              name="File Upload History"-->
<!--              parent="library_menu_root"-->
<!--              action="file_history_window"/>-->

</odoo>