<odoo>
    <record id="product_template_list_view" model="ir.ui.view">
        <field name="name">product.books.list.view</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="invoice_policy"/>
                <field name="is_storable"/>
                <field name="list_price"/>
            </list>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.books.form.view</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="invoice_policy"/>
                    <field name="is_storable"/>
                    <field name="list_price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="product_template_action" model="ir.actions.act_window">
        <field name="name">Product Records</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('product_template_list_view')})]"/>
<!--        <field name="view_ids"-->
<!--               eval="[(5, 0, 0), (0, 0, {'view_mode': 'form', 'view_id': ref('product_template_form_view')})]"/>-->
    </record>

    <menuitem id="product_template"
              name="Product"
              parent="library_menu_root"
              action="product_template_action"/>
</odoo>