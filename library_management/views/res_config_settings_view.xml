<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='performance']" position="after">
                <div>
                    <block title="Library Management"  name="fines_amounts_book" class="fines_amounts_book">
                    <setting id="fines_amounts_book" help="Enter fine Amount for book per day">
                        <field name="fines_amounts_book"/>
                    </setting>
                </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
