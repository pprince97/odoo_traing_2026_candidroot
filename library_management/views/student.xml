<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="student_view_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="show_book_history" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="books_borrow_history" widget="statinfo" string="Books Borrowed"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="email" required="1"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="gender"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="student_view_list" model="ir.ui.view">
        <field name="name">res.partner.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gender"/>
            </list>
        </field>
    </record>

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.partner</field>
        <field name="domain">[('person', '=', 'student')]</field>
        <field name="context">{'default_person':'student'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('student_view_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('student_view_form')}),
        ]"/>
    </record>

    <menuitem id="student" name="Student" parent="root" action="student_action" sequence="4"
              groups="group_library_student"/>

</odoo>
