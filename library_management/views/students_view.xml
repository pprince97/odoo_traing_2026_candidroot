<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="student_inherit_list_view" model="ir.ui.view">
        <field name="name">student.inherit.list.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gender"/>
            </list>
        </field>
    </record>


    <record id="student_inherit_kanban_views" model="ir.ui.view">
        <field name="name">student.inherit.kanban.views</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gender"/>

                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>

                    </t>

                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">

                            <!-- Header -->
                            <div class="o_kanban_header">
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <t t-if="record.phone.value">
                                    <span class="badge bg-secondary float-end">
                                        <field name="phone"/>
                                    </span>
                                </t>

                            </div>

                            <!-- Body -->
                            <div class="o_kanban_content mt-2">
                                <div>
                                    <span class="badge text-bg-info">
                                        <field name="email"/>
                                    </span>

                                    <t t-if="record.gender.raw_value == 'male'">
                                        <span class="badge text-bg-success float-end">Male</span>
                                    </t>

                                    <t t-else="">
                                        <span class="badge text-bg-danger float-end">Female</span>
                                    </t>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="student_inherit_form_views" model="ir.ui.view">
        <field name="name">student.inherit.form.views</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_button_box" name="button_box" groups="library_management.group_librarian">
                        <button name="get_history_of_books" class="oe_stat_button" type="object" icon="fa-book">
                            <field name="count_total_book" string="Total Books" widget="statinfo"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="gender"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="student_action_window" model="ir.actions.act_window">
        <field name="name">Students Record</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_member':'student'}</field>
        <field name="domain">[('member','=','student')]</field>
    </record>

    <record id="action_student_list" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="student_inherit_list_view"/>
        <field name="act_window_id" ref="student_action_window"/>
    </record>

    <record id="action_student_form" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="student_inherit_form_views"/>
        <field name="act_window_id" ref="student_action_window"/>
    </record>

    <record id="action_student_kanban" model="ir.actions.act_window.view">
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="student_inherit_kanban_views"/>
        <field name="act_window_id" ref="student_action_window"/>
    </record>

    <menuitem id="student_view"
              name="Student"
              parent="library_menu_root"
              action="student_action_window"/>
</odoo>
