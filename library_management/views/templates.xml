    <!--    different website -->
    <template id="custom_homepage_a1" name="homepage_a1">
        <t t-call="website.layout" pageName.f="homepage">
            <div id="wrap" class="oe_structure oe_empty">
                <h1>Welcome to Our Inherited Homepage A1</h1>
            </div>
        </t>
    </template>

    <template id="custom_homepage_a2" name="homepage_a2">
        <t t-call="website.layout" pageName.f="homepage">
            <div id="wrap" class="oe_structure oe_empty">
                <h1>Welcome to Our Inherited Homepage A2</h1>
            </div>
        </t>
    </template>


    <!--            Create submenu-->
    <record id="parent_book_menu" model="website.menu">
        <field name="name">Book</field>
        <field name="url">#</field>
        <field name="parent_id" model="website.menu"
               search="[('website_id', '=', ref('website.default_website')),('parent_id', '=', False)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">65</field>
    </record>


    <record id="menu_book_form_data1" model="website.menu">
        <field name="name">Book Data</field>
        <field name="url">/book-data</field>
        <field name="parent_id" ref="parent_book_menu"/>
        <field name="sequence" type="int">65</field>
    </record>


    <record id="menu_book_form_data2" model="website.menu">
        <field name="name">Book Form</field>
        <field name="url">/book/form</field>
        <field name="parent_id" ref="parent_book_menu"/>
        <field name="sequence" type="int">65</field>
    </record>


    <!-- Menu Bar-->
    <record id="menu_policy" model="website.menu">
        <field name="name">Cookie Policy</field>
        <field name="url">/policy</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">60</field>
    </record>


</odoo>

