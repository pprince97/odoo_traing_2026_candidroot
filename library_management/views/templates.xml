<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="book_form" name="Book Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                         data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"
                          style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Book Form</h1>
                    </div>
                </section>

                <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-6 mt-2 mt-lg-0 container w-72 mx-auto">
                                <form class="row g-3" action="/book-create" method="post">

                                    <div class="col-md-12">
                                        <label for="inputBook" class="form-label">Student Name</label>
                                        <select id="inputBook" name="student_id" class="form-select">
                                            <option t-att-selected="not default_value" disabled="disabled" value="">
                                                -----Select student name-----
                                            </option>
                                            <t t-foreach="request.env['res.partner'].sudo().search([('member', '=', 'student')])"
                                               t-as="val">
                                                <option t-att-value="val.id">
                                                    <t t-esc="val.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="inputBook" class="form-label">Book Name</label>
                                        <input type="text" name="name" class="form-control" id="inputBook"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="inputBarcode" class="form-label">Barcode</label>
                                        <input type="password" name="barcode" class="form-control" id="inputBarcode"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="inputStatus" class="form-label">Status</label>
                                        <select id="inputStatus" name="state" class="form-select">
                                            <option t-att-selected="not default_value" disabled="disabled" value="">
                                                ---Select Option---
                                            </option>
                                            <option>published</option>
                                            <option>unpublished</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="inputCategory" class="form-label">Category</label>
                                        <select id="inputCategory" name="category" class="form-select">
                                            <option t-att-selected="not default_value" disabled="disabled" value="">
                                                ---Select Option---
                                            </option>
                                            <option>anime</option>
                                            <option>hollywood</option>
                                            <option>motivation</option>
                                            <option>music</option>
                                            <option>other</option>
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label for="inputStock" class="form-label">Stock</label>
                                        <input type="text" name="stock" class="form-control" id="inputStock"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="inputBorrowPrice" class="form-label">Borrow Price</label>
                                        <input type="text" name="borrow_price" class="form-control"
                                               id="inputBorrowPrice"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="inputDayLimit" class="form-label">Max Day Limit</label>
                                        <input type="text" name="max_day_limit" class="form-control"
                                               id="inputDayLimit"/>
                                    </div>

                                    <div class="form-floating">
                                        <textarea class="form-control" placeholder="Leave a comment here"
                                                  id="floatingTextarea2" style="height: 100px"/>
                                        <label for="floatingTextarea2">Comments</label>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" name="description" type="checkbox"
                                                   id="gridCheck"/>
                                            <label class="form-check-label" for="gridCheck">
                                                Check me out
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!--    Book data-->
    <template id="book_data" name="Book Menu View">
        <t t-call="website.layout">
            <section class="container py-5">
                <div class="row justify-content-center">
                    <h3 class="mb-4 text-center">Welcome to Library Management</h3>
                    <form action="/book/form" method="get">
                        <button type="submit" class="btn btn-primary">Create Record</button>
                    </form>
                    <br/>
                    <br/>
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Student</th>
                                <th>Book</th>
                                <th>Barcode</th>
                                <th>State</th>
                                <th>Category</th>
                                <th>Stock</th>
                                <th>Available Copies</th>
                                <th>Fine Amount</th>
                                <th>Borrow Price</th>
                                <th>Maximum Day Limit</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tboady>
                            <t t-foreach="books" t-as="book">
                                <tr>
                                    <td>
                                        <span t-field="book.id"/>
                                    </td>
                                    <td>
                                        <span t-field="book.student_id"/>
                                    </td>
                                    <td>
                                        <span t-field="book.name"/>
                                    </td>
                                    <td>
                                        <span t-field="book.barcode"/>
                                    </td>
                                    <td>
                                        <span t-field="book.state"/>
                                    </td>
                                    <td>
                                        <span t-field="book.category"/>
                                    </td>
                                    <td>
                                        <span t-field="book.stock"/>
                                    </td>
                                    <td>
                                        <span t-field="book.available_copies"/>
                                    </td>
                                    <td>
                                        <span t-field="book.fine_amount"/>
                                    </td>
                                    <td>
                                        <span t-field="book.borrow_price"/>
                                    </td>
                                    <td>
                                        <span t-field="book.maximum_day_limit"/>
                                    </td>
                                    <td>
                                        <button id="myBtn">
                                            <img alt="svgImg"
                                                 src="library_management/static/src/img/icons8-delete-25.png"/>
                                        </button>

                                        <button>
                                            <img alt="svgImg"
                                                 src="library_management/static/src/img/icons8-edit-25.png"/>
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tboady>
                    </table>
                </div>
            </section>
        </t>
    </template>


    <!--    Record in My Account Portal-->
    <template id="portal_my_home_books" name="Book List" inherit_id="portal.portal_my_home" priority="10">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div id="portal_alert_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                    <t t-set="title">Book Lists</t>
                    <t t-set="url" t-value="'/book-data'"/>
                    <t t-set="text">View and Create a books</t>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>


