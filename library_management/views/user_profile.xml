<odoo>
    <record id="user_profile_list_view" model="ir.ui.view">
        <field name="name">user.profile.list.view</field>
        <field name="model">user.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="city_id"/>
            </list>
        </field>
    </record>


    <record id="user_profile_form_view" model="ir.ui.view">
        <field name="name">user.profile.form.view</field>
        <field name="model">user.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="city_id"/>
                        </group>

                        <group>
                            <field name="address"/>
                            <field name="zip_code"/>
                            <field name="user_image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="user_profile_action_window" model="ir.actions.act_window">
        <field name="name">Profile Record</field>
        <field name="res_model">user.profile</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="profile_record"
              name="Profile"
              parent="library_menu_root"
              action="user_profile_action_window"/>
</odoo>