<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="wizard_view_form">
            <field name="name">report.wizard.form</field>
            <field name="model">report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="is_returned"/>
                                <field name="student_ids" widget="many2many_tags"/>
                                <field name="book_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <footer>
                            <button name="show_history" type="object" string="Search Records" class="oe_highlight"/>
                            <button name="print_history" type="object" string="Print Records" class="oe_highlight"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="book_history_view_form">
            <field name="name">history.wizard.form</field>
            <field name="model">report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="start_date" readonly="1"/>
                                <field name="end_date" readonly="1"/>
                                <field name="is_returned" readonly="1"/>
                                <field name="student_ids" widget="many2many_tags" readonly="1"/>
                                <field name="book_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="book_history_view_list" model="ir.ui.view">
            <field name="name">history.wizard.list</field>
            <field name="model">report.wizard</field>
            <field name="arch" type="xml">
                <list>
                    <field name="start_date" readonly="1"/>
                    <field name="end_date" readonly="1"/>
                    <field name="is_returned" readonly="1"/>
                    <field name="student_ids" widget="many2many_tags" readonly="1"/>
                    <field name="book_ids" widget="many2many_tags" readonly="1"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="report_action">
            <field name="name">Report</field>
            <field name="res_model">report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="wizard_view_form"/>
        </record>

        <menuitem id="report" name="Reporting" parent="root" sequence="5" groups="group_school_librarian"/>
        <menuitem id="book_history" name="Book History" parent="report" groups="group_school_librarian"
                  action="report_action"/>

    </data>
</odoo>