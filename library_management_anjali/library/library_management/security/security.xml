<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_library_management">
            <field name="name">Library Management</field>
            <field name="sequence">1</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library</field>
            <field name="sequence">2</field>
            <field name="category_id" ref="library_management.module_category_library_management"/>
        </record>

        <!--    Groups  -->

        <record id="group_project_student" model="res.groups">
            <field name="name">Student</field>
            <field name="sequence">3</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>
        <record id="group_project_librarian" model="res.groups">
            <field name="name">Librarian</field>
            <field name="sequence">4</field>
            <field name="implied_ids" eval="[(4, ref('library_management.group_project_student'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>
        <record id="group_project_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">5</field>
            <field name="implied_ids" eval="[(4, ref('library_management.group_project_librarian'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="user_ids" eval="[(4,ref('base.user_root')),(4,ref('base.user_admin'))]"/>
        </record>

        <record id="group_project_librarian_menu" model="res.groups">
            <field name="name">Librarian Menu</field>
        </record>

        <!--    Record Rules  -->

        <!--    Student  -->

        <record id="project_rule_student_student" model="ir.rule">
            <field name="name">Student : own list only</field>
            <field name="model_id" ref="library_management.model_res_partner"/>
            <field name="domain_force">[('user_id','=',user.id),('student_code','!=',False)]</field>
            <field name="groups" eval="[(4, ref('library_management.group_project_student'))]"/>
        </record>
        <record id="project_rule_student_borrow_request" model="ir.rule">
            <field name="name">Student : own borrow request only</field>
            <field name="model_id" ref="library_management.model_library_borrow_request"/>
            <field name="domain_force">[('student_id','in',user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('library_management.group_project_student'))]"/>
        </record>

        <!--    Librarian  -->

        <record id="student_creation_librarian" model="ir.rule">
            <field name="name">Librarian : All students</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|',('librarian_code','=',False),('user_ids','!=',False)]</field>
            <field name="groups" eval="[(4, ref('library_management.group_project_librarian')),(4,ref('base.group_erp_manager'))]"/>
        </record>
<!--        <record id="librarian_rule_view_self" model="ir.rule">-->
<!--            <field name="name">Librarian : Own list only</field>-->
<!--            <field name="model_id" ref="base.model_res_partner"/>-->
<!--            <field name="domain_force">[('user_id','=',user.id),('librarian_code','!=',False))]</field>-->
<!--            <field name="groups" eval="[(4, ref('library_management.group_project_librarian')),(4,ref('base.group_erp_manager'))]"/>-->
<!--        </record>-->
        <record id="project_rule_librarin_borrow_request" model="ir.rule">
            <field name="name">Librarian : own borrow request only</field>
            <field name="model_id" ref="library_management.model_library_borrow_request"/>
            <field name="domain_force">[('librarian_id','in',user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('library_management.group_project_librarian'))]"/>
        </record>

        <!--    Admin  -->

        <record id="project_rule_admin_students_librarian" model="ir.rule">
            <field name="name">Admin : all students/librarian</field>
            <field name="model_id" ref="library_management.model_res_partner"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management.group_project_admin'))]"/>
        </record>
        <record id="project_rule_admin_borrow_request" model="ir.rule">
            <field name="name">Admin : all borrow request</field>
            <field name="model_id" ref="library_management.model_library_borrow_request"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management.group_project_admin'))]"/>
        </record>
    </data>
</odoo>