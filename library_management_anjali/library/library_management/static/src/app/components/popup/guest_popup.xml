<templates>
    <t t-name="library_management.GuestCountDialog">
        <Dialog title="'No of Guest'" size="'lg'">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-4 d-flex align-items-center">
                        <label class="mb-0 me-2" style="white-space: nowrap;">No of Male:</label>
                        <input type="number" t-model.number="state.male" class="form-control form-control-sm"/>
                    </div>
                    <div class="col-4 d-flex align-items-center">
                        <label class="mb-0 me-2" style="white-space: nowrap;">No of Female:</label>
                        <input type="number" t-model.number="state.female" class="form-control form-control-sm"/>
                    </div>
                    <div class="col-4 d-flex align-items-center">
                        <label class="mb-0 me-2" style="white-space: nowrap;">No of Guest:</label>
                        <input type="number" t-att-value="totalCount" class="form-control form-control-sm"
                               readonly="1"/>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="_onNext" t-att-disabled="totalCount == 0">Next</button>
                <button class="btn btn-secondary" t-on-click="_onSkip">Skip</button>
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="library_management.GuestDetailsDialog">
        <Dialog title="'Guest Details'" size="'lg'">
            <div style="max-height: 400px; overflow-y: auto;">
                <t t-foreach="state.guests" t-as="guest" t-key="guest.id">
                    <div class="row mt-3 mb-1">
                        <div class="col-12">
                            <strong class="text-primary">Customer-<t t-esc="guest_index + 1"/>:
                            </strong>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center border-bottom pb-2">
                        <div class="col-4 d-flex align-items-center">
                            <label class="mb-0 me-2">Age:</label>
                            <input type="number" t-model.number="guest.age" class="form-control form-control-sm"/>
                        </div>
                        <div class="col-4 d-flex align-items-center">
                            <label class="mb-0 me-2">Nationality:</label>
                            <select t-model="guest.nationality" class="form-select form-select-sm">
                                <option value="">Select...</option>
                                <t t-foreach="countries" t-as="country" t-key="country.id">
                                    <option t-att-value="country.id">
                                        <t t-esc="country.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="col-4 d-flex align-items-center">
                            <label class="mb-0 me-2">Gender:</label>
                            <select t-model="guest.gender" class="form-select form-select-sm">
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="_onConfirm">Next</button>
                <button class="btn btn-secondary" t-on-click="_onPrevious">Previous</button>
                <button class="btn btn-secondary" t-on-click="_onSkip">Skip</button>
            </t>
        </Dialog>
    </t>
</templates>
