<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="library_management.ControlButtonsInherit" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]" position="before">
             <button t-att-class="buttonClass" t-on-click="() => this.onCustomButtonClick()">
                    <i class="oi oi-arrow-right me-1" />Custom Button
             </button>
        </xpath>
    </t>
</templates>
