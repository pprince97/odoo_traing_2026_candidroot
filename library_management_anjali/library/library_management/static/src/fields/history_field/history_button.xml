<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <templates>
        <t t-name="library_management.ImageField" t-inherit="web.ImageField" t-inherit-mode="extension">
            <xpath expr="//div[hasclass('o_image_uploader_container')]" position="inside">
                <button
                        class="o_select_file_button btn btn-light border-0 rounded-circle m-1 p-1"
                        data-tooltip="History"
                        aria-label="History">
                    <i class="fa fa-fw fa-clock-o"/>
                </button>
            </xpath>
        </t>
    </templates>
</odoo>
