<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="library_management.CustomDialog">
        <Dialog title="'Select Attachments'">
            <div class="p-3">
                <ul class="list-group">
                    <t t-foreach="state.attachments" t-as="attachment" t-key="attachment.id">
                        <li class="list-group-item d-flex align-items-center">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   t-att-checked="state.selectedIds.has(attachment.id)"
                                   t-on-change="() => this.toggleSelection(attachment.id)"/>
                            <t t-esc="attachment.name"/>
                        </li>
                    </t>
                </ul>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSave">Save</button>
                <button class="btn btn-secondary" t-on-click="props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>