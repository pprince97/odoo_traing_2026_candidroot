    <template id="books_template">
        <t t-call="website.layout">
            <t t-if="user.has_group('library_management.group_project_librarian') or user.has_group('library_management.group_project_admin')">
                <div class="container my-5">
                    <div class="card shadow-sm border-0 custom-book-form">
                        <div class="card-header bg-primary text-white py-3">
                            <h4 class="mb-0">Add New Library Book</h4>
                        </div>
                        <div class="card-body p-4">
                            <form action="/book/create" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row g-4">
                                    <div class="col-md">
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <label class="form-label fw-bold">Book Name <span class="text-danger">*</span></label>
                                                <input type="text" name="name" class="form-control form-control-lg" required="1"/>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fw-bold">Barcode <span class="text-danger">*</span></label>
                                                <input type="text" name="barcode" class="form-control" required="1"/>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fw-bold">Total Stock <span class="text-danger">*</span></label>
                                                <input type="number" name="stock" class="form-control" required="1" min="1"/>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fw-bold">Max Days Limit <span class="text-danger">*</span></label>
                                                <input type="number" name="maximum_day" class="form-control" required="1"/>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fw-bold">Borrow Price/Day <span class="text-danger">*</span></label>
                                                <div class="input-group">
<!--                                                    <span class="input-group-text">$</span>-->
                                                    <input type="number" step="0.01" name="borrow_price" class="form-control" required="1"/>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label fw-bold">Currency</label>
                                                <select name="currency" class="form-select">
                                                    <t t-foreach="request.env['res.currency'].sudo().search([])" t-as="curr">
                                                        <option t-att-value="curr.id" t-att-selected="curr.name == 'USD'"><t t-esc="curr.name"/></option>
                                                    </t>
                                                </select>
                                            </div>
<!--                                            <div class="col-12 mt-4">-->
<!--                                                <div class="form-check form-switch">-->
<!--                                                    <input class="form-check-input" type="checkbox" name="state" value="published" id="stateCheck"/>-->
<!--                                                    <label class="form-check-label fw-bold" for="stateCheck">Publish immediately?</label>-->
<!--                                                </div>-->
<!--                                            </div>-->
                                            <div class="col-12">
                                                <label class="form-label fw-bold d-block">Status</label>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="state" id="statePublished" value="published" checked="checked"/>
                                                    <label class="form-check-label" for="statePublished">Publish Book</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="state" id="stateUnpublished" value="unpublished"/>
                                                    <label class="form-check-label" for="stateUnpublished">Unpublish Book</label>
                                                </div>
                                            </div>
                                            <div class="col-6 border-end">
                                                <label class="form-label fw-bold">Cover Image</label>
                                                <div class="image-upload-wrapper text-center p-3 border rounded bg-light">
                                                    <i class="oi oi-camera d-block mb-2 fs-2 text-muted"/>
                                                    <input type="file" name="cover_image" class="form-control" accept="image/*"/>
                                                </div>
                                            </div>
                                            <div class="col-6 border-end">
                                                <div class="mt-4">
                                                    <label class="form-label fw-bold">Description</label>
                                                    <textarea name="description" class="form-control" rows="5" placeholder="Brief summary of the book..."/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-5 text-center">
                                    <a href="/book" class="btn btn-primary px-5 py-2 fw-bold shadow-sm">Cancel</a>
                                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm">Save Book to Library</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </t>
<!--            <t t-if="not user.has_group('library_management.group_project_librarian')">-->
                <div class="mt-5 border rounded">
                    <div class="container text-center py-3 w-50">
                        <h4 class="mb-3 fw-bold text-primary" style="font-size: 45px;">All Books</h4>
                    </div>
                    <table class="table table-hover table-borderless" style="border-color: #e9ecef;">
                        <thead style="background-color: #f8f9fa; border-bottom: 2px solid #edeff1;">
                            <tr class="text-uppercase" style="font-size: 1rem; letter-spacing: 0.5px;">
                                <th class="py-3 px-4 text-start text-muted">Name</th>
                                <th class="py-3 px-4 text-start text-muted">Barcode</th>
                                <th class="py-3 px-4 text-start text-muted">Borrow Price</th>
                            </tr>
                        </thead>
                        <tbody class="align-middle">
                            <t t-foreach="books" t-as="book">
                                <tr style="border-bottom: 1px solid #f0f2f5;">
                                    <td class="py-3 px-4 text-start fw-medium text-dark"><t t-esc="book.name"/></td>
                                    <td class="py-3 px-4 text-start fw-medium text-dark"><t t-esc="book.barcode"/></td>
                                    <td class="py-3 px-4 text-start fw-medium text-dark"><t t-esc="book.borrow_price" /></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
<!--        </t>-->
    </template>

    <record id="menu_library" model="website.menu">
        <field name="name">Library</field>
        <field name="parent_id" model="website.menu" search="[('website_id','=',ref('website.default_website')),('parent_id','=',False)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">300</field>
    </record>

    <record id="menu_library1" model="website.menu">
        <field name="name">book</field>
        <field name="url">/book</field>
        <field name="parent_id" ref="menu_library"/>
        <field name="sequence" type="int">500</field>
    </record>

    <record id="menu_library_services_mega" model="website.menu">
        <field name="name">Library Services</field>
        <field name="url">#</field>
        <field name="parent_id" model="website.menu" search="[('website_id','=',ref('website.default_website')),('parent_id','=',False)]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="is_mega_menu" eval="True"/>
        <field name="sequence">300</field>
        <field name="mega_menu_content" type="html">
            <section class="s_mega_menu_multi_menus pt32 pb32 bg-white">
                <div class="container">
                    <div class="row g-4 justify-content-center">
                        <div class="col-lg-2 text-center">
                            <div class="p-3 border rounded shadow-sm h-100">
                                <i class="fa fa-book fa-3x mb-3 text-primary"/>
                                <h6 class="fw-bold">Books</h6>
                                <p class="small text-muted mb-3">Access 50,000+ titles across all genres and formats.</p>
                                <a href="/book" class="btn btn-outline-primary btn-sm w-100 mt-auto">Browse</a>
                            </div>
                        </div>
                        <div class="col-lg-2 text-center">
                            <div class="p-3 border rounded shadow-sm h-100">
                                <i class="fa fa-book fa-3x mb-3 text-primary"/>
                                <h6 class="fw-bold">Borrow Request</h6>
                                <p class="small text-muted mb-3">Easy booking and renewal for all physical collections.</p>
                                <a href="/borrow_request" class="btn btn-outline-primary btn-sm w-100 mt-auto">Browse</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </field>
    </record>
</odoo>