    <template id="portal_borrow_request_menu" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'borrow_request'" t-attf-class="breadcrumb-item #{'active ' if not borrow_request else ''}">
                <a t-if="borrow_request" t-attf-href="/borrow_request">Borrow Request</a>
                <t t-else="">Borrow Request</t>
            </li>
            <li t-if="borrow_request" class="breadcrumb-item active">
                <t t-out="borrow_request.serial_number" t-if="borrow_request.serial_number != ''"/>
                <t t-else=""><em>Borrow Request</em></t>
            </li>
        </xpath>
    </template>

    <template id="portal_borrow_request" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Library Borrow Request</t>
                <t t-set="url" t-value="'/borrow_request'"/>
                <t t-set="text">See borrow request for library</t>
                <t t-set="config_card" t-value="True"/>
                <t t-set="icon" t-value="'/library_management/static/src/img/book.svg'"/>
            </t>
        </xpath>
    </template>

