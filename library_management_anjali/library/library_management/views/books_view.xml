<!--                                    </div>-->
<!--                                    <div class="col-7 text-start">-->
<!--                                        <strong><field name="name"/></strong>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                                <div class="row mb-1">-->
<!--                                    <div t-if="record.barcode.value" class="col-5 text-muted">-->
<!--                                        <strong>Barcode :</strong>-->
<!--                                    </div>-->
<!--                                    <div class="col-7 text-start">-->
<!--                                        <strong><field name="barcode"/></strong>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                                <div class="row mb-1">-->
<!--                                    <div t-if="record.borrow_price.value" class="col-5 text-muted">-->
<!--                                        <strong>Borrow Price :</strong>-->
<!--                                    </div>-->
<!--                                    <div class="col-7 text-start">-->
<!--                                        <strong><field name="borrow_price"/></strong>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                            </main>-->
<!--                        </div>-->
