            </kanban>
        </field>
    </record>

    <record model="ir.actions.act_window" id="library_management_books_action">
        <field name="name">Books</field>
        <field name="res_model">library.books</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem name="Library Management" id="library_management_root"/>
    <menuitem name="Books" id="library_management_books" parent="library_management_root"
              action="library_management_books_action" groups="library_management.group_project_librarian" sequence="1"/>
</odoo>