<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_test_model_list" model="ir.ui.view">
        <field name="name">custom.widget.list</field>
        <field name="model">custom.widget</field>
        <field name="arch" type="xml">
            <list string="Custom Records">
                <field name="name"/>
                <field name="status_text"/>
            </list>
        </field>
    </record>
    <record id="view_custom_test_model_form" model="ir.ui.view">
        <field name="name">custom.widget.form</field>
        <field name="model">custom.widget</field>
        <field name="arch" type="xml">
            <form string="Custom Widget Test">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="status_text" widget="hover_uppercase_widget"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_custom_test_model" model="ir.actions.act_window">
        <field name="name">My Custom Widget</field>
        <field name="res_model">custom.widget</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_custom_test_model"
              name="Premium Partner"
              parent="library_management_root"
              action="action_custom_test_model"/>
</odoo>
