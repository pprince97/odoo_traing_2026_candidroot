<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_website1" model="website">
        <field name="name">Custom Website 1</field>
        <field name="sequence">50</field>
    </record>
    <record id="custom_website2" model="website">
        <field name="name">Custom Website 2</field>
        <field name="sequence">60</field>
    </record>

    <template id="custom_home_multi_website" inherit_id="website.homepage" name="Multi-Website Homepage Override">
        <xpath expr="//div[@id='wrap']" position="replace">
            <t t-if="website.id == request.env.ref('website.default_website').id">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                        <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container">
                            <h1>Library Home Page</h1>
                        </div>
                    </section>
                    <section class="s_text_block pb40 pt40 bg-100" data-snippet="s_text_block">
                        <div class="container text-center">
                            <h2 class="display-4 fw-bold mb-3">Resource Library</h2>
                            <p class="lead text-muted mx-auto mb-4" style="max-width: 700px;">
                                Explore our curated repository of technical documentation, expert insights, and digital assets.
                                Everything you need to master our services is right at your fingertips.
                            </p>
                            <div class="row justify-content-center mb-5">
                                <div class="col-md-6">
                                    <div class="input-group input-group-lg shadow-sm">
                                        <input type="text" class="form-control border-0" placeholder="Search for guides, papers, or media..."/>
                                        <button class="btn btn-primary px-4" type="button">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="s_three_columns pt32 pb32">
                        <div class="container">
                            <div class="row">
                                <div class="col-lg-4 text-center mb-4">
                                    <div class="p-4 border rounded shadow-sm hover-elevate">
                                        <i class="fa fa-book fa-3x text-primary mb-3"></i>
                                        <h4>User Guides</h4>
                                        <p class="text-muted small">Step-by-step manuals for all core features.</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 text-center mb-4">
                                    <div class="p-4 border rounded shadow-sm hover-elevate">
                                        <i class="fa fa-file-code-o fa-3x text-primary mb-3"></i>
                                        <h4>API Docs</h4>
                                        <p class="text-muted small">Technical references for developers and integrators.</p>
                                    </div>
                                </div>
                                <div class="col-lg-4 text-center mb-4">
                                    <div class="p-4 border rounded shadow-sm hover-elevate">
                                        <i class="fa fa-video-camera fa-3x text-primary mb-3"></i>
                                        <h4>Video Tutorials</h4>
                                        <p class="text-muted small">Visual walkthroughs of our latest version 19 features.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
            <t t-if="website.id == request.env.ref('library_management.custom_website1').id">
                <div id="wrap" class="oe_structure">
                    <section class="s_title pt48 pb48 bg-200">
                        <div class="container">
                            <h1>Welcome to Custom Website 1</h1>
                        </div>
                    </section>
                </div>
            </t>
            <t t-elif="website.id == request.env.ref('library_management.custom_website2').id">
                <div id="wrap" class="oe_structure">
                    <section class="s_banner pt48 pb48 bg-200">
                        <div class="container">
                            <h1>Welcome to Custom Website 2</h1>
                        </div>
                    </section>
                </div>
            </t>
            <t t-else="">
                <div id="wrap" class="oe_structure oe_empty"/>
            </t>
        </xpath>
    </template>

    <template id="contactus_layout_inherited" inherit_id="website.contactus" name="Custom Contact Form">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty bg-100">
                <section class="s_title pt64 pb40">
                    <div class="container text-center">
                        <h1 class="display-4 fw-bold">Let's Connect</h1>
                        <p class="lead text-muted mx-auto" style="max-width: 600px;">
                            Have a question about our library services or students?
                            Drop us a message and we'll get back to you within 24 hours.
                        </p>
                    </div>
                </section>
                <section class="pb64">
                    <div class="container">
                        <div class="row g-0 shadow-lg rounded-4 overflow-hidden bg-white">
                            <div class="col-lg-4 bg-primary p-5 text-white">
                                <h3 class="fw-bold mb-4">Contact Information</h3>
                                <ul class="list-unstyled">
                                    <li class="mb-4 d-flex align-items-start">
                                        <i class="fa fa-map-marker mt-1 me-3 opacity-75"/>
                                        <span>123 University Lane,<br/>Knowledge City, 56001</span>
                                    </li>
                                    <li class="mb-4 d-flex align-items-center">
                                        <i class="fa fa-phone me-3 opacity-75"/>
                                        <span>+91 98765 43210</span>
                                    </li>
                                    <li class="mb-4 d-flex align-items-center">
                                        <i class="fa fa-envelope me-3 opacity-75"/>
                                        <span>info@odoo19library.com</span>
                                    </li>
                                </ul>
                                <div class="mt-5 pt-5 border-top border-white-50">
                                    <h6 class="small text-uppercase fw-bold opacity-75">Follow Us</h6>
                                    <div class="d-flex gap-3 mt-3">
                                        <a href="#" class="text-white"><i class="fa fa-facebook fa-lg"/></a>
                                        <a href="#" class="text-white"><i class="fa fa-twitter fa-lg"/></a>
                                        <a href="#" class="text-white"><i class="fa fa-linkedin fa-lg"/></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8 p-5">
                                <span class="d_website_form_send_success d-none">
                                    <div class="alert alert-success">Your message has been sent successfully!</div>
                                </span>
                                <div class="p-5">
                                    <form action="/website/form/" method="post" enctype="multipart/form-data"
                                          class="o_mark_required s_website_form"
                                          data-mark="*"
                                          data-model_name="crm.lead"
                                          data-success-mode="redirect"
                                          data-success-page="/thank-you">

                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="redirect" value="/thank-you"/>
                                        <input type="hidden" name="name" value="Library Contact Form Lead"/>

                                        <div class="s_website_form_rows row g-3">
                                            <div class="col-md-6 mb-3 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label small fw-bold">Full Name</label>
                                                <input type="text" name="contact_name" class="form-control s_website_form_input border-0 bg-light p-3" required="1" placeholder="Enter your name"/>
                                            </div>
                                            <div class="col-md-6 mb-3 s_website_form_field" data-type="email" data-name="Field">
                                                <label class="form-label small fw-bold">Email Address</label>
                                                <input type="email" name="email_from" class="form-control s_website_form_input border-0 bg-light p-3" required="1" placeholder="email@example.com"/>
                                            </div>
                                            <div class="col-12 mb-3 s_website_form_field" data-type="tel" data-name="Field">
                                                <label class="form-label small fw-bold">Phone Number</label>
                                                <input type="tel" name="phone" class="form-control s_website_form_input border-0 bg-light p-3" placeholder="+1 123 456 7890"/>
                                            </div>
                                            <div class="col-12 mb-3 s_website_form_field" data-type="text" data-name="Field">
                                                <label class="form-label small fw-bold">Message</label>
                                                <textarea name="description" rows="5" class="form-control s_website_form_input border-0 bg-light p-3" required="1" placeholder="How can we help?"></textarea>
                                            </div>
                                            <div class="col-12 text-end d-flex align-items-center justify-content-end">
                                                <span id="o_website_form_result" class="me-3"></span>
                                                <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm o_website_form_send">
                                                    Send Message <i class="fa fa-paper-plane ms-2 small"/>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

</odoo>