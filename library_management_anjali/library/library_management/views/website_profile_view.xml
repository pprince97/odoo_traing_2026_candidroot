<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="wesite_profile_custom" inherit_id="library_management.students_template">
        <xpath expr="//div[hasclass('row')]" position="before">
            <a role="button" href="/student/profile" class="btn btn-primary mt-3"><i class="fa fa-user-plus me-2"/>Create Student</a>
        </xpath>
    </template>
    <template id="student_profile_template" name="Student Profile Form">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-primary text-white p-3">
                                <h3 class="mb-0"><i class="fa fa-user-circle me-2"/>Student Profile Registration</h3>
                            </div>
                            <div class="card-body p-4">
                                <form id="student_form" class="needs-validation">
                                    <div class="row g-4">
<!--                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>-->
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">Full Name</label>
                                            <input type="text" id="name" name="name" class="form-control shadow-none" placeholder="John Doe" required="1"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">Email Address</label>
                                            <input type="email" id="email" name="email" class="form-control shadow-none" placeholder="john@example.com" required="1"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold d-block">Gender</label>
                                            <div class="mt-2">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="gender" id="gender_male" value="male" required="1"/>
                                                    <label class="form-check-label" for="gender_male">Male</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="gender" id="gender_female" value="female" required="1" checked="1"/>
                                                    <label class="form-check-label" for="gender_female">Female</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label fw-bold">Upload Student Document (PDF)</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="fa fa-file-pdf-o"/></span>
                                                <input type="file" name="file_data" id="file_input" class="form-control shadow-none"/>
                                            </div>
                                            <div id="file_error" class="text-danger mt-1 fw-bold" style="display:none;"></div>
                                            <small class="text-muted">Maximum file size: 10MB</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">Phone Number</label>
                                            <input type="tel" id="phone" name="phone" class="form-control shadow-none" placeholder="+1 234 567 890"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold">Zip Code</label>
                                            <input type="text" name="zip" id="zip" class="form-control shadow-none" placeholder="10001"/>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-bold">Street Address</label>
                                            <textarea name="address" id="address" class="form-control shadow-none" rows="2" placeholder="123 Odoo Street..."></textarea>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold">Country</label>
                                            <select id="country_id" name="country_id" class="form-select shadow-none">
                                                <option value="">Select Country...</option>
                                                <t t-foreach="countries" t-as="c">
                                                    <option t-att-value="c.id"><t t-esc="c.name"/></option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold">State</label>
                                            <select id="state_id" name="state_id" class="form-select shadow-none" disabled="1">
                                                <option value="">Select State...</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold">City</label>
                                            <div id="city_wrapper">
                                                <input type="text" name="city_text" id="city_field" class="form-control shadow-none" placeholder="Enter City"/>
                                            </div>
                                        </div>
                                        <div class="col-12 pt-3">
                                            <button type="submit" id="submit_profile_btn" class="btn btn-primary btn-lg w-100 shadow-sm">
                                                <i class="fa fa-save me-2"/>Create Profile
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>