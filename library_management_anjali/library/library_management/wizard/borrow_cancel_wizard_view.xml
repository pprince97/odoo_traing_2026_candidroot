<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="borrow_cancel_wizard" model="ir.ui.view">
        <field name="name">borrow.cancel.wizard.form</field>
        <field name="model">borrow.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="serial_number" invisible="1"/>
                    <field name="cancellation_reason"/>
                </group>
                <footer>
                    <button string="Submit" name="cancel_borrow" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>