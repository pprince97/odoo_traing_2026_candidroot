<record id="library_management_jui.model_library_books" model="ir.model">
  <field name="website_form_access">True</field>
</record>
<function model="ir.model.fields" name="formbuilder_whitelist">
            <value>library.books</value>
            <value eval="[
                'name',
                'description',
                'barcode',
                'state',
                'category',
                'stock',
                'cover_image',
                'borrow_price',
                'maximum_day_limit',
            ]"/>
        </function>
    <template id="library_management_jui.book" name="Books">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <section class="title mb-5">
                        <span class="bg-image d-flex pt-4 pb-4" style="background-image: url('library_management_jui/static/src/image/menu_bg.jpg');background-position: 50% 0;">
                        <div class="container">
                            <h1 class="text-white">Book</h1>
                        </div>
                        </span>
                    </section>
                    <section class="body mt-5 mb-5">
                        <div class="container text-center">
                            <p class="fs-5">Sorry, you are not eligible to access this page.</p>
                        </div>
                        <div class="justify-content-center mt-2 d-flex"><a href="/" class="fs-5">Home</a></div>
                    </section>
                </div>
            </div>
        </t>
    </template>

