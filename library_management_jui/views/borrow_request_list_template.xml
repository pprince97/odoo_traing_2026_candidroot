<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="borrow_request_list_template" name="Borrow request List">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty mb-5">
            <section class="title mb-5">
                <span class="bg-image d-flex pt-4 pb-4" style="background-image: url('library_management_jui/static/src/image/menu_bg.jpg');background-position: 50% 0;">
                <div class="container">
                    <h1 class="text-white">Borrow Requests</h1>
                </div>
                </span>
            </section>

            <div class="container mt-3 mb-5">
                <div class="container mt-2">
                    <div class="container mt-2 mb-4">
                        <div class="row">
                            <div class="col-md-6 ">
                                <h3 class="mb-4">Borrow Requests</h3>
                            </div>
                            <div class="col-md-6 mt-2 text-end" groups="library_management_jui.library_group_librarian">
                                <a href="/create_borrow_request" role="button" class="btn btn-primary s_website_form_send">Create Borrow Request
                                </a>
                            </div>
                        </div>
                    </div>

                <div class="table-responsive shadow-sm rounded border">
                    <table class="table table-hover mb-0 bg-white">
                        <thead class="table-light border-bottom text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Serial No</th>
                                <th>Student</th>
                                <th>Librarian</th>
                                <th>Issue Date</th>
                                <th>Return Date</th>
                                <th class="text-end">Fine</th>
                                <th class="text-end">Total</th>
                                <th class="text-center pe-4">Status</th>
                                <th>Borrow request lines</th>
                                <th>Canceled Date</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 'docs' comes from your controller dictionary -->
                            <t t-foreach="docs" t-as="doc">
                                <tr class="position-relative clickable-row" style="cursor: pointer;">
                                    <td class="ps-4 align-middle font-weight-bold">
                                        <!-- Dynamic link using the record ID -->
                                        <a t-attf-data-bs-target="#borrow_request_#{doc.id}" href="#" class="stretched-link text-decoration-none text-reset" data-bs-toggle="modal">
                                            <t t-out="doc.serial_number"/>
                                        </a>
                                    </td>
                                    <td class="align-middle" t-out="doc.student_id.name"/>
                                    <td class="align-middle" t-out="doc.librarian_id.name"/>
                                    <td class="align-middle">
                                        <span t-field="doc.issue_date" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td class="align-middle">
                                        <span t-field="doc.return_date" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td class="align-middle text-end">
                                        <span t-field="doc.fine_amount"
                                              t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                    <td class="align-middle text-end">
                                        <span t-field="doc.total_amount"
                                              t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                    <td class="align-middle text-center pe-4">
                                        <span t-attf-class="badge rounded-pill #{
                                            'bg-info text-dark' if doc.state == 'draft' else
                                            'bg-primary' if doc.state == 'issued' else
                                            'bg-success' if doc.state == 'returned' else 'bg-danger text-white'}">
                                            <!-- Displays the Selection Label (e.g., 'Draft') instead of the key ('draft') -->
                                            <t t-out="dict(doc._fields['state'].selection).get(doc.state)"/>
                                        </span>
                                    </td>
                                    <td>
                                        <t t-foreach="doc.borrow_request_lines_id" t-as="line">
                                            <span t-out="line.book_id.name"/>
                                        </t>
                                    </td>
<!--                                    <td><t t-out="len(doc.borrow_request_lines_id)"/> lines</td>-->
                                    <td class="align-middle text-danger">
                                        <t t-if="doc.state == 'canceled'">
                                            <span t-field="doc.canceled_date" t-options='{"widget": "date"}'/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="align-middle italic small text-muted">
                                        <t t-if="doc.state == 'canceled'">
                                            <span t-out="doc.cancellation_reason"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-foreach="docs" t-as="doc">
                    <div class="modal fade" t-attf-id="borrow_request_#{doc.id}" tabindex="-1">
                        <t t-call="library_management_jui.borrow_record_view_template">
                            <t t-set="record" t-value="doc"/>
                        </t>
                    </div>
                </t>
                </div>
            </div>
            <style>
                .clickable-row:hover { background-color: #f8f9fa !important; }
            </style>

            </div>
        </div>
    </t>
    </template>

    <template id="borrow_record_view_template" name="Borrow Record View Template">
        <div id="wrap" class="oe_structure">
            <t t-if="record.state != 'draft'">
                <t t-call="library_management_jui.view_borrow_record_template">
                    <t t-set="record" t-value="record"/>
                </t>
            </t>
            <t t-else="">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-body p-4">
                            <p>What action would you like to perform on this record?</p>
                            <div class="d-flex justify-content-center gap-2">
                                <!-- View Action -->
                                <a t-attf-href="/my/action/view/#{record.id}" class="btn btn-primary ">
                                    View Template
                                </a>

                                <!-- Redirect to Update Template -->
                                <a t-attf-href="/my/action/update/#{record.id}" class="btn btn-primary">
                                    Update Template
                                </a>

                                <!-- Redirect to Delete Template (or Confirmation Page) -->
                                <a t-attf-href="/my/action/delete/#{record.id}" class="btn btn-primary">
                                    Delete Template
                                </a>
                            </div>
                        </div>
                        <div class="modal-footer justify-content-start">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">close</button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <template id="view_borrow_record_page_template" name="Borrow Record View Template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <t t-call="library_management_jui.view_borrow_record_template">
                    <t t-set="record" t-value="record"/>
                </t>
            </div>
        </t>
    </template>

    <template id="view_borrow_record_template" name="Borrow Record View Template">
        <div id="wrap" class="oe_structure">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title m-3 mb-0 mt-0">Details:
                            <t t-out="record.serial_number"/>
                        </h5>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="container">
                            <h1 class="mt-4">Borrow Record Details</h1>

                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title">Serial Number:
                                        <span t-field="record.serial_number"/>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-3">Student ID</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.student_id.name"/>
                                        </div>

                                        <div class="col-sm-3">Librarian ID</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.librarian_id.name"/>
                                        </div>

                                        <div class="col-sm-3">State</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.state"/>
                                        </div>

                                        <div t-if="record.issue_date" class="col-sm-3">Issued Date</div>
                                        <div t-if="record.issue_date" class="col-sm-9">
                                            <span t-field="record.issue_date"/>
                                        </div>

                                        <div t-if="record.return_date" class="col-sm-3">Return Date</div>
                                        <div t-if="record.return_date" class="col-sm-9">
                                            <span t-field="record.return_date"/>
                                        </div>

                                        <div class="col-sm-3">Fine Amount</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.fine_amount"/>
                                        </div>

                                        <div class="col-sm-3">Total Amount</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.total_amount"/>
                                        </div>

                                        <div t-if="record.canceled_date" class="col-sm-3">Canceled Date</div>
                                        <div t-if="record.canceled_date" class="col-sm-9">
                                            <span t-field="record.canceled_date"/>
                                        </div>

                                        <div t-if="record.cancellation_reason" class="col-sm-3">Cancellation Reason</div>
                                        <div t-if="record.cancellation_reason" class="col-sm-9">
                                            <span t-field="record.cancellation_reason"/>
                                        </div>

                                    </div>

                                    <h6>Borrowed Items:</h6>
                                    <t t-if="record.borrow_request_lines_id">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Book</th>
                                                    <th>Quantity</th>
                                                    <th>Amount Per Unit</th>
                                                    <th>Issue Date</th>
                                                    <th>Return Date</th>
                                                    <th>Issue Days</th>
                                                    <th>Fine Amount</th>
                                                    <th>Total Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="record.borrow_request_lines_id" t-as="line">
                                                    <tr>
                                                        <td>
                                                            <t t-out="line.book_id.name"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.quantity"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.amount_per_unit"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.issue_date"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.return_date"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.issue_days"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.fine_amount"/>
                                                        </td>
                                                        <td>
                                                            <t t-out="line.total_amount" sum="Total Amount"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <p>No items borrowed.</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-start m-3">
                        <button type="button" class="btn btn-secondary"><a href="/borrow_request">close</a></button>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="update_borrow_record_template" name="Borrow Record Update Template">
        <t t-call="website.layout">
        <div id="wrap" class="oe_structure">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title m-3 mb-0 mt-0">Details:
                            <t t-out="record.serial_number"/>
                        </h5>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="container">
                            <h1 class="mt-4">Update Borrow Record</h1>
                            <div class="modal-content border-0 shadow-lg">
                                <form action="/borrow_request/update" method="post" class="container mt-3 p-4">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="request_id" t-att-value="record.id"/>

                                    <!-- Header / Title Area -->
                                    <div class="border-bottom pb-2 mb-4 d-flex justify-content-between align-items-center">
                                        <h4 class="mb-0">Record: <span t-esc="record.serial_number" class="text-primary"/></h4>

                                        <!-- Editable State Selection -->
                                        <div class="btn-group shadow-sm">
                                            <t t-foreach="request.env['library.borrow.request']._fields['state'].selection" t-as="option">
                                                <input type="radio" class="btn-check" name="state"
                                                       t-att-id="'state_' + option[0]"
                                                       t-att-value="option[0]"
                                                       t-att-checked="option[0] == record.state"/>
                                                <label t-attf-class="btn btn-sm btn-outline-secondary px-3" t-att-for="'state_' + option[0]">
                                                    <t t-esc="option[1]"/>
                                                </label>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- Main Content Grid -->
                                    <div class="row g-4">
                                        <!-- EDITABLE: Student -->
                                        <div class="col-md-6 border-end">
                                            <label class="form-label text-muted small fw-bold mb-1">Student</label>
                                            <select name="student_id" class="form-select form-select-sm border-secondary-subtle shadow-sm">
                                                <t t-foreach="request.env['res.partner'].sudo().search([('is_student','=',True)])" t-as="student">
                                                    <option t-att-value="student.id" t-att-selected="student.id == record.student_id.id">
                                                        <t t-esc="student.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>

                                        <!-- READONLY: Librarian -->
                                        <div class="col-md-6 ps-md-4">
                                            <label class="text-muted small fw-bold mb-1">Assigned Librarian</label>
                                            <div class="text-dark"><t t-esc="record.librarian_id.name"/></div>
                                            <input type="hidden" name="librarian_id" t-att-value="record.librarian_id.id"/>
                                        </div>

                                        <!-- READONLY: Other Dates/Reasons (Visible only if they exist) -->
                                        <div t-if="record.state == 'cancelled'" class="col-md-12 mt-3">
                                            <label class="text-muted small fw-bold mb-1 text-danger">Cancellation Reason</label>
                                            <textarea name="cancellation_reason"
                                                      class="form-control form-control-sm border-danger-subtle shadow-sm"
                                                      rows="2"
                                                      required="1"><t t-esc="record.cancellation_reason"/></textarea>
                                            <small class="text-muted italic">Please provide a reason for cancelling this request.</small>
                                        </div>

                                        <t t-set="available_books" t-value="request.env['library.books'].sudo().search([('state','=','published')])"/>

                                        <!-- Line Items Table -->
                                        <div class="col-12 mt-4">
                                            <h6 class="border-bottom pb-2">Borrowed Items</h6>
                                            <table class="table table-sm table-borderless mt-2 align-middle">
                                                <thead class="text-muted small text-uppercase">
                                                    <tr>
                                                        <th style="width: 40%;">Book</th>
                                                        <th class="text-center">Quantity</th>
                                                        <th class="text-center">Issue date</th>
                                                        <th class="text-center">Return date</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="record.borrow_request_lines_id" t-as="line">
                                                        <tr>
                                                            <td>
                                                                <input type="hidden" name="line_ids" t-att-value="line.id"/>
                                                                <select t-attf-name="line_book_id_{{line.id}}" class="form-select form-select-sm">
                                                                    <t t-foreach="available_books" t-as="book">
                                                                        <option t-att-value="book.id" t-att-selected="book.id == line.book_id.id">
                                                                            <t t-esc="book.name"/>
                                                                        </option>
                                                                    </t>
                                                                </select>
                                                            </td>
                                                            <td><input type="number" t-attf-name="line_qty_{{line.id}}" class="form-control form-control-sm text-center" t-att-value="line.quantity"/></td>
                                                            <td><input type="date" t-attf-name="line_issue_{{line.id}}" class="form-control form-control-sm" t-att-value="line.issue_date"/></td>
                                                            <td><input type="date" t-attf-name="line_return_{{line.id}}" class="form-control form-control-sm" t-att-value="line.return_date"/></td>
                                                            <td class="text-end"><a t-attf-href="/record/line/delete/#{line.id}" class="btn btn-sm text-danger"><i class="fa fa-trash"/></a></td>
                                                        </tr>
                                                    </t>
                                                    <tr class="table-info-subtle border-top-2">
                                                        <td>
                                                            <select name="new_book_id" class="form-select form-select-sm border-primary-subtle">
                                                                <option value="">Select Book to add...</option>
                                                                <t t-foreach="record.env['library.books'].sudo().search([('state','=','published')])" t-as="book">
                                                                    <option t-att-value="book.id"><t t-esc="book.name"/></option>
                                                                </t>
                                                            </select>
                                                        </td>
                                                        <td><input type="number" name="new_qty" value="1" class="form-control form-control-sm text-center border-primary-subtle"/></td>
                                                        <td><input type="date" name="new_issue_date" class="form-control form-control-sm border-primary-subtle"/></td>
                                                        <td><input type="date" name="new_return_date" class="form-control form-control-sm border-primary-subtle"/></td>
                                                        <td class="text-center">
                                                            <button type="submit" name="btn_action" value="add_line" class="btn btn-sm btn-primary">
                                                                Add
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="modal-footer border-0 px-0 mt-4">
                                        <button type="submit" name="btn_action" value="save_all" class="btn btn-primary px-4">Update Record</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-start m-3">
                        <button type="button" class="btn btn-secondary"><a href="/borrow_request">close</a></button>
                    </div>
                </div>
            </div>
        </div>
        </t>
    </template>

    <record id="custom_menu_book_requests" model="website.menu">
        <field name="name">Borrow requests</field>
        <field name="url">/borrow_request</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">110</field>
        <field name="group_ids"  eval="[(4, ref('library_management_jui.library_group_librarian'))]"/>
    </record>
</odoo>