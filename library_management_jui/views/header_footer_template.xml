<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="footer_custom_library" inherit_id="website.footer_custom" name="Default" active="True">
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-attf-class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//footer[@id='bottom']" position="after">
            <div id="footer" class="oe_structure oe_structure_solo border text-break bg-primary p-3 bg-opacity-25">
                <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-6 pt24 pb24">
                                <h5>Useful Links</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/book">Add Book</a></li>
                                    <li><a href="/booklist">Book Catalog</a></li>
                                    <li><a href="/contactus">Contact us</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-6 pt24 pb24">
                                <h5>About us</h5>
                                <p>Welcome to our digital library, your all-in-one hub for exploring books and managing your reading list.
                                <br/><br/>Whether you're a student looking for research papers or a book lover hunting for your next favorite novel, our platform makes it easy to search the catalog, reserve titles, and track your due dates online.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
