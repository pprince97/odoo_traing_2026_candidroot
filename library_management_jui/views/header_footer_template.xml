    <template id="library_management_jui.replacedheader" inherit_id="website.template_header_default" active="True">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//header" position="after">
            <header>
                <nav id="o_main_nav" t-attf-class="navbar pt24 pb24 navbar-expand-lg o_main_nav #{header_content_width} p-0">
                <div class="container-fluid">
                    <a class="navbar-brand" href="#">
                        <img src="/library_management_jui/static/src/image/logo.png"
                             alt="Library Logo"
                             width="30"
                             height="30"
                             class="d-inline-block m-2"/>
                    </a>
                    <!-- Navigation Menu -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                            <t t-call="website.submenu">
                                <t t-set="item_class" t-value="'nav-item'"/>
                                <t t-set="link_class" t-value="'nav-link text-black'"/>
                            </t>
                        </t>
                    </ul>

                    <!-- Right Side Icons/Buttons -->
                    <ul class="navbar-nav align-items-center gap-2 flex-shrink-0 justify-content-end ps-3">
                        <!-- Sign In -->
                        <t t-call="portal.placeholder_user_sign_in">
                            <t t-set="_link_class" t-value="_additional_btn_color or 'o_nav_link_btn nav-link border px-3'"/>
                        </t>

                        <!-- User Dropdown -->
                        <t t-call="portal.user_dropdown">
                            <t t-set="_user_name" t-value="True"/>
                            <t t-set="_item_class" t-value="'nav-item dropdown'"/>
                            <t t-set="_link_class" t-value="(_additional_btn_color or 'nav-link') + ' border-0'"/>
                            <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                        </t>
                    </ul>
                </div>
            </nav>
            </header>
        </xpath>
    </template>
</odoo>