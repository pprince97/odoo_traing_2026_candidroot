<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--Admin-->

        <record id="librarian_kanban" model="ir.ui.view">
            <field name="name">Librarian</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="name"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="gender"/>
                                </div>
                            </div>
                            <div>
                               <field name="email"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="librarian_form" model="ir.ui.view">
            <field name="name">Librarian</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Form View">

                    <sheet>
                        <div name="button_box" position="inside">
                            <button name="borrow_request_by_librarian"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-list">
                                <field name="borrow_request_count" string="Borrow Request" widget="statinfo"/>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="gender"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Librarian-->

        <record id="librarian_librarian_kanban" model="ir.ui.view">
            <field name="name">Librarian</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile" create="0">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="name"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="gender"/>
                                </div>
                            </div>
                            <div>
                               <field name="email"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="librarian_librarian_form" model="ir.ui.view">
            <field name="name">Librarian</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Form View" create="0">

                    <sheet>
                        <div name="button_box" position="inside">
                            <button name="borrow_request_by_librarian"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-list">
                                <field name="borrow_request_count" string="Borrow Request" widget="statinfo"/>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="gender"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!--Admin-->

        <record id="library_librarian_action_id" model="ir.actions.act_window">
            <field name="name">Librarian</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'default_is_librarian':1}</field>
            <field name="domain">[('is_librarian','=','1')]</field>
        </record>

        <record model="ir.actions.act_window.view" id="kanban_librarian_action">
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="librarian_kanban"/>
            <field name="act_window_id" ref="library_librarian_action_id"/>
        </record>

        <record model="ir.actions.act_window.view" id="form_librarian_action">
            <field name="view_mode">form</field>
            <field name="view_id" ref="librarian_form"/>
            <field name="act_window_id" ref="library_librarian_action_id"/>
        </record>

        <!--Librarian-->

        <record id="library_librarian_librarian_action_id" model="ir.actions.act_window">
            <field name="name">Librarian</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'default_is_librarian':1}</field>
            <field name="domain">[('is_librarian','=','1'),('user_id','=',uid)]</field>
        </record>

        <record model="ir.actions.act_window.view" id="kanban_librarian_librarian_action">
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="librarian_librarian_kanban"/>
            <field name="act_window_id" ref="library_librarian_librarian_action_id"/>
        </record>

        <record model="ir.actions.act_window.view" id="form_librarian_librarian_action">
            <field name="view_mode">form</field>
            <field name="view_id" ref="librarian_librarian_form"/>
            <field name="act_window_id" ref="library_librarian_librarian_action_id"/>
        </record>

        <menuitem id="library_librarian_id" name="Librarian" parent="library_management_jui.library_management_id" action="library_librarian_librarian_action_id" groups="library_management_jui.library_group_librarian_librarian"/>
        <menuitem id="library_librarian_only_id" name="Librarian" parent="library_management_jui.library_management_id" action="library_librarian_action_id" groups="library_management_jui.library_group_admin"/>
    </data>
</odoo>