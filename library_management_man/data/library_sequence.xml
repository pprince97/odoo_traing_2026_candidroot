<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
<!--        Book Barcode Sequence-->
        <record id="book_sequence" model="ir.sequence">
            <field name="name">Book Sequence</field>
            <field name="code">book.sequence</field>
            <field name="prefix">LB</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

           <record id="student_sequence" model="ir.sequence">
            <field name="name">Student Sequence</field>
            <field name="code">student.sequence</field>
            <field name="prefix">LS</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

           <record id="librarian_sequence" model="ir.sequence">
            <field name="name">Librarian Sequence</field>
            <field name="code">librarian.sequence</field>
            <field name="prefix">LL</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="borrow_request_sequence" model="ir.sequence">
            <field name="name">Borrow Request Sequence</field>
            <field name="code">request.sequence</field>
            <field name="prefix">LBR</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>