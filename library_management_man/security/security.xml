<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--   Group Category   -->
         <record model="ir.module.category" id="module_category_library_management">
            <field name="name">Library Management</field>
            <field name="sequence">5</field>
        </record>

        <!-- Group Privilege        -->
         <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Roles</field>
            <field name="sequence">55</field>
            <field name="category_id" ref="library_management_man.module_category_library_management"/>
        </record>

        <!--  Groups  -->
        <record id="group_library_student" model="res.groups">
            <field name="name">Students</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <record id="group_library_librarian" model="res.groups">
            <field name="name">Librarian</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('library_management_man.group_library_student'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <record id="group_library_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('library_management_man.group_library_librarian'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <!--     RECORD RULES     -->

