<!--         View Only your Own Request and your Own data-->
<!--          Borrow Request-->
         <record id="student_borrow_book_request" model="ir.rule">
            <field name="name">View Only Own Request</field>
            <field name="model_id" ref="model_library_borrow_request"/>
            <field name="domain_force">[('student_id', '=', user.name),]</field>
            <field name="groups" eval="[(4, ref('library_management_man.group_library_student'))]"/>
        </record>

         <record id="librarian_borrow_book_request" model="ir.rule">
            <field name="name">View Only Own Request</field>
            <field name="model_id" ref="model_library_borrow_request"/>
            <field name="domain_force">[('librarian_id', '=', user.name)]</field>
            <field name="groups" eval="[(4, ref('library_management_man.group_library_librarian'))]"/>
        </record>

        <record id="student_borrow_book_request_librarian" model="ir.rule">
            <field name="name">View Only Own Request</field>
            <field name="model_id" ref="model_library_borrow_request"/>
            <field name="domain_force">[(1, '=', 1),]</field>
            <field name="groups" eval="[(4, ref('library_management_man.group_library_admin'))]"/>
        </record>

<!--        student data-->
        <record id="student_own_data" model="ir.rule">
            <field name="name">View Only Own Request</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('name', '=', user.name),]</field>
            <field name="groups" eval="[(4, ref('library_management_man.group_library_student'))]"/>
        </record>

         <record id="librarian_own_data" model="ir.rule">
            <field name="name">View Only Own Request</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|',('name', '=', user.name),('student_code','!=', False)]</field>
            <field name="groups" eval="[(4, ref('library_management_man.group_library_librarian'))]"/>
        </record>

        <record id="student_own_data_librarian" model="ir.rule">
            <field name="name">View Only Own Request</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1),]</field>
            <field name="groups" eval="[(4, ref('library_management_man.group_library_admin'))]"/>
        </record>

