<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="library_management_man.BinaryFieldHistory" t-inherit="web.BinaryField" t-inherit-mode="extension">
       <xpath expr="//button[hasclass('o_clear_file_button')]" position="after">
            <button
                class="btn btn-link btn-sm lh-1 fa fa-history o_history_file_button"
                data-tooltip="History"
                aria-label="History"
                t-on-click="onHistoryClick"
            />
        </xpath>
    </t>
</templates>


