<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="book_history_list" model="ir.ui.view">
            <field name="name">book_history.list</field>
            <field name="model">book.history</field>
            <field name="arch" type="xml">
                <list>
                    <field name="file_name"/>
                    <field name="file"/>
                    <field name="upload_date"/>
                    <field name="book_id"/>
                </list>
            </field>
        </record>

        <record id="book_history_form" model="ir.ui.view">
            <field name="name">book_history.form</field>
            <field name="model">book.history</field>
            <field name="arch" type="xml">
                <form name="form_view">
                    <sheet>
                        <group>
                            <field name="file_name"/>
                            <field name="file"/>
                            <field name="upload_date"/>
                            <field name="book_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="book_history_search" model="ir.ui.view">
            <field name="name">book_history.search</field>
            <field name="model">book.history</field>
            <field name="arch" type="xml">
                <search>
                    <field name="file_name"/>
                    <field name="upload_date"/>
                </search>
            </field>
        </record>


        <record id="book_history_kanban" model="ir.ui.view">
            <field name="name">book_history.kanban</field>
            <field name="model">book.history</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <templates>
                        <t t-name="card">
                            <field class="fw-bold" name="file_name"/>
                            <field name="upload_date"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

