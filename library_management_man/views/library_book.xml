<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="library_book_list" model="ir.ui.view">
            <field name="name">library_book.list</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="barcode"/>
                    <field name="book_currency"/>
                    <field name="available_copies"/>
                    <field name="stock"/>
                    <field name="borrow_price"/>
                    <field name="maximum_day_limit"/>
                </list>
            </field>
        </record>

        <record id="library_book_form" model="ir.ui.view">
            <field name="name">library_book.form</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <form name="form_view">
                    <header>

                        <button string="Unpublished"
                                name="unpublished_book"
                                type="object"
                                class="oe_highlight"
                                groups="library_management_man.group_library_librarian"
                                invisible="state in ['unpublished']"
                        />

                        <button string="Published"
                                name="published_book"
                                type="object"
                                class="oe_highlight"
                                groups="library_management_man.group_library_librarian"
                                invisible="state in ['published']"
                        />

                        <field name="state" widget="statusbar"
                               statusbar_visible="published,unpublished"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" string="Available Books"
                                    widget="statinfo" icon="fa-star">
                                <field name="remaining_copies" string="Available Books" widget="statinfo"/>
                            </button>
                            <button type="object" string="History of Borrowed"
                                    widget="statinfo" icon="fa-star" name="history_of_borrow_book"
                                    groups="library_management_man.group_library_librarian">
                                <field name="borrow_lines_ids" string="History of Borrowed" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="barcode" readonly="True"/>
                                <field name="book_currency"/>
                                <field name="category_id"/>
                                <field name="available_copies"/>
                                <field name="fine_amount"/>
                                <!--                                <field name="remaining_copies"/>-->
                            </group>
                            <group>
                                <field name="stock"/>
                                <field name="borrow_price"/>
                                <field name="maximum_day_limit"/>
                                <field name="description"/>
                                <field name="cover_image" filename="image_name" />
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="library_book_search" model="ir.ui.view">
            <field name="name">library_book.search</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="barcode"/>
                    <field name="book_currency"/>
                </search>
            </field>
        </record>


        <record id="library_book_kanban" model="ir.ui.view">
            <field name="name">library_book.kanban</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <templates>
                        <t t-name="card">
                            <field class="fw-bold" name="name"/>
                            <field name="barcode"/>
                            <field name="book_currency"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="library_book_action">
            <field name="name">Books Details</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">list,form,search,kanban</field>
        </record>

        <menuitem name="Library Management" id="library_menu_root"/>

        <menuitem name="Books" id="library_book_menu" parent="library_menu_root"
                  action="library_book_action" groups="library_management_man.group_library_librarian"
        />

    </data>
</odoo>