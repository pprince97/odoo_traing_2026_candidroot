<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="library_borrow_request_list" model="ir.ui.view">
            <field name="name">library_borrow_request.list</field>
            <field name="model">library.borrow.request</field>
            <field name="arch" type="xml">
                <list>
                    <field name="serial_number" readonly="True"/>
                    <field name="student_id"/>
                    <field name="librarian_id"/>
                    <field name="issue_date"/>
                    <field name="return_date"/>
                </list>
            </field>
        </record>

        <record id="library_borrow_request_form" model="ir.ui.view">
            <field name="name">library_borrow_request.form</field>
            <field name="model">library.borrow.request</field>
            <field name="arch" type="xml">
                <form name="form_view">
                    <header>
                        <button string="Draft"
                                name="draft_request"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ['draft','issued','canceled']"
                        />

                        <button string="issued"
                                name="issue_request"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ['issued','returned','canceled']"
                        />

                        <button string="returned"
                                name="returned_request"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ['returned','canceled','draft']"
                        />
                        <button string="Canceled"
                                name="cancellation_request"
                                type="object"
                                class="oe_highlight"
                                invisible="state in ['issued','returned','canceled']"
                        />
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,canceled,issued,returned"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="serial_number" readonly="True"/>
                                <field name="student_id" domain="[('student_code','!=', False)]" readonly="state in ['issued','returned','canceled']"/>
                                <field name="librarian_id" domain="[('librarian_code','!=', False)]" readonly="state in ['issued','returned','canceled']"/>
                                <field name="issue_date" readonly="True"/>
                                <field name="return_date" readonly="True"/>
                            </group>
                            <group>
                                <field name="fine_amount" readonly="True"/>
                                <field name="total_amount" readonly="True"/>
                                <field name="canceled_date" readonly="True" invisible="state in ['issued','returned','draft']" />
                                <field name="cancellation_reason" readonly="True" invisible="state in ['issued','returned','draft']"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="borrow_lines" string="Borrow Request Lines">
                                <field name="borrow_request_line_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="library_borrow_request_search" model="ir.ui.view">
            <field name="name">library_borrow_request.search</field>
            <field name="model">library.borrow.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="serial_number" readonly="True"/>
                    <field name="student_id"/>
                    <field name="librarian_id"/>
                    <field name="issue_date"/>
                    <field name="return_date"/>
                </search>
            </field>
        </record>


        <record id="library_borrow_request_kanban" model="ir.ui.view">
            <field name="name">library_borrow_request.kanban</field>
            <field name="model">library.borrow.request</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <templates>
                        <t t-name="card">
                            <field class="fw-bold" name="serial_number"/>
                            <field name="student_id"/>
                            <field name="librarian_id"/>
                            <field name="issue_date"/>
                            <field name="return_date"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="library_borrow_request_action">
            <field name="name">Borrow Request Details</field>
            <field name="res_model">library.borrow.request</field>
            <field name="view_mode">list,form,search,kanban</field>
        </record>

        <menuitem name="Borrow Request" id="library_borrow_request_menu" parent="library_menu_root"
                  action="library_borrow_request_action"
        />

    </data>
</odoo>