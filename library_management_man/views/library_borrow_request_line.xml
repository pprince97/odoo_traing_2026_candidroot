<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="library_borrow_request_line_list" model="ir.ui.view">
            <field name="name">library_borrow_request_line.list</field>
            <field name="model">library.borrow.request.line</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="book_id"/>
                    <field name="quantity"/>
                    <field name="amount_per_unit"/>
                    <field name="issue_date"/>
                    <field name="return_date"/>
                    <field name="fine_amount" readonly="True" force_save="1"/>
                    <field name="total_amount" readonly="True" force_save="1" />
                    <field name="issue_days" readonly="True" force_save="1"/>
                </list>
            </field>
        </record>

        <record id="library_borrow_request_line_form" model="ir.ui.view">
            <field name="name">library_borrow_request_line.form</field>
            <field name="model">library.borrow.request.line</field>
            <field name="arch" type="xml">
                <form name="form_view">
                    <sheet>
                        <group>
                            <group>
                                <field name="book_id"/>
                                <field name="quantity"/>
                                <field name="amount_per_unit"/>
                                <field name="issue_date"/>
                                <field name="return_date"/>
                            </group>
                            <group>
                                <field name="fine_amount" />
                                <field name="total_amount" />
                                <field name="issue_days" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="library_borrow_request_line_search" model="ir.ui.view">
            <field name="name">library_borrow_request_line.search</field>
            <field name="model">library.borrow.request.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="book_id"/>
                    <field name="quantity"/>
                    <field name="amount_per_unit"/>
                    <field name="issue_date"/>
                    <field name="return_date"/>
                </search>
            </field>
        </record>


        <record id="library_borrow_request_line_kanban" model="ir.ui.view">
            <field name="name">library_borrow_request_line.kanban</field>
            <field name="model">library.borrow.request.line</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <templates>
                        <t t-name="card">
                            <field class="fw-bold" name="book_id"/>
                            <field name="quantity"/>
                            <field name="amount_per_unit"/>
                            <field name="issue_date"/>
                            <field name="return_date"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="library_borrow_request_line_action">
            <field name="name">Borrow Request Line Details</field>
            <field name="res_model">library.borrow.request.line</field>
            <field name="view_mode">list,form,search,kanban</field>
        </record>

        <menuitem name="Borrow Request Line" id="library_borrow_request_line_menu" parent="library_menu_root"
                  action="library_borrow_request_line_action" groups="library_management_man.group_library_librarian"
        />

    </data>
</odoo>