<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cancellation_request_wizard" model="ir.ui.view">
            <field name="name">Cancellation Request Wizard</field>
            <field name="model">cancellation.request</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                           <field name="cancellation_reason"/>
                            <footer>
                                <button name="canceled_process" string="Cancel" type="object" class="oe_highlight"/>
                                <button name="canceled_request" string="Done" type="object" class="oe_highlight"/>
                            </footer>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>