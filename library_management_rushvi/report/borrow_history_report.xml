<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_borrow_history_document">
        <t t-call="web.external_layout">
            <div class="row">
                <div class="col-12">
                    <strong>Start Date:</strong>
                    <span t-field="doc.start_date"/>
                    <br/>
                    <strong>End Date:</strong>
                    <span t-field="doc.end_date"/>
                     <br/>
                    <strong>Students:</strong>
                    <span t-field="doc.students_ids" t-if="doc.students_ids"/>
                    <span t-else="">All</span>
                    <br/>
                    <strong>Books:</strong>
                    <span t-field="doc.books_ids" t-if="doc.books_ids"/>
                    <span t-else="">All</span>
                </div>
            </div>
            <br/>
            <h3>Borrow History</h3>
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th class="text-start">Book</th>
                        <th class="text-center">Student</th>
                        <th class="text-center">Issue Date</th>
                        <th class="text-center">Return Date</th>
                        <th class="text-center">Final Amount Pay</th>
                        <th class="text-center">Issue Days</th>
                        <th class="text-end">Librarian</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="docs.get_history_records()" t-as="line">
                        <tr>
                            <td class="text-start">
                                <span t-field="line.book_id"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.borrow_request_id.student_id"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.borrow_request_id.issue_date"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.borrow_request_id.return_date"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.total_amount"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.issue_days"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.borrow_request_id.librarian_id"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>

    <template id="report_borrow_historys">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="library_management_rushvi.report_borrow_history_document"/>
            </t>
        </t>
    </template>

    <record id="report_borrow_history" model="ir.actions.report">
        <field name="name">Borrow History</field>
        <field name="model">wizard.reporting.books.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management_rushvi.report_borrow_historys</field>
        <field name="report_file">library_management_rushvi.report_borrow_historys</field>
        <field name="binding_model_id" ref="model_wizard_reporting_books_history"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
