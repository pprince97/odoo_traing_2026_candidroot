<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--   Group Category   -->
         <record model="ir.module.category" id="module_category_library_management">
            <field name="name">Library Management</field>
            <field name="sequence">1</field>
        </record>

        <!-- Group Privilage        -->
         <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="library_management_rushvi.module_category_library_management"/>
        </record>
.
        <!--  Groups  -->
        <record id="group_library_student" model="res.groups">
            <field name="name">Student</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <record id="group_library_librarian" model="res.groups">
            <field name="name">Librarian</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('library_management_rushvi.group_library_student'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <record id="group_library_admin" model="res.groups">
            <field name="name">Library Admin</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('library_management_rushvi.group_library_librarian'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

         <record model="res.groups" id="res_groups_privilege_library_menu">
            <field name="name">Librarian Menu</field>
        </record>

<!--        RECORD RULES           -->
        <record id="student_creation_student" model="ir.rule">
            <field name="name">student creation restriction for student</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('user_id',"=",user.id),('is_librarian','=',False)]</field>
            <field name="groups" eval="[(4, ref('library_management_rushvi.group_library_student'))]"/>
        </record>

         <record id="librarian_rule_view_self_student" model="ir.rule">
            <field name="name">Librarian view self and all users</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|',('is_librarian','=',False),('user_ids','!=',False)]</field>
            <field name="groups" eval="[(4, ref('library_management_rushvi.group_library_librarian')),(4,ref('base.group_erp_manager'))]"/>
             <field name="perm_read" eval="True"/>
        </record>

        <record id="admin_record_rule" model="ir.rule">
            <field name="name">Admin can view all students and librarians</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management_rushvi.group_library_admin'))]"/>
        </record>

<!--        For library_borrow_requests  -->
        <record id="student_librarian_borrow_reqeust" model="ir.rule">
            <field name="name">Students/Librarians can only view their own requests </field>
            <field name="model_id" ref="model_library_borrow_requests"/>
            <field name="domain_force">['|',('student_id','=',user.partner_id.id),('librarian_id','=',user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('library_management_rushvi.group_library_student')),(4, ref('library_management_rushvi.group_library_librarian'))]"/>
        </record>

        <record id="admin_borrow_request" model="ir.rule">
            <field name="name">admin can view all borrow_requests</field>
            <field name="model_id" ref="model_library_borrow_requests"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management_rushvi.group_library_admin'))]"/>
        </record>

    </data>
</odoo>