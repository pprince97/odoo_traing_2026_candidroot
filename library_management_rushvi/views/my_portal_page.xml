<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<!--   Borrow Request Detailed Page  -->
    <template id="borrow_requests_template_form" name="Borrow Request Portal View">
        <t t-call="portal.portal_layout">
            <div class="container py-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="text-primary mb-0">
                            Request #<span t-field="borrow_request.serial_number"/>
                        </h2>
                        <small class="text-muted">Librarian: <span t-field="borrow_request.librarian_id.name"/></small>
                    </div>
                    <div class="text-end">
                        <span t-attf-class="badge rounded-pill #{'bg-success' if borrow_request.state == 'returned' else 'bg-warning'} px-3 py-2">
                            <t t-esc="borrow_request.state.upper() if borrow_request.state else 'DRAFT'"/>
                        </span>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0">General Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 border-end">
                                <p><strong>Student:</strong> <span t-field="borrow_request.student_id.name"/></p>
                                <p><strong>Total Fine:</strong> <span t-field="borrow_request.fine_amount" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></p>
                            </div>
                            <div class="col-md-6 ps-md-4">
                                <p><strong>Issue Date:</strong> <span t-field="borrow_request.issue_date"/></p>
                                <p><strong>Return Date:</strong> <span t-field="borrow_request.return_date"/></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0">Borrowed Books
                        <span>
                            <button t-if="user.has_group('library_management_rushvi.group_library_librarian')" type="button" class="btn btn-primary"
                                data-bs-toggle="modal" data-bs-target="#newBorrowRequestLineModal">
                                <i class="fa fa-plus me-1"/> New Request Line
                            </button>
                        </span>
                        </h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Book</th>
                                    <th class="text-center">Qty</th>
                                    <th>Issue Date</th>
                                    <th>Return Date</th>
                                    <th class="text-center">Days</th>
                                    <th class="text-end pe-4">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="borrow_request.borrow_request_line_ids" t-as="line">
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold"><span t-field="line.book_id.name"/></div>
                                            <small class="text-muted">Fine/Day: <span t-field="line.fine_settings_amt"/></small>
                                        </td>
                                        <td class="text-center"><span t-field="line.quantity"/></td>
                                        <td><span t-field="line.issue_date"/></td>
                                        <td><span t-field="line.return_date"/></td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark"><t t-esc="line.issue_days"/> Days</span>
                                        </td>
                                        <td class="text-end pe-4 font-weight-bold">
                                            <span t-field="line.total_amount" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-white py-3">
                        <div class="row justify-content-end">
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal:</span>
                                    <span><span t-field="borrow_request.total_amount"/></span>
                                </div>
                                <div class="d-flex justify-content-between h5 text-primary">
                                    <strong>Grand Total:</strong>
                                    <strong><span t-field="borrow_request.total_amount"/></strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--  Borrow Request Line Modal    -->
            <div class="modal fade" id="newBorrowRequestLineModal" tabindex="-1" aria-labelledby="newBorrowRequestLineLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                     <form t-attf-action="/my/borrow-requests/#{borrow_request.id}/write" method="post">
                         <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="modal-header">
                                <h5 class="modal-title" id="newBorrowRequestLineLabel">Create New Borrow Request Line</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <!-- Book -->
                                    <div class="col-md-6 mb-3">
                                        <label for="book_id" class="form-label fw-bold">Select Book</label>
                                        <select name="book_id" class="form-select" required="1">
                                            <option value="">Choose</option>
                                            <!-- Fetches all book records -->
                                            <t t-foreach="request.env['library.books'].search([('state','=','published')])" t-as="book">
                                                <option t-att-value="book.id">
                                                    <t t-esc="book.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!-- Quantity  -->
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Quantity</label>
                                            <input type="number" name="quantity" class="form-control"/>
                                        </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="issue_date" class="form-label fw-bold">Issue Date</label>
                                        <input type="date" name="issue_date" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="return_date" class="form-label fw-bold">Expected Return Date</label>
                                        <input type="date" name="return_date" class="form-control" required="1"/>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Add Line</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>


<!--    Borrow Requests -->
    <template id="borrow_requests_template">
        <t t-call="portal.portal_layout">
            <div class="mt-1 container">
                <h3 class="d-flex justify-content-between align-items-center w-90">
                    <span>All Borrow Requests</span>
                    <span>
                        <button t-if="user.has_group('library_management_rushvi.group_library_librarian')"
                                type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#newBorrowRequestModal">
                            <i class="fa fa-plus me-1"/> New Request
                        </button>
                    </span>
                </h3>


                <table class="table">
                    <thead>
                        <th><b>Serial Number</b></th>
                        <th><b>Student</b></th>
                        <th><b>Librarian</b></th>
                        <th><b>State</b></th>
                        <th><b>Issued Date</b></th>
                        <th><b>Return date</b></th>
                        <th><b>Fine amount</b></th>
                        <th><b>Total amount</b></th>
                    </thead>
                    <t t-foreach="borrow_requests" t-as="borrow_request">
                        <tr>
                            <td><a t-attf-href="/my/borrow-requests/#{borrow_request.id}"><t t-esc="borrow_request.serial_number"/></a></td>
                            <td><t t-esc="borrow_request.student_id.name"/></td>
                            <td><t t-esc="borrow_request.librarian_id.name"/></td>
                            <td><t t-esc="borrow_request.state"/></td>
                            <td><t t-esc="borrow_request.issue_date"/></td>
                            <td><t t-esc="borrow_request.return_date"/></td>
                            <td><t t-esc="borrow_request.fine_amount"/></td>
                            <td><t t-esc="borrow_request.total_amount"/></td>
                        </tr>
                    </t>
                </table>
            </div>
            <!-- CREATE MODAL -->
            <div class="modal fade" id="newBorrowRequestModal" tabindex="-1" aria-labelledby="newBorrowRequestLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <form action="/my/borrow-requests/create" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="modal-header">
                                <h5 class="modal-title" id="newBorrowRequestLabel">Create New Borrow Request</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <!-- Student -->
                                    <div class="col-md-6 mb-3">
                                        <label for="student_id" class="form-label fw-bold">Select Student</label>
                                        <select name="student_id" class="form-select" required="1">
                                            <option value="">Choose </option>
                                            <!-- Fetches all student records -->
                                            <t t-foreach="request.env['res.partner'].search([('is_student','=',True)])" t-as="student">
                                                <option t-att-value="student.id">
                                                    <t t-esc="student.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!-- Librarian  -->
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold text-muted">Managed By (Librarian)</label>
                                            <input type="text" class="form-control bg-light" t-att-value="request.env.user.partner_id.name" readonly="1"/>
                                            <input type="hidden" name="librarian_id" t-att-value="request.env.user.partner_id.id"/>
                                        </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="issue_date" class="form-label fw-bold">Issue Date</label>
                                        <input type="date" name="issue_date" class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="return_date" class="form-label fw-bold">Expected Return Date</label>
                                        <input type="date" name="return_date" class="form-control" required="1"/>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Submit Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>


<!--    Breadcrumb   -->
    <template id="portal_borrow_request_menu" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'borrow_request'" t-attf-class="breadcrumb-item #{'active ' if not borrow_request else ''}">
                <a t-if="borrow_request" t-attf-href="/my/borrow-requests">Borrow Requests</a>
                <t t-else="">Borrow Requests</t>
            </li>
            <li t-if="borrow_request" class="breadcrumb-item active">
                <t t-out="borrow_request.serial_number"/>
            </li>
        </xpath>
    </template>

<!--    Borrow Request Card on My Account Page-->
    <template id="portal_my_home_custom" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Borrow Requests</t>
                <t t-set="url" t-value="'/my/borrow-requests'"/>
                <t t-set="text">View Your Borrow Requests</t>
                <t t-set="config_card" t-value="True"/>
                <t t-set="icon" t-value="'/library_management_rushvi/static/src/img/book-engineering-svgrepo-com.svg'"/>
            </t>
        </xpath>
    </template>
</odoo>
<!--data-oe-xpath="/t[1]/div[1]/a[1]/div[1]/img[1]"-->