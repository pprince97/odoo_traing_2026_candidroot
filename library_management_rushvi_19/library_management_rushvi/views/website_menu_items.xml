<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
 <record id="book_menu" model="website.menu">
     <field name="name">Library</field>
     <field name="url"></field>
     <field name="website_id" ref="website.default_website" />
     <field name="parent_id" model="website.menu" search="[('website_id','=',ref('website.default_website')),('parent_id','=',False)]"/>
     <field name="sequence">70</field>
    </record>

    <record id="book_menu1" model="website.menu">
        <field name="name">Books</field>
        <field name="url">/books</field>
<!--        <field name="website_id" ref="website.default_website" />-->
        <field name="parent_id" ref="book_menu" />
        <field name="sequence">80</field>
    </record>

    <record id="book_menu2" model="website.menu">
        <field name="name">Students</field>
        <field name="url">/students</field>
<!--        <field name="website_id" ref="website.default_website" />-->
        <field name="parent_id" ref="book_menu"/>
        <field name="sequence">90</field>
    </record>

    <record id="book_menu3" model="website.menu">
        <field name="name">Librarians</field>
        <field name="url">/librarians</field>
        <field name="website_id" ref="website.default_website" />
        <field name="parent_id" ref="book_menu"/>
        <field name="sequence">100</field>
        <field name="group_ids" eval="[(4,ref('library_management_rushvi.group_library_librarian'))]"/>
    </record>
 </odoo>