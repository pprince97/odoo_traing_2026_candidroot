<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">

    <record id="website_library1" model="website">
        <field name="name">Library 1</field>
        <field name="company_id" ref="base.main_company"/>
<!--        <field name="domain">localhost:8069</field>-->
        <field name="language_ids" eval="[(4, ref('base.lang_en'))]"/>
        <field name="default_lang_id" ref="base.lang_en"/>
        <field name="sequence">20</field>
    </record>

    <record id="website_library2" model="website">
        <field name="name">Library 2</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="language_ids" eval="[(4, ref('base.lang_en'))]"/>
        <field name="default_lang_id" ref="base.lang_en"/>
        <field name="sequence">30</field>
    </record>

    <template id="custom_home_multi_website" inherit_id="website.homepage" name="Multi-Website Homepage Override">
    <xpath expr="//div[@id='wrap']" position="replace">
        <t t-if="website.id == request.env.ref('library_management_rushvi.website_library1').id">
            <div id="wrap" class="oe_structure">
                <section class="s_title pt48 pb48 bg-200">
                    <div class="container">
                        <h6>Welcome to Custom Library 1</h6>
                    </div>
                </section>
            </div>
        </t>
        <t t-elif="website.id == request.env.ref('library_management_rushvi.website_library2').id">
            <div id="wrap" class="oe_structure">
                <section class="s_banner pt48 pb48 bg-200">
                    <div class="container">
                        <h6>Welcome to Custom Library 2</h6>
                    </div>
                </section>
            </div>
        </t>
        <t t-else="">
            <div id="wrap" class="oe_structure oe_empty"/>
        </t>
    </xpath>
</template>

</odoo>
