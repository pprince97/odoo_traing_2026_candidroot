<odoo>
    <data>

        <record model="ir.ui.view" id="librarian_kanban_view">
            <field name="name">res.users.inherit.librarian.kanban</field>
            <field name="model">res.users</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <kanban sample="1">
                    <templates>
                        <t t-name="card" class="flex-row">
                            <main class="ps-2">
                                <div class="mb-1">
                                    <field name="name" class="mb-0 fw-bold fs-5"/>
                                </div>
                                <div class="text-truncate">
                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                    <field name="email"/>
                                </div>
                                <div>
                                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                    <field name="phone"/>
                                </div>
                                <div>
                                    <field name="gender"/>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.ui.view" id="librarian_form_view">
            <field name="name">library.librarian.form.view</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group string="Librarian Details">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="gender"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_librarian">
            <field name="name">Librarian Action</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'librarian':'1'}</field>
            <field name="domain">[('is_student', '=', False)]</field>
        </record>

        <record id="action_librarian_kanban" model="ir.actions.act_window.view">
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="librarian_kanban_view"/>
            <field name="act_window_id" ref="action_librarian"/>
        </record>

        <record id="action_librarian_form" model="ir.actions.act_window.view">
            <field name="view_mode">form</field>
            <field name="view_id" ref="librarian_form_view"/>
            <field name="act_window_id" ref="action_librarian"/>
        </record>

    </data>
</odoo>
