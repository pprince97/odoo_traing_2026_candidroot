<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.library_management_smit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div>
                    <block title='Library Management' class='fine_amount' name="fine_amount_container">
                        <setting id="fine_amount" string="Fine Amount" help="Fine amount for delay in return.">
                            <field name="fine_amount" string="Fine Amount"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
