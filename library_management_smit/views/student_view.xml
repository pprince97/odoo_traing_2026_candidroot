<odoo>
    <data>

        <record model="ir.ui.view" id="student_kanban_view">
            <field name="name">res.users.inherit.student.kanban</field>
            <field name="model">res.users</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <kanban sample="1">
                    <templates>
                        <t t-name="card" class="flex-row">
                            <main class="ps-2">
                                <div class="mb-1">
                                    <field name="name" class="mb-0 fw-bold fs-5"/>
                                </div>
                                <div class="text-truncate">
                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                    <field name="email"/>
                                </div>
                                <div>
                                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                    <field name="phone"/>
                                </div>
                                <div>
                                    <field name="gender"/>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.ui.view" id="student_form_view">
            <field name="name">library.student.form.view</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_book_borrowed_history" type="object"
                                    class="oe_stat_button" icon="fa-id-card-o">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="book_borrowed_count"/>
                                    </span>
                                    <span class="o_stat_text">Book Borrowed Count</span>
                                </div>
                            </button>
                        </div>
                        <group string="Student Details">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="gender"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_student">
            <field name="name">Student Action</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'student':'1'}</field>
            <field name="domain">[('is_student', '=', True)]
            </field>
        </record>

        <record id="action_student_kanban" model="ir.actions.act_window.view">
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="student_kanban_view"/>
            <field name="act_window_id" ref="action_student"/>
        </record>

        <record id="action_student_form" model="ir.actions.act_window.view">
            <field name="view_mode">form</field>
            <field name="view_id" ref="student_form_view"/>
            <field name="act_window_id" ref="action_student"/>
        </record>

    </data>
</odoo>
