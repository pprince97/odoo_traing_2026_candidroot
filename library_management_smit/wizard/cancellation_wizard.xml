<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cancellation_wizard_view_form" model="ir.ui.view">
            <field name="name">cancellation.wizard.view.form</field>
            <field name="model">cancellation.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group name="Reason For Cancellation">
                            <field name="reason"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="wizard_cancel_create" string="Submit" type="object" class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
