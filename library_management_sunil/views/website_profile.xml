<odoo>

    <data>
        <record id="view_website_profile_list" model="ir.ui.view">
            <field name="name">website.profile.list</field>
            <field name="model">website.profile</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="city"/>
                </list>
            </field>
        </record>

        <record id="view_website_profile_form" model="ir.ui.view">
            <field name="name">website.profile.form</field>
            <field name="model">website.profile</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="city"/>
                            <field name="address"/>
                            <field name="zip_code"/>
                            <field name="pdf_file" widget="binary"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

     <record id="profile_action" model="ir.actions.act_window">
            <field name="name">profile</field>
            <field name="res_model">website.profile</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="profile_menu_root" name="Profile"
                  parent="menu_root"
                  action="profile_action"/>
    </data>
</odoo>