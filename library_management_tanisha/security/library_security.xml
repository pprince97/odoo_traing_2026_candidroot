<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <!-- Groups Category -->
    <record model="ir.module.category" id="library_management_groups_category">
        <field name="name">Library Management</field>
        <field name="sequence">1</field>
    </record>

    <!-- Groups Privilege -->
    <record model="res.groups.privilege" id="library_management_groups_privilege">
        <field name="name">Library</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="library_management_tanisha.library_management_groups_category"/>
    </record>

    <!-- Groups -->
    <record id="group_library_student" model="res.groups">
        <field name="name">Student</field>
        <field name="sequence">3</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="library_management_groups_privilege"/>
    </record>

    <record id="group_library_librarian" model="res.groups">
        <field name="name">Librarian</field>
        <field name="sequence">4</field>
        <field name="implied_ids" eval="[(4, ref('library_management_tanisha.group_library_student'))]"/>
        <field name="privilege_id" ref="library_management_groups_privilege"/>
    </record>

    <record id="group_library_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="sequence">5</field>
        <field name="implied_ids" eval="[(4, ref('library_management_tanisha.group_library_librarian'))]"/>
        <field name="privilege_id" ref="library_management_groups_privilege"/>
    </record>

    <!--   Borrow Requests  -->
    <record id="student_borrow_requests" model="ir.rule">
        <field name="name">Student Borrow Requests</field>
        <field name="model_id" ref="library_management_tanisha.model_library_borrow_request"/>
        <field name="domain_force">[('student_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('library_management_tanisha.group_library_student'))]"/>
    </record>

    <record id="librarian_borrow_requests" model="ir.rule">
        <field name="name">Librarian Borrow Requests</field>
        <field name="model_id" ref="library_management_tanisha.model_library_borrow_request"/>
        <field name="domain_force">[('librarian_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('library_management_tanisha.group_library_librarian'))]"/>
    </record>

    <record id="admin_borrow_requests" model="ir.rule">
        <field name="name">Admin Borrow Requests</field>
        <field name="model_id" ref="library_management_tanisha.model_library_borrow_request"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('library_management_tanisha.group_library_admin'))]"/>
    </record>

    <!--   Librarian Record  -->
    <record id="librarian_own_record" model="ir.rule">
        <field name="name">Librarian Own Record</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('|'),('is_student','=',True),('id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('library_management_tanisha.group_library_librarian'))]"/>
    </record>

    <record id="admin_librarian_records" model="ir.rule">
        <field name="name">Admin Librarian Records</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('library_management_tanisha.group_library_admin'))]"/>
    </record>

</odoo>