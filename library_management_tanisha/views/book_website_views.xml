<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="book_website_template" name="Book">
        <t t-call="website.layout">
            <div class="container">
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h3>Book Details</h3>
                    </div>
                    <div class="col-md-6 text-end">
                        <a href="/book" class="btn btn-primary">Register Book</a>
                    </div>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Barcode</th>
                            <th>State</th>
                            <th>Category</th>
                            <th>Available copies</th>
                            <th>Stock</th>
<!--                            <td>Borrow price</td>-->
                            <th>Max day limit</th>
                            <th>Description</th>
                            <th>Cover image</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="books" t-as="book">
                            <tr>
                                <td>
                                    <t t-if="book.name">
                                        <span t-field="book.name"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="book.barcode">
                                        <span t-field="book.barcode"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="book.state">
                                        <span t-field="book.state"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="book.category">
                                        <span t-field="book.category"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="book.available_copies">
                                        <span t-field="book.available_copies"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="book.stock">
                                        <span t-field="book.stock"/>
                                    </t>
                                </td>
<!--                                <td>-->
<!--                                    <t t-if="book.borrow_price">-->
<!--                                        <span t-field="book.borrow_price"/>-->
<!--                                    </t>-->
<!--                                </td>-->
                                <td>
                                    <t t-if="book.max_day_limit">
                                        <span t-field="book.max_day_limit"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="book.description">
                                        <span t-field="book.description"/>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="image_data_uri(book.cover_image)">
                                        <img t-att-src="image_data_uri(book.cover_image)" alt="Cover Image" height="70px" width="100px"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <data noupdate="1">

        <record id="library_book_website_menu" model="website.menu">
            <field name="name">Book</field>
            <field name="url">/library-book</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">10</field>
        </record>

    </data>

</odoo>
