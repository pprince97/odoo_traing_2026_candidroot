    <template id="book_website_template" name="Book">
        <t t-call="website.layout">
            <div class="container">
                <form action="/library-book" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-3">
                                    <h3>Books</h3>
                                </div>
                                <div class="col-md-9">
                                    <div role="search">

                                        <input type="search" name="search"
                                               class="search-query form-control oe_search_box border-0 bg-light"
                                               placeholder="Search..." style="width: 300px">
                                        </input>
                                    </div>
                                    <!--                        <t t-call="portal.portal_searchbar">-->
                                    <!--                            <t t-set="title">Search...</t>-->
                                    <!--                        </t>-->
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <a href="/book" class="btn btn-primary">Register Book</a>
                        </div>
                    </div>
                    <div class="row">
                        <t t-foreach="books" t-as="book">
                            <div class="col-md-3 border m-3">
                                <div class="d-flex justify-content-center pt-3">
                                    <t t-if="image_data_uri(book.cover_image)">
                                        <img t-att-src="image_data_uri(book.cover_image)" alt="Cover Image"
                                             height="100px" width="100px"/>
                                    </t>
                                </div>
                                <div class="pt-3">
                                    <t t-if="book.name">
                                        <p>Name:
                                            <span t-field="book.name"/>
                                        </p>
                                    </t>
                                    <t t-if="book.barcode">
                                        <p>Barcode:
                                            <span t-field="book.barcode"/>
                                        </p>
                                    </t>
                                    <t t-if="book.category">
                                        <p>Category:
                                            <span t-field="book.category"/>
                                        </p>
                                    </t>
                                    <t t-if="book.state">
                                        <p>State:
                                            <span t-field="book.state"/>
                                        </p>
                                    </t>
                                    <t t-if="book.borrow_price">
                                        <p>Price:
                                            <span t-field="book.borrow_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': book.currency_id or res_company.currency_id}"/>
                                            /day
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="row my-3">
                        <div class="col-12">
                            <t t-call="portal.pager">
                                <t t-set="classname" t-value="'d-flex justify-content-center'"/>
                            </t>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>


    <data noupdate="1">

        <record id="library_book_website_menu" model="website.menu">
            <field name="name">Book</field>
            <field name="url">/library-book</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">10</field>
        </record>

    </data>

</odoo>
