    <template id="book_website_template" name="Book">
        <t t-call="website.layout">
            <div class="container">
                <form action="/library-book" method="post">
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <h3>Book Details</h3>
                        </div>
                        <div class="col-md-6 text-end">
                            <a href="/book" class="btn btn-primary">Register Book</a>
                        </div>
                    </div>
                    <div class="row">
                        <t t-foreach="books" t-as="book">
                            <div class="col-md-3 border m-3">
                                <div class="d-flex justify-content-center pt-3">
                                    <t t-if="image_data_uri(book.cover_image)">
                                        <img t-att-src="image_data_uri(book.cover_image)" alt="Cover Image" height="100px" width="100px"/>
                                    </t>
                                </div>
                                <div class="pt-3">
                                    <t t-if="book.name">
                                        <p>Name: <span t-field="book.name"/></p>
                                    </t>
                                    <t t-if="book.barcode">
                                        <p>Barcode: <span t-field="book.barcode"/></p>
                                    </t>
                                    <t t-if="book.category">
                                        <p>Category: <span t-field="book.category"/></p>
                                    </t>
                                    <t t-if="book.state">
                                        <p>State: <span t-field="book.state"/></p>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <t t-call="portal.pager">
                                <t t-set="classname" t-value="'d-flex justify-content-center'"/>
                            </t>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>


    <data noupdate="1">

        <record id="library_book_website_menu" model="website.menu">
            <field name="name">Book</field>
            <field name="url">/library-book</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">10</field>
        </record>

    </data>

</odoo>
