<odoo>

    <template id="custom_header_tanisha" inherit_id="website.layout">
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-attf-class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//header[@id='top']" position="after">
            <div class="container my-3">
                <div class="row">
                    <div class="col-md-4">
                        <img src="/library_management_tanisha/static/img/demo_image.jpeg" height="50px" width="60px"
                             alt="Custom Logo" class="img-fluid"/>
                    </div>
                    <div class="col-md-8">
                        <div role="menu">
                            <div class="row">
                                <div class="col-md-6">
                                    <ul t-if="not navbar_back_url" class="nav"
                                        t-att-data-menu_name="editable and 'Website Menu'"
                                        t-att-data-content_menu_id="editable and website.menu_id.id">
                                        <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                            <t t-call="website.submenu">
                                                <t t-set="item_class" t-value="'nav-item'"/>
                                                <t t-set="link_class" t-value="'nav-link text-nowrap'"/>
                                            </t>
                                        </t>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <a groups="base.group_public" t-attf-href="/web/login" role="menuitem"
                                               t-attf-class="#{_link_class}">
                                                <i class="fa fa-fw fa-sign-in me-1 small text-primary-emphasis"/>
                                                Sign in
                                            </a>
                                            <a groups="base.group_user" href="#" role="button" data-bs-toggle="dropdown"
                                               t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}">
                                                <span t-field="user_id.name"/>
                                            </a>
                                            <div t-attf-class="dropdown-menu js_usermenu #{_dropdown_menu_class}"
                                                 role="menu">
                                                <a groups="base.group_user" href="/odoo" role="menuitem"
                                                   class="dropdown-item ps-3"
                                                   id="o_backend_user_dropdown_link">
                                                    <i class="fa fa-fw fa-th me-1 small text-primary-emphasis"/>
                                                    Apps
                                                </a>
                                                <a groups="base.group_user" href="/my/home" role="menuitem"
                                                   class="dropdown-item ps-3">
                                                    <i class="fa fa-fw fa-id-card-o me-1 small text-primary-emphasis"/>
                                                    My Account
                                                </a>
                                                <div id="o_logout_divider" class="dropdown-divider"/>
                                                <a groups="base.group_user" t-attf-href="/web/session/logout?redirect=/"
                                                   role="menuitem" id="o_logout"
                                                   class="dropdown-item ps-3">
                                                    <i class="fa fa-fw fa-sign-out me-1 small text-primary-emphasis"/>
                                                    Logout
                                                </a>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <a href="/contactus" class="btn btn-primary mb-3">Contact Us</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@id='footer']" position="attributes">
            <attribute name="t-attf-class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='footer']" position="after">
            <footer class="s_text_block pt40 pb16 bg-black-50" data-snippet="s_text_block" data-name="Container">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-2 pt24 pb24">
                            <h5>Useful Links</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <a href="/">Home</a>
                                </li>
                                <li>
                                    <a href="#">About us</a>
                                </li>
                                <li>
                                    <a href="/library-book">Book</a>
                                </li>
                                <li>
                                    <a href="/contactus">Contact us</a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-lg-5 pt24 pb24">
                            <h5>About us</h5>
                            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Fugit, quam.</p>
                        </div>
                        <div class="col-lg-4 offset-lg-1 pt24 pb24">
                            <h5>Connect with us</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <i class="fa fa-comment fa-fw me-2"/>
                                    <a href="/contactus">Contact us</a>
                                </li>
                                <li>
                                    <i class="fa fa-envelope fa-fw me-2"/>
                                    <a href="mailto:info@mycompany.example.com">info@mycompany.example.com</a>
                                </li>
                                <li>
                                    <i class="fa fa-phone fa-fw me-2"/>
                                    <a href="tel:+1 777-777-7778">
                                        <span class="o_force_ltr">+1 777-777-7778</span>
                                    </a>
                                </li>
                            </ul>
                            <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media"
                                 data-name="Social Media" contenteditable="false">
                                <h5 class="s_social_media_title d-none" contenteditable="true">Follow us</h5>
                                <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank"
                                   aria-label="Facebook">
                                    <i class="fa fa-facebook rounded-circle shadow-sm o_editable_media"/>
                                </a>
                                <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank"
                                   aria-label="X">
                                    <i class="fa fa-twitter rounded-circle shadow-sm o_editable_media"/>
                                </a>
                                <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank"
                                   aria-label="LinkedIn">
                                    <i class="fa fa-linkedin rounded-circle shadow-sm o_editable_media"/>
                                </a>
                                <a href="/" class="text-800" aria-label="Extra page">
                                    <i class="fa fa-home rounded-circle shadow-sm o_editable_media"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

</odoo>