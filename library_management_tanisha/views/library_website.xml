<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="library_website" model="website">
        <field name="name">Library Website</field>
    </record>

    <record id="mega_menu_library" model="website.menu">
        <field name="name">Mega Menu</field>
        <field name="url">/mega-menu</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">30</field>
        <field name="is_mega_menu">True</field>
        <field name="mega_menu_content" type="html">
            <section class="py-4 bg-white">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6">
                            <h5>Library</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <a href="#">Book</a>
                                </li>
                                <li>
                                    <a href="#">Borrow Request</a>
                                </li>
                                <li>
                                    <a href="#">Student</a>
                                </li>
                                <li>
                                    <a href="#">Librarian</a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-lg-6">
                            <h5>Gym</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <a href="#">Trainer</a>
                                </li>
                                <li>
                                    <a href="#">Trainee</a>
                                </li>
                                <li>
                                    <a href="#">Diet</a>
                                </li>
                                <li>
                                    <a href="#">Workout</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </field>
    </record>

