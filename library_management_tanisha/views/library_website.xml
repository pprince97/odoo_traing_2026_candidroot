    <template id="custom_home_page_tanisha_library" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="inside">
            <t t-if="website_id == %(library_management_tanisha.library_website)d">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                         data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"
                          style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Welcome to the Home Page of Library Website</h1>
                    </div>
                </section>
            </t>
        </xpath>
    </template>

    <template id="price_invisible_logout" inherit_id="website_sale.products_item">
        <xpath expr="//div[hasclass('o_wsale_product_sub')]" position="attributes">
            <attribute name="t-if">not user_id._is_public()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('oe_subdescription_wrapper')]" position="after">
            <t t-if="user_id._is_public()">
                <a t-attf-href="/web/login" class="text-danger">Sign In to View Price</a>
            </t>
        </xpath>
    </template>

    <template id="price_invisible_logout_2" inherit_id="website_sale.product">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="attributes">
            <attribute name="t-if">not user_id._is_public()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="after">
            <t t-if="user_id._is_public()">
                <a t-attf-href="/web/login" class="text-danger">Sign In to View Price</a>
            </t>
        </xpath>
    </template>


</odoo>
