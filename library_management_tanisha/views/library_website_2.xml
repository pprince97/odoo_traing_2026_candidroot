<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_header_tanisha_library_2" inherit_id="website.layout">
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-attf-class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//header[@id='top']" position="after">
            <div class="container my-3">
                <div class="row">
                    <div class="col-md-4">
                        <img src="/library_management_tanisha/static/img/demo_image.jpeg" height="50px" width="60px"
                             alt="Custom Logo" class="img-fluid"/>
                    </div>
                    <div class="col-md-8">
                        <div role="menu">
                            <div class="row">
                                <div class="col-md-6">
                                    <a href="/">Home</a>
                                </div>
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <a groups="base.group_public" t-attf-href="/web/login" role="menuitem"
                                               t-attf-class="#{_link_class}">
                                                <i class="fa fa-fw fa-sign-in me-1 small text-primary-emphasis"/>
                                                Sign in
                                            </a>
                                            <a groups="base.group_user" href="#" role="button" data-bs-toggle="dropdown"
                                               t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}">
                                                <span t-field="user_id.name"/>
                                            </a>
                                            <div t-attf-class="dropdown-menu js_usermenu #{_dropdown_menu_class}"
                                                 role="menu">
                                                <a groups="base.group_user" href="/odoo" role="menuitem"
                                                   class="dropdown-item ps-3"
                                                   id="o_backend_user_dropdown_link">
                                                    <i class="fa fa-fw fa-th me-1 small text-primary-emphasis"/>
                                                    Apps
                                                </a>
                                                <a groups="base.group_user" href="/my/home" role="menuitem"
                                                   class="dropdown-item ps-3">
                                                    <i class="fa fa-fw fa-id-card-o me-1 small text-primary-emphasis"/>
                                                    My Account
                                                </a>
                                                <div id="o_logout_divider" class="dropdown-divider"/>
                                                <a groups="base.group_user" t-attf-href="/web/session/logout?redirect=/"
                                                   role="menuitem" id="o_logout"
                                                   class="dropdown-item ps-3">
                                                    <i class="fa fa-fw fa-sign-out me-1 small text-primary-emphasis"/>
                                                    Logout
                                                </a>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <a href="/contactus" class="btn btn-primary mb-3">Contact Us</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <data noupdate="1">

        <record id="library_website_2" model="website">
            <field name="name">Library Website 2</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="user_id" ref="base.public_user"/>
        </record>

    </data>
</odoo>
