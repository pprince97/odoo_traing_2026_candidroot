<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="library_book_template_login" name="Book">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                         data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"
                          style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Welcome to the Library Management</h1>
                    </div>
                </section>
                <section class="pt40 pb40">
                    <div class="container">
                        <h4>Fill up the form to upload the book.</h4>
                        <section>
                            <div class="container">
                                <form id="book_page_form" action="/book/form" method="post"
                                      enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="row">
                                        <div class="mt-3">
                                            <label for="book_name">Name *</label>
                                            <input id="book_name" type="text" class="form-control" name="name"
                                                   required=""
                                                   style="width: 800px"/>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mt-3">
                                                <label for="book_barcode">Barcode *</label>
                                                <input id="book_barcode" type="char" class="form-control" name="barcode"
                                                       required="" style="width: 400px"/>
                                            </div>
                                            <div class="mt-3">
                                                <label for="book_state">State *</label>
                                                <div role="radio_group">
                                                    <input id="book_state_published" type="radio" class="o_radio_input"
                                                           name="state" value="published"/>
                                                    Published
                                                    <input id="book_state_unpublished" type="radio"
                                                           class="o_radio_input ms-4" name="state" value="unpublished"/>
                                                    Unpublished
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <label for="category">Category *</label>
                                                <div>
                                                    <select id="book_category" name="category"
                                                            class="from-select form-control"
                                                            style="width: 400px">
                                                        <option value="knowledge">Knowledge</option>
                                                        <option value="novel">Novel</option>
                                                        <option value="story">Story</option>
                                                        <option value="science">Science</option>
                                                        <option value="history">History</option>
                                                        <option value="comic">Comic</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <label for="book_description">Description *</label>
                                                <textarea id="book_description" class="form-control" name="description"
                                                          required="" style="width: 400px" rows="5"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6 ps-0">
                                            <div class="mt-3">
                                                <label for="book_available_copies">Available copies</label>
                                                <input id="book_available_copies" type="number" min="0" max="100"
                                                       step="1"
                                                       class="form-control" name="available_copies" style="width: 400px"
                                                       value="0"/>
                                            </div>
                                            <div class="mt-3">
                                                <label for="book_stock">Stock</label>
                                                <input id="book_stock" type="number" min="0" max="100" step="1"
                                                       class="form-control" name="stock" style="width: 400px"
                                                       value="0"/>
                                            </div>
                                            <div class="mt-3">
                                                <label for="book_borrow_price">Borrow Price(per day)</label>
                                                <input id="book_borrow_price" type="number" min="0.5" step="0.5"
                                                       class="form-control" name="borrow_price" style="width: 400px"
                                                       value="0.5"/>
                                            </div>
                                            <div class="mt-3">
                                                <label for="book_max_day_limit">Max day limit</label>
                                                <input id="book_max_day_limit" type="number" min="1" step="1"
                                                       class="form-control" name="max_day_limit" style="width: 400px"
                                                       value="1"/>
                                            </div>
                                            <div class="mt-3 s_website_form_field">
                                                <label for="book_cover_image">Cover image</label>
                                                <input id="book_cover_image" type="file"
                                                       class="form-control" name="cover_image"
                                                       style="width: 400px"/>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <button class="btn btn-primary" type="submit">Submit</button>
                                            <a href="/library-book" class="btn btn-primary">Show Books</a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </section>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="library_book_template_logout" name="Book">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                         data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"
                          style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Welcome to the Library Management</h1>
                    </div>
                </section>
                <section class="pt40 pb40" data-snippet="s_text_block">
                    <div class="container">
                        <h3>Please login to upload the Book!</h3>
                    </div>
                </section>
            </div>
        </t>
    </template>

