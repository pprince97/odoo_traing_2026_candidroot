<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="book_history_wizard_form" model="ir.ui.view">
        <field name="name">book.history.wizard.form</field>
        <field name="model">book.history.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_return_date"/>
                            <field name="student_ids" widget="many2many_tags"/>
                            <field name="book_ids" widget="many2many_tags" domain="[('state','=','published')]"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="print_history"
                            string="Print"
                            class="oe_highlight"
                            type="object"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="book_history_wizard_action" model="ir.actions.act_window">
        <field name="name">Book Borrow History</field>
        <field name="res_model">book.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
