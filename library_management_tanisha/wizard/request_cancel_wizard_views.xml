<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="cancel_request_wizard_form" model="ir.ui.view">
        <field name="name">request.cancel.wizard.form</field>
        <field name="model">request.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="cancellation_reason"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="submit"
                            string="Submit"
                            class="oe_highlight"
                            type="object"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>