<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Groups Category -->
        <record model="ir.module.category" id="library_management_groups_catgory">
            <field name="name">Library Management</field>
            <field name="sequence">35</field>
        </record>

        <!--Group Privilage-->
        <record model="res.groups.privilege" id="res_groups_privilege_library">
            <field name="name">Library Role</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="library_management_urvi.library_management_groups_catgory"/>
        </record>

        <!-- Groups-->
        <record id="group_library_student" model="res.groups">
            <field name="name">Student</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <record id="group_library_hide_librarian" model="res.groups">
            <field name="name">Hide</field>
            <field name="sequence">9</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_library_librarian" model="res.groups">
            <field name="name">Librarian</field>
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('library_management_urvi.group_library_student')),(4,ref('base.group_erp_manager'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
        </record>

        <record id="group_library_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">12</field>
            <field name="implied_ids"
                   eval="[(4,ref('library_management_urvi.group_library_librarian'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_library"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>


        <!-- rules -->
        <record id="borrow_rule_student" model="ir.rule">
            <field name="name">Library Data Student</field>
            <field ref="model_library_borrow_request" name="model_id"/>
            <field name="domain_force">[('student_id.user_id','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('library_management_urvi.group_library_student'))]"/>
        </record>


        <record id="borrow_rule_librarian" model="ir.rule">
            <field name="name">Library Data Librarian</field>
            <field ref="model_library_borrow_request" name="model_id"/>
            <field name="domain_force">[('librarian_id.user_id','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('library_management_urvi.group_library_librarian'))]"/>
        </record>

        <record id="borrow_rule_admin" model="ir.rule">
            <field name="name">Library Data Admin</field>
            <field ref="model_library_borrow_request" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management_urvi.group_library_admin'))]"/>
        </record>

        <record id="student_creation_student" model="ir.rule">
            <field name="name">student creation restriction for student</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management_urvi.group_library_student'))]"/>
        </record>

        <record id="librarian_rule_view_self" model="ir.rule">
            <field name="name">Librarian view self</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups"
                   eval="[(4, ref('library_management_urvi.group_library_librarian'))]"/>
        </record>

        <record id="admin_record_rule" model="ir.rule">
            <field name="name">Admin can view all students and librarians</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('library_management_urvi.group_library_admin'))]"/>
        </record>


        <record id="base.menu_administration" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('base.group_system'), ref('library_management_urvi.group_library_admin')])]"/>
        </record>
    </data>
</odoo>
