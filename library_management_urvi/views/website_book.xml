    <template id="template_public_view" name="Blog Template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                         data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"
                          style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Book</h1>
                    </div>
                </section>

                <div class="container d-block text-center">
                    <h2 class="mt0">Welcome to your <b>Book Page</b>!
                    </h2>
                    <p class="lead d-none d-md-block">Please <b>Login</b> to see the Records
                    </p>
                </div>
            </div>
        </t>
    </template>

    <record id="menu_blog" model="website.menu">
        <field name="name">Book</field>
        <field name="url">/book</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">40</field>
        <field name="group_ids" eval="[(4, ref('library_management_urvi.group_library_librarian')),
        (4, ref('library_management_urvi.group_library_admin'))]"/>
    </record>

</odoo>