<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="template_create_book" name="Book Form">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-4 mb-4">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <!--                        <form id="book_form" action="/book/submit" method="post" enctype="multipart/form-data"-->
                        <!--                              class="s_website_form">-->
                        <form action="/book/submit" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <h1 class="text-center">Register a New Book</h1>

                            <div class="mb-3">
                                <label for="name">Book Title</label>
                                <input type="text" name="name" class="form-control s_website_form_input" required="1"/>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="barcode">Barcode</label>
                                    <input type="text" name="barcode" class="form-control s_website_form_input"
                                           required="1"/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="category">Category</label>
                                    <select name="category" class="form-select">
                                        <option value="mystery">Mystery</option>
                                        <option value="horror">Horror</option>
                                        <option value="romantic">Romantic</option>
                                        <option value="science">Science</option>
                                        <option value="history">History</option>
                                        <option value="biography">Biography</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="description">Description</label>
                                <textarea name="description" class="form-control s_website_form_input" rows="3"
                                          required="1"/>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label for="copies">Copies</label>
                                    <input type="number" name="copies" class="form-control s_website_form_input"/>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="borrow_price">Price per Day</label>
                                    <input type="number" step="0.01" name="borrow_price"
                                           class="form-control s_website_form_input"
                                           required="1"/>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label for="maximum_day_limit">Day Limit</label>
                                    <input type="number" name="maximum_day_limit"
                                           class="form-control s_website_form_input"/>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-1">
                                    <label for="maximum_day_limit">State</label>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <input type="radio" name="state" value="unpublished"/>
                                    Unpublished
                                </div>
                                <div class="col-md-2 mb-3">
                                    <input type="radio" name="state" value="published"/>
                                    Published
                                </div>
                            </div>
                            <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required"
                                 data-type="image" data-name="Field">
                                <label class="s_website_form_label" style="width: 200px" for="cover_image_b">
                                    <span class="s_website_form_label_content">Cover Image</span>
                                </label>
                                <input id="cover_image_b" type="file" class="form-control s_website_form_input"
                                       name="image"/>
                            </div>
                            <button type="submit" class="btn btn-primary">Register Book</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>library.book</value>
        <value eval="[
                    'name',
                    'barcode',
                    'description',
                    'borrow_price',
                    'copies',
                    'category',
                    'maximum_day_limit',
                    'image'
                ]"/>
    </function>

