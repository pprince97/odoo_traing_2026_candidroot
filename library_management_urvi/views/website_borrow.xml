<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="borrow_list_template" name="Borrow Records List">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container">
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <h1 class="mb-4 ms-0">Borrowed Requests</h1>
                        </div>
                        <div class="col-md-6 mb-3 text-end">
                            <a href="/borrow/create" role="button" class="btn btn-primary s_website_form_send">New
                                Borrow
                                Request
                            </a>
                        </div>
                    </div>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Serial Number</th>
                                <th>Student ID</th>
                                <th>Librarian ID</th>
                                <th>State</th>
                                <th>Issued Date</th>
                                <th>Return Date</th>
                                <th>Fine Amount</th>
                                <th>Total Amount</th>
                                <th>Canceled Date</th>
                                <th>Cancellation Reason</th>
                                <th>Lines</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="borrows" t-as="borrow">
                                <tr>
                                    <td>
                                        <!-- Trigger Button (Serial Number) -->
                                        <a href="#" data-bs-toggle="modal"
                                           t-attf-data-bs-target="#modal_borrow_#{borrow.id}" class="fw-bold">
                                            <!--                                        <a href="/borrow/{borrow.id}" target="_top">-->
                                            <t t-out="borrow.serial_number"/>
                                        </a>
                                    </td>
                                    <!--                                    <td>-->
                                    <!--                                        <t t-out="borrow.serial_number"/>-->
                                    <!--                                    </td>-->
                                    <td>
                                        <t t-out="borrow.student_id.name or 'N/A'"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.librarian_id.name or 'N/A'"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.state"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.issued_date"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.return_date"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.currency_id.symbol or ''"/>
                                        <t t-out="borrow.fine_amount"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.currency_id.symbol or ''"/>
                                        <t t-out="borrow.total_amount"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.canceled_date"/>
                                    </td>
                                    <td>
                                        <t t-out="borrow.cancellation_reason"/>
                                    </td>
                                    <td>
                                        <t t-out="len(borrow.borrow_request_lines_ids)"/>
                                        lines
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-foreach="borrows" t-as="borrow">
                        <div class="modal fade" t-attf-id="modal_borrow_#{borrow.id}" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header border-bottom-0">
                                        <h5 class="modal-title">Details:
                                            <t t-out="borrow.serial_number"/>
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Close"/>
                                    </div>
                                    <div class="modal-body pt-0">
                                        <t t-call="library_management_urvi.borrow_record_view_template">
                                            <t t-set="record" t-value="borrow"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>


    <template id="borrow_record_view_template" name="Borrow Record View Template">

        <div id="wrap" class="oe_structure">
            <div class="container">
                <h1 class="mt-4">Borrow Record Details</h1>

                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Serial Number:
                            <span t-field="record.serial_number"/>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-3">Student ID</div>
                            <div class="col-sm-9">
                                <span t-field="record.student_id.name"/>
                            </div>

                            <div class="col-sm-3">Librarian ID</div>
                            <div class="col-sm-9">
                                <span t-field="record.librarian_id.name"/>
                            </div>

                            <div class="col-sm-3">State</div>
                            <div class="col-sm-9">
                                <span t-field="record.state"/>
                            </div>

                            <div t-if="record.issued_date" class="col-sm-3">Issued Date</div>
                            <div t-if="record.issued_date" class="col-sm-9">
                                <span t-field="record.issued_date"/>
                            </div>

                            <div t-if="record.return_date" class="col-sm-3">Return Date</div>
                            <div t-if="record.return_date" class="col-sm-9">
                                <span t-field="record.return_date"/>
                            </div>

                            <div class="col-sm-3">Fine Amount</div>
                            <div class="col-sm-9">
                                <span t-field="record.fine_amount"
                                      t-options='{"widget": "monetary", "display_currency": record.currency_id}'/>
                            </div>

                            <div class="col-sm-3">Total Amount</div>
                            <div class="col-sm-9">
                                <span t-field="record.total_amount"
                                      t-options='{"widget": "monetary", "display_currency": record.currency_id}'/>
                            </div>

                            <div t-if="record.canceled_date" class="col-sm-3">Canceled Date</div>
                            <div t-if="record.canceled_date" class="col-sm-9">
                                <span t-field="record.canceled_date"/>
                            </div>

                            <div t-if="record.cancellation_reason" class="col-sm-3">Cancellation Reason</div>
                            <div t-if="record.cancellation_reason" class="col-sm-9">
                                <span t-field="record.cancellation_reason"/>
                            </div>

                        </div>

                        <h6>Borrowed Items:</h6>
                        <t t-if="record.borrow_request_lines_ids">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Book</th>
                                        <th>Quantity</th>
                                        <th>Amount Per Unit</th>
                                        <th>Issue Date</th>
                                        <th>Return Date</th>
                                        <th>Issue Days</th>
                                        <th>Fine Amount</th>
                                        <th>Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="record.borrow_request_lines_ids" t-as="line">
                                        <tr>
                                            <td>
                                                <t t-out="line.book_id.name"/>
                                            </td>
                                            <td>
                                                <t t-out="line.quantity"/>
                                            </td>
                                            <td>
                                                <t t-out="line.amount_per_unit"/>
                                            </td>
                                            <td>
                                                <t t-out="line.issue_date"/>
                                            </td>
                                            <td>
                                                <t t-out="line.return_date"/>
                                            </td>
                                            <td>
                                                <t t-out="line.issue_days"/>
                                            </td>
                                            <td>
                                                <t t-out="line.fine_amount"
                                                   t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                            </td>
                                            <td>
                                                <t t-out="line.total_amount" sum="Total Amount"
                                                   t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p>No items borrowed.</p>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="create_borrow_request_template" name="Create Borrow Request">
    <t t-call="website.layout">
        <div id="wrap" class="container mt-5 mb-5">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="mb-0">Borrow Request</h2>
                        <!-- Status Bar Simulation -->
                        <div class="btn-group border rounded shadow-sm" role="group">
                            <button type="button" class="btn btn-primary btn-sm px-3">Draft</button>
                            <button type="button" class="btn btn-light btn-sm px-3">Issued</button>
                            <button type="button" class="btn btn-light btn-sm px-3">Returned</button>
                            <button type="button" class="btn btn-light btn-sm px-3">Canceled</button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <form action="/borrow" method="post" class="js_website_submit_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Header Fields -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-4 col-form-label fw-bold text-muted">Serial Number</label>
                                    <div class="col-sm-8"><input type="text" class="form-control-plaintext" value="New" readonly="1"/></div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-4 col-form-label fw-bold">Student</label>
                                    <div class="col-sm-8">
                                        <select name="student_id" class="form-select" required="1">
                                            <t t-foreach="students" t-as="student">
                                                <option t-att-value="student.id"><t t-out="student.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-4 col-form-label fw-bold text-muted">Librarian</label>
                                    <div class="col-sm-8"><input type="text" class="form-control-plaintext" t-att-value="request.env.user.name" readonly="1"/></div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-4 col-form-label fw-bold">Issued Date</label>
                                    <div class="col-sm-8"><input type="date" name="issued_date" class="form-control" readonly="1"/></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row mb-2">
                                    <label class="col-sm-4 col-form-label fw-bold">Currency</label>
                                    <div class="col-sm-8">
                                        <select name="currency_id" class="form-select">
                                            <t t-foreach="currencies" t-as="curr">
                                                <option t-att-value="curr.id" t-att-selected="curr.id == request.env.company.currency_id.id">
                                                    <t t-out="curr.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row mb-2">
                                    <label class="col-sm-4 col-form-label fw-bold text-muted">Returned Date</label>
                                    <div class="col-sm-8"><input type="date" name="return_date" class="form-control-plaintext" readonly="1"/></div>
                                </div>
                                <div class="form-group row mb-2 text-primary">
                                    <label class="col-sm-4 col-form-label fw-bold">Fine Amount</label>
                                    <div class="col-sm-8 py-2">$ 0.00</div>
                                </div>
                                <div class="form-group row mb-2 fw-bold text-primary fs-5">
                                    <label class="col-sm-4 col-form-label">Total Amount</label>
                                    <div class="col-sm-8 py-2">$ 0.00</div>
                                </div>
                            </div>
                        </div>

                        <!-- Notebook / Tabs Simulation -->
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active fw-bold" href="#">Borrow Lines</a>
                            </li>
                        </ul>

                        <!-- One2many Lines Table -->
                        <div class="table-responsive">
                            <table class="table table-sm border" id="borrow_lines_table">
                                <thead class="bg-light">
                                    <tr>
                                        <th style="width: 25%;">Book</th>
                                        <th style="width: 10%;">Quantity</th>
                                        <th style="width: 15%;">Issue Date</th>
                                        <th style="width: 15%;">Return Date</th>
                                        <th style="width: 10%;">Issue Days</th>
                                        <th style="width: 15%;">Total Amount</th>
                                        <th style="width: 5%;" />
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="line_row">
                                        <td>
                                            <select name="book_id" class="form-select form-select-sm" required="1">
                                                <option value="">Select Book...</option>
                                                <t t-foreach="books" t-as="book">
                                                    <option t-att-value="book.id"><t t-out="book.display_name"/></option>
                                                </t>
                                            </select>
                                        </td>
                                        <td><input type="number" name="quantity" class="form-control form-control-sm" value="1" min="1"/></td>
                                        <td><input type="date" name="line_issue_date" class="form-control form-control-sm" required="1"/></td>
                                        <td><input type="date" name="line_return_date" class="form-control form-control-sm" required="1"/></td>
                                        <td><input type="number" class="form-control-plaintext form-control-sm ps-2" readonly="1" value="0"/></td>
                                        <td><input type="number" class="form-control-plaintext form-control-sm ps-2" readonly="1" value="0.00"/></td>
<!--                                        <td class="text-center align-middle">-->
<!--                                            <i class="fa fa-trash-o text-danger cursor-pointer remove_line" style="cursor: pointer;"></i>-->
<!--                                        </td>-->
                                    </tr>
                                </tbody>
                            </table>
                            <button type="button" class="btn btn-link p-0 text-decoration-none" id="add_line_btn">
                                <i class="fa fa-plus-circle me-1" /> Add a line
                            </button>
                        </div>

                        <div class="mt-4 border-top pt-3 text-end">
                            <button type="submit" class="btn btn-primary px-5">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Dynamic Row Script -->
        <script type="text/javascript">
            document.getElementById('add_line_btn').addEventListener('click', function() {
                const tbody = document.querySelector('#borrow_lines_table tbody');
                const lastRow = tbody.querySelector('tr:last-child');
                const newRow = lastRow.cloneNode(true);

                // Clear input values in the new row
                newRow.querySelectorAll('input').forEach(input => input.value = '');
                newRow.querySelector('select').selectedIndex = 0;
                tbody.appendChild(newRow);
            });

            document.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove_line')) {
                    const rows = document.querySelectorAll('.line_row');
                    if (rows.length > 1) {
                        e.target.closest('tr').remove();
                    }
                }
            });
        </script>
    </t>
</template>


