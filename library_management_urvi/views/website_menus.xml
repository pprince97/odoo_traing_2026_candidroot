    <template id="custom_homepage" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                     data-snippet="s_title" data-scroll-background-ratio="1">
                <span class="s_parallax_bg oe_img_bg"
                      style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                <div class="o_we_bg_filter bg-black-50"/>
                <div class="container">
                    <h1>Home Page</h1>
                </div>
            </section>

            <div class="p-5 mb-4 bg-light rounded-3">
                <div class="container-fluid py-5">
                    <h1 class="display-5 fw-bold">Welcome to Library Homepage!</h1>
                    <p class="col-md-8 fs-4">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Animi atque
                        corporis maiores molestiae nostrum omnis vero. Alias aut, cumque cupiditate, debitis fuga in
                        minus necessitatibus nobis, quaerat saepe sed ullam?
                    </p>
                </div>
            </div>

        </xpath>
    </template>

    <template id="partner_edit_template" name="Contact Details">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-4">
                <div class="row">
                    <div class="col-lg-6 offset-lg-3">
                        <h2 class="mb-4">Update Your Information</h2>
                        <form action="/my/profile/update" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <!-- Name -->
                            <div class="mb-3">
                                <label for="name" class="form-label">Full Name</label>
                                <input type="text" name="name" class="form-control"
                                       t-att-value="partner.name" required="required"/>
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" name="email" class="form-control"
                                       t-att-value="partner.email" required="required"/>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3">
                                <label for="phone" class="form-label">Phone</label>
                                <input type="tel" name="phone" class="form-control"
                                       t-att-value="partner.phone"/>
                            </div>

                            <!-- Gender (Assuming a selection field) -->
                            <div class="mb-3">
                                <label for="gender" class="form-label">Gender</label>
                                <select name="gender" class="form-select">
                                    <option value="">Select...</option>
                                    <option value="male" t-att-selected="partner.gender == 'male'">Male</option>
                                    <option value="female" t-att-selected="partner.gender == 'female'">Female</option>
                                    <!--                                    <option value="other" t-att-selected="partner.gender == 'other'">Other</option>-->
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <template id="addons_in_account_" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                <t t-set="title">Personal Info</t>
                <t t-set="text">Your Info</t>
                <t t-set="url" t-value="'/my/profile'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>


