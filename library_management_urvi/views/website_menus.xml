    </template>


    <template id="custom_header" inherit_id="website.layout" name="Custom Header">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//header" position="after">
            <header>
                <nav class="navbar navbar-expand-lg navbar-light bg-primary shadow-sm py-3">
                    <div class="container">
                        <a class="navbar-brand fw-bold text-primary" href="/">
                            <img src="/library_management_urvi/static/src/image/book.png" alt="Logo"
                                 style="height: 40px;" class="me-2"/>
                            <span class="text-white">Library</span>
                        </a>

                        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                                data-bs-target="#navbarNav">
                            <span class="navbar-toggler-icon"/>
                        </button>

                        <div class="collapse navbar-collapse" id="navbarNav">
                            <ul class="navbar-nav ms-auto align-items-center">
                                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-call="website.submenu">
                                            <t t-set="item_class" t-value="'nav-item'"/>
                                            <t t-set="link_class" t-value="'nav-link text-white'"/>
                                        </t>
                                    </t>
                                </ul>
                                <t t-if="user_id._is_public()">
                                    <li class="nav-item ms-lg-3">
                                        <a class="btn btn-outline-primary rounded-pill px-4" href="/web/login">Login</a>
                                    </li>
                                </t>
                                <t t-else="">
                                    <li class="nav-item dropdown ms-lg-3">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                                           id="userMenu" role="button" data-bs-toggle="dropdown">
                                            <span class="me-2 text-dark">
                                                <t t-esc="user_id.name"/>
                                            </span>
                                            <img t-attf-src="/web/image/res.users/#{user_id.id}/avatar_128"
                                                 class="rounded-circle"
                                                 style="width: 35px; height: 35px; object-fit: cover;"/>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-3">
                                            <li>
                                                <a class="dropdown-item" href="/my/home">My Account</a>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider"/>
                                            </li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="/web/session/logout">Logout
                                                </a>
                                            </li>
                                        </ul>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>

