<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="menu_reporting" model="website.menu">
        <field name="name">Library Reporting</field>
        <field name="parent_id" model="website.menu"
               search="[('parent_id','=',False),('website_id','=',ref('website.default_website'))]"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence" type="int">45</field>
    </record>

