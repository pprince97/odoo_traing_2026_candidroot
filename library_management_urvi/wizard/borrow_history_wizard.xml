<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="borrow_history_wizard_view" model="ir.ui.view">
        <field name="name">Borrow.History.Wizard.View</field>
        <field name="model">borrow.history.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="is_return_date"/>
                        <field name="students" widget="many2many_tags" domain="[('library_role','=','student')]"/>
                        <field name="books"  widget="many2many_tags" domain="[('state','=','published')]"/>
                    </group>
                    <footer>
                        <button
                                type="object"
                                name="wizard_borrow_history"
                                string="Print Report"
                                class="btn-primary"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>