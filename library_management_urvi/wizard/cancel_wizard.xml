<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cancel_wizard_view" model="ir.ui.view">
        <field name="name">Cancel.Wizard.View</field>
        <field name="model">cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="reason"/>
                    </group>
                    <footer>
                        <button
                                type="object"
                                name="wizard_cancel_create"
                                string="Submit"
                                class="btn-primary"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>