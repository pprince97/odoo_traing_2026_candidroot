<!--<?xml version="1.0" encoding="utf-8"?>-->
<odoo>
    <data>
        <record model="ir.ui.view" id="custom_tree">
            <field name="name">New</field>
            <field name="model">custom.new</field>
            <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role"/>
                <field name="topic"/>

            </list>
            </field>
        </record>

        <record id="custom_form" model="ir.ui.view">
            <field name="name">New</field>
            <field name="model">custom.new</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="role"/>
                            </group>
                            <group>
                                <field name="topic"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="new_action">
            <field name="name">New</field>
            <field name="res_model">custom.new</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="Child_new" id="menu_new_child" parent="new.menu_another_root" action="new.new_action"/>


