<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="owl_js.AttachmentDialog">
        <Dialog title.translate="Select Attachments" size="'md'">
           <div class="modal-content">
               <div class="modal-body">
                    <t t-if="state.attachments!=false">
                        <ul class="list-group">
                            <t t-foreach="state.attachments" t-as="att" t-key="att.id">
                                <li class="list-group-item">
                                    <input type="checkbox"
                                           t-att-data-id="att.id"
                                           t-on-change="() => this.toggleSelection(att.id)"/>
                                    <t t-esc="att.name"/>
                                </li>
                            </t>
                        </ul>
                    </t>
                   <t t-else="">
                        <p>No attachments found.</p>
                    </t>
               </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" t-on-click="confirm">Attach Selected</button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>

<!--t-on-change="toggleSelection(att.id)"-->