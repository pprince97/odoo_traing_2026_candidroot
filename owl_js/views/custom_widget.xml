<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_library_form" model="ir.ui.view">
        <field name="name">library.books.form</field>
        <field name="model">customwidget.widget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" widget="capitalize_widget"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_libirary_books" model="ir.actions.act_window">
        <field name="name">Custom Widget</field>
        <field name="res_model">customwidget.widget</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
