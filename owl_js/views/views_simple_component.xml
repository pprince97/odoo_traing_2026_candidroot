<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_counter" model="ir.actions.client">
        <field name="name">OWL Counter</field>
        <field name="tag">owl_js.counter_action</field>
    </record>

    <record id="action_props" model="ir.actions.client">
        <field name="name">Props</field>
        <field name="tag">owl_js.props_action</field>
    </record>
    <record id="action_counter_component" model="ir.actions.client">
        <field name="name">Counter OWL</field>
        <field name="tag">owl_js.counter_component_tag</field>
    </record>

    <menuitem id="owl_menu_root" name="Owl Components"/>
    <menuitem id="menu_counter"
              name="OWL Simple Component"
              action="action_counter" parent="owl_menu_root"/>
    <menuitem id="menu_counter"
              name="OWL Simple Component"
              action="action_counter" parent="owl_menu_root"/>
    <menuitem id="menu_props"
              name="Props"
              action="action_props" parent="owl_menu_root"/>
    <menuitem id="custom_widget"
              name="Custom Widget"
              action="action_libirary_books" parent="owl_menu_root"/>
    <menuitem id="menu_counter_component"
              name="Lifecycle"
              action="action_counter_component" parent="owl_menu_root"/>
</odoo>