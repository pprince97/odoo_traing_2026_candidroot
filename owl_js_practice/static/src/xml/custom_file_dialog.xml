<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="owl_js_practice.custom_file_upload">
        <Dialog size="'md'" title="props.title" modalRef="modalRef">
            <div class="d-flex" style="height: 400px;">
                <!-- Left: List of Files -->
                <div class="w-40 border-end overflow-auto p-2">
                    <ul class="list-group">
                        <t t-foreach="state.files" t-as="file" t-key="file.id">
                            <li class="list-group-item d-flex justify-content-between align-items-center" t-on-click="() => this.selectFile(file)">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" t-att-value="file.id"/>
                                    <label class="form-check-label"><t t-esc="file.name"/></label>
                                </div>
                            </li>
                        </t>
                    </ul>
                </div>
                <div class="w-60 p-2 d-flex align-items-center justify-content-center bg-light">
                    <t t-if="state.previewUrl">
                        <img t-if="state.previewType === 'image'" t-att-src="state.previewUrl" class="img-fluid border"/>
                        <iframe t-else="" t-att-src="state.previewUrl" class="w-100 h-100 border"/>
                    </t>
                    <t t-else="">
                        <span class="text-muted">Select a file to preview</span>
                    </t>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="(ev) => this.onConfirm(ev)">Send</button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>