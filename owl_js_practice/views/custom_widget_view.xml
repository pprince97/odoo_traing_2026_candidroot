<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="custom_widget_list" model="ir.ui.view">
            <field name="name">custom.widget</field>
            <field name="model">custom.widget.model</field>
            <field name="arch" type="xml">
            <list>
                <field name="number" width="25px"/>
            </list>
            </field>
        </record>

        <record id="custom_widget_form" model="ir.ui.view">
            <field name="name">custom.widget</field>
            <field name="model">custom.widget.model</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="number" widget="roundup" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="custom_widget_action" model="ir.actions.act_window">
            <field name="name">Custom Widget</field>
            <field name="res_model">custom.widget.model</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="custom_widget_main_menu" name="Custom Widget"  action="owl_js_practice.custom_widget_action"/>

    </data>
</odoo>