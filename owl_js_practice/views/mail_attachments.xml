<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_inherited_form_view" model="ir.ui.view">
            <field name="name">mail.inherited.form.view</field>
            <field name="model">mail.compose.message</field>
            <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
            <field name="arch" type="xml">
                <xpath expr="//footer/field[@name='attachment_ids']" position="after">
                    <field name="attach_files" widget="internal_files"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>