<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="pos_restaurant.DetailPopup">
    <Dialog title.translate="Guest Detail" size="'md'">
        <div t-ref="popup_root">
        <t t-foreach="state_array.arr" t-as="a" t-key="a">
        <div class="row m-2 guest-row">
            <div class="col-md-4">
                <label for="age" class="form-label mb-0">Age:</label>
                <input type="number" name="age" required="" class="form-control mb-1 guest-age"/>
            </div>

            <div class="col-md-4">
                <label for="female_no" class="form-label mb-0">Nationality:</label>
                <select name="nationality" class="form-select form-select-sm guest-nationality">
                    <option value="" hidden="1">Select Country...</option>
                    <t t-foreach="countries" t-as="country" t-key="country.id">
                        <option t-att-value="country.id">
                            <t t-esc="country.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="col-md-4">
                <label for="gender" class="form-label mb-0">Gender:</label>
                <select name="gender" class="form-select form-select-sm guest-gender">
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                </select>
            </div>
        </div>
        </t>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="next_up">
                Next
            </button>
            <button class="btn btn-secondary" t-on-click="previous">
                Previous
            </button>
            <button class="btn btn-secondary" t-on-click="props.close">
                Skip
            </button>
        </t>
        </div>
    </Dialog>
</t>
</templates>
