<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="GuestOuterInfo">
        <Dialog size="'md'" title="props.title">
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <label>No of Male</label>
                        <input class="form-control mb-2" t-model="state.no_of_male" t-on-input="onInputChanged"/>
                    </div>
                    <div class="col-md-4">
                        <label>No of Female</label>
                        <input class="form-control mb-2" t-model="state.no_of_female" t-on-input="onInputChanged"/>
                    </div>
                    <div class="col-md-4">
                        <label>No of Total</label>
                        <input class="form-control mb-2" t-model="state.no_of_total" readonly="readonly"/>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="display: flex; gap: 10px;">
                <button class="btn btn-primary" t-on-click="confirm">Next</button> <!-- t-att-disabled="!isValid" -->
                <button class="btn btn-secondary" t-on-click="close">Close</button>
                <button class="btn btn-secondary" t-on-click="skip">Skip</button>
            </div>
        </Dialog>
    </t>
</templates>