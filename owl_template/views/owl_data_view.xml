<odoo>
    <record id="user_profile_list_view" model="ir.ui.view">
        <field name="name">user.profile.list.view</field>
        <field name="model">owl.data.storage</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
                <field name="image"/>
            </list>
        </field>
    </record>


    <record id="user_profile_form_view" model="ir.ui.view">
        <field name="name">user.profile.form.view</field>
        <field name="model">owl.data.storage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="image"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="owl_action_window" model="ir.actions.act_window">
        <field name="name">Owl Record</field>
        <field name="res_model">owl.data.storage</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="owl_record"
              name="Owl Data"
              parent="owl_parent_js"
              action="owl_action_window"/>
</odoo>