<odoo>
    <record id="pos_order_guest_list_view" model="ir.ui.view">
        <field name="name">pos.order.guest.list.view</field>
        <field name="model">pos.order.guest</field>
        <field name="arch" type="xml">
            <list>
                <field name="age"/>
                <field name="nationality"/>
                <field name="gender"/>
            </list>
        </field>
    </record>


    <record id="pos_order_guest_form_view" model="ir.ui.view">
        <field name="name">pos.order.guest.form.view</field>
        <field name="model">pos.order.guest</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="age"/>
                            <field name="nationality"/>
                            <field name="gender"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_guest_action_window" model="ir.actions.act_window">
        <field name="name">POS order Guest Record</field>
        <field name="res_model">pos.order.guest</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="owl_record"
              name="Guest Details"
              parent="owl_parent_js"
              action="pos_guest_action_window"/>
</odoo>