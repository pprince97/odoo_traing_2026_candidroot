<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="inherit_pos_order_fields_add" model="ir.ui.view">
        <field name="name">inherit.pos.order.fields.add</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_count']" position="after">
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="table_duration"/>
            </xpath>

            <xpath expr="//page[@name='notes']" position="after">
                <page name="guest_details" string="Guest Details">
                    <group string="No of Guests">
                        <field name="no_of_male"/>
                        <field name="no_of_female"/>
                        <field name="no_of_total"/>
                    </group>

                    <group string="Guest Details">
                        <field name="guest_ids">
                            <list editable="bottom">
                                <field name="age"/>
                                <field name="nationality"/>
                                <field name="gender"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>