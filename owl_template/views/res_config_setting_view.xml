<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="after">
                <block title="Guest Details" id="guest_details_pos">
                    <setting string="Guest Details" help="Guest Details">
                        <field name="guest_details"/>
                        <div class="content-group" invisible="not guest_details">
                            <div class="row">
                                <label for="guest_details_timing" class="col-lg-6" string="Guest Details Timing"/>
                                <field name="guest_details_timing" class="col-lg-6"/>
                            </div>
                            <div class="row">
                                <span>
                                    <label for="guest_details_required" class="col-lg-6" string="Guest Details Required"/>
                                    <field name="guest_details_required" class="col-lg-6"/>
                                </span>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>