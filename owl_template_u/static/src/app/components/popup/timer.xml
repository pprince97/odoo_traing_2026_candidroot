<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('label fw-bolder fs-4 position-absolute top-50 start-50 translate-middle')]"
               position="before">
            <t t-if="pos.tableHasOrders(table)">
                <t t-set="active_order" t-value="pos.models['pos.order'].find(o => o.table_id and o.table_id.id === table.id)"/>
<!--                <t t-esc="active_order.preset_time"/>-->
                <t t-set="is_ID"  t-value="!(typeof active_order.id === 'string')"/>
                <t t-if="is_ID === true">
                    <t t-esc="getTableDuration(table)"/>
                </t>
            </t>
        </xpath>
    </t>
</templates>
