<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom.AddGuestNumberDetailsPopup">
        <Dialog title.translate="Guest Details">
            <div class="row">
                <div class="col-4">
                    Number of Male: <input type="number" t-model="state.male" t-on-input="compute_total"/>
                </div>
                <div class="col-4">
                    Number of Female: <input type="number" t-model="state.female" t-on-input="compute_total"/>
                </div>
                <div class="col-4">
                    Total Number of Guests: <input type="number" t-model="state.total_no_of_guests" readonly="1"/>
                </div>
            </div>
            <br/>
            <hr/>
            <footer>
                <button class="btn btn-primary" string="Next" t-on-click="guestDetailsPopUp">Next</button>
<!--                <button class="btn" string="Skip" t-on-click="props.close">Skip</button>-->
                 <button class="btn" t-on-click="props.close" t-att-disabled="isSkipDisabled">Skip</button>
            </footer>
        </Dialog>
    </t>
</templates>