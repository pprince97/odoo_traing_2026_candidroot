<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom.AddGuestNumberDetialsPopup">
        <Dialog title.translate="Guest Details">
            <div class="row">
                <div class="col-4">
                    Number of Male: <input type="number" t-model="state.male" t-on-input="compute_total"/>
                </div>
                <div class="col-4">
                    Number of Female: <input type="number" t-model="state.female" t-on-input="compute_total"/>
                </div>
                <div class="col-4">
                    Total Number of Guests: <input type="number" t-model="state.total_no_of_guests" readonly="1"/>
                </div>
            </div>
            <br/>
            <hr/>
            <footer>
                <button class="oe_highlight" string="Next" on-click="openCustomerDetialsPopUp">Next</button>
            </footer>
        </Dialog>
    </t>
</templates>
