<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_custom111" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <block title="Point of Sale" id="restaurant_section">
                    <setting id="guest_details" help="Guest Details">
                        <field name="guest_details"/>
                        <br/>
                        <label for="guest_details_timing" invisible="not guest_details">Guest Detail Timings</label>
                        <field name="guest_details_timing" invisible="not guest_details"/>
                        <br/>
                        <label for="guest_details_required" invisible="not guest_details">Guest Detail Required</label>
                        <field name="guest_details_required" invisible="not guest_details"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>