<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_jui.Control_Buttons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath
            expr="//div[hasclass('control-buttons-modal')]"
            position="inside">
            <button t-att-class="buttonClass" t-on-click="() => this.fill_details()">
                <i class="fa fa-pencil-square-o me-1" /> Customer Details
            </button>
        </xpath>
    </t>
</templates>