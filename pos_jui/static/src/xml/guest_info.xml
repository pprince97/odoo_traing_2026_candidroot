<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="pos_jui.guest_info_dialog">
        <Dialog size="'lg'" title="props.title" modalRef="modalRef">
            <t t-foreach="this.guestRange" t-as="num" t-key="num">
            <div class="row">
                <div class="col-12 my-3"><strong>Guest <t t-esc="num"/></strong></div>
                <div class="form-group col-4">
                    <div class="row">
                        <div class="col-6">
                            <label for="age" class="mt-2">Age:</label>
                        </div>
                        <div class="col-6">
                            <input t-attf-id="age_{{num}}" type="number" name="age" class="form-control"/>
                        </div>
                    </div>
                </div>
                <div class="form-group col-4">
                    <div class="row">
                        <div class="col-6">
                            <label for="nationality" class="mt-2">Nationality:</label>
                        </div>
                        <div class="col-6">
                            <select name="nationality" t-attf-id="nationality_{{num}}" class="form-control">
                                <option value="">Select a country...</option>
                                <t t-foreach="countries" t-as="country" t-key="country.id">
                                    <option t-att-value="country.id">
                                        <t t-esc="country.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group col-4">
                    <div class="row">
                        <div class="col-6">
                            <label for="gender" class="mt-2">Gender:</label>
                        </div>
                        <div class="col-6">
                            <select name="gender" t-attf-id="gender_{{num}}" class="form-control">
                                <t t-foreach="genderEntries" t-as="gen" t-key="gen[0]">
                                    <option t-att-value="gen[0]">
                                        <t t-esc="gen[1]"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.next()">Next</button>
                <button class="btn btn-secondary" t-on-click="() => this.prev()">Previous</button>
                <button class="btn btn-secondary" t-on-click="() => this.skip_view()" t-if="!pos.config.guest_details_required">Skip</button>
            </t>
        </Dialog>
    </t>
</templates>