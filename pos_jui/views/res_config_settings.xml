<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_guest_details" model="ir.ui.view">
        <field name="name">res.config.settings.view.guest.details.inherit.pos_self_order.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="restaurant_section" position="inside">
                <setting string="Guest Details" id="guest_details_setting" help="Guest Details" invisible="pos_module_pos_restaurant == False">
                    <field name="guest_details"/>
                    <div class="content-group" invisible="guest_details == False">
                        <div class="mt8">
                            <label for="guest_details_timing" class="me-3">Guest Details Timing</label>
                            <field name="guest_details_timing"/>
                            <br/>
                            <label for="guest_details_required" class="me-3">Guest Details Required</label>
                            <field name="guest_details_required"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>