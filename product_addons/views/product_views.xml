<odoo>
    <data>

        <record id="product_tree" model="ir.ui.view">
            <field name="name">product.addons.list</field>
            <field name="model">product.info</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="product_image"/>
                    <field name="type"/>
                    <field name="price"/>
                    <field name="available"/>
                    <field name="order_date_time"/>
                    <field name="delivery_date"/>
                    <field name="subscriber"/>
                    <field name="product_review"/>
                </list>
            </field>
        </record>

        <record id="product_form" model="ir.ui.view">
            <field name="name">product.addons.list</field>
            <field name="model">product.info</field>
            <field name="arch" type="xml">
                <form string="Product Details">
                    <sheet>
                        <group>

                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="product_image"/>
                                <field name="type"/>

                            </group>
                            <group>

                                <group>
                                    <field name="price"/>
                                    <field name="available"/>
                                    <field name="order_date_time"/>
                                    <field name="delivery_date"/>
                                </group>

                                <group>
                                    <field name="subscriber"/>
                                    <field name="product_review"/>
                                </group>
                            </group>

                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_addons_action" model="ir.actions.act_window">
            <field name="name">product.addons.window</field>
            <field name="res_model">product.info</field>
            <field name="view_mode">list,form</field>
        </record>


<!--        <menuitem id="product_menu" name="Product"/>-->
        <menuitem id="product1_menu" name="Products" action="product_addons.product_addons_action"/>
    </data>
</odoo>