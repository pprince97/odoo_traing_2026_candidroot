<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_inherit_view_urvi" model="ir.ui.view">
        <field name="name">inherit.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page name="partner-inherit" string="Parts Specifications" invisible="categ_id == %(product_management.product_category_accessories)d">
                    <group string="PRODUCT INFO">
                        <field name="multipart"/>
                    </group>
                    <group>
                        <group string="PRODUCT DETAILS" invisible="multipart == True">
                            <field name="material_id"/>
                            <field name="color_id"
                                   context="{'form_view_ref':'product_management.color_shade_form_view'}"/>
                            <field name="surface_id"/>
                            <field name="printing_id" context="{'printing':1}"/>
                        </group>
                        <group string="PRODUCT PRICE">
                            <field name="product_cost" widget="monetary"/>
                            <field name="accessories_cost" widget="monetary"/>
                            <field name="total_cost" widget="monetary"/>
                        </group>
                    </group>
                    <group string="ACCESSORIES" invisible="multipart == True">
                    </group>
                    <group string="PRODUCTS" invisible="multipart == False">
                    </group>
                    <group invisible="multipart == False">
                        <field name="product_lines" nolabel="1" colspan="1">
                            <list editable="bottom">
                                <field name="sub_product_id" string="Product" domain="[('id','!=',product_id)]"/>
                                <field name="cost" widget="monetary" string="Cost"/>
                                <field name="quantity"/>
                                <field name="total" string="Total"/>
                            </list>
                        </field>
                    </group>
                    <group invisible="multipart == True">
                        <field name="product_lines" nolabel="1" colspan="1">
                            <list editable="bottom">
                                <field name="sub_product_id" string="Accessory"
                                       domain="[('categ_id','=',%(product_management.product_category_accessories)d)]"/>
                                <field name="cost" widget="monetary" string="Cost"/>
                                <field name="quantity"/>
                                <field name="total" string="Total"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="total_cost" string="Price" readonly="0" invisible="categ_id != %(product_management.product_category_accessories)d"/>
            </xpath>
        </field>
    </record>

    <record id="color_shade_form_view" model="ir.ui.view">
        <field name="name">color.shade.form</field>
        <field name="model">product.color.shade</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

