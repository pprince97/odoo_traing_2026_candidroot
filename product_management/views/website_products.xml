<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="attribute_addition_product" inherit_id="website_sale.product_attribute_filters_form"
              name="Custom attribute">
        <xpath expr="//form" position="inside">
            <t
                    t-call="product_management.area_attribute"
            >
                <t
                        t-set="_classes"
                        t-valuef="{{is_sidebar_collapsible and 'accordion accordion-flush'}} {{is_sidebar_collapsible and (opt_wsale_categories or len(attributes) > 0)}}"
                />
            </t>
        </xpath>
    </template>

    <template id="area_attribute" name="Area Attribute">
        <t t-if="isMobile">
            <t t-set="_status" t-value="'inactive'"/>
            <div
                    id="o_wsale_area_option"
                    t-attf-class="position-relative {{_classes}} {{is_disabled and 'opacity-75 pe-none user-select-none'}}"
            >
                <div class="accordion-item border-top border-bottom rounded-0">
                    <div class="accordion-header h6 mb-0">
                        <button
                                t-attf-class="o_wsale_offcanvas_title accordion-button collapsed"
                                type="button"
                                t-att-data-status="_status"
                                data-bs-toggle="collapse"
                                t-attf-data-bs-target="#o_wsale_area_option_inner"
                                t-attf-aria-controls="o_wsale_area_option_inner"
                                t-att-aria-expanded="_status == 'active' and 'True' or 'False'"
                        >
                            <b>Applicable Area</b>
                        </button>
                    </div>
                    <div
                            id="o_wsale_area_option_inner"
                            class="accordion-collapse collapse hidden"
                    >
                        <div class="accordion-body pt-0">
                            <div class="list-group list-group-flush">
                                
                                <t t-foreach="application" t-as="area" class="list-group-item border-0 ps-0 pb-0">
                                    <div class="form-check mb-1">
                                        <input type="checkbox"
                                               name="applications"
                                               class="form-check-input"
                                               t-att-value="area.id"
                                               onchange="this.form.submit()"
                                               t-att-checked="'checked' if str(area.id) in request.httprequest.args.getlist('applications') else None"
                                        />
                                        <label class="form-check-label fw-normal" t-attf-for="area_#{area.id}"
                                               t-field="area.name"/>
                                    </div>
                                </t>
                                <t t-foreach="request.httprequest.args.items()" t-as="arg">
                                    <t t-if="arg[0] not in ['applications', 'page']">
                                        <input type="hidden" t-att-name="arg[0]" t-att-value="arg[1]"/>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div
                    id="o_wsale_area_option"
                    t-attf-class="position-relative {{_classes}} {{is_disabled and 'opacity-75 pe-none user-select-none'}}"
            >
                <div class="accordion-item">
                    <div class="accordion-header h6 mb-0">
                        <button
                                class="accordion-button px-0 bg-transparent shadow-none"
                                type="button"
                                data-bs-toggle="collapse"
                                t-attf-data-bs-target="#o_wsale_area_option_inner"
                                t-attf-aria-controls="o_wsale_area_option_inner"
                                aria-expanded="true"
                        >
                            <b>Applicable Area</b>
                        </button>
                    </div>
                    <div
                            id="o_wsale_area_option_inner"
                            class="accordion-collapse collapse show"
                    >
                        <form method="get" action="/shop">
                            <t t-foreach="application" t-as="area" class="list-group-item border-0 ps-1 pb-0">
                                <div class="form-check mb-1">
                                    <input type="checkbox"
                                           name="applications"
                                           class="form-check-input"
                                           t-att-value="area.id"
                                           onchange="this.form.submit()"
                                           t-att-checked="'checked' if str(area.id) in request.httprequest.args.getlist('applications') else None"
                                    />
                                    <label class="form-check-label fw-normal" t-attf-for="area_#{area.id}"
                                           t-field="area.name"/>
                                </div>
                            </t>
                            <t t-foreach="request.httprequest.args.items()" t-as="arg">
                                <t t-if="arg[0] not in ['applications', 'page']">
                                    <input type="hidden" t-att-name="arg[0]" t-att-value="arg[1]"/>
                                </t>
                            </t>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="clear_filters" inherit_id="website_sale.products" name="Clear Filters">
        <xpath expr="//div[hasclass('border-bottom')]" position="attributes">
            <attribute name="t-if">attrib_values or tags or request.httprequest.args.getlist('applications') or
                (show_price_filter and isFilteringByPrice)
            </attribute>
        </xpath>
        <xpath expr="//div[hasclass('border-bottom')]/a" position="attributes">
            <attribute name="t-att-href">keep(attribute_values=0, tags=0, min_price=0, max_price=0, applications=0)
            </attribute>
        </xpath>
    </template>
    <template id="clear_filters_mobile" inherit_id="website_sale.o_wsale_offcanvas" name="Clear Filters">
        <xpath expr="//div[hasclass('offcanvas-body')]/a" position="attributes">
            <attribute name="t-attf-class"
                       add="{{(not attrib_values and not isFilteringByPrice and not tags and not request.httprequest.args.getlist('applications')) and 'disabled'}}"
                       remove="{{(not attrib_values and not isFilteringByPrice and not tags) and 'disabled' }}"
                       separator=" "/>
            <attribute name="t-att-aria-disabled">(not attrib_values and not isFilteringByPrice and not tags and not
                request.httprequest.args.getlist('applications')) and 'true' or 'false'
            </attribute>
            <attribute name="t-att-href">keep(attribute_values=0, tags=0, min_price=0, max_price=0, applications=0)
            </attribute>
        </xpath>
    </template>
</odoo>