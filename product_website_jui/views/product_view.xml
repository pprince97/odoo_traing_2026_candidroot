<odoo>
    <data>
        <record id="product_inherited_form_view" model="ir.ui.view">
            <field name="name">product.inherited.form.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='public_categ_ids']" position="after">
                    <field name="product_taxonomy_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>