<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="shop_taxonomy_filter" inherit_id="website_sale.product_attribute_filters_form"
              name="Add Taxonomy Filter">
        <xpath expr="//form" position="inside">
            <div t-attf-class="{{'border-bottom pb-2 mx-n3 px-3' if isMobile else ''}}">
                <t t-foreach="request.httprequest.args.items()" t-as="arg">
                    <t t-if="arg[0] not in ['my_product', 'page', 'taxonomies']">
                        <input type="hidden" t-att-name="arg[0]" t-att-value="arg[1]"/>
                    </t>
                </t>
                <t t-foreach="request.httprequest.args.getlist('tags')" t-as="tag">
                    <input type="hidden" name="tags" t-att-value="tag"/>
                </t>
                <div class="accordion-header h6 mb-0" t-attf-class="{{'mx-4' if isMobile else ''}}">
                    <button class="accordion-button px-0 bg-transparent shadow-none"
                            type="button"
                            data-bs-toggle="collapse"
                            aria-expanded="true"
                            t-attf-data-bs-target="#custom_filter_taxonomy"
                            t-attf-aria-controls="custom_filter_taxonomy">
                        <b>Taxonomy</b>
                    </button>
                </div>
                <div id="custom_filter_taxonomy" class="accordion-collapse collapse show" t-attf-class="{{'mx-4' if isMobile else ''}}">
                    <div class="flex-column mb-3">
                        <t t-foreach="taxonomies" t-as="tax">
                            <div class="form-check">
                                <input type="checkbox"
                                       class="form-check-input"
                                       name="taxonomies"
                                       t-att-id="'tax_%s' % tax.id"
                                       t-att-value="tax.id"
                                       t-att-checked="'checked' if str(tax.id) in request.httprequest.args.getlist('taxonomies') else None"
                                       onchange="this.form.submit()"/>
                                <label class="form-check-label fw-normal" t-attf-for="tax_#{tax.id}"
                                       t-field="tax.name"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <template id="clear_filters" inherit_id="website_sale.products" name="Clear Filters">
        <xpath expr="//div[hasclass('border-bottom')]" position="attributes">
            <attribute name="t-if">attrib_values or tags or request.httprequest.args.getlist('taxonomies') or (show_price_filter and isFilteringByPrice)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('border-bottom')]/a" position="attributes">
            <attribute name="t-att-href">keep(attribute_values=0, tags=0, min_price=0, max_price=0, taxonomies=0)</attribute>
        </xpath>
    </template>
    <template id="clear_filters_mobile" inherit_id="website_sale.o_wsale_offcanvas" name="Clear Filters">
        <xpath expr="//div[hasclass('offcanvas-body')]/a" position="attributes">
            <attribute name="t-attf-class" add="{{(not attrib_values and not isFilteringByPrice and not tags and not request.httprequest.args.getlist('taxonomies')) and 'disabled'}}"
                       remove="{{(not attrib_values and not isFilteringByPrice and not tags) and 'disabled' }}" separator=" "/>
            <attribute name="t-att-aria-disabled">(not attrib_values and not isFilteringByPrice and not tags and not request.httprequest.args.getlist('taxonomies')) and 'true' or 'false'</attribute>
            <attribute name="t-att-href">keep(attribute_values=0, tags=0, min_price=0, max_price=0, taxonomies=0)</attribute>
        </xpath>
    </template>
    <template id="product_items" inherit_id="website_sale.products_item" name="Product items">
        <xpath expr="//div[hasclass('product_price')]/span" position="attributes">
            <attribute name="t-if">(template_price_vals['price_reduce'] or not website.prevent_zero_price_sale) and not user_id._is_public()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product_price')]/span" position="after">
            <span t-else="" class="mb-0 fw-bold text-danger">
                Please sign in to see the price
            </span>
        </xpath>
        <xpath expr="//div[hasclass('product_price')]/t" position="attributes">
            <attribute name="t-if">('base_price' in template_price_vals and (template_price_vals['base_price'] &gt; template_price_vals['price_reduce']) and (template_price_vals['price_reduce'] or not website.prevent_zero_price_sale)) and not user_id._is_public()</attribute>
        </xpath>
    </template>
    <template id="product_container_price" inherit_id="website_sale.product_price" name="Product price">
        <xpath expr="//div[@name='product_price_container']/span" position="attributes">
            <attribute name="t-if">not user_id._is_public()</attribute>
        </xpath>
        <xpath expr="//div[@name='product_price_container']/span" position="after">
            <span t-else="" class="mb-0 fw-bold text-danger">
                Please sign in to see the price
            </span>
        </xpath>
        <xpath expr="//span[@name='product_list_price']" position="attributes">
            <attribute name="t-if">not user_id._is_public()</attribute>
        </xpath>
    </template>
</odoo>
