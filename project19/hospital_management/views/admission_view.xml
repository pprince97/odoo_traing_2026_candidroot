<odoo>
    <data>
        <record id="admission_h_list" model="ir.ui.view">
            <field name="name">Admission</field>
            <field name="model">admission.model</field>
            <field name="arch" type="xml">
            <list>
                <field name="name" width="25px"/>
                <field name="patient_id" width="25px"/>
                <field name="admit_date" width="30px"/>
                <field name="discharge_date" width="30px"/>
                <field name="bed_no" width="25px"/>
                <field name="ward_type" width="25px"/>
                <field name="bill_amount" width="25px"/>
                <field name="paid_amount" width="25px"/>
                <field name="notes" width="25px"/>
                <field name="p_active" width="25px"/>
            </list>
            </field>
        </record>


        <record id="admission_h_tree" model="ir.ui.view">
            <field name="name">Admission</field>
            <field name="model">admission.model</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <header>
                        <button name="admit_p"
                                string="Admit"
                                type="object"
                                confirm="This is confirmation button for patient admission"
                                class="oe_highlight"
                                confirm-label="are you sure?"
                        />
                        <button name="discharge_p"
                                string="Discharge"
                                type="object"
                                class="oe_highlight"/>
                        <button name="mark_paid"
                                string="Mark as Paid"
                                type="object"
                                class="oe_highlight"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" width="25px"/>
                                <field name="patient_id" width="25px"/>
                                <field name="admit_date" width="30px"/>
                                <field name="discharge_date" width="30px"/>
                                <field name="bed_no" width="25px"/>
                                <field name="ward_type" width="25px"/>
                            </group>
                            <group>
                                <field name="bill_amount" width="25px"/>
                                <field name="paid_amount" width="25px"/>
                                <field name="notes" width="25px" />
                                <field name="p_active" width="25px"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="admission_h_search" model="ir.ui.view">
            <field name="name">Admission</field>
            <field name="model">admission.model</field>
            <field name="arch" type="xml">
                <search string="Search admission">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <filter name="ward_general" string="General" domain="[('ward_type', '=', 'general')]"/>
                    <filter name="ward_semi" string="Semi" domain="[('ward_type', '=', 'semi')]"/>
                    <filter name="ward_private" string="Private" domain="[('ward_type', '=', 'private')]"/>
                </search>
            </field>
        </record>

        <record id="admission_h_kanban" model="ir.ui.view">
            <field name="name">Admission</field>
            <field name="model">admission.model</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="patient_id"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="ward_type"/>
                                </div>
                            </div>
                            <div>
                               <field name="admit_date"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="admission_h_pivot" model="ir.ui.view">
            <field name="name">Admission</field>
            <field name="model">admission.model</field>
            <field name="arch" type="xml">
                <pivot string="Admission">
                    <field name="admit_date" type="col"/>
                    <field name="discharge_date" type="row"/>
                </pivot>
            </field>
        </record>

         <record id="admission_h_calendar" model="ir.ui.view">
             <field name="name">Admission</field>
             <field name="model">admission.model</field>
             <field name="arch" type="xml">
                 <calendar string="Admission" date_start="admit_date">
                     <field name="name"/>
                 </calendar>
             </field>
        </record>

        <record id="admission_h_graph" model="ir.ui.view">
             <field name="name">Admission</field>
             <field name="model">admission.model</field>
             <field name="arch" type="xml">
                 <graph string="Admission" type="line" sample="1">
                     <field name="ward_type"/>
                     <field name="bill_amount"/>
                 </graph>
             </field>
        </record>

        <record id="admission_h_action"  model="ir.actions.act_window">
            <field name="name">Admission</field>
            <field name="res_model">admission.model</field>
            <field name="view_mode">list,form,search,kanban,pivot,calendar,graph</field>
        </record>

        <menuitem name="Admission" id="admission_h_id" parent="hospital_management_parent" action="admission_h_action"/>
    </data>
</odoo>