<odoo>
    <data>
        <record id="appointment_h_list" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
            <list>
                <field name="name" width="25"/>
                <field name="patient_id" width="25"/>
                <field name="doctor_id" width="25"/>
                <field name="description" width="25"/>
                <field name="appointment_date" width="25"/>
                <field name="token_no" width="25"/>
                <field name="fees" width="25"/>
                <field name="followup_date" width="25"/>
                <field name="is_emergency" width="25"/>
            </list>
            </field>
        </record>

        <record id="action_website" model="ir.actions.act_url">
            <field name="name">Website</field>
            <field name="url">/</field>
            <field name="target">self</field>
        </record>

        <record id="appointment_h_tree" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <header>
                        <button name="confirm_status"
                                string="Confirm Appointment"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['confirm','cancel','done']"/>
                        <button name="done_status"
                                string="Mark Done"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['done','cancel','draft']"/>
                        <button name="cancel_status"
                                string="Cancel"
                                type="object"
                                class="oe_highlight"
                                invisible="status in ['cancel','done']"/>
                        <button name="%(action_website)d" string="Website" type="action" class="oe_highlight"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,confirm,done,cancel"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" width="25px"/>
                                <field name="patient_id" width="25px" context="{'test':True}"/>
                                <field name="doctor_id" width="30px" context="{'test2':True}"/>
                                <field name="appointment_date" width="30px"/>
                                <field name="token_no" width="25px"/>
                                <field name="fees" width="25px"/>
                            </group>
                            <group>
                                <field name="paid" width="25px"/>
                                <field name="description" width="25px" force_save="1"/>
                                <field name="prescription" width="25px" filename="report_name"/>
                                <field name="followup_date" width="25px"/>
                                <field name="duration_mins" width="25px"/>
                                <field name="is_emergency" width="25px"/>
                                <field name="partner_id" width="25px"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="attach" string="Attachments">
                                <field name="attachment" filename="file_name"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="appointment_h_search" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
                <search string="Search appointment">
                    <field name="name"/>
                    <field name="doctor_id"/>
                    <field name="patient_id"/>
                    <field name="token_no"/>
                    <filter name="status_draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                    <filter name="status_confirm" string="Confirm" domain="[('status', '=', 'confirm')]"/>
                    <filter name="status_done" string="Done" domain="[('status', '=', 'done')]"/>
                    <filter name="status_cancel" string="Cancel" domain="[('status', '=', 'cancel')]"/>
<!--                    <filter name="fees_total" string="Fees" domain="[('fees', '=', True)]"/>-->
                </search>
            </field>
        </record>

        <record id="appointment_h_kanban" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="doctor_id"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="patient_id"/>
                                </div>
                            </div>
                            <div>
                               <field name="appointment_date"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="appointment_h_pivot" model="ir.ui.view">
            <field name="name">Appointment</field>
            <field name="model">appointment.model</field>
            <field name="arch" type="xml">
                <pivot string="Appointment">
                    <field name="doctor_id" type="col"/>
                    <field name="appointment_date" type="row"/>
                </pivot>
            </field>
        </record>

         <record id="appointment_h_calendar" model="ir.ui.view">
             <field name="name">Appointment</field>
             <field name="model">appointment.model</field>
             <field name="arch" type="xml">
                 <calendar string="Appointment" date_start="appointment_date">
                     <field name="name"/>
                 </calendar>
             </field>
        </record>

        <record id="appointment_h_graph" model="ir.ui.view">
             <field name="name">Appointment</field>
             <field name="model">appointment.model</field>
             <field name="arch" type="xml">
                 <graph string="Appointments" type="line" sample="1">
                     <field name="patient_id"/>
                     <field name="doctor_id"/>
                 </graph>
             </field>
        </record>

        <record id="appointment_h_action"  model="ir.actions.act_window">
            <field name="name">Appointment</field>
            <field name="res_model">appointment.model</field>
            <field name="view_mode">list,form,search,kanban,pivot,calendar,graph</field>
            <field name="help" type="html">
                <p>
                    Create a Recurring Plan
                </p>
            </field>
        </record>

        <record id="appointment_server_action" model="ir.actions.server">
            <field name="name">Change Description</field>
            <field name="model_id" ref="model_appointment_model"/>
            <field name="binding_model_id" ref="model_appointment_model" />
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.change_description(records)
            </field>
        </record>

        <record id="appointment_patient_action"  model="ir.actions.act_window">
            <field name="name">Appointment</field>
            <field name="res_model">appointment.model</field>
            <field name="view_mode">form</field>
        </record>

        <menuitem name="Appointment" id="appointment_h_id" parent="hospital_management_parent" action="appointment_h_action"/>
    </data>
</odoo>