<odoo>
    <data>
        <record id="doctor_h_list" model="ir.ui.view">
            <field name="name">Doctor</field>
            <field name="model">doctor.model</field>
            <field name="arch" type="xml">
            <list>
                <field name="name" width="25px"/>
                <field name="department" width="25px"/>
                <field name="available" width="30px"/>
                <field name="room_no" width="30px"/>
                <field name="max_patients" width="25px"/>
                <field name="doc_img" width="25px"/>
                <field name="bio" width="25px"/>
                <field name="employee_id" width="25px"/>
            </list>
            </field>
        </record>


        <record id="doctor_h_tree" model="ir.ui.view">
            <field name="name">Doctor</field>
            <field name="model">doctor.model</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <header>
                        <button name="toggle_availability" type="object" class="oe_highlight" string="Toggle Availability"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" width="25px"/>
                                <field name="department" width="25px"/>
                                <field name="available" width="30px"/>
                            </group>
                            <group>
                                <field name="room_no" width="30px"/>
                                <field name="max_patients" width="25px"/>
                                <field name="employee_id" width="25px" required="0" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="doc_image" string="Doctor Image">
                                <field name="doc_img" widget="contact_image"/>
                            </page>
                            <page name="biop" string="Bio">
                                <field name="bio"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="doctor_h_search" model="ir.ui.view">
            <field name="name">Doctor</field>
            <field name="model">doctor.model</field>
            <field name="arch" type="xml">
                <search string="Search doctor">
                    <field name="name"/>
                    <field name="department"/>
                    <field name="employee_id"/>
                    <filter string="Opd" name="department_opd" domain="[('department', '=', 'opd')]"/>
                    <filter string="Surgery" name="department_surgery" domain="[('department', '=', 'surgery')]"/>
                    <filter string="ICU" name="department_icu" domain="[('department', '=', 'icu')]"/>
                </search>
            </field>
        </record>

        <record id="doctor_h_kanban" model="ir.ui.view">
            <field name="name">Doctor</field>
            <field name="model">doctor.model</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="name"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="department"/>
                                </div>
                            </div>
                            <div>
                               <field name="available"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="doctor_h_pivot" model="ir.ui.view">
            <field name="name">Doctor</field>
            <field name="model">doctor.model</field>
            <field name="arch" type="xml">
                <pivot string="Doctor">
                    <field name="name" type="col"/>
                    <field name="department" type="row"/>
                </pivot>
            </field>
        </record>

         <record id="doctor_h_calendar" model="ir.ui.view">
             <field name="name">Doctor</field>
             <field name="model">doctor.model</field>
             <field name="arch" type="xml">
                 <calendar string="Doctor" date_start="date_start">
                     <field name="name"/>
                 </calendar>
             </field>
        </record>

        <record id="doctor_h_graph" model="ir.ui.view">
             <field name="name">Doctor</field>
             <field name="model">doctor.model</field>
             <field name="arch" type="xml">
                 <graph string="Doctor" type="line" sample="1">
                     <field name="department"/>
                     <field name="max_patients"/>
                 </graph>
             </field>
        </record>

        <record id="doctor_h_action"  model="ir.actions.act_window">
            <field name="name">Doctor</field>
            <field name="res_model">doctor.model</field>
            <field name="view_mode">list,form,search,kanban,pivot,calendar,graph</field>
        </record>

        <menuitem name="Doctors" id="doctor_h_id" parent="hospital_management_parent" action="doctor_h_action"/>
    </data>
</odoo>