<odoo>
    <data>
        <record id="hr_employee_hospital_inherit_view" model="ir.ui.view">
            <field name="name">hr.employee.hospital.inherit.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <header>
                    <button name="approve_doctor" type="object" class="oe_highlight" string="Approve Doctor"/>
                    <button name="open_patient_list" type="object" class="oe_highlight" string="Open Patient List"/>
                </header>
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <page name="Hospital Management">
                        <group>
                            <group>
                                <field name="is_medical_staff"/>
                                <field name="license_no"/>
                                <field name="specialization"/>
                            </group>
                            <group>
                                <field name="consultation_fee"/>
                                <field name="exp_years"/>
                                <field name="Joining_datetime"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="patient" string="Patients">
                                <field name="patient_ids">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                            <page name="sign" string="Signature">
                                <field name="sign" widget="contact_image"/>
                            </page>
                            <page name="note" string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>