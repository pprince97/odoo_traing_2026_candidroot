<odoo>
    <data>

        <record id="res_partner_inherit_view" model="ir.ui.view">
            <field name="name">res.partner.inherit.view</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="view_appointment" type="object" class="oe_stat_button" icon="fa-id-card-o">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="appointment_count"/></span>
                            <span class="o_stat_text">View Appointment</span>
                        </div>
                    </button>
                </div>
<!--                <button name="generate_p_code" type="object" class="oe_stat_button" string="Generate Patient Code" invisible="is_patient == False"/>-->
                <xpath expr="//field[@name='vat']" position="before">-->
                   <group name="student">
                       <field name="patient_code"/>
                       <field name="last_visit"/>
                       <field name="next_visit"/>
                   </group>

                </xpath>
                <xpath expr="//div[@class='o_address_format']" position="after">
                    <group name="stud">
                        <field name="is_patient"/>
                        <field name="is_doctor"/>
                    </group>
                </xpath>
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page name="Hospital Management">
                        <group>
                            <group>
                                <field name="blood_group"/>
                                <field name="weight"/>
                                <field name="height"/>
                                <field name="appointment_count" width="25px"/>
                            </group>
                            <group>
                                <field name="medical_history"/>
                                <field name="insurance_doc"/>
                                <field name="emergency_contact"/>
                                <field name="risk_level"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
