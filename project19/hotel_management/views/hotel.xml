<odoo>
    <data>

        <record id="hotel_list" model="ir.ui.view">
            <field name="name">Hotel</field>
            <field name="model">obj.hotel</field>
            <field name="arch" type="xml">

                <list>
                    <field name="name" width="30px"/>
                    <field name="t_rooms" width="30px"/>
                    <field name="rating" width="30px"/>
                    <field name="category" width="30px"/>
                    <field name="is_active" width="30px"/>
                    <field name="o_date" width="30px"/>
                    <field name="description" width="30px"/>
                    <field name="lic_doc" filename="file_name" width="30px"/>
                    <field name="image" filename="file_name_i" width="30px"/>

                    <field name="room_ids" width="30px"/>
                    <field name="booking_ids" width="30px"/>
                    <field name="service_ids" width="30px"/>
                </list>

            </field>
        </record>

        <record id="hotel_form" model="ir.ui.view">
            <field name="name">Hotel</field>
            <field name="model">obj.hotel</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="t_rooms"/>
                                <field name="rating"/>
                            </group>
                            <group>
                                <field name="category"/>
                                <field name="is_active"/>
                                <field name="o_date"/>`
                            </group>
                        </group>

                        <notebook>

                            <page string="Description" name="des">
                                <group>
                                    <field name="description"/>
                                </group>
                            </page>

                            <page string="Upload documents" name="upload_docs">
                                <group>
                                    <group>
                                        <field name="lic_doc" filename="file_name"/>
                                    </group>
                                    <group>
                                        <field name="image" filename="file_name_i"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Rooms" name="rooms">
                                <group>
                                    <field name="room_ids">
                                        <list>
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <page string="Bookings" name="Bookings">
                                <group>
                                    <field name="booking_ids">
                                        <list>
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                            <page string="Services" name="services">
                                <group>
                                    <field name="service_ids">
                                        <list>
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hotel_search" model="ir.ui.view">
            <field name="name">Hotel</field>
            <field name="model">obj.hotel</field>
            <field name="arch" type="xml">
                <search string="Search hotel">
                    <field name="name"/>
                    <field name="t_rooms" />
                    <field name="category"/>
                </search>
            </field>
        </record>

        <record id="hotel_action" model="ir.actions.act_window">
            <field name="name">Hotel</field>
            <field name="res_model">obj.hotel</field>
            <field name="view_mode">list,form,search</field>
        </record>

        <menuitem name="Hotel Management" id="parent_id"/>
        <menuitem name="Hotel" id="hotel_menu_id" parent="parent_id" action="hotel_action"/>

    </data>
</odoo>
