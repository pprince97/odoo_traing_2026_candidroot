<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bills_document">
        <t t-call="web.external_layout">
            <div class="row">
                <div class="col-6">
                    <strong>Project Name:</strong>
                    <span t-field="doc.project_id.name"/>
                    <br/>
                    <strong>Customer Name:</strong>
                    <span t-field="doc.partner_id"/>
                     <br/>
                    <strong>Bill No.:</strong>
                    <span t-field="doc.name"/>
                </div>
            </div>
            <br/>
            <h3> Tasks </h3>
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th>Task name</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">Price</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc.invoice_line_ids.filtered(lambda line: line.price_subtotal >= 0)" t-as="line">
                        <tr>
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.quantity"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.price_unit"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div class="row">
                <div class="col-6"/>
                <div class="col-6">
                <hr/>
                    <table class="table table-borderless">
                        <tr>
                            <td><strong>Total Amount:</strong></td>
                            <td class="text-end"><span t-field="doc.amount_total"/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="report_project_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="project_management.report_bills_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_bill" model="ir.actions.report">
        <field name="name">Product Bill</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_management.report_project_bill</field>
        <field name="report_file">project_management.report_project_bill</field>
        <field name="print_report_name">'Bill'</field>
        <field name="binding_model_id" ref="sale.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>