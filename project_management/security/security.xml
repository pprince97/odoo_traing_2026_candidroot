<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--   Group Category   -->
         <record model="ir.module.category" id="module_category_project_management">
            <field name="name">Project Management</field>
            <field name="sequence">1</field>
        </record>

        <!-- Group Privilage        -->
         <record model="res.groups.privilege" id="res_groups_privilege_project">
            <field name="name">Project</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="project_management.module_category_project_management"/>
        </record>

        <!--  Groups  -->
        <record id="group_project_assignee" model="res.groups">
            <field name="name">Assignee</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
        </record>

        <record id="group_project_manager" model="res.groups" context="{'doctor':True}">
            <field name="name">Manager</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('project_management.group_project_assignee'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
        </record>

        <record id="group_project_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('project_management.group_project_manager'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
        </record>

        <!--     RECORD RULES     -->
        <!-- TimeSheets-->
         <record id="assignee_timesheets" model="ir.rule">
            <field name="name">View and edit own Timesheets</field>
            <field name="model_id" ref="model_project_timesheet"/>
            <field name="domain_force">['|',('assignee_id.id', '=', user.id),('assignee_id.id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_assignee'))]"/>
        </record>

        <!-- Manager  -->
        <record id="manager_timesheets" model="ir.rule">
            <field name="name">View all Timesheets of assigned project</field>
            <field name="model_id" ref="model_project_timesheet"/>
            <field name="domain_force">['|',('task_id.manager_id', '=', user.id),('task_id.manager_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_manager'))]"/>
        </record>

        <!-- Admin -->
        <record id="admin_timesheets" model="ir.rule">
            <field name="name">View and edit all Timesheets</field>
            <field name="model_id" ref="model_project_timesheet"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_admin'))]"/>
        </record>

        <!--  Projects  -->
        <record id="assignee_projects" model="ir.rule">
            <field name="name">View and edit own Timesheets</field>
            <field name="model_id" ref="model_project_projects"/>
            <field name="domain_force">['|',('assignee_ids', 'in', user.id),('assignee_ids', '=', False)]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_assignee'))]"/>
        </record>

        <!-- Manager -->
        <record id="manager_projects" model="ir.rule">
            <field name="name">View and edit all Timesheets</field>
            <field name="model_id" ref="model_project_projects"/>
            <field name="domain_force">['|',('manager_id.id', '=', user.id),('manager_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_manager'))]"/>
        </record>

        <!-- Admin -->
        <record id="admin_projects" model="ir.rule">
            <field name="name">View and edit all Timesheets</field>
            <field name="model_id" ref="model_project_projects"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_admin'))]"/>
        </record>

        <!--  Tasks  -->
        <record id="assignee_tasks" model="ir.rule">
            <field name="name">View and edit own Timesheets</field>
            <field name="model_id" ref="model_project_tasks"/>
            <field name="domain_force">['|',('assignee_ids', 'in', user.id),('assignee_ids', '=', False)]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_assignee'))]"/>
        </record>

        <!-- Manager  -->
        <record id="manager_tasks" model="ir.rule">
            <field name="name">View and edit all Timesheets</field>
            <field name="model_id" ref="model_project_tasks"/>
            <field name="domain_force">[('project_id.manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_manager'))]"/>
        </record>

        <!-- Admin -->
        <record id="admin_tasks" model="ir.rule">
            <field name="name">View and edit all Timesheets</field>
            <field name="model_id" ref="model_project_tasks"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('project_management.group_project_admin'))]"/>
        </record>

