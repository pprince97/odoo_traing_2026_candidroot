<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_per_hour_rate_view_list" model="ir.ui.view">
        <field name="name">project.per.hour.rate.list</field>
        <field name="model">project.per.hour.rate</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_hours"/>
                <field name="end_hours"/>
                <field name="per_hour_rate"/>
            </list>
        </field>
    </record>

    <record id="project_per_hour_rate_view_form" model="ir.ui.view">
        <field name="name">project.per.hour.rate.form</field>
        <field name="model">project.per.hour.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                       <field name="start_hours"/>
                        <field name="end_hours"/>
                        <field name="per_hour_rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_per_hour_rate_action" model="ir.actions.act_window">
        <field name="name">Rates</field>
        <field name="res_model">project.per.hour.rate</field>
        <field name="view_mode">list</field>
    </record>
</odoo>