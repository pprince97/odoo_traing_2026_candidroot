<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_projects_view_list" model="ir.ui.view">
        <field name="name">project.projects.list</field>
        <field name="model">project.projects</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="manager_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">project.projects.form</field>
        <field name="model">project.projects</field>
        <field name="arch" type="xml">
            <form>
                <header>
                     <button type="object"
                             name="state_in_progress"
                            string="In Progress"
                            invisible="state in ['in_progress','done','cancelled']"
                            class="oe_highlight"
                            groups="project_management.group_project_manager"/>
                     <button type="object"
                             name="state_done"
                            string="Done"
                            invisible="state in['new','done','cancelled']"
                            class="oe_highlight"
                            groups="project_management.group_project_manager"/>
                     <button type="object"
                            name="state_canceled"
                            string="Cancelled"
                            invisible="state in['in_progress','done','cancelled']"
                            class="oe_highlight"
                            groups="project_management.group_project_manager"/>
                    <button type="object"
                            name="generate_bill"
                            string="Generate Bill"
                            class="oe_highlight"
                            groups="project_management.group_project_manager"
                            invisible="not show_generate_bill_button"/>

                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="view_tasks" type="object" string="Tasks"
                                widget="statinfo" icon="fa-star">
                            <field name="task_count" string="Tasks" widget="statinfo"/>
                        </button>
                         <button name="view_bills" type="object" string="Tasks"
                                widget="statinfo" icon="fa-star">
                            <field name="bill_count" string="Bills" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="assignee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="rate_per_hour" string="Rates">
                            <field name="per_hour_rate">
                                <list editable="bottom">
                                    <field name="start_hours"/>
                                    <field name="end_hours"/>
                                    <field name="per_hour_rate"/>
                                </list>
                            </field>>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_project_view_kanban" model="ir.ui.view">
        <field name="name">project.project.kanban</field>
        <field name="model">project.projects</field>
        <field name="arch" type="xml">
            <kanban class="o_event_kanban_view">
                <templates>
                    <t t-name="card" class="p-0 row">
                        <main class="col pt-3 pb-2 px-3 justify-content-between">
                            <div>
                                <div class="fw-bold fs-5 text-truncate">
                                    <field name="name"/>
                                </div>
                                <div class="d-flex ps-1">
                                    <i title="Customer"/>
                                    <field name="customer_id"/>
                                </div>
                                <div class="d-flex ps-1">
                                    <i title="Manager"/>
                                    <field name="manager_id" class="me-1"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.projects</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="project_menu_root" name="Project Management"/>
    <menuitem id="project_project_menu" name="Projects"
              parent="project_menu_root" action="project_project_action"/>

</odoo>