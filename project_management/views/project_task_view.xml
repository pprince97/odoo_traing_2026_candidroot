<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="project_task_view_list" model="ir.ui.view">
        <field name="name">project.tasks.list</field>
        <field name="model">project.tasks</field>
        <field name="arch" type="xml">
            <list>
                <field name="task_name"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <field name="task_start_date"/>
                <field name="task_end_date"/>
            </list>
        </field>
    </record>

    <record id="project_task_view_form" model="ir.ui.view">
        <field name="name">project.tasks.form</field>
        <field name="model">project.tasks</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1','fold_field':'fold'}" invisible="not project_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                         <button name="view_bills" type="object" string="Tasks"
                                widget="statinfo" icon="fa-star">
                            <field name="bill_count" string="Bills" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="task_name"/>
                            <field name="project_id"/>
                            <field name="task_start_date"/>
                            <field name="task_end_date"/>
                            <field name="task_done_date" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="customer_id"/>
                            <field name="assignee_ids"
                                   widget="many2many_tags"
                                   domain="[('id', 'in', allowed_assignees)]"
                                   options="{'no_create': True, 'no_edit': True}"/>
<!--                            <field name="assignee_ids"-->
<!--                                   widget="many2many_tags"-->
<!--                                   invisible="project_id"/>-->
                            <field name="allowed_assignees" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="timesheet" string="Timesheets">
                            <field name="timesheet_ids">
                                <list editable="bottom">
                                    <field name="assignee_id" domain="[('id', 'in', allowed_assignees)]"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="hours_spent"/>
                                    <field name="amount" column_invisible="1"/>
                                </list>
                            </field>
                            <group name="note_group" col="6" class="mt-2">
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="task_total">
                                    <field name="task_hours" widget="float_time"/>
<!--                                    <field name="task_total_cost" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>-->
                                </group>
                                <div class="clearfix"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_task_action" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">project.tasks</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_task_menu" name="Tasks"
              parent="project_menu_root" action="project_task_action"/>
</odoo>