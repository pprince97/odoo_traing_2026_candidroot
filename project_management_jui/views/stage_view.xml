<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stage_list" model="ir.ui.view">
        <field name="name">Stage</field>
        <field name="model">project.stage</field>
        <field name="arch" type="xml">
        <list>
            <field name="name" width="25px"/>
            <field name="project_ids" width="25px"/>
        </list>
        </field>
    </record>

    <record id="stage_form" model="ir.ui.view">
        <field name="name">Stage</field>
        <field name="model">project.stage</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="projects" string="Projects">
                            <field name="project_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stage_action" model="ir.actions.act_window">
        <field name="name">Stage</field>
        <field name="res_model">project.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="stage_id" name="Stage" parent="project_management_jui.project_parent_id" action="stage_action"/>
</odoo>