<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_list" model="ir.ui.view">
        <field name="name">Task</field>
        <field name="model">project.task_jui</field>
        <field name="arch" type="xml">
        <list>
            <field name="name" width="25px"/>
            <field name="project_id" width="25px"/>
            <field name="manager_id" width="30px"/>
            <field name="assignees_id" width="30px"/>
            <field name="task_start_date" width="30px"/>
            <field name="task_end_date" width="25px"/>
            <field name="customer_id" width="25px"/>
            <field name="stage_id" width="25px"/>
            <field name="timesheet_id" width="25px"/>
            <field name="done_date" width="25px"/>
        </list>
        </field>
    </record>


    <record id="task_form" model="ir.ui.view">
        <field name="name">Task</field>
        <field name="model">project.task_jui</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <header>
                    <field name="stage_id" widget="statusbar" domain="['|',('project_ids','=',project_id),('project_ids','=',False)]" options="{'clickable': '1','fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button name="view_bills_task" type="object" class="oe_stat_button" icon="fa-id-card-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="bill_count"/></span>
                                <span class="o_stat_text">View Bills</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="manager_id"/>
                            <field name="assignees_id" widget="many2many_tags" domain="[('project_id','=',project_id),('id','in',allowed_assigns)]"/>
                        </group>
                        <group>
                            <field name="task_start_date"/>
                            <field name="task_end_date"/>
                            <field name="done_date" invisible="1"/>
                            <field name="customer_id"/>
                            <field name="stage_id" domain="['|',('project_ids','=',project_id),('project_ids','=',False)]" context="{'default_project_ids': project_id.id}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="timesheet" string="Timesheet">
                            <field name="timesheet_id" context="{'default_task_id':id}">
                                <list editable="top">
                                    <field name="task_id"/>
                                    <field name="assignees_id" domain="[('task_id','=',task_id)]"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="description"/>
                                    <field name="spent_hour"/>
                                </list>
                            </field>
                            <group name="note_group" col="6" class="mt-2 mt-md-0">
                                <group class="oe_subtotal_footer order-0 order-lg-1 flex-column" colspan="2" name="total_hours">
                                    <field name="total_hours"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="task_action" model="ir.actions.act_window">
        <field name="name">Task</field>
        <field name="res_model">project.task_jui</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="task_id" name="Task" parent="project_management_jui.project_parent_id" action="task_action"/>
</odoo>