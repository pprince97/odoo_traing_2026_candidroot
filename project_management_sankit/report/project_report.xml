<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_tasks_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Tasks Report</h2>

                <table class="table table-bordered" style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Manager</th>
                            <th>Assignees</th>
                            <th>Project</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="rec">
                            <tr>
                                <td>
                                    <span t-field="rec.name"/>
                                </td>
                                <td>
                                    <span t-field="rec.task_manager_id"/>
                                </td>
                                <td>
                                    <span t-field="rec.task_assignees_ids"/>
                                </td>
                                <td>
                                    <span t-field="rec.project_id"/>
                                </td>
                                <td>
                                    <span t-field="rec.start_date"/>
                                </td>
                                <td>
                                    <span t-field="rec.end_date"/>
                                </td>
<!--                                <td>-->
<!--                                    <span t-field="rec.timesheet_ids"/>-->
<!--                                </td>-->
<!--                                <td>-->
<!--                                    <t t-foreach="rec.timesheet_ids" t-as="part">-->

<!--                                        <t t-esc="part['spend_hours']"/>-->
<!--                                    </t>-->
<!--                                </td>-->
                            </tr>

                            <tr>
                                <td colspan="3">
                                    <strong>Timesheets:</strong>
<!--                                    <div t-field="rec.timesheet_ids"/>-->
                                    <div>
                                        <t t-foreach="rec.timesheet_ids" t-as="part">
                                            <div t-field="part.timesheet_code"/>
                                        </t>
                                    </div>
                                </td>

                                <td colspan="2">
                                    <strong>Spend Hours:</strong>
                                    <div>
                                        <t t-foreach="rec.timesheet_ids" t-as="part">
<!--                                            <t t-esc="part['spend_hours']"/>-->
                                            <div t-field="part.spend_hours"/>
                                        </t>
                                    </div>
                                </td>
                                <td colspan="1">
                                    <strong>Total Hours:</strong>
                                    <div t-field="rec.total_hours"/>
                                </td>
                            </tr>

                        </t>

                    </tbody>
                </table>

            </div>
        </t>
    </template>

    <template id="report_task">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="project_management_sankit.report_tasks_document"/>
            </t>
            <!--            <t t-foreach="rec.timesheet_ids" t-as="part">-->
            <!--                <t t-esc="part['spend_hours']"/>-->
            <!--            </t>-->
            <!--            <t t-if="actions" t-foreach="actions" t-as="action">-->
            <!--            <a t-att-href="action['url']">-->
            <!--                <t t-esc="action['title']"/>-->
            <!--            </a>-->



            <!--            </t>-->
        </t>
    </template>

    <record id="action_report_task" model="ir.actions.report">
        <field name="name">Tasks Report</field>
        <field name="model">project.tasks</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_management_sankit.report_task</field>
        <field name="report_file">project_management_sankit.report_task</field>
        <field name="print_report_name">'task'</field>
        <field name="binding_model_id" ref="model_project_tasks"/>
        <field name="binding_type">report</field>
    </record>


</odoo>
