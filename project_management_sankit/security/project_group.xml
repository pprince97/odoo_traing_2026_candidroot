<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Groups Category        -->
        <record model="ir.module.category" id="project_management_groups_catgory">
            <field name="name">Project Management</field>
            <field name="sequence">35</field>
        </record>

        <!-- Group Privilage        -->
        <record model="res.groups.privilege" id="res_groups_privilege_project">
            <field name="name">Project</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="project_management_sankit.project_management_groups_catgory"/>
        </record>

        <!-- Groups -->


        <record id="group_project_assignees" model="res.groups">
            <field name="name">Assignees</field>
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_project_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
            <field name="implied_ids" eval="[(4, ref('group_project_assignees'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_project_assignees_timesheets" model="ir.rule">
            <field name="name">Tasks of this Assignees</field>
            <field name="model_id" ref="project_management_sankit.model_project_timesheet"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_project_assignees'))]"/>
        </record>

        <record id="group_project_assignees_tasks" model="ir.rule">
            <field name="name">Tasks of this Assignees</field>
            <field name="model_id" ref="project_management_sankit.model_project_tasks"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_project_assignees'))]"/>
        </record>


    </data>
</odoo>
