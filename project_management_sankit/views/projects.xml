<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_list" model="ir.ui.view">
        <field name="name">Projects</field>
        <field name="model">project.projects</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_manager_id"/>
                <field name="project_assignees_ids"/>
                <field name="start_date"/>
                <field name="end_date"/>

            </list>
        </field>
    </record>
    <record id="project_bill_wizard_form1" model="ir.actions.act_window">
        <field name="name">Create Bill</field>
        <field name="res_model">wizard.create_project_bill</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_management_sankit.project_bill_wizard_form_view"/>
        <field name="target">new</field>
    </record>

    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">Projects</field>
        <field name="model">project.projects</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(project_management_sankit.project_bill_wizard_form1)d" type="action"
                            class="btn-primary"
                            string="Create Bill"/>
                    <button
                            name="in_progress_state"
                            string="In Progress"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['in_progress','done','invoice']"
                    />
                    <button
                            name="done_state"
                            string="Done"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['draft','done','invoice']"
                    />
                    <button
                            name="invoice_state"
                            string="In Voice"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['draft','in_progress','invoice']"
                    />
                    <button
                            name="draft_state"
                            string="Cancel"
                            type="object"
                            class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,invoice"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button name="action_tasks_button"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="task_ids" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="project_manager_id"/>
                            <field name="project_assignees_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Per Hour Rate">
                            <field name="rate_calculation_ids"/>
                        </page>
                        <page string="Tasks">
                            <field name="task_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="project_management_action_project" model="ir.actions.act_window">
        <field name="name">Project</field>
        <field name="res_model">project.projects</field>
        <field name="view_mode">list,form</field>

    </record>
    <menuitem id="project_menu_root" name="Project Management Sankit"/>

    <menuitem id="project_project_menu"
              name="Project"
              parent="project_menu_root"
              action="project_management_action_project"/>
</odoo>
