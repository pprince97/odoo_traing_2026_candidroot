<odoo>
    <record id="dynamic_stage_list" model="ir.ui.view">
        <field name="name">stage.list</field>
        <field name="model">dynamic.stages</field>
        <field name="arch" type="xml">
            <list string="Stages" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="done"/>
                <field name="fold"/>
            </list>
        </field>
    </record>
    <record id="dynamic_stage_form" model="ir.ui.view">
        <field name="name">stage.form</field>
        <field name="model">dynamic.stages</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="done"/>
                        <field name="fold"/>
                        <field name="project_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="dynamic_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">dynamic.stages</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="dynamic_stage_menu"
              name="Stages"
              parent="project_menu_root"
              action="dynamic_stage_action"/>
</odoo>