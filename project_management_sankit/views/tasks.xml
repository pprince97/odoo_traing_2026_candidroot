<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_search" model="ir.ui.view">
        <field name="name">Tasks</field>
        <field name="model">project.tasks</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="task_manager_id"/>
                <field name="task_assignees_ids" force_save="1"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_hours" force_save="1" readonly="1"/>
                <field name="total_amount" force_save="1" readonly="1"/>
                <filter string="Today" name="end_date_only"
                        domain="[('end_date_only', '=', context_today())]"/>
                <group>
                    <filter string="Project" name="project" context="{'group_by':'project_id'}"/>
                    <filter string="Manager" name="manager" context="{'group_by':'task_manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_task_view_list" model="ir.ui.view">
        <field name="name">Tasks</field>
        <field name="model">project.tasks</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="task_manager_id"/>
                <field name="task_assignees_ids" force_save="1"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_hours" force_save="1" readonly="1"/>
                <field name="total_amount" force_save="1" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="project_task_view_form" model="ir.ui.view">
        <field name="name">Task</field>
        <field name="model">project.tasks</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1','fold_field': 'fold'}"
                           domain="['|', ('project_ids', 'in', project_id), ('project_ids', '=', False)]"/>
                    <button class="oe_stat_button" name="generate_task_bill" type="object" string="Generate Bill"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button name="action_timesheet_button"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="timesheet_ids" widget="statinfo" string="Timesheets"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="task_assignees_ids" widget="many2many_tags" force_save="1"/>

                        </group>
                        <group>
                            <field name="task_manager_id" force_save="1"/>
                            <field name="start_date" widget="daterange" options="{'end_date_field':'end_date'}"/>
                            <field name="total_hours" force_save="1" readonly="1"/>
                            <field name="total_amount" force_save="1" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timesheet">
                            <field name="timesheet_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_management_action_tasks" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">project.tasks</field>
        <field name="view_mode">list,form,search</field>
    </record>

    <menuitem id="project_task_menu"
              name="Task"
              parent="project_menu_root"
              action="project_management_action_tasks"/>
</odoo>
