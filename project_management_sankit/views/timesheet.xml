<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_task_timesheet" model="ir.sequence">
            <field name="name">TimeSheet Seq</field>
            <field name="code">timesheet.seq</field>
            <field name="prefix">T/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>

        <record id="project_timesheet_view_list" model="ir.ui.view">
            <field name="name">Timesheet</field>
            <field name="model">project.timesheet</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="timesheet_code"/>
                    <field name="timesheet_assignees_ids" widget="many2many_tags" force_save="1"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="tasks_id"/>
                    <field name="spend_hours" force_save="1"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="project_timesheet_view_form" model="ir.ui.view">
            <field name="name">Timesheet</field>
            <field name="model">project.timesheet</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="timesheet_code"/>
                            <field name="timesheet_assignees_ids" widget="many2many_tags" force_save="1"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="tasks_id"/>
                            <field name="project_id" readonly="1" force_save="1"/>
                            <field name="spend_hours" force_save="1"/>
                            <field name="price" force_save="1" readonly="1"/>

                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="project_management_action_timesheet" model="ir.actions.act_window">
            <field name="name">Timesheets</field>
            <field name="res_model">project.timesheet</field>
            <field name="view_mode">list,form</field>

        </record>

        <menuitem id="project_timesheet_menu"
                  name="Timesheet"
                  parent="project_menu_root"
                  action="project_management_action_timesheet"/>

</odoo>
