<odoo>
    <record id="project_bill_wizard_form_view" model="ir.ui.view">
        <field name="name">project.bill.form.view</field>
        <field name="model">wizard.create_project_bill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="select" widget="radio" options="{'horizontal': true}"/>
                        <field name="project_id"/>
                        <field name="start_date" widget="daterange" options="{'end_date_field':'end_date'}" invisible="select in ['task_wise']"/>
                        <field name="selected_task_ids" widget="many2many_tags" invisible="select in ['date_wise']"/>
                    </group>
                    <footer>
                        <button type="object" string="Create Bill" name="generate_project_bill" invisible="select in ['date_wise']"/>
                        <button type="object" string="Generate Bill PDF" name="generate_project_pdf" invisible="select in ['date_wise']"/>
                        <button type="object" string="Generate Bill" name="generate_project_bill_using_dics" invisible="select in ['date_wise']"/>
                        <button type="object" string="Bill Using Date" name="generate_project_bill_using_date" invisible="select in ['task_wise']"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
