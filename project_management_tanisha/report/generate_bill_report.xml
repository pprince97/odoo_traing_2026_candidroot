<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_generated_bill">
        <t t-call="web.external_layout">
            <t t-esc="docs"/>
            <br/>
            <t t-esc="doc_model"/>
            <t t-foreach="docs" t-as="rec">
                Customer name:
                <span t-field="rec.partner_id"/>
                <br/>
                Bill date:
                <span t-field="rec.invoice_date"/>
                <br/>
                <table class="table" style="border: 1px solid black">
                    <thead>
                        <tr>
                            <th>
                                <span>Description</span>
                            </th>
                            <th>
                                <span>Quantity</span>
                            </th>
                            <th>
                                <span>Unit</span>
                            </th>
                            <th>
                                <span>Price</span>
                            </th>
                            <th>
                                <span>Amount</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rec.invoice_line_ids" t-as="r">
                            <tr>
                                <td>
                                    <span t-field="r.name"/>
                                </td>
                                <td>
                                    <span t-field="r.quantity"/>
                                </td>
                                <td>
                                    <span t-field="r.product_uom_id"/>
                                </td>
                                <td>
                                    <span t-field="r.price_unit"/>
                                </td>
                                <td>
                                    <span t-field="r.price_subtotal"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <hr style="width: 20%; margin-left: auto; margin-right: 0"/>
                <div class="o_total text-end">
                    <strong>Total Amount:</strong>
                    <strong t-field="rec.amount_total"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_bill">
        <t t-call="web.html_container">
            <t t-call="project_management_tanisha.report_generated_bill"/>
        </t>
    </template>

    <record id="generate_bill_report" model="ir.actions.report">
        <field name="name">Bill Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_management_tanisha.report_bill</field>
        <field name="report_file">project_management_tanisha.report_bill</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>

