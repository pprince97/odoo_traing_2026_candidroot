<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <!-- Groups Category -->
    <record model="ir.module.category" id="project_management_groups_category">
        <field name="name">Project Management</field>
        <field name="sequence">1</field>
    </record>

    <!-- Groups Privilege -->
    <record model="res.groups.privilege" id="project_management_groups_privilege">
        <field name="name">Project</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="project_management_tanisha.project_management_groups_category"/>
    </record>

    <!-- Groups -->
    <record id="group_project_assignee" model="res.groups">
        <field name="name">Assignee</field>
        <field name="sequence">3</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="project_management_groups_privilege"/>
    </record>

    <record id="group_project_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">4</field>
        <field name="implied_ids" eval="[(4, ref('project_management_tanisha.group_project_assignee'))]"/>
        <field name="privilege_id" ref="project_management_groups_privilege"/>
    </record>

    <record id="group_project_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="sequence">5</field>
        <field name="implied_ids" eval="[(4, ref('project_management_tanisha.group_project_manager'))]"/>
        <field name="privilege_id" ref="project_management_groups_privilege"/>
    </record>

    <!--  Projects  -->
    <record id="assignee_projects" model="ir.rule">
        <field name="name">Assignee Projects</field>
        <field name="model_id" ref="project_management_tanisha.model_project_tanisha_project"/>
        <field name="domain_force">[('assign_ids','in',user.id)]</field>
        <field name="groups" eval="[(4, ref('project_management_tanisha.group_project_assignee'))]"/>
    </record>

    <record id="manager_projects" model="ir.rule">
        <field name="name">Manager Projects</field>
        <field name="model_id" ref="project_management_tanisha.model_project_tanisha_project"/>
        <field name="domain_force">[('manager_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('project_management_tanisha.group_project_manager'))]"/>
    </record>

    <record id="admin_projects" model="ir.rule">
        <field name="name">Admin Projects</field>
        <field name="model_id" ref="project_management_tanisha.model_project_tanisha_project"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('project_management_tanisha.group_project_admin'))]"/>
    </record>

    <!--  Tasks  -->
    <record id="assignee_tasks" model="ir.rule">
        <field name="name">Assignee Tasks</field>
        <field name="model_id" ref="project_management_tanisha.model_project_tanisha_task"/>
        <field name="domain_force">[('assign_ids','in',user.id)]</field>
        <field name="groups" eval="[(4, ref('project_management_tanisha.group_project_assignee'))]"/>
    </record>

    <record id="manager_tasks" model="ir.rule">
        <field name="name">Manager Tasks</field>
        <field name="model_id" ref="project_management_tanisha.model_project_tanisha_task"/>
        <field name="domain_force">[('manager_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('project_management_tanisha.group_project_manager'))]"/>
    </record>

    <record id="admin_tasks" model="ir.rule">
        <field name="name">Admin Tasks</field>
        <field name="model_id" ref="project_management_tanisha.model_project_tanisha_task"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('project_management_tanisha.group_project_admin'))]"/>
    </record>




</odoo>