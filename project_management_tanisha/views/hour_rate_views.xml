<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="hour_rate_list_view" model="ir.ui.view">
        <field name="name">project.hour.rate.list</field>
        <field name="model">project.hour.rate</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_hour"/>
                <field name="end_hour"/>
            </list>
        </field>
    </record>

    <record id="hour_rate_form_view" model="ir.ui.view">
        <field name="name">project.hour.rate.form</field>
        <field name="model">project.hour.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="start_hour"/>
                        <field name="end_hour"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hour_rate_action" model="ir.actions.act_window">
        <field name="name">Hour Rates</field>
        <field name="res_model">project.hour.rate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>