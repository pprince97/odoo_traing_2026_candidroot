<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="project_list_view" model="ir.ui.view">
        <field name="name">project.tanisha.project.list</field>
        <field name="model">project.tanisha.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="manager_id"/>
                <field name="assign_ids" widget="many2many_tags"/>
                <field name="customer_id"/>
            </list>
        </field>
    </record>

    <record id="project_form_view" model="ir.ui.view">
        <field name="name">project.tanisha.project.form</field>
        <field name="model">project.tanisha.project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="generate_bill"
                            type="object"
                            class="oe_highlight"
                            string="Generate Bill"
                            groups="project_management_tanisha.group_project_manager,project_management_tanisha.group_project_admin"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="show_bills"
                                icon="fa-list"
                        >
                            <field string="Show bills" name="bill_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="state" widget="radio" options="{'horizontal': True}"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="assign_ids" widget="many2many_tags"/>
                            <field name="customer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="hour_rate" string="Hour Rate">
                            <field name="rate_ids">
                                <list editable="top">
                                    <field name="start_hour"/>
                                    <field name="end_hour"/>
                                    <field name="per_hour_rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_menu_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.tanisha.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="project_menu" name="Projects" parent="project_root_menu" action="project_menu_action" sequence="1"/>

</odoo>