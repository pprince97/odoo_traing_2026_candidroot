<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_bill_document">
        <t t-call="web.external_layout">
<!--            <t t-esc="docs"/>-->
<!--            <t t-esc="docs_ids"/>-->
<!--            <t t-esc="doc_model"/>-->
            <t >
                <h6>
                    <span t-field="doc.name"/>
                </h6>
            </t>
        </t>
    </template>

    <template id="report_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="project_management_urvi.report_bill_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_bill" model="ir.actions.report">
        <field name="name">patient Report</field>
        <field name="model">project.project.urvi</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_management_urvi.report_bill</field>
        <field name="report_file">project_management_urvi.report_bill</field>
        <field name="print_report_name">'Bill'</field>
        <field name="binding_model_id" ref="model_project_project_urvi"/>
        <field name="binding_type">report</field>
    </record>


</odoo>
