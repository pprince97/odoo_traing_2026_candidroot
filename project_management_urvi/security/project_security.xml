<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Groups Category        -->
        <record model="ir.module.category" id="project_management_groups_catgory">
            <field name="name">Project Management</field>
            <field name="sequence">35</field>
        </record>

        <!--        Group Privilage-->
        <record model="res.groups.privilege" id="res_groups_privilege_project">
            <field name="name">Project</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="project_management_urvi.project_management_groups_catgory"/>
        </record>

        <!-- Groups        -->
        <record id="group_project_assigns" model="res.groups">
            <field name="name">Assigns</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
        </record>

        <record id="group_project_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('project_management_urvi.group_project_assigns'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
        </record>

        <record id="group_project_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">12</field>
            <field name="implied_ids"
                   eval="[(4,ref('project_management_urvi.group_project_manager'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_project"/>
        </record>


        <record id="project_rule_assigns" model="ir.rule">
            <field name="name">Personal Projects</field>
            <field ref="model_project_project_urvi" name="model_id"/>
            <field name="domain_force">['|',('assigns_ids','in',user.id),('assigns_ids','=',False)]</field>
            <field name="groups" eval="[(4, ref('project_management_urvi.group_project_assigns'))]"/>
        </record>


        <record id="project_rule_manager" model="ir.rule">
            <field name="name">Personal Projects</field>
            <field ref="model_project_project_urvi" name="model_id"/>
            <field name="domain_force">['|',('manager_id','in',user.id),('manager_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('project_management_urvi.group_project_manager'))]"/>
        </record>

        <record id="project_rule_admin" model="ir.rule">
            <field name="name">Personal Projects</field>
            <field ref="model_project_project_urvi" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('project_management_urvi.group_project_admin'))]"/>
        </record>

        <record id="task_rule_assigns" model="ir.rule">
            <field name="name">Personal Tasks</field>
            <field ref="model_project_task_urvi" name="model_id"/>
            <field name="domain_force">['|',('assigns_ids','in',user.id),('assigns_ids','=',False)]</field>
            <field name="groups" eval="[(4, ref('project_management_urvi.group_project_assigns'))]"/>
        </record>

        <record id="task_rule_manager" model="ir.rule">
            <field name="name">Personal Task</field>
            <field ref="model_project_task_urvi" name="model_id"/>
            <field name="domain_force">['|',('manager_id','in',user.id),('manager_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('project_management_urvi.group_project_manager'))]"/>
        </record>

        <record id="task_rule_admin" model="ir.rule">
            <field name="name">Personal Task</field>
            <field ref="model_project_task_urvi" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('project_management_urvi.group_project_admin'))]"/>
        </record>
    </data>
</odoo>
