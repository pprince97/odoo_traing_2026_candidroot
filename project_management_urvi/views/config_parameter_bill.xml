<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='account_vendor_bills']" position="after">
                    <block title="Project Bill" id="project_bill">
                        <setting id="project_bill_setting" >
                            <div class="content-group mb-3">
                                <div>
                                    <div class="mt8">
                                        <field name="project_bill"/>
                                         <label for="project_bill" name="Rate Sheet" />
                                        <br />
<!--                                        <label for="project_id" name=" Project Name" />-->
<!--                                        <field name="project_id" />-->
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
    </record>
</odoo>
