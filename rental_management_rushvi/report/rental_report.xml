<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rental_document">
        <t t-call="web.external_layout">
            <div class="row">
                <div class="col-12">
                    <strong>Start Date:</strong>
                    <span t-field="doc.start_date"/>
                    <br/>
                    <strong>End Date:</strong>
                    <span t-field="doc.end_date"/>
                    <br/>
                </div>
            </div>
            <br/>
            <h3>Rental Orders</h3>
            <table class="table table-borderless">
                <thead>
                    <tr>
                        <th class="text-start">Customer Name</th>
                        <th class="text-center">Rental Number</th>
                        <th class="text-center">Start Date</th>
                        <th class="text-center">End Date</th>
                        <th class="text-center">Total Amount</th>
                        <th class="text-end">State</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="docs.get_rental_history_records()" t-as="line">
                        <tr>
                            <td class="text-start">
                                <span t-field="line.customer_id"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.rental_number"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.rent_start_date"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.rent_end_date"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.total_amount"/>
                            </td>
                            <td class="text-end">
                                <span t-field="line.state"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>

    <template id="report_rental">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="rental_management_rushvi.report_rental_document"/>
            </t>
        </t>
    </template>

    <record id="rental_history_report" model="ir.actions.report">
        <field name="name">Rental History Report</field>
        <field name="model">wizard.rental.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_management_rushvi.report_rental</field>
        <field name="report_file">rental_management_rushvi.report_rental</field>
        <field name="binding_model_id" ref="model_wizard_rental_history"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
