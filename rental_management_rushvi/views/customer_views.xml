<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inherit_res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                    name="view_rental_orders"
                        string="Rental Orders"
                        icon="fa-star">
                    <field name="rental_order_count" string="Rental Order Count" widget="statinfo"/>
                </button>
                <button type="object"
                    name="view_rental_products"
                        string="Rental Products"
                        icon="fa-star">
                    <field name="rental_product_count" string="Rental Product Count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>