<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wizard_invoice_rental_orders_view_form" model="ir.ui.view">
        <field name="name">wizard.invoice.rental.orders.form</field>
        <field name="model">wizard.invoice.rental.orders</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="amount_to_invoice"/>
                            <field name="total_rent_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_amount"/>
                            <field name="rental_order_id" invisble="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button type="object"
                            name="generate_bill"
                            string="Generate Bill"
                            class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>