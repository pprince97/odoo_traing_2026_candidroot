<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wizard_rental_histor_view_form" model="ir.ui.view">
        <field name="name">wizard.rental.history.form</field>
        <field name="model">wizard.rental.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="customer_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button type="object"
                            name="generate_rental_history_report"
                            string="Generate Report"
                            class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reporting_rental_history_wizard" model="ir.actions.act_window">
        <field name="name">Rental History</field>
        <field name="res_model">wizard.rental.history</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_rental_histor_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>