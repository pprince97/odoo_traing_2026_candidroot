<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_view_list" model="ir.ui.view">
        <field name="name">Customer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>
    <record id="customer_view_form" model="ir.ui.view">
        <field name="name">Customer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_rental" type="object" icon="fa-users">
                            <field string="Rental" name="rental_ids" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="customer_action_window" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('customer_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('customer_view_form')})]"/>

    </record>

    <menuitem id="customer_menu"
              name="Customer"
              parent="rental_menu_root"
              action="customer_action_window"/>
</odoo>
