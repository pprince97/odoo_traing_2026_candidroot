<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_order_view_list" model="ir.ui.view">
        <field name="name">Product Order</field>
        <field name="model">product.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="list_price"/>
                <field name="serial_number_ids"/>
            </list>
        </field>
    </record>
    <record id="product_order_view_form" model="ir.ui.view">
        <field name="name">Product Order</field>
        <field name="model">product.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="list_price"/>
                        <field name="serial_number_ids" domain="[('product_id', '=', product_id),('available', '=', True) ]" widget="many2many_tags"/>
                        <!--                    <field name="product_id"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="product_order_action_window" model="ir.actions.act_window">
        <field name="name">Product Order</field>
        <field name="res_model">product.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="product_order_menu"
              name="Order"
              parent="rental_menu_root"
              action="product_order_action_window"/>
</odoo>
