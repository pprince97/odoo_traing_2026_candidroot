<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_configuration_view_list" model="ir.ui.view">
        <field name="name">Product Configuration</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type" readonly="1"/>
                <field name="tracking" readonly="1"/>
                <field name="list_price"/>
                <field name="serial_number_ids"/>
            </list>
        </field>
    </record>
    <record id="product_configuration_view_form" model="ir.ui.view">
        <field name="name">Product Configuration</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type" readonly="1"/>
                        <field name="tracking" readonly="1"/>
                        <field name="list_price"/>
                        <field name="serial_number_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="product_configuration_action_window" model="ir.actions.act_window">
        <field name="name">Product Configuration</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_tracking': 'serial'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('product_configuration_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product_configuration_view_form')})]"/>

    </record>
    <menuitem id="rental_menu_root" name="Rental Management Sankit"/>

    <menuitem id="product_configuration_menu"
              name="Product Configuration"
              parent="rental_menu_root"
              action="product_configuration_action_window"/>
</odoo>
