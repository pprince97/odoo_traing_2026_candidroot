<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="user_profile_view_list" model="ir.ui.view">
        <field name="name">User Profile</field>
        <field name="model">user.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="city_id"/>
            </list>
        </field>
    </record>
    <record id="user_profile_view_form" model="ir.ui.view">
        <field name="name">User Profile</field>
        <field name="model">user.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="country_id"/>
                        <field name="state_id"/>
                        <field name="city_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="user_profile_action_window" model="ir.actions.act_window">
        <field name="name">User Profile</field>
        <field name="res_model">user.profile</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="user_profile_menu"
              name="User Profile"
              parent="rental_menu_root"
              action="user_profile_action_window"/>
</odoo>
