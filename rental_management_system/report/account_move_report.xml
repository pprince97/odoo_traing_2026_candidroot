<odoo>
    <template id="billing_account_record_template">
        <t t-call="web.external_layout">
<!--            <t t-foreach="docs" t-as="record">-->

                <div class="page">
                    <h2>
                        <t t-esc="o.name"/>
                    </h2>

                    <table class="table table-borderless">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Hours</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.invoice_line_ids"
                                t-as="line">
                                <td>
                                    <t t-esc="line.name"/>
                                </td>
                                <td>
                                    <t t-esc="line.price_unit"/>
                                </td>
                                <td>
                                    <t t-esc="line.price_subtotal"/>
                                </td>
                            </tr>
                            <tr>
                                <strong><td colspan="2">Sub Total:</td></strong>
                                <strong><td><t t-esc="o.amount_residual"/></td></strong>
                            </tr>
                        </tbody>
                    </table>
                </div>
<!--            </t>-->
        </t>
    </template>

    <template id="report_account_payment_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="project_management_smit.billing_account_record_template" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="report_account_billing_record" model="ir.actions.report">
        <field name="name">Billing record Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_management_smit.report_account_payment_receipt</field>
        <field name="report_file">project_management_smit.report_account_payment_receipt</field>
        <field name="binding_model_id"
               ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>