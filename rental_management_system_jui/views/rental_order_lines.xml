<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rental_order_lines_list" model="ir.ui.view">
            <field name="name">Rental Order</field>
            <field name="model">rental.order.lines</field>
            <field name="arch" type="xml">
                <list>
                    <field name="product_id" width="30px"/>
                    <field name="available_pieces_ids" width="30px"/>
                    <field name="total_amount" width="30px"/>
                </list>
            </field>
        </record>

        <record id="rental_order_lines_form" model="ir.ui.view">
            <field name="name">Rental Order</field>
            <field name="model">rental.order.lines</field>
            <field name="arch" type="xml">
                <form string="Form View">

                    <sheet>
                        <group>
                            <group>
                                <field name="product_id"/>
                            </group>
                            <group>
                                <field name="total_amount"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="available_pieces" string="Available Pieces">
                                <field name="available_pieces_ids" domain="[('product_id','in',product_id),('is_available','=',False)]">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rental_order_lines_action_id" model="ir.actions.act_window">
            <field name="name">Rental Order</field>
            <field name="res_model">rental.order.lines</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>