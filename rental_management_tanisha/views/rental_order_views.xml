<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="rental_order_list_view" model="ir.ui.view">
        <field name="name">rental.order.list</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="serial_no"/>
                <field name="customer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <field name="product_ids" widget="many2many_tags"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <record id="rental_order_form_view" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="serial_no" readonly="1"/>
                            <field name="customer_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rental_order_menu_action" model="ir.actions.act_window">
        <field name="name">Rental Order</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="rental_order_menu" name="Rental Order" parent="rental_root_menu" action="rental_order_menu_action"/>

</odoo>