<odoo>
        <data>
            <record model="ir.ui.view" id="classes_tree">
            <field name="name">school.list</field>
            <field name="model">school.classes</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="section"/>
                    <field name="class_strength"/>
                    <field name="average_score"/>
                    <field name="start_date"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="classes_form" model="ir.ui.view">
            <field name="name">school.form</field>
            <field name="model">school.classes</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="section"/>
                                <field name="class_strength"/>
                                <field name="average_score"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="is_active"/>
                                <field name="timetable"/>
                                <field name="class_image"/>
                                <field name="stars" widget="priority"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="students" string="Students">
                                <group>
                                    <field name="student_ids"/>
                                </group>
                            </page>
                            <page name="school" string="Schools">
                                <group>
                                    <field name="school_ids">
                                        <list>
                                            <field name="name"/>
                                            <field name="code"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

            <record id="classes_form_2" model="ir.ui.view">
            <field name="name">school.form</field>
            <field name="model">school.classes</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="section" widget="priority"/>
                            <field name="class_strength"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="school_classes" model="ir.actions.act_window">
            <field name="name">school.window</field>
            <field name="res_model">school.classes</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="classes_menu" name="Class" parent="school.sms_menu_root"
                  action="school.school_classes" sequence="4"/>
    </data>
</odoo>

