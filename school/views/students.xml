<odoo>
    <data>
        <record model="ir.ui.view" id="students_tree1">
            <field name="name">school.list</field>
            <field name="model">school.students</field>
            <field name="arch" type="xml">
                <list>
                    <field name="roll_number"  widget='handle'/>
                    <field name="name"/>
                    <field name="percentage"/>
                    <field name="gender"/>
                    <field name="is_active"/>
                    <field name="date_of_birth"/>
                    <field name="admission_datetime"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="students_tree2">
            <field name="name">school.list</field>
            <field name="model">school.students</field>
            <field name="arch" type="xml">
                <list>
                    <field name="roll_number"/>
                    <field name="name"/>
                    <field name="percentage"/>
                    <field name="gender"/>
                </list>
            </field>
        </record>

        <record id="students_form1" model="ir.ui.view">
            <field name="name">school.form</field>
            <field name="model">school.students</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
<!--                                <field name="roll_number" widget="monetary"/>-->
                                <field name="roll_number"/>
                                <field name="name"/>
                                <field name="percentage" widget="float"/>
<!--                                <field name="percentage" widget="statinfo"/>-->
                                <field name="gender" widget="selection"/>
                                <field name="is_active" widget="boolean_toggle" readonly="1"/>
<!--                                <field name="school_id" widget="many2one_avatar"/>-->
                                <field name="school_id"/>
                            </group>
                            <group>
                                <field name="date_of_birth"/>
                                <field name="admission_datetime"/>
                                <field name="remarks" widget="text"/>
                                <field name="id_proof"/>
                                <field name="photo"/>
                                <field name="class_id" context="{'form_view_ref':'school.classes_form_2'}"/>
<!-- <field name="htmlfield"/>&ndash;&gt; -->
                            </group>
                        </group>
                        <notebook>
                            <page name="teachers" string="Teachers">
                                <field name="teacher_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="employee_code"/>
                                    </list>
                                </field>
                            </page>
                            <page name="subjects" string="Subjects">
                                <field name="subject_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="subject_code"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="students_form2" model="ir.ui.view">
            <field name="name">school.form</field>
            <field name="model">school.students</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                                <field name="roll_number"/>
                                <field name="name"/>
                                <field name="percentage"/>
                                <field name="gender"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

<!--        <record id="school_students" model="ir.actions.act_window">-->
<!--            <field name="name">school.window</field>-->
<!--            <field name="res_model">school.students</field>-->
<!--            <field name="view_mode">list,form</field>-->
<!--        </record>-->

        <record id="school_students1" model="ir.actions.act_window">
            <field name="name">school.window</field>
            <field name="res_model">school.students</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5,0,0),
                        (0,0,{'view_mode':'list','sequence':1,'view_id':ref('students_tree1')}),
                        (0,0,{'view_mode':'form','sequence':2,'view_id':ref('students_form1')})]"/>
        </record>
        <record id="school_students2" model="ir.actions.act_window">
            <field name="name">school.window</field>
            <field name="res_model">school.students</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5,0,0),
                        (0,0,{'view_mode':'list','sequence':1,'view_id':ref('students_tree2')}),
                        (0,0,{'view_mode':'form','sequence':2,'view_id':ref('students_form2')})]"/>
        </record>

        <menuitem id="sms_menu_root" name="School Management Module"/>
        <menuitem id="students_menu" name="Students" parent="school.sms_menu_root" sequence="1"/>
        <menuitem id="students_menu1" name="Students_1" parent="school.students_menu"
                  action="school.school_students1"/>
        <menuitem id="students_menu2" name="Students_2" parent="school.students_menu"
                  action="school.school_students2"/>
<!--        <field name="view_ids" eval="[(5, 0, 0),-->
<!--            (0, 0, {'view_mode': 'list', 'sequence': 1, 'view_id': ref('hr_contract_template_list_view')}),-->
<!--            (0, 0, {'view_mode': 'form', 'sequence': 2, 'view_id': ref('hr_contract_template_form_view')})]"/>-->
    </data>
</odoo>