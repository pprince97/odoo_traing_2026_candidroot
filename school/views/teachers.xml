<odoo>
    <data>
           <record model="ir.ui.view" id="teachers_tree">
            <field name="name">school.list</field>
            <field name="model">school.teachers</field>
            <field name="arch" type="xml">
                <list>
                    <field name="employee_code"/>
                    <field name="name"/>
                    <field name="experience"/>
                    <field name="salary"/>
                    <field name="qualification"/>
                    <field name="is_permanent"/>
                    <field name="last_login"/>
                </list>
            </field>
        </record>
        <record id="teachers_form" model="ir.ui.view">
            <field name="name">school.form</field>
            <field name="model">school.teachers</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_code"/>
                                <field name="name"/>
                                <field name="qualification"/>
                                <field name="experience"/>
                                <field name="salary"/>
                                <field name="subject_id"/>
                                <field name="school_id"/>
                            </group>
                            <group>
                                <field name="joining_date"/>
                                <field name="is_permanent"/>
                                <field name="last_login"/>
                                <field name="school_id"/>
                                <field name="certificate"/>
                                <field name="image" widget="image"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="students" string="Students">
                                <field name="student_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="roll_number"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="school_teachers" model="ir.actions.act_window">
            <field name="name">school.window</field>
            <field name="res_model">school.teachers</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="teachers_menu" name="Teachers" parent="school.sms_menu_root"
                  action="school.school_teachers" sequence="2"/>
    </data>
</odoo>