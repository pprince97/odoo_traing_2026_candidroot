<odoo>

    <record id="class_list" model="ir.ui.view">
         <field name="name">school_management.list</field>
         <field name="model">school.class</field>
         <field name="arch" type="xml">
             <list>
                 <field name="name"/>
                 <field name="class_strength"/>
                 <field name="student_ids"/>
                 <field name="school_ids"/>
                 <field name="avg_score"/>
                 <field name="section"/>
                 <field name="is_active"/>
                 <field name="start_date"/>
                 <field name="description"/>
                 <field name="timetable"/>
                 <field name="class_image"/>
             </list>
         </field>
    </record>

    <record id="class_form" model="ir.ui.view">
         <field name="name">school_management.form</field>
         <field name="model">school.class</field>
         <field name="arch" type="xml">
             <form string="Teacher Form View">
                 <sheet>
                     <group>
                         <group>
                             <field name="name"/>
                             <field name="class_strength"/>
                             <field name="avg_score"/>
                             <field name="section"/>
                             <field name="is_active"/>
                         </group>
                         <group>
                             <field name="start_date"/>
                             <field name="description"/>
                             <field name="timetable"/>
                             <field name="class_image" widget="image"/>
                         </group>
                     </group>
                     <notebook>
                         <page name="students" string="Students">
                             <field name="student_ids">
                                <list>
                                    <field name="name" width="50px"/>
                                    <field name="roll_no" width="50px"/>
                                </list>
                             </field>
                         </page>
                         <page string="Schools" name="schools">
                            <field name="school_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="area"/>
                                </list>
                            </field>
                        </page>
                     </notebook>
                 </sheet>
             </form>
         </field>
    </record>

    <record id="class_action" model="ir.actions.act_window">
            <field name="name">Classes</field>
            <field name="res_model">school.class</field>
            <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Class" id="school_class_manu" parent="school_management.school_menu"
              action="school_management.class_action"/>

</odoo>