<odoo>
    <data>


        <record model="ir.ui.view" id="custom_tree1">
            <field name="name">Student</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
            <list>
                <field name="name" width="25px"/>
                <field name="roll_number" width="25px"/>
                <field name="percentage" width="25px"/>
                <field name="gender" width="25px"/>
                <field name="is_active" width="25px"/>
                <field name="dob" width="25px"/>
                <field name="admission" width="25px"/>
                <field name="remarks" width="25px"/>
                <field name="id_proof" width="25px" filename="file_name"/>
                <field name="photo" width="25px" filename="file_name_i"/>
                <field name="active" width="15px"/>
<!--                <field name="money" width="30px"/>-->
                <field name="htm" width="60px"/>

                <field name="class_id" width="30px"/>
<!--                <field name="subject_ids" width="30px"/>-->
                <field name="teacher_ids" width="30px"/>

                <field name="school_id" width="30px"/>
            </list>
            </field>
        </record>


        <record id="custom_form1" model="ir.ui.view">
            <field name="name">Student</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>


                        <group>
                            <group>
                                <field name="name"/>
                                <field name="roll_number"/>
                                <field name="percentage"/>
                                <field name="gender"/>
                                <field name="is_active" />
                                <field name="dob"/>
                                <field name="admission" invisible="active == True"/>
                                <field name="remarks"/>
                            </group>
                            <group>
                                <field name="id_proof" filename="file_name"/>
                                <field name="photo" widget="image" filename="file_name_i"/>
                                <field name="active"/>
<!--                                <field name="money"/>-->
                                <field name="htm"/>
                                <field name="class_id" context="{'form_view_ref':'school_management.context_class_form'}"/>
                            </group>
                        </group>


                        <notebook>

<!--                            <page name="Reference2" string="reference2">-->
<!--                                <group>-->
<!--                                <field name="subject_ids">-->
<!--                                    <list>-->
<!--                                        <field name="name"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                                </group>-->
<!--                            </page>-->

                            <page name="Reference3" string="reference3">
                                <group>
                                <field name="teacher_ids">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                                </group>
                            </page>

                            <page name="School ref" string="school ref">
                                <group>
                                <field name="school_id">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                                </group>
                            </page>
                        </notebook>


                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <record model="ir.actions.act_window" id="student_action">
            <field name="name">Student</field>
            <field name="res_model">school.student</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem name="School Management" id="parent_school"/>
        <menuitem name="Student" id="student_school" parent="school_management.parent_school" action="school_management.student_action"/>


    </data>
</odoo>