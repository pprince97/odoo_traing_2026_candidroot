<odoo>
    <record model="ir.ui.view" id="custom_tree1">
        <field name="name">school_management.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="roll_number"/>
                <field name="percentage"/>
                <field name="gender"/>
                <field name="is_active_student"/>
                <field name="date_of_birth"/>
                <field name="admission_datetime"/>
                <field name="remarks"/>
                <field name="id_proof" filename="file_name"/>
                <field name="photo" widget="image"/>
                <field name="class_id"/>
                <field name="school_id"/>
            </list>
        </field>
    </record>

    <record id="custom_form1" model="ir.ui.view">
        <field name="name">school_management.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form string="Form View">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="roll_number"/>
                            <field name="percentage"/>
                            <field name="gender"/>
                            <field name="id_proof" filename="file_name"/>
                        </group>
                        <group>
                            <field name="is_active_student"/>
                            <field name="date_of_birth"/>
                            <field name="admission_datetime"/>
                            <field name="remarks"/>
                            <field name="photo" widget="image"/>
                            <field name="class_id"/>
                            <field name="school_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="subjects" String="Subjects">
                            <field name="subject_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>

                        </page>
                        <page name="teachers" String="Teachers">
                            <field name="teacher_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="Extra">
                            <field name="extra_note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.actions.act_window" id="student_action">
        <field name="name">Student</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Student" id="school_student" parent="school_management.school_menu"
              action="school_management.student_action"/>


</odoo>