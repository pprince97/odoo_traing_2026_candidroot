<odoo>

    <record id="student_list" model="ir.ui.view">
         <field name="name">school_management.list</field>
         <field name="model">school.student</field>
         <field name="arch" type="xml">
             <list>
                 <field name="name"/>
                 <field name="roll_no"/>
                 <field name="roll_no"/>
                 <field name="class_id"/>
                 <field name="teacher_ids"/>
                 <field name="subject_ids"/>
                 <field name="school_id"/>
                 <field name="percentage"/>
                 <field name="gender"/>
                 <field name="is_active_student"/>
                 <field name="dob"/>
                 <field name="admission_date_time"/>
                 <field name="remarks"/>
                 <field name="id_proof"/>
                 <field name="photo"/>
             </list>
         </field>
    </record>

