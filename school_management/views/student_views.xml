    <record id="student_form" model="ir.ui.view">
         <field name="name">school_management.form</field>
         <field name="model">school.student</field>
         <field name="arch" type="xml">
             <form string="Student Form View">
                 <sheet>
                     <group>
                         <group>
                             <field name="name"/>
                             <field name="roll_no"/>
                             <field name="percentage"/>
                             <field name="gender"/>
                             <field name="is_active_student" widget="boolean_toggle"/>
                         </group>
                         <group>
                             <field name="dob"/>
                             <field name="admission_date_time"/>
                             <field name="remarks"/>
                             <field name="id_proof"/>
                             <field name="photo" widget="contact_image" options="{'size': [50,50]}"/>
                         </group>
                     </group>
                     <notebook>
                         <page string="Class" name="class">
                             <field name="class_id"/>
                         </page>
                         <page string="Teachers" name="teachers">
                             <field name="teacher_ids">
                                 <list>
                                     <field name="name"/>
                                     <field name="employee_code"/>
                                 </list>
                             </field>
                         </page>
                         <page string="Subjects" name="subjects">
                             <field name="subject_ids" >
                                 <list>
                                     <field name="name"/>
                                     <field name="subject_code"/>
                                 </list>
                             </field>
                         </page>
                         <page string="School" name="school">
                             <field name="school_id" context="{'form_view_ref': 'school_management.school_form_view'}"/>
<!--                             <field name="school_id" options="{'no_create':True}" context="{'kanban_view_ref': 'school_management.school_kanban_view1'}"/>-->
                         </page>
                     </notebook>
                 </sheet>
             </form>
         </field>
    </record>

