<odoo>

    <record id="subject_tree" model="ir.ui.view">
         <field name="name">school_management.list</field>
         <field name="model">school.subject</field>
         <field name="arch" type="xml">
             <list>
                 <field name="name"/>
                 <field name="subject_code"/>
                 <field name="student_ids"/>
                 <field name="teacher_ids"/>
                 <field name="school_ids"/>
                 <field name="max_marks"/>
                 <field name="passing_marks"/>
                 <field name="subject_type"/>
                 <field name="is_optional"/>
                 <field name="syllabus"/>
                 <field name="reference_material"/>
                 <field name="icon"/>
             </list>
         </field>
    </record>

    <record id="subject_form" model="ir.ui.view">
         <field name="name">school_management.form</field>
         <field name="model">school.subject</field>
         <field name="arch" type="xml">
             <form string="Subject From View">
                 <sheet>
                     <group>
                         <group>
                             <field name="name"/>
                             <field name="subject_code"/>
                             <field name="max_marks"/>
                             <field name="passing_marks"/>
                             <field name="subject_type"/>
                         </group>
                         <group>
                             <field name="is_optional"/>
                             <field name="syllabus"/>
                             <field name="reference_material"/>
                             <field name="icon" widget="image"/>
                         </group>
                     </group>
                     <notebook>
                         <page name="students" string="Students">
                             <field name="student_ids">
                                 <list>
                                     <field name="name"/>
                                     <field name="roll_no"/>
                                 </list>
                             </field>
                         </page>
                         <page string="Teachers" name="teachers">
                             <field name="teacher_ids">
                                 <list>
                                     <field name="name"/>
                                     <field name="employee_code"/>
                                 </list>
                             </field>
                         </page>
                         <page string="Schools" name="schools">
                             <field name="school_ids">
                                 <list>
                                     <field name="name"/>
                                     <field name="area"/>
                                 </list>
                             </field>
                         </page>
                     </notebook>
                 </sheet>
             </form>
         </field>
    </record>

    <record id="subject_action" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">school.subject</field>
            <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Subject" id="school_subject_manu" parent="school_management.school_menu"
              action="school_management.subject_action"/>

</odoo>