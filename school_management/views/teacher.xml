<odoo>
    <data>

        <record model="ir.ui.view" id="custom_tree2">
            <field name="name">Teacher</field>
            <field name="model">school.teacher</field>
            <field name="arch" type="xml">

            <list>
                <field name="name" width="30px"/>
                <field name="emp_code" width="30px"/>
                <field name="exp_years" width="30px"/>
                <field name="salary" width="30px"/>
                <field name="qualification" width="30px"/>
                <field name="is_perm" width="30px"/>
                <field name="joining_date" width="30px"/>
                <field name="last_login" width="30px"/>
                <field name="certificate" width="30px" filename="file_name1"/>
                <field name="image" width="30px" filename="file_name_i1"/>

                <field name="student_ids" width="30px"/>
<!--                <field name="subject_id" width="30px"/>-->
                <field name="school_id2" width="30px"/>

            </list>
            </field>
        </record>

        <record id="custom_form2" model="ir.ui.view">
            <field name="name">Teacher</field>
            <field name="model">school.teacher</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="emp_code"/>
                                <field name="exp_years"/>
                                <field name="salary"/>
                                <field name="qualification"/>
                            </group>
                            <group>
                                <field name="is_perm"/>
                                <field name="joining_date"/>
                                <field name="last_login"/>
                                <field name="certificate" filename="file_name1"/>
                                <field name="image" filename="file_name_i1"/>
                            </group>
                        </group>

                        <notebook>

                            <page name="Reference" string="reference">
                                <group>
                                <field name="student_ids">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                                </group>
                            </page>

<!--                            <page name="Reference2" string="reference2">-->
<!--                                <group>-->
<!--                                <field name="subject_id">-->
<!--                                    <list>-->
<!--                                        <field name="name"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                                </group>-->
<!--                            </page>-->

                            <page name="School ref" string="school ref">
                                <group>
                                <field name="school_id2">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="teacher_action">
            <field name="name">Teacher</field>
            <field name="res_model">school.teacher</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Teacher" id="teacher_school" parent="school_management.parent_school" action="school_management.teacher_action"/>
    </data>
</odoo>
