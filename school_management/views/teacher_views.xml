<odoo>

    <record id="teacher_list" model="ir.ui.view">
         <field name="name">school_management.list</field>
         <field name="model">school.teacher</field>
         <field name="arch" type="xml">
             <list>
                 <field name="name"/>
                 <field name="employee_code"/>
                 <field name="student_ids"/>
                 <field name="subject_id"/>
                 <field name="school_id"/>
                 <field name="exp_years"/>
                 <field name="salary"/>
                 <field name="qualification"/>
                 <field name="is_permanent"/>
                 <field name="joining_date"/>
                 <field name="last_login"/>
                 <field name="certificate"/>
                 <field name="image"/>
             </list>
         </field>
    </record>

    <record id="teacher_form" model="ir.ui.view">
         <field name="name">school_management.form</field>
         <field name="model">school.teacher</field>
         <field name="arch" type="xml">
             <form string="Teacher Form View">
                 <sheet>
                     <group>
                         <group>
                             <field name="name"/>
                             <field name="employee_code"/>
                             <field name="exp_years"/>
                             <field name="salary"/>
                             <field name="qualification"/>
                         </group>
                         <group>
                             <field name="is_permanent"/>
                             <field name="joining_date"/>
                             <field name="last_login"/>
                             <field name="certificate"/>
                             <field name="image" widget="image"/>
                         </group>
                     </group>
                     <notebook>
                         <page string="Students" name="students">
                             <field name="student_ids">
                                 <list>
                                     <field name="name"/>
                                     <field name="roll_no"/>
                                 </list>
                             </field>
                         </page>
                         <page string="Subject" name="subject">
                             <field name="subject_id">
                                 <list>
                                     <field name="name"/>
                                     <field name="subject_code"/>
                                 </list>
                             </field>
                         </page>
                         <page string="School" name="school">
                             <field name="school_id">
                                 <list>
                                     <field name="name"/>
                                     <field name="area"/>
                                 </list>
                             </field>
                         </page>
                     </notebook>
                 </sheet>
             </form>
         </field>
     </record>

    <record id="teacher_action" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">school.teacher</field>
            <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Teacher" id="school_teacher_menu" parent="school_management.school_menu"
              action="school_management.teacher_action"/>

</odoo>