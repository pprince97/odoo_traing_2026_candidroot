<odoo>
    <data>
        <record id="classes_list_view" model="ir.ui.view">
            <field name="name">classes.list</field>
            <field name="model">classes.object</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="class_strength"/>
                    <field name="avg_score"/>
                    <field name="section"/>
                    <field name="is_active"/>
                    <field name="start_date"/>
                    <field name="description"/>
                    <field name="timetable"/>
                    <field name="class_img"/>
                </list>
            </field>
        </record>

        <record id="classes_form_view" model="ir.ui.view">
            <field name="name">classes.form</field>
            <field name="model">classes.object</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="class_strength"/>
                                <field name="section"/>
                                <field name="avg_score"/>
                            </group>

                            <group>
                                <field name="is_active"/>
                                <field name="start_date"/>
                                <field name="description"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Attachments">
                                <group>
                                    <field name="timetable"/>
                                    <field name="class_img" widget="image" options="{'size': [100, 150]}"/>
                                </group>
                            </page>

                            <!--student and class-->
<!--                            <page name="student" string="Student">-->
<!--                                <field name="student_ids">-->
<!--                                    <list>-->
<!--                                        <field name="name"/>-->
<!--                                        <field name="roll_no"/>-->
<!--                                        <field name="gender"/>-->
<!--                                        <field name="dob"/>-->
<!--                                        <field name="percentage"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </page>-->
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="classes_action_window" model="ir.actions.act_window">
            <field name="name">Classes Record</field>
            <field name="res_model">classes.object</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Classes" id="classes_menu_record"
                  parent="menu_root"
                  action="classes_action_window"/>
    </data>
</odoo>