<odoo>
    <record id="school_list_view" model="ir.ui.view">
        <field name="name">school_list_view</field>
        <field name="model">school.object</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="school_form_view" model="ir.ui.view">
        <field name="name">school_form_view</field>
        <field name="model">school.object</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" />
                            <field name="address" invisible="not is_active"/>
                            <field name="phone" readonly="code != '91'"/>
                            <field name="school_category"/>
                            <field name="email" readonly="school_category not in 'private'"/>
                            <field name="is_active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Attachments">
                            <group>
                                <field name="school_img" widget="image" options="{'size': [100, 150]}"/>
                            </group>
                        </page>

<!--                            school and student-->
                        <page name="student" string="Student">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="roll_no"/>
                                    <field name="percentage"/>
                                    <field name="gender"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>

<!--                    teacher and school-->
                        <page name="teacher" string="Teacher">
                            <field name="teacher_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="employeeCode"/>
                                    <field name="experience"/>
                                    <field name="salary"/>
                                    <field name="qualification"/>
                                </list>
                            </field>
                        </page>

                        <!--school and subject-->
                        <page name="subject" string="Subject">
                            <field name="subject_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="subject_code"/>
                                    <field name="subject_type"/>
                                    <field name="max_marks"/>
                                    <field name="passing_marks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="school_action_window" model="ir.actions.act_window">
        <field name="name">Schools</field>
        <field name="res_model">school.object</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="school_menu_record"
              name="School"
              parent="menu_root"
              action="school_action_window"/>
</odoo>