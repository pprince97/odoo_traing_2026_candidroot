<odoo>
    <data>
        <record id="student_list_view" model="ir.ui.view">
            <field name="name">student.list</field>
            <field name="model">student.object</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="roll_no"/>
                    <field name="percentage"/>
                    <field name="gender"/>
                    <field name="is_active"/>
                    <field name="dob"/>
                    <field name="admission_dt"/>
                    <field name="remarks"/>
                    <field name="id_proof"/>
                    <field name="photo"/>
                </list>
            </field>
        </record>

        <record id="student_form_view" model="ir.ui.view">
            <field name="name">student.form</field>
            <field name="model">student.object</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="roll_no"/>
                                <field name="dob"/>
                                <field name="gender"/>
                            </group>
                            <group>
                                <field name="is_active"/>
                                <field name="percentage"/>
                                <field name="admission_dt" readonly="gender not in 'male'"/>
                                <field name="remarks"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Attachments">
                                <field name="id_proof"/>
                                <group>
                                   <field name="photo" widget="image" options="{'size': [100, 150]}"/>
                                </group>
                            </page>

                            <page string="HTML">
                                <field name="st_html"/>
                            </page>

<!--                            School and Student-->
                            <page name="school" string="School">
                                <field name="school_id">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>

<!--                            student and class-->
                            <page name="class" string="Class">
                                <field name="class_id">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>

<!--                            student and teacher-->
                            <page name="teacher" string="Teacher">
                                <field name="teacher_id">
                                    <list>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>

                        <!-- Student and Subject-->
                            <page name="subject" string="Subject">
                                <field name="subject_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="subject_code"/>
                                        <field name="max_marks"/>
                                        <field name="subject_type"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="student_action_window" model="ir.actions.act_window">
            <field name="name">Student Records</field>
            <field name="res_model">student.object</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_root" name="School Management"/>
        <menuitem id="student_menu_record"
                  name="Student"
                  parent="menu_root"
                  action="student_action_window"/>

    </data>
</odoo>
