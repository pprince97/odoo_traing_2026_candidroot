<odoo>
    <data>
        <record id="teacher_list_view" model="ir.ui.view">
            <field name="name">teacher.list</field>
            <field name="model">teacher.object</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employeeCode"/>
                    <field name="experience"/>
                    <field name="salary"/>
                    <field name="qualification"/>
                    <field name="isPermanent"/>
                    <field name="joining_date"/>
                    <field name="lastLogin"/>
                    <field name="certificate"/>
                    <field name="image"/>
                </list>
            </field>
        </record>

        <record id="teacher_form_view" model="ir.ui.view">
            <field name="name">teacher.form</field>
            <field name="model">teacher.object</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="employeeCode"/>
                                <field name="experience"/>
                                <field name="salary"/>
                                <field name="qualification"/>
                            </group>

                            <group>
                                <field name="isPermanent"/>
                                <field name="joining_date"/>
                                <field name="lastLogin"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Certificate">
                                <field name="certificate"/>
                            </page>
                            <page string="Avatar">
                                <field name="image" widget="image" class="oe_avatar"/>
                            </page>

<!--                            Student and teacher-->
                            <page name="student" string="Student">
                                <field name="student_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="roll_no"/>
                                        <field name="gender"/>
                                        <field name="dob"/>
                                        <field name="percentage"/>
                                        <field name="admission_dt"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Teacher and Subject-->
                            <page name="subject" string="Subject">
                                <field name="subject_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="subject_code"/>
                                        <field name="max_marks"/>
                                        <field name="passing_marks"/>
                                        <field name="subject_type"/>
                                        <field name="is_optional"/>
                                    </list>
                                </field>
                            </page>

<!--                            school and teacher-->
                            <page name="school" string="School">
                                <field name="school_id">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="phone"/>
                                        <field name="email"/>
                                        <field name="address"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="teacher_action_window" model="ir.actions.act_window">
            <field name="name">Teacher Records</field>
            <field name="res_model">teacher.object</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Teacher" id="teacher_menu_record"
                  parent="menu_root"
                  action="teacher_action_window"/>
    </data>
</odoo>