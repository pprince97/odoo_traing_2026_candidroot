<odoo>
    <data>

        <record model="ir.module.category" id="module_category_service">
            <field name="name">Service Management</field>
            <field name="sequence">5</field>
        </record>

        <!--  privilege-->

        <record model="res.groups.privilege" id="res_groups_privilege_service">
            <field name="name">User Role</field>
            <field name="category_id" ref="service_management_amitkumar.module_category_service"/>
            <field name="sequence">7</field>
        </record>

        <!-- Group-->

        <record id="group_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_owner" model="res.groups">
            <field name="name">Owner</field>
            <field name="sequence">21</field>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="implied_ids" eval="[(4, ref('service_management_amitkumar.group_customer'))]"/>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">22</field>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="implied_ids" eval="[(4, ref('service_management_amitkumar.group_owner'))]"/>
        </record>


        <!--        Record Rule-->

        <record id="owner_access_own_company" model="ir.rule">
            <field name="name">Owner: Access own company</field>
            <field name="model_id" ref="service_management_amitkumar.model_service_company"/>
            <field name="groups" eval="[(4, ref('group_owner'))]"/>
            <field name="domain_force">[('owner_id', '=', user.id)]</field>
        </record>

        <record id="admin_access_all_company" model="ir.rule">
            <field name="name">Admin: Access all company</field>
            <field name="model_id" ref="service_management_amitkumar.model_service_company"/>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>


<!--        owner own category-->
        <record id="owner_access_own_category" model="ir.rule">
            <field name="name">Owner: Access own category</field>
            <field name="model_id" ref="service_management_amitkumar.model_service_category"/>
            <field name="groups" eval="[(4, ref('group_owner'))]"/>
            <field name="domain_force">[('companies_id.owner_id', '=', user.id)]</field>
        </record>

        <record id="admin_access_own_category" model="ir.rule">
            <field name="name">Admin: Access own category</field>
            <field name="model_id" ref="service_management_amitkumar.model_service_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
        </record>


<!--        owner own services-->
        <record id="owner_access_own_services" model="ir.rule">
            <field name="name">Owner: Access own services</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('group_owner'))]"/>
            <field name="domain_force">[('companies_id.owner_id', '=', user.id)]</field>
        </record>

        <record id="admin_access_own_services" model="ir.rule">
            <field name="name">Admin: Access own services</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

<!--        OWN SERVICE REQUEST-->
