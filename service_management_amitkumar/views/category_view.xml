<odoo>
    <record id="category_list_view" model="ir.ui.view">
        <field name="name">category.list.view</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="companies_id"/>
            </list>
        </field>
    </record>


    <record id="category_form_view" model="ir.ui.view">
        <field name="name">category.form.view</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="companies_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="service_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="service_category_id"/>
                                    <field name="companies_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="category_action_window" model="ir.actions.act_window">
        <field name="name">Service Category Record</field>
        <field name="res_model">service.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="category_record"
              name="Service Category"
              parent="service_menu_root"
              action="category_action_window"/>

</odoo>