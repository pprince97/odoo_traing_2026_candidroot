<odoo>
    <record id="company_list_view" model="ir.ui.view">
        <field name="name">company.list.view</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="owner_id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="description"/>
            </list>
        </field>
    </record>


    <record id="company_form_view" model="ir.ui.view">
        <field name="name">company.form.view</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="description"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Services">
                            <field name="service_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="service_category_id"/>
                                    <field name="companies_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Service Categories">
                            <field name="service_category_ids"/>
                        </page>

                        <page string="Service Requests">
                            <field name="service_request_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="company_action_window" model="ir.actions.act_window">
        <field name="name">Company Record</field>
        <field name="res_model">service.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="service_menu_root" name="Service Management"/>

    <menuitem id="company_record"
              name="Company"
              parent="service_menu_root"
              action="company_action_window"/>

</odoo>