    <record id="inherit_product_template_action" model="ir.actions.act_window">
        <field name="name">Product Record</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="context" eval="{'default_type':'service'}"/>
        <field name="domain">[('type','=','service')]</field>
        <field name="view_ids"
               eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('inherit_product_template_list_view')})]"/>
<!--        <field name="view_ids"-->
<!--               eval="[(5, 0, 0), (0, 0, {'view_mode': 'form', 'view_id': ref('inherit_product_template_form_view')})]"/>-->
    </record>

    <menuitem id="inherit_product_template"
              name="Product"
              parent="service_menu_root"
              action="inherit_product_template_action"/>
</odoo>