<odoo>
    <record id="inherit_product_template_list_view" model="ir.ui.view">
        <field name="name">inherit.product.template.list.view</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="service_category_id"/>
                <field name="companies_id"/>
            </list>
        </field>
    </record>

        <record id="product_template_inherit" model="ir.ui.view">
            <field name="name">product.template.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="service_category_id"/>
                    <field name="companies_id"/>
                </xpath>

                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="placeholder">Enter service name</attribute>
                </xpath>
            </field>
        </record>

