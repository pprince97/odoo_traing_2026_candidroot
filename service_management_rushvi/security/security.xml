<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--   Group Category   -->
        <record model="ir.module.category" id="module_category_service_management">
            <field name="name">Service Management</field>
            <field name="sequence">1</field>
        </record>

        <!-- Group Privilage    -->
        <record model="res.groups.privilege" id="res_groups_privilege_service">
            <field name="name">Service</field>
            <field name="sequence">150</field>
            <field name="category_id" ref="service_management_rushvi.module_category_service_management"/>
        </record>
        .
        <!--  Groups  -->
        <record id="group_service_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>

        <record id="group_service_owner" model="res.groups">
            <field name="name">Owner</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>

        <record id="group_service_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('service_management_rushvi.group_service_owner'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!--        RECORD RULES           -->
        <!--        Company       -->
        <record id="company_restriction_owner" model="ir.rule">
            <field name="name">Company Restriction for owner</field>
            <field name="model_id" ref="service_management_rushvi.model_service_company"/>
            <field name="domain_force">[('owner_id','=',user.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_owner')),(4, ref('product.group_product_manager'))]"/>
        </record>

        <record id="company_restriction_admin" model="ir.rule">
            <field name="name">Company Restriction for Admin</field>
            <field name="model_id" ref="service_management_rushvi.model_service_company"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_admin'))]"/>
        </record>

        <!--        Category       -->
        <record id="category_restriction_owner" model="ir.rule">
            <field name="name">Category Restriction for owner</field>
            <field name="model_id" ref="service_management_rushvi.model_service_category"/>
            <field name="domain_force">[('company_id','in',user.commercial_partner_id.service_company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_owner'))]"/>
        </record>

        <record id="category_restriction_admin" model="ir.rule">
            <field name="name">Category Restriction for Admin</field>
            <field name="model_id" ref="service_management_rushvi.model_service_category"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_admin'))]"/>
        </record>

        <!--     Services      -->
        <record id="service_restriction_owner" model="ir.rule">
            <field name="name">Service Restriction for owner</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[('service_company_id','in',user.commercial_partner_id.service_company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_owner'))]"/>
        </record>

        <record id="service_restriction_admin" model="ir.rule">
            <field name="name">Service Restriction for Admin</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_admin'))]"/>
        </record>

        <!--     Service Request        -->
        <record id="request_restriction_owner" model="ir.rule">
            <field name="name">Request Restriction for owner</field>
            <field name="model_id" ref="service_management_rushvi.model_service_request"/>
            <field name="domain_force">[('company_id','in',user.commercial_partner_id.service_company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_owner'))]"/>
        </record>

        <record id="request_restriction_admin" model="ir.rule">
            <field name="name">Request Restriction for Admin</field>
            <field name="model_id" ref="service_management_rushvi.model_service_request"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_rushvi.group_service_admin'))]"/>
        </record>

    </data>
</odoo>