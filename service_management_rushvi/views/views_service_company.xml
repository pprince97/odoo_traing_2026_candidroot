<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_service_company_list" model="ir.ui.view">
        <field name="name">service.company.list</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="registration_number"/>
                <field name="owner_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="state"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="view_service_company_form" model="ir.ui.view">
        <field name="name">service.company.form</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="registration_number"/>
                            <field name="owner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_company" model="ir.actions.act_window">
        <field name="name">Company</field>
        <field name="res_model">service.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Service Management" id="service_menu_root"/>
    <menuitem name="Company" id="menuitem_service_company"
              parent="service_menu_root"
              action="action_service_company"
              sequence="10"/>
</odoo>