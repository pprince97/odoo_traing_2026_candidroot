<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Groups Category        -->
        <record model="ir.module.category" id="service_management_groups_catgory">
            <field name="name">Service Management</field>
            <field name="sequence">35</field>
        </record>

        <!-- Group Privilage        -->
        <record model="res.groups.privilege" id="res_groups_privilege_service">
            <field name="name">Service</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="service_management_sankit.service_management_groups_catgory"/>
        </record>

        <!-- Groups -->
        <record id="group_service_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>
        <record id="group_service_owner" model="res.groups">
            <field name="name">Owner</field>
            <field name="sequence">15</field>
            <field name="implied_ids" eval="[(4, ref('group_service_customer'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>

        <record id="group_service_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="implied_ids" eval="[(4, ref('group_service_owner'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>


        <record id="group_service_admin_company" model="ir.rule">
            <field name="name">Service Admin Company</field>
            <field name="model_id" ref="service_management_sankit.model_company_object"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_service_admin'))]"/>
        </record>
        <record id="group_service_owner_company" model="ir.rule">
            <field name="name">Service Owner Company</field>
            <field name="model_id" ref="service_management_sankit.model_company_object"/>
            <field name="domain_force">[('owner_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_service_owner'))]"/>
        </record>


        <record id="group_service_category_admin_company" model="ir.rule">
            <field name="name">Service Category Admin</field>
            <field name="model_id" ref="service_management_sankit.model_service_category"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_service_admin'))]"/>
        </record>
        <record id="group_service_category_company" model="ir.rule">
            <field name="name">Service Category Owner</field>
            <field name="model_id" ref="service_management_sankit.model_service_category"/>
            <field name="domain_force">[('owner_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_service_owner'))]"/>
        </record>
<!--        product.product -->


        <record id="group_services_admin" model="ir.rule">
            <field name="name">Service Admin</field>
            <field name="model_id" ref="service_management_sankit.model_product_template"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_service_admin'))]"/>
        </record>
        <record id="group_services_owner" model="ir.rule">
            <field name="name">Service Owner</field>
            <field name="model_id" ref="service_management_sankit.model_product_template"/>
            <field name="domain_force">[('owner_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_service_owner'))]"/>
        </record>


        <record id="group_service_request_admin" model="ir.rule">
            <field name="name">Service Request Admin</field>
            <field name="model_id" ref="service_management_sankit.model_service_request"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_service_admin'))]"/>
        </record>
        <record id="group_service_request_owner" model="ir.rule">
            <field name="name">Service Request Owner</field>
            <field name="model_id" ref="service_management_sankit.model_service_request"/>
            <field name="domain_force">[('owner_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_service_owner'))]"/>
        </record>
        <record id="group_service_request_customer" model="ir.rule">
            <field name="name">Service Request Customer</field>
            <field name="model_id" ref="service_management_sankit.model_service_request"/>
            <field name="domain_force">[('customer_id','=',user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_service_customer'))]"/>
        </record>



    </data>
</odoo>
