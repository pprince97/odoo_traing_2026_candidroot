<odoo>
    <record id="patch_of_not_negative_view" model="ir.ui.view">
        <field name="name">Not Negative Total</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="outer">
                    <div class="popup">
                        <h2 class="center">Total Amount is Zero</h2>
                        <br/>
                        <button id="closebtn">Close</button>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>