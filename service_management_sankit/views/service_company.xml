<odoo>

    <record id="company_list_view" model="ir.ui.view">
        <field name="name">Company List</field>
        <field name="model">company.object</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>
    <record id="company_form_view" model="ir.ui.view">
        <field name="name">Company Form</field>
        <field name="model">company.object</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="company_window_action_menu" model="ir.actions.act_window">
        <field name="name">Company</field>
        <field name="res_model">company.object</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="service_menu_root" name="Service Management"/>

    <menuitem id="company_menu"
              name="Company"
              action="company_window_action_menu"
              parent="service_menu_root"
    />
</odoo>