<odoo>

    <record id="service_seq" model="ir.sequence">
            <field name="name">service Seq</field>
            <field name="code">service.seq</field>
            <field name="prefix">SN/</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    <record id="service_request_list_view" model="ir.ui.view">
        <field name="name">Service Request List</field>
        <field name="model">service.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="request_number"/>
                <field name="customer_id"/>
                <field name="company_id"/>
                <field name="service_category_id"/>
                <field name="service_id"/>
                <field name="service_date"/>
            </list>
        </field>
    </record>
    <record id="service_request_form_view" model="ir.ui.view">
        <field name="name">Service Request Form</field>
        <field name="model">service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            name="in_progress_state"
                            string="In Progress"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['in_progress','done','invoice']"
                    />
                    <button
                            name="done_state"
                            string="Done"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['draft','done','invoice']"
                    />
                    <button
                            name="invoice_state"
                            string="In Voice"
                            type="object"
                            class="oe_highlight"
                            invisible="state in ['draft','in_progress','invoice']"
                    />
                    <button
                            name="draft_state"
                            string="Cancel"
                            type="object"
                            class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,invoice"/>
                </header>
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="company_id"/>
                        <field name="service_category_id"/>
                        <field name="service_id"/>
                        <field name="service_date"/>
                        <field name="country_id"/>
                        <field name="state_id"/>
                        <field name="city_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_request_window_action_menu" model="ir.actions.act_window">
        <field name="name">Service Request</field>
        <field name="res_model">service.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="service_request_menu"
              name="Service Request"
              action="service_request_window_action_menu"
              parent="service_menu_root"
    />
</odoo>