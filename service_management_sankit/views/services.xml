<odoo>

    <record id="service_list_view" model="ir.ui.view">
        <field name="name">Service List</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type" readonly="1"/>
                <field name="service_category_id"/>
                <field name="service_company_id"/>
            </list>
        </field>
    </record>
    <record id="service_form_view" model="ir.ui.view">
        <field name="name">Service Form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type" readonly="1"/>
                        <field name="service_category_id"/>
                        <field name="service_company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_window_action_menu" model="ir.actions.act_window">
        <field name="name">Service</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_type': 'service'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('service_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('service_form_view')})]"/>
    </record>

    <menuitem id="service_menu"
              name="Service"
              action="service_window_action_menu"
              parent="service_menu_root"
              groups="service_management_sankit.group_service_owner"
    />
</odoo>