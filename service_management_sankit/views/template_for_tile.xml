<odoo>
    <data>
        <template id="portal_my_service_request" name="Service Request" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <div id="portal_alert_category" position="inside">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                        <t t-set="title">Service Request</t>
                        <t t-set="url" t-value="'/service-request'"/>
                        <t t-set="text">My Service Requests</t>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </div>
            </xpath>
        </template>

        <template id="service_request" name="Service Request">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                             data-snippet="s_title" data-scroll-background-ratio="1">
                        <span class="s_parallax_bg oe_img_bg"
                              style="background-image: url('/web/image/website.s_picture_default_image'); background-position: 50% 0;"/>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container">
                            <h1>Service Request</h1>
                        </div>
                    </section>

                    <div class="container my-5">
                        <table class="small table table-bordered text-center">
                            <thead class="highlight">
                                <tr>
                                    <th scope="col" style="width: 10%">ID</th>
                                    <th scope="col">Request Number</th>
                                    <th scope="col">Service</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Company</th>
                                    <th scope="col">Service Date</th>
                                    <th scope="col">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="service_records" t-as="service_request">
                                    <tr>
                                        <th scope="row">
                                            <span t-esc="service_request.id"/>
                                        </th>
                                        <td>
                                            <span t-esc="service_request.request_number"/>
                                        </td>
                                        <td>
                                            <span t-esc="service_request.service_id.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="service_request.service_category_id.service_name"/>
                                        </td>
                                        <td>
                                            <span t-esc="service_request.company_id.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="service_request.service_date"/>
                                        </td>
                                        <td>
                                            <span t-esc="service_request.state"/>
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>
                        <div class="row mt-3">
                             <div class="col-12">
                        <t t-call="portal.pager">
                            <t t-set="classname" t-value="'d-flex justify-content-center'"/>
                        </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>

