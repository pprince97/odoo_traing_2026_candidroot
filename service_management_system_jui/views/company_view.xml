<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="service_company_list" model="ir.ui.view">
            <field name="name">company</field>
            <field name="model">custom.service.company</field>
            <field name="arch" type="xml">
            <list>
                <field name="name" width="30px"/>
                <field name="phone" width="15px"/>
                <field name="email" width="40px"/>
                <field name="address" width="30px"/>
                <field name="owner_id" width="30px"/>
                <field name="service_category_ids" width="30px"/>
                <field name="service_ids" width="30px"/>
                <field name="service_request_ids" width="30px"/>
            </list>
            </field>
        </record>

        <record id="service_company_form" model="ir.ui.view">
            <field name="name">company</field>
            <field name="model">custom.service.company</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="address"/>
                            </group>
                            <group>
                                <field name="owner_id"/>
                                <field name="service_category_ids" widget="many2many_tags" domain="[('company_id_s','=',False)]"/>
                                <field name="service_ids" widget="many2many_tags" domain="[('type','=','service'),'|',('category_id','in',service_category_ids),('category_id','=',False)]"/>
                                <field name="service_request_ids" widget="many2many_tags" domain="[('company_id_s','=',id)]"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="service_company_action_id" model="ir.actions.act_window">
            <field name="name">Company</field>
            <field name="res_model">custom.service.company</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="service_company_menu" name="Company" parent="service_management_system_jui.service_management_system_menu" action="service_management_system_jui.service_company_action_id"/>

    </data>
</odoo>