<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="service_category_list" model="ir.ui.view">
            <field name="name">service.category</field>
            <field name="model">service.category</field>
            <field name="arch" type="xml">
            <list>
                <field name="name" width="30px"/>
                <field name="service_ids" width="15px"/>
                <field name="company_id_s" width="40px"/>
            </list>
            </field>
        </record>

        <record id="service_category_form" model="ir.ui.view">
            <field name="name">service.category</field>
            <field name="model">service.category</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="service_ids" widget="many2many_tags" domain="[('type','=','service')]"/>
                            </group>
                            <group>
                                <field name="company_id_s"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="service_category_action_id" model="ir.actions.act_window">
            <field name="name">Service Category</field>
            <field name="res_model">service.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="service_category_menu" name="Service Category" parent="service_management_system_jui.service_management_system_menu" action="service_management_system_jui.service_category_action_id"/>

    </data>
</odoo>