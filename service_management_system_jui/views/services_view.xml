<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="services_inherited_form_view" model="ir.ui.view">
            <field name="name">services.inherited.form.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="category_id"/>
                    <field name="company_id_s"/>
                </xpath>
            </field>
        </record>

        <record id="services_action_id" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'default_type':'service'}</field>
            <field name="domain">[('type','=','service')]</field>
        </record>

        <menuitem id="services_menu" name="Services" parent="service_management_system_jui.service_management_system_menu" action="service_management_system_jui.services_action_id"/>
    </data>
</odoo>