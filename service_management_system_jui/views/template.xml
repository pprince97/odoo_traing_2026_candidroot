<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="service_management_system_jui.inheritedaccountservicesbtn" name="Service Request Form" inherit_id="portal.side_content">
        <xpath expr="//a[hasclass('btn-link')]" position="after">
            <br/>
            <a role="button" href="/my/service/request/form" class="btn btn-primary p-2 mt-3">Request Service</a>
        </xpath>
    </template>

    <template id="service_management_system_jui.inheritedaccountservices" name="Service Request" inherit_id="portal.portal_my_home">
            <xpath expr="//div[@id='portal_common_category']" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/portal/static/src/img/portal-connection.svg'"/>
                    <t t-set="title">Service Request List</t>
                    <t t-set="text">My service request list</t>
                    <t t-set="url" t-value="'/my/service/request/list'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </xpath>
    </template>

    <record id="service_management_system_jui.model_service_request" model="ir.model">
      <field name="website_form_access">True</field>
    </record>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>service.request</value>
        <value eval="[
            'request_number',
            'date',
            'company_id_s',
            'category_id',
            'service_id',
            'customer_id',
            'country_id',
            'state_id',
            'city_id',
            'street',
            'state',
            ]"/>
    </function>

    <template id="service_management_system_jui.service_request_template_list" name="Service Request">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">

                    <!-- HEADER -->
                    <section class="title mb-5">
                        <span class="bg-primary d-flex pt-4 pb-4"
                              style="background-position: 50% 0;">
                            <div class="container">
                                <h1 class="text-white">Service Request List</h1>
                            </div>
                        </span>
                    </section>
                    <div id="_price_range_option">
                        <input
                            type="range"
                            multiple="multiple"
                            t-attf-class="form-range range-with-input {{_classes_input}}"
                            t-att-min="30"
                            t-att-max="100"
                            t-att-value="(min_price, max_price)"
                        />
                    </div>
                    <section class="container body mt-5 mb-5">
                        <div class="row">
                            <div class="col-md-4" id="service_request_list">
                                <a role="button" href="/my/service/request/form" class="btn btn-primary">Request Service</a>
                            </div>
                            <div class="col-md-8 text-end d-flex justify-content-end align-items-center">
                                <form t-att-action="default_url" method="get">
                                    <input type="hidden" name="state" t-att-value="state"/>
                                    <div t-attf-class="input-group #{_classes}" role="search" style="max-width: 300px;">
                                        <t t-set="search_placeholder">Search...</t>
                                        <input type="search" name="search" t-att-class="'search-query form-control oe_search_box %s %s' % (_input_classes or '', '' if default_style else 'border-0 bg-light')" t-att-placeholder="search_placeholder" t-att-value="search" oninput="this.form.submit()"/>
                                    </div>
                                </form>
                                <span class="small me-1 navbar-text">States:</span>
                                <div class="btn-group">
                                    <button id="service_searchbar_filters" data-bs-toggle="dropdown" class="btn btn-light dropdown-toggle">
                                        <t t-esc="state_filters.get(state,state_filters.get('all')).get('label', 'All')"/>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="service_searchbar_filters">
                                        <t t-foreach="state_filters" t-as="option">
                                            <a t-att-href="default_url + '?' + keep_query('*', state=option)"
                                               t-attf-class="dropdown-item#{state == option and ' active' or ''}">
                                                <span t-esc="state_filters[option].get('label')"/>
                                            </a>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <div class="container">
                        <table class="table table-hover mb-5 bg-white">
                            <thead>
                                <tr class="active">
                                    <th name="request_number">Request No</th>
                                    <th name="date">Date</th>
                                    <th name="customer_id">Customer</th>
                                    <th name="company_id_s">Company</th>
                                    <th name="category_id">Category</th>
                                    <th name="service_id">Service</th>
                                    <th name="service_id">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="requests" t-as="req">
                                    <tr>
                                        <td>
                                            <a t-attf-data-bs-target="#service_request_#{req.id}" href="#" data-bs-toggle="modal">
                                                <span t-field="req.request_number"/>
                                            </a>
                                        </td>
                                        <td><span t-field="req.date"/></td>
                                        <td><span t-field="req.customer_id" /></td>
                                        <td><span t-field="req.company_id_s" /></td>
                                        <td><span t-field="req.category_id" /></td>
                                        <td><span t-field="req.service_id" /></td>
                                        <td><span t-field="req.state" /></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-foreach="requests" t-as="req">
                            <div class="modal fade" t-attf-id="service_request_#{req.id}" tabindex="-1">
                                <t t-call="service_management_system_jui.service_record_modal_template">
                                    <t t-set="record" t-value="req"/>
                                </t>
                            </div>
                        </t>
                        <div class="d-flex justify-content-center mt-3 mb-5">
                            <t t-call="website.pager">
                                <t t-set="_classes">mt-2 ml-md-2</t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="service_record_modal_template" name="Service Record Modal Template">
        <div id="wrap" class="oe_structure">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title m-3 mb-0 mt-0">Details:
                            <t t-out="record.request_number"/>
                        </h5>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="container">
                            <h1 class="mt-4">Service Request Details</h1>

                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title">Request Number:
                                        <span t-field="record.request_number"/>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-3">Date:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.date"/>
                                        </div>

                                        <div class="col-sm-3">Customer:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.customer_id.name"/>
                                        </div>

                                        <div class="col-sm-3">Company:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.company_id_s"/>
                                        </div>

                                        <div class="col-sm-3">Category:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.category_id"/>
                                        </div>

                                        <div class="col-sm-3">Service:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.service_id"/>
                                        </div>

                                        <div class="col-sm-3">Country:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.country_id"/>
                                        </div>

                                        <div class="col-sm-3">State:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.state_id"/>
                                        </div>

                                        <div class="col-sm-3">City:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.city"/>
                                        </div>

                                        <div class="col-sm-3">Street:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.street"/>
                                        </div>

                                        <div class="col-sm-3">State:</div>
                                        <div class="col-sm-9">
                                            <span t-field="record.state"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-start m-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">close</button>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="service_management_system_jui.service_request_template_form" name="Service Request Form">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">

                    <!-- HEADER -->
                    <section class="title mb-5">
                        <span class="bg-primary d-flex pt-4 pb-4"
                              style="background-position: 50% 0;">
                            <div class="container">
                                <h1 class="text-white">Service Request Form</h1>
                            </div>
                        </span>
                    </section>

                    <section class="body mt-5 mb-5">
                        <div class="container" id="service_request_form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row">
                                <div class="mb-2 col-12">
                                    <label class="me-3">State :</label>
                                    <t t-set="state_options" t-value="request.env['service.request']._fields['state'].selection"/>
                                    <t t-foreach="state_options" t-as="option">
                                        <div class="form-check form-check-inline">
                                            <input type="radio"
                                                   id="s_state"
                                                   name="state"
                                                   class="form-check-input"
                                                   t-att-value="option[0]"
                                                   t-att-checked="option[0] == requests.state if requests and requests.state else option[0] == 'draft'"/>
                                            <label class="form-check-label">
                                                <t t-esc="option[1]"/>
                                            </label>
                                        </div>
                                    </t>
                                </div>
                                <input type="hidden" id="s_dynamic_state" name="dynamic_state" value=""/>

                                <div id="div_date" class="col-lg-6 mb-2">
                                    <label class="col-form-label" for="s_date">
                                        Date*
                                    </label>
                                    <input id="s_date" type="date" name="date" class="form-control"/>
                                </div>
                                <div id="div_customer" class="mb-2 col-lg-6">
                                    <t t-set="current_customer" t-value="request.env.user"/>

                                    <label class="py-2">Customer*</label>
                                    <select id="s_customer_id" name="customer_id" class="form-control"
                                            readonly="1"
                                            style="pointer-events:none; background:#e9ecef;">
                                        <option t-att-value="current_customer.id" selected="selected">
                                            <t t-esc="current_customer.name"/>
                                        </option>
                                    </select>
                                </div>

                                <t t-set="countries" t-value="request.env['res.country'].search([])"/>
                                <div id="div_country" class="col-lg-6 mb-2">
                                    <label class="col-form-label" for="s_country_id">
                                        Country*
                                    </label>
                                    <select id="s_country_id" name="country_id" class="form-select">
                                        <option value="">Country...</option>
                                        <option
                                            t-foreach="countries"
                                            t-as="c"
                                            t-att-value="c.id"
                                            t-att-code="c.code"
                                            t-out="c.name"
                                        />
                                    </select>
                                </div>

                                <div id="div_category" class="mb-2 col-lg-6">
                                    <t t-set="categories" t-value="request.env['service.category'].search([])"/>
                                    <label class="py-2">Categories*</label>
                                    <select id="s_category_id" name="category_id" class="form-select">
                                        <option value="">Categories...</option>
                                        <t t-foreach="categories" t-as="catg">
                                            <option t-att-value="catg.id">
                                                <t t-esc="catg.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div id="div_services" class="col-lg-6 mb-2"/>
                                <div id="div_company" class="col-lg-6 mb-2"/>
                                <div id="div_state" class="col-lg-6 mb-2"/>
                                <div id="div_city" class="col-md-6 mb-2"/>
                                <div id="div_street" class="col-lg-6 mb-2">
                                    <label class="col-form-label" for="s_street">
                                        street
                                    </label>
                                    <input id="s_street" type="text" name="street" class="form-control"/>
                                </div>

                            </div>

                            <div id="myModal" class="cmodal">
                              <div class="cmodal-content">
                                  <h4>Please Fill up Mandatory Fields</h4>
                                  <br/>
                                  <span class="cclose" id="close_modal">close</span>
                              </div>
                            </div>

                            <div id="mySubmitModal" class="cmodal">
                              <div class="cmodal-content">
                                  <h4>Your Form has been submitted successfully</h4>
                                  <br/>
                                  <span class="cclose" id="close_submit_modal">close</span>
                              </div>
                            </div>

                            <!-- FINAL SUBMIT -->
                            <div class="mt-4">
                                <button id="save_details" type="submit" class="btn btn-primary">
                                    Submit
                                </button>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>
</odoo>