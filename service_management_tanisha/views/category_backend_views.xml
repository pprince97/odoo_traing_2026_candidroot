<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="category_list_view" model="ir.ui.view">
        <field name="name">service.category.list</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="category_form_view" model="ir.ui.view">
        <field name="name">service.category.form</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="category_menu_action" model="ir.actions.act_window">
        <field name="name">Company</field>
        <field name="res_model">service.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem name="Category" id="category_menu" parent="service_root_menu" action="category_menu_action"/>

</odoo>