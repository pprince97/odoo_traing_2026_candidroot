<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="company_kanban_view" model="ir.ui.view">
        <field name="name">service.company.kanban</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="logo" class="w-100 h-auto m-0" widget="image"
                                   options="{'img_class': 'object-fit-contain w-100 h-100'}"/>
                        </aside>
                        <main class="ps-2">
                            <div t-if="record.name.raw_value" class="text-truncate">
                                <field class="fw-bold fs-5" name="name"/>
                            </div>
                            <div t-if="record.owner_id.raw_value" class="text-truncate">
                                <i class="fa fa-fw me-1 fa-user text-primary" title="Owner"/>
                                <field name="owner_id" class="ms-2 text-muted"/>
                            </div>
                            <div t-if="record.email.raw_value" class="text-truncate">
                                <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                <field name="email" class="ms-2 text-muted"/>
                            </div>
                            <div t-if="record.phone.raw_value" class="text-truncate">
                                <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                <field name="phone" class="ms-2 text-muted"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="company_form_view" model="ir.ui.view">
        <field name="name">service.company.form</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="owner_id"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="logo" widget="image" options="{'size': [100,100]}"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="website" widget="url"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="company_menu_action" model="ir.actions.act_window">
        <field name="name">Company</field>
        <field name="res_model">service.company</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <menuitem name="Service Management" id="service_root_menu"/>

    <menuitem name="Company" id="company_menu" parent="service_root_menu" action="company_menu_action"/>

</odoo>