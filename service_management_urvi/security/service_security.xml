<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="service_management_groups_catgory">
            <field name="name">Service Management</field>
            <field name="sequence">35</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_service">
            <field name="name">Service Role</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="service_management_urvi.service_management_groups_catgory"/>
        </record>

        <record id="group_service_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>


        <record id="group_service_owner" model="res.groups">
            <field name="name">Owner</field>
            <field name="sequence">11</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
        </record>

        <record id="group_service_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">12</field>
            <field name="implied_ids"
                   eval="[(4,ref('service_management_urvi.group_service_owner'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_service"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>


        <record id="company_rule_owner" model="ir.rule">
            <field name="name">only owner related company</field>
            <field ref="model_service_company" name="model_id"/>
            <field name="domain_force">[('owner_id','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_owner'))]"/>
        </record>


        <record id="company_rule_admin" model="ir.rule">
            <field name="name">Admin can see All Companies</field>
            <field ref="model_service_company" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_admin'))]"/>
        </record>

        <record id="category_rule_owner" model="ir.rule">
            <field name="name">only owner related category</field>
            <field ref="model_service_category" name="model_id"/>
            <field name="domain_force">[('company_id.owner_id','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_owner'))]"/>
        </record>


        <record id="category_rule_admin" model="ir.rule">
            <field name="name">Admin can see All category</field>
            <field ref="model_service_category" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_admin'))]"/>
        </record>

        <record id="service_rule_owner" model="ir.rule">
            <field name="name">only owner related service</field>
            <field ref="model_product_template" name="model_id"/>
            <field name="domain_force">[('service_company_id.owner_id','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_owner'))]"/>
        </record>


        <record id="service_rule_admin" model="ir.rule">
            <field name="name">Admin can see All service</field>
            <field ref="model_product_template" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_admin'))]"/>
        </record>

        <record id="request_rule_owner" model="ir.rule">
            <field name="name">only owner related request</field>
            <field ref="model_service_request" name="model_id"/>
            <field name="domain_force">[('category_id.company_id.owner_id','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_owner'))]"/>
        </record>


        <record id="request_rule_admin" model="ir.rule">
            <field name="name">Admin can see All request</field>
            <field ref="model_service_request" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('service_management_urvi.group_service_admin'))]"/>
        </record>

        <record id="group_sm" model="res.groups">
            <field name="name">

                management</field>
        </record>
    </data>
</odoo>
