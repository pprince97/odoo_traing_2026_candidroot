<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="service_category_list_view" model="ir.ui.view">
        <field name="name">service.category.list</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="service_category_form_view" model="ir.ui.view">
        <field name="name">service.category.form</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="category_action" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">service.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="service_category" name="Category" parent="service_root" action="category_action"
              sequence="2"/>
</odoo>