<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="service_company_list_view" model="ir.ui.view">
        <field name="name">service.company.list</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="owner_id"/>
                <field name="website" widget="url"/>
                <field name="address"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="service_company_form_view" model="ir.ui.view">
        <field name="name">service.company.form</field>
        <field name="model">service.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="owner_id" context="{'owner':1}" domain="[('group_ids','in',%(service_management_urvi.group_service_owner)d)]"/>
                        </group>
                        <group>
                            <field name="website" widget="url"/>
                            <field name="address"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="company_action" model="ir.actions.act_window">
        <field name="name">Company</field>
        <field name="res_model">service.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="service_root" name="Service Management"/>
    <menuitem id="service_company" name="Company" parent="service_root" action="company_action"
              sequence="1"/>
</odoo>