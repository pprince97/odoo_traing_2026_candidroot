<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="service_request_list_view" model="ir.ui.view">
        <field name="name">service.request.list</field>
        <field name="model">service.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="req_number"/>
                <field name="customer_id"/>
                <field name="date"/>
                <field name="category_id"/>
                <field name="service_id"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="city_id"/>
                <field name="street"/>
            </list>
        </field>
    </record>

    <record id="service_request_form_view" model="ir.ui.view">
        <field name="name">service.request.form</field>
        <field name="model">service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            string="Cancel"
                            name="cancel_state"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ['draft']"
                    />
                    <button
                            string="Confirm"
                            name="confirm_state"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ['draft']"
                    />
                    <button
                            string="Done"
                            name="done_state"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ['confirm']"
                    />
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,done,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="req_number"/>
                            <field name="customer_id" context="{'customer':1}"
                                   domain="[('group_ids','in',%(service_management_urvi.group_service_customer)d)]"/>
                            <field name="category_id" options='{"no_open": True, "no_create": True}'/>
                            <field name="service_id" options='{"no_open": True, "no_create": True}'
                                   readonly="not category_id" domain="[('service_category_id','in',category_id)]"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="country_id"/>
                            <field name="state_id" domain="[('country_id','in',country_id)]"/>
                            <field name="city_id" domain="[('country_id','in',country_id),('state_id','in',state_id)]"/>
                            <field name="street"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="request_action" model="ir.actions.act_window">
        <field name="name">Service Request</field>
        <field name="res_model">service.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="service_request" name="Request" parent="service_root" action="request_action"
              sequence="4"/>
</odoo>