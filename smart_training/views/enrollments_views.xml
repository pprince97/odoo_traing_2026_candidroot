<odoo>
    <record id="view_enrollments_list" model="ir.ui.view">
        <field name="name">smart.training.enrollments.list</field>
        <field name="model">smart.training.enrollments</field>
        <field name="arch" type="xml">
            <list>
                <field name="enrollment_date"/>
                <field name="attendance_percentage"/>
                <field name="score"/>
                <field name="result"/>
                <field name="feedback"/>
            </list>
        </field>
    </record>
    <record id="view_enrollments_form" model="ir.ui.view">
        <field name="name">smart.training.enrollments.form</field>
        <field name="model">smart.training.enrollments</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="session_id"/>
                            <field name="program_id"/>
                            <field name="enrollment_date"/>
                            <field name="attendance_percentage"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="result"/>
                            <field name="certificate_id"/>
                            <field name="feedback"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_enrollments" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">smart.training.enrollments</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="smart_training_enrollments" name="Enrollments"
              action="action_enrollments" parent="smart_training_root"/>
</odoo>