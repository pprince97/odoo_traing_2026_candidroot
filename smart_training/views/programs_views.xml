<odoo>
    <record id="view_programs_list" model="ir.ui.view">
        <field name="name">smart.training.programs.list</field>
        <field name="model">smart.training.programs</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="duration_hours"/>
                <field name="level"/>
                <field name="active"/>
                <field name="certification_available"/>
                <field name="passing_score"/>
            </list>
        </field>
    </record>
    <record id="view_programs_form" model="ir.ui.view">
        <field name="name">smart.training.programs.form</field>
        <field name="model">smart.training.programs</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="duration_hours"/>
                            <field name="passing_score"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="fees"/>
                            <field name="level"/>
                            <field name="active"/>
                            <field name="fees" widget="monetary"/>
                            <field name="certification_available"/>
                            <field name="trainer_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="sessions" string="Sessions">
                            <field name="session_ids" widget="one2many"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_programs_kanban" model="ir.ui.view">
        <field name="name">smart.training.programs.kanban</field>
        <field name="model">smart.training.programs</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div>
                            <strong><field name="name"/></strong>
                        </div>
                        <div>
                            <field name="code"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_programs" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">smart.training.programs</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="smart_training_root" name="Smart Training"/>
    <menuitem id="smart_training_programs" name="Programs"
              action="action_programs" parent="smart_training_root"/>
</odoo>