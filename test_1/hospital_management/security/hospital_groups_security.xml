<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Groups Category -->

       <record model="ir.module.category" id="hospital_management_group_catgory">
            <field name="name">Hospital Management</field>
            <field name="sequence">20</field>
       </record>

        <!-- Group Privilege -->

        <record model="res.groups.privilege" id="hospital_management_group_privilege">
            <field name="name">Hospital</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="hospital_management.hospital_management_group_catgory"/>
        </record>

        <!-- Groups -->

        <record id="hospital_group_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="hospital_management.hospital_management_group_privilege"/>
        </record>

        <record id="hospital_group_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="hospital_management.hospital_management_group_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <record id="hospital_group_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="hospital_management.hospital_management_group_privilege"/>
            <field name="implied_ids" eval="[(4, ref('hospital_group_patient'))]"/>
        </record>

        <record id="hospital_group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="hospital_management.hospital_management_group_privilege"/>
            <field name="implied_ids" eval="[(4, ref('hospital_group_doctor')),(4, ref('hospital_group_receptionist'))]"/>
        </record>

        <record id="group_doctor_extra_rights" model="res.groups">
            <field name="name">Doctor Extra Rights</field>
        </record>

    </data>
</odoo>
