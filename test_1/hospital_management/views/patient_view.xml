<odoo>
    <data>

        <record id="patient_list" model="ir.ui.view">
            <field name="name">Patient</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
            <list>
                <field name="patient_code" width="25px"/>
                <field name="name" width="30px"/>
                <field name="date_of_birth" width="30px"/>
                <field name="age" width="30px"/>
                <field name="phone" width="25px"/>
                <field name="email" width="25px"/>
            </list>
            </field>
        </record>


        <record id="patient_form" model="ir.ui.view">
            <field name="name">Patient</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Form View">
                    <sheet>

                        <div name="button_box" position="inside">
                            <button name="appointment_p_btn" type="object" class="oe_stat_button" icon="fa-id-card-o">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Appointments</span>
                                    <span class="o_stat_value"><field name="appointment_count"/></span>
                                </div>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="patient_code"/>
                                <field name="name"/>
                                <field name="date_of_birth"/>
                                <field name="age"/>
                                <field name="phone" widget="phone"/>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <span>Address</span>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" placeholder="State" class="o_address_state" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <div name="partner_address_country" class="d-flex justify-content-between">
                                        <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                    </div>
                                </div>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="patient_action" model="ir.actions.act_window">
            <field name="name">Patient</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'is_patient':1}</field>
            <field name="domain">[('patient_code','like','p%')]</field>
        </record>

        <record model="ir.actions.act_window.view" id="list_patient_action">
            <field name="view_mode">list</field>
            <field name="view_id" ref="patient_list"/>
            <field name="act_window_id" ref="patient_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="form_patient_action">
            <field name="view_mode">form</field>
            <field name="view_id" ref="patient_form"/>
            <field name="act_window_id" ref="patient_action"/>
        </record>

        <menuitem name="Patient" id="patient_id" parent="hospital_management.hospital_management_id" action="patient_action" groups="hospital_management.group_doctor_extra_rights,hospital_management.hospital_group_patient"/>
    </data>
</odoo>