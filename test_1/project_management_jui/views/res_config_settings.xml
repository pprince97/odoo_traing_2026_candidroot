<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_project_jui" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.project.jui</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='languages_setting_container']" position="after">
                    <block title="Project management" id="show_project_bill">
                        <setting id="project_bill_setting" >
                            <div class="content-group mb-3">
                                <div>
                                    <div class="mt8">
                                        <field name="show_bill"/>
                                        <label for="show_bill">Show the bill in project management</label>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
