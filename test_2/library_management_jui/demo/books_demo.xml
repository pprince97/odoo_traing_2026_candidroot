<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.USD" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <record id="book1_demo" model="library.books">
        <field name="name">book1</field>
        <field name="barcode">b0001</field>
        <field name="description">description of book1</field>
        <field name="currency_id" ref="base.USD"/>
        <field name="state">unpublished</field>
        <field name="category">novel</field>
        <field name="available_copies">0</field>
        <field name="stock">10</field>
        <field name="stock_copy">10</field>
        <field name="borrow_price">50</field>
        <field name="maximum_day_limit">5</field>
