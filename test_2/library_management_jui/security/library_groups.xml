<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Groups Category -->

       <record model="ir.module.category" id="library_management_group_catgory">
            <field name="name">Library Management</field>
            <field name="sequence">40</field>
       </record>

        <!-- Group Privilege -->

        <record model="res.groups.privilege" id="library_management_group_privilege">
            <field name="name">Role</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="library_management_jui.library_management_group_catgory"/>
        </record>

        <!-- Groups -->

        <record id="library_group_student" model="res.groups">
            <field name="name">Student</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="library_management_jui.library_management_group_privilege"/>
        </record>

        <record id="library_group_librarian" model="res.groups">
            <field name="name">Librarians</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('library_management_jui.library_group_student')),(4, ref('base.group_erp_manager'))]"/>
            <field name="privilege_id" ref="library_management_jui.library_management_group_privilege"/>
        </record>

        <record id="library_group_librarian_librarian" model="res.groups">
            <field name="name">Librarians</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="library_group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('library_management_jui.library_group_librarian'))]"/>
            <field name="privilege_id" ref="library_management_jui.library_management_group_privilege"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
