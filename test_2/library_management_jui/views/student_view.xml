<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="student_kanban" model="ir.ui.view">
            <field name="name">Student</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <kanban class="o_hr_department_kanban o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="row">
                                <div class="col-8">
                                   <h4><field class="fw-bold fs-2" name="name"/></h4>
                                </div>
                                <div class="col-4 text-end">
                                    <field class="badge text-bg-success rounded-pill" name="gender"/>
                                </div>
                            </div>
                            <div>
                               <field name="email"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="student_form" model="ir.ui.view">
            <field name="name">Student</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Form View">

                    <sheet>
                        <div name="button_box" position="inside">
                            <button name="borrow_history_of_student"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-list">
                                <field name="borrow_history_count" string ="Borrow History" widget="statinfo"/>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="gender"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="library_student_action_id" model="ir.actions.act_window">
            <field name="name">Student</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,form</field>
            <field name="context">{'default_is_student':1}</field>
            <field name="domain">[('is_student','=','1')]</field>
        </record>

        <record model="ir.actions.act_window.view" id="kanban_student_action">
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="student_kanban"/>
            <field name="act_window_id" ref="library_student_action_id"/>
        </record>

        <record model="ir.actions.act_window.view" id="form_student_action">
            <field name="view_mode">form</field>
            <field name="view_id" ref="student_form"/>
            <field name="act_window_id" ref="library_student_action_id"/>
        </record>

        <menuitem id="library_student_id" name="Student" parent="library_management_jui.library_management_id" action="library_student_action_id"/>
    </data>
</odoo>