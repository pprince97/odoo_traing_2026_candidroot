<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="borrow_request_cancel_wizard_form" model="ir.ui.view">
            <field name="name">borrow.request.cancel</field>
            <field name="model">library.borrow.request.cancel.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="cancellation_reason"/>
                        </group>
                        <footer>
                            <button
                                    type="object"
                                    name="wizard_submit"
                                    string="Submit"
                                    class="btn-success"
                            />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>