    <template id="website_book_borrow_template" name="Book Borrow Requests">
        <t t-call="website.layout">
            <t t-foreach="requests" t-as="req">
                <div class="container">
                    <h2>
                        <t t-esc="req.serial_number"/>
                    </h2>

                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>Librarian Name</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <t t-esc="req.student_id.name"/>
                                </td>
                                <td>
                                    <t t-esc="req.librarian_id.name"/>
                                </td>
                                <td>
                                    <t t-esc="req.total_amount"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="custom_home" model="website.menu">
        <field name="name">Partner</field>
        <field name="url">/partner/form</field>
        <field name="parent_id" ref="website.main_menu"/>
    </record>

    <record id="contact_us" model="website.menu">
        <field name="name">Contact Us</field>
        <field name="url">/contactus</field>
        <field name="parent_id" ref="website.main_menu"/>
    </record>

</odoo>