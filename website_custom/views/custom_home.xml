<odoo>
    <template id="custom_home_logged_in" name="CSS Vs SCSS">
        <t t-call="website.layout">
            <div>
                <h2>
                    <b>Welcome Home Logged In User</b>
                </h2>
                <br/>
                <br/>
                <div>
                    <h4>CSS</h4>
                    <ul>
                        <li>
                            CSS (Cascading Style Sheets) is a stylesheet language for designing the layout of web pages.
                        </li>
                        <li>
                            It is simple to use and follows a cascading hierarchy to apply styles to HTML elements.
                        </li>
                    </ul>
                </div>
                <br/>
                <div>
                    <h4>SCSS</h4>
                    <ul>
                        <li>
                            SCSS (Sassy CSS) is a preprocessor scripting language that extends CSS with features like
                            variables, nesting, and mixins.
                        </li>
                        <li>
                            It makes stylesheets more maintainable and efficient to write.
                        </li>
                    </ul>
                </div>
                <br/>
            </div>
        </t>
    </template>

    <template id="custom_home_not_logged_in" name="CSS Vs SCSS">
        <t t-call="website.layout">
            <div>
                <h2>
                    <b>You can access this page but Please log in!!!!</b>
                </h2>
                <br/>
                <br/>
                <div>
                    <h4>CSS</h4>
                    <ul>
                        <li>
                            CSS (Cascading Style Sheets) is a stylesheet language for designing the layout of web pages.
                        </li>
                        <li>
                            It is simple to use and follows a cascading hierarchy to apply styles to HTML elements.
                        </li>
                    </ul>
                </div>
                <br/>
                <div>
                    <h4>SCSS</h4>
                    <ul>
                        <li>
                            SCSS (Sassy CSS) is a preprocessor scripting language that extends CSS with features like
                            variables, nesting, and mixins.
                        </li>
                        <li>
                            It makes stylesheets more maintainable and efficient to write.
                        </li>
                    </ul>
                </div>
                <br/>
            </div>
        </t>
    </template>

    <template id="partner_form_template" name="CSS Vs SCSS">
        <t t-call="website.layout">
            <form action="/partner/form/submit" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <input type="text" name="name" placeholder="Name" required="1"/>
                <input type="email" name="email" placeholder="Email"/>
                <input type="text" name="phone" placeholder="Phone"/>

                <button type="submit">Submit</button>
            </form>
        </t>
    </template>

    <template id="website_partner_template">
        <xpath expr="//input[@name='email']" position="after">
            <div class="form-group mt-3">
                <label for="channel_ids">Channels</label>
                <select name="channel_ids" id="channel_ids" class="form-control" multiple="True">
                    <t t-foreach="request.env['res.partner'].sudo().search([])" t-as="c">
                        <option t-att-value="c.id">
                            <t t-esc="c.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </template>

    <template id="portal_my_home_rental" name="Rental" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div id="portal_alert_category" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/account/static/src/img/bill.svg'"/>
                    <t t-set="title">Borrow Requests</t>
                    <t t-set="url" t-value="'/borrow'"/>
                    <t t-set="text">See borrow requests</t>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="custom_simple_footer" inherit_id="website.layout">

        <xpath expr="//footer" position="replace">

            <footer class="bg-dark text-white mt-5">
                <div class="container py-4">

                    <div class="row">

                        <div class="col-md-6">
                            <h5>CandidRoot</h5>
                        </div>

                        <div class="col-md-6 text-md-end mt-3 mt-md-0">
                            <a href="/partner/form" class="text-white me-3">
                                Partner
                            </a>
                            <a href="/contactus" class="text-white">
                                Contact Us
                            </a>
                        </div>

                    </div>

                    <hr class="border-light my-3"/>

                    <div class="text-center">
                        <small>
                            © 2026 CandidRoot | All Rights Reserved
                        </small>
                    </div>

                </div>
            </footer>

        </xpath>

    </template>

