<odoo>


    <template id="hide_price_card_tile" inherit_id="website_sale.products_item">

        <xpath expr="//div[contains(@class, 'product_price')]" position="attributes">
            <attribute name="t-if">not request.env.user._is_public()</attribute>
        </xpath>
        <xpath expr="//div[contains(@class, 'product_price')]" position="replace">
            <attribute name="t-if">not request.env.user._is_public()</attribute>
        </xpath>

    </template>

    <template id="hide_price_shop_tile" inherit_id="website_sale.product">

        <xpath expr="//div[contains(@class, 'o_wsale_product_details_content_section_price')]" position="attributes">
            <attribute name="t-if">not request.env.user._is_public()</attribute>
        </xpath>

    </template>


